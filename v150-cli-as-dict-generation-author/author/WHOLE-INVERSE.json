l':plan['generation_terminal']['pin']}\n\n\n\ndef stage_spec(plan, label):\n    require(label in STAGES,'fixed original six-stage order required')\n    component,stage=label.split('-',1)\n    require(component in GENERATOR_ORDER and stage in ('generate-1','generate-2','check'),\n            'unknown original generator phase')\n    require(plan['components']==GENERATOR_SPEC,'fixed original generators/host order differ')\n    return component,stage,plan['components'][component]\n\n\ndef second_output_directory(plan, component):\n    label=component+'-generate-2';index=STAGES.index(label)\n    return Path(plan['attempt'])/('%02d-'%(index+1)+label)/'outputs'\n\n\ndef version_authority_maps(plan, installed, attempt):\n    \"\"\"Publish complete actual maps only after all six generation owners pass.\n\n    The source contains no new file or changed test. These new map versions\n    do not make the prior R5/Patch14 qualifications apply to the new hosts.\n    \"\"\"\n    actual=decode(checked(installed['map']));base=decode(checked(plan['base_source']['map']))\n    r5_raw=checked(plan['r5_before']);patch_raw=checked(plan['patch14_before'])\n    r5=decode(r5_raw);patch=decode(patch_raw)\n    cli={'hepta/hia_cli_patch_result_native.py','hepta/hia_patch_cli_records.py',\n         'tests/hia_patch_cli_support.py','tests/test_hia_patch_cli_source.py',\n         'tests/test_hia_patch_cli_native.py'}\n    require(len(actual)==len(base)==3210 and len(r5)==3191 and len(patch)==14\n            and not set(r5)&set(patch) and set(actual)==set(base)==set(r5)|set(patch)|cli,\n            'original complete3191/14/3210 path domains differ')\n    require(all(base[n]==v for n,v in r5.items())and all(base[n]==v for n,v in patch.items()),\n            'retained maps must bind the actual complete prepared base')\n    require(set(installed['changed_bytes'])=={'hepta/hia_inspect_program_data.py','hepta/hia_patch_result_data.py'},\n            'unchanged policy inputs must reproduce original HIA/ports; only actual host data changes')\n    require({n for n in base if actual[n]!=base[n]}==set(plan['changed_source_paths'])|set(installed['changed_bytes']),\n            'unexpected actual product-source change')\n    current_r5={n:actual[n]for n in r5};current_patch={n:actual[n]for n in patch}\n    require({n for n in r5 if current_r5[n]!=r5[n]}==set(plan['changed_source_paths'])|{'hepta/hia_inspect_program_data.py'}\n            and {n for n in patch if current_patch[n]!=patch[n]}=={'hepta/hia_patch_result_data.py'},\n            'actual versioned authority changes exceed the reviewed hosts and generated identities')\n    write_new_file(attempt/'R5-SOURCE-MAP-BEFORE.json',r5_raw,0o644)\n    write_new_file(attempt/'PATCH14-SOURCE-MAP-BEFORE.json',patch_raw,0o644)\n    publish(attempt/'ACTUAL-R5-SOURCE-MAP.json',current_r5)\n    publish(attempt/'ACTUAL-PATCH14-SOURCE-MAP.json',current_patch)\n    result={'status':'ACTUAL_GENERATED_AUTHORITY_MAPS_NOT_QUALIFICATION',\n        'source_files':3210,'r5_files':3191,'patch14_files':14,\n        'source_map':installed['map'],'source_tree':installed['tree'],\n        'r5_before':capture(attempt/'R5-SOURCE-MAP-BEFORE.json'),\n        'r5_actual':capture(attempt/'ACTUAL-R5-SOURCE-MAP.json'),\n        'patch14_before':capture(attempt/'PATCH14-SOURCE-MAP-BEFORE.json'),\n        'patch14_actual':capture(attempt/'ACTUAL-PATCH14-SOURCE-MAP.json'),\n        'historical_patch14':plan['patch14_historical'],\n        'all_old_test_files_complete_bytes_unchanged':all(actual[n]==base[n]for n in base if n.startswith('tests/')),\n        'external_tests':plan['external_tests'],'future_qualification_executed':False,\n        'old_R5_or_Patch14_PASS_transferred':False}\n    require(result['all_old_test_files_complete_bytes_unchanged'],'original tests changed')\n    publish(attempt/'ACTUAL-AUTHORITY-MAPS.json',result)\n    return result\n",
