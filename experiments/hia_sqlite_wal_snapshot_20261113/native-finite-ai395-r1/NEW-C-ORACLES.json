{
  "schema": "hia.sqlite.wal.snapshot.C-oracle-static-draft.v1",
  "status": "AUTHORED_UNCOMPILED_UNEXECUTED",
  "owner": "root",
  "entry": "oracle_wal_recover_find",
  "signature": "uint32 oracle_wal_recover_find(const u8 *raw, u64 n, u64 target_page, u64 *out32, u64 *read_pairs, u64 read_words)",
  "output_fields": [
    "recovery rc",
    "find rc or UINT64_MAX when not called",
    "hdr.mxFrame",
    "hdr.nPage",
    "Wal.szPage",
    "raw hdr.szPage (1 means 65536)",
    "hdr.bigEndCksum",
    "checkpoint counter",
    "committed checksum 0 or raw error state",
    "committed checksum 1 or raw error state",
    "salt 0 big-endian word",
    "salt 1 big-endian word",
    "hdr.isInit",
    "hdr.iVersion",
    "hdr.aCksum[0]",
    "hdr.aCksum[1]",
    "found frame",
    "found page-data offset or zero",
    "actual read calls",
    "actual read bytes",
    "actual file-size calls",
    "actual allocated WAL-index pages",
    "last read offset",
    "last read size",
    "short-read errors",
    "reserved zero",
    "reserved zero",
    "reserved zero",
    "reserved zero",
    "reserved zero",
    "reserved zero",
    "reserved zero"
  ],
  "transport": {
    "whole_finite_WAL_bytes_max": 8388608,
    "target_page": "0 for scan-only; otherwise 1..4294967295",
    "read_words": "even, at least 2*(floor(n/536)+2), at most 32772",
    "read_pairs": "Every actual sqlite3OsRead(offset,size), in order; unused words must remain original seed.",
    "alignment": "out32/read_pairs aligned to 8 bytes, all spans disjoint; full real buffer allocations and canaries retained.",
    "raw_source_unchanged": true
  },
  "return_codes": {
    "0": "Actual original recovery and optional find returned; inspect raw out[0]/out[1] before comparison.",
    "1": "Finite scalar transport admission refused before output writes.",
    "2": "WAL-index memory-provider setup failed; not a passing oracle."
  },
  "mode": "Original WAL_HEAPMEMORY_MODE; original allocator/index/hash/recovery/find algorithms, with a finite byte-copy I/O provider only.",
  "structs": "Complete original Wal, WalIndexHdr, WalCkptInfo, WalHashLoc and ht_slot; sqlite3_file is explicitly a minimal finite in-memory transport, not an original VFS structure.",
  "source_capability": "All retained original selected bodies, including complete walIndexRecover and walFindFrame, are byte-exact; no HIA algorithm code is linked.",
  "projection_rules": [
    "First retain adapter rc, all raw output words, full WAL input, full read buffer and canaries for each C version.",
    "A successful recovery with mxFrame=0 leaves effective database size/page size to the independently fixed base database fields; do not label raw nPage=0 a truncation.",
    "Above-snapshot-size targets are missing at the pager admission boundary even if raw walFindFrame finds an older frame. Preserve the raw C result before this separate projection.",
    "Fixed-prefix comparisons use independently declared captured byte views; never choose the C input domain or view from a new HIA return status.",
    "Unsupported version can produce raw rc=14; preserve original header/checksum/salt state. Protocol, reentry, mutable-state custody and huge sparse extents have no equivalent C call."
  ],
  "required_compile_flags": [
    "-std=c11",
    "-O2",
    "-fPIC",
    "-shared",
    "-fno-lto",
    "-fno-common",
    "-fno-strict-aliasing",
    "-fno-fast-math",
    "-Wl,-Bsymbolic",
    "-Wl,-z,defs"
  ],
  "assertions": {
    "NDEBUG_allowed": false,
    "SQLITE_DEBUG": 1,
    "SQLITE_ENABLE_EXPENSIVE_ASSERT": 1,
    "WalIndexHdr_bytes": 48,
    "WALINDEX_HDR_SIZE": 136,
    "WALINDEX_PGSZ": 32768
  },
  "exclusions": [
    "No filesystem or OS/shared-memory lock qualification; forbidden real-VFS paths abort.",
    "No native HIA execution, pager admission/backfill/checkpoint/durability/SQL/AgentStore or default activation qualification.",
    "The 8 MiB limit bounds this finite C oracle only; no such whole-WAL limit is added to HIA.",
    "The non-Windows guarded entry is initialized for original SEH assertions. No Windows exception or concurrent index publication claim.",
    "Public status constants and single-thread atomic-load/store transport macros are explicit adapter definitions."
  ],
