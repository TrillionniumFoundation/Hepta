+        for fail in failures:
+            pair = {label: observe(core, entry, args, allocation_fail_at=fail,
+                                  max_steps=1000000, max_heap_bytes=1048576, max_call_depth=32)
+                    for label, core in (("original", original), ("candidate", candidate))}
