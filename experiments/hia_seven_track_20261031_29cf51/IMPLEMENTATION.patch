+                policy={"schema": POLICY_SCHEMA, "budget_mode": "both_fit_same_quotas", "max_allocator_interactions": 64,
+                        "max_vm_ticks": 4096, "max_call_depth": 2, "max_live_heap_bytes": 4})
+        except HIAStaticBudgetRejected as error:
