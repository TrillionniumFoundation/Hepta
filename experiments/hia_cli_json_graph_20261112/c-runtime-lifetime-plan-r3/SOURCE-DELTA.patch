@@ -5,6 +5,17 @@
  * This avoids importing private TLS; error and ownership order are unchanged.
  * Private development ABI; not compiled or executed.
  */
+
+/* Exact CPython v3.12.14 Python/errors.c body; local linkage only.
+ * Preserve the explicit state, stolen reference, and store-before-DECREF.
+ */
+static void
+cj312_set_raised_exception(PyThreadState *tstate, PyObject *exc)
+{
+    PyObject *old_exc = tstate->current_exception;
+    tstate->current_exception = exc;
+    Py_XDECREF(old_exc);
+}
 
