        },
        {
          "line": 1402,
          "text": "    // merge the template args provided from command line with the args provided in the user request"
        },
        {
          "line": 1403,
          "text": "    auto chat_template_kwargs_object = json_value(body, \"chat_template_kwargs\", json::object());"
        },
        {
          "line": 1404,
          "text": "    inputs.chat_template_kwargs = opt.chat_template_kwargs;"
        },
        {
          "line": 1405,
          "text": "    for (const auto & item : chat_template_kwargs_object.items()) {"
        },
        {
          "line": 1406,
          "text": "        inputs.chat_template_kwargs[item.key()] = item.value().dump();"
        },
        {
          "line": 1407,
          "text": "    }"
        },
        {
          "line": 1408,
          "text": ""
        },
        {
          "line": 1409,
          "text": "    // parse the \"enable_thinking\" kwarg to override the default value"
        },
        {
          "line": 1410,
          "text": "    auto enable_thinking_kwarg = json_value(inputs.chat_template_kwargs, \"enable_thinking\", std::string(\"\"));"
        },
        {
          "line": 1411,
          "text": "    if (enable_thinking_kwarg == \"true\") {"
        },
        {
          "line": 1412,
          "text": "        inputs.enable_thinking = true;"
        },
        {
          "line": 1413,
          "text": "    } else if (enable_thinking_kwarg == \"false\") {"
        },
        {
          "line": 1414,
          "text": "        inputs.enable_thinking = false;"
        },
        {
          "line": 1415,
          "text": "    } else if (!enable_thinking_kwarg.empty() && enable_thinking_kwarg[0] == '\"') {"
        },
        {
          "line": 1416,
          "text": "        throw std::invalid_argument(\"invalid type for \\\"enable_thinking\\\" (expected boolean, got string)\");"
        },
        {
          "line": 1417,
          "text": "    }"
        },
        {
          "line": 1418,
          "text": ""
        },
        {
          "line": 1419,
          "text": "    // Parse the OAI \"reasoning_effort\" field; \"none\" disables reasoning."
        },
        {
          "line": 1420,
          "text": "    if (body.contains(\"reasoning_effort\")) {"
        },
        {
          "line": 1421,
          "text": "        auto reasoning_effort = json_value(body, \"reasoning_effort\", std::string(\"\"));"
        },
        {
          "line": 1422,
          "text": "        if (reasoning_effort == \"none\") {"
        },
        {
          "line": 1423,
          "text": "            inputs.enable_thinking = false;"
        },
        {
          "line": 1424,
          "text": "            inputs.chat_template_kwargs.erase(\"reasoning_effort\");"
        },
        {
          "line": 1425,
          "text": "        } else if (!reasoning_effort.empty()) {"
        },
        {
          "line": 1426,
          "text": "            inputs.chat_template_kwargs[\"reasoning_effort\"] = json(reasoning_effort).dump();"
        },
        {
          "line": 1427,
          "text": "        }"
        },
        {
          "line": 1428,
          "text": "    }"
        },
        {
          "line": 1429,
          "text": ""
        },
        {
