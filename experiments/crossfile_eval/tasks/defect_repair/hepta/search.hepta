module search;
pub fn locate(values: read [i64], count: usize, key: i64) -> usize effects {panic} {
    if count == 0 { return 0; }
    let mut lo: usize = 0;
    let mut hi = count - 1;
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if values[mid] <= key { lo = mid + 1; } else { hi = mid; }
    }
    return lo;
}
