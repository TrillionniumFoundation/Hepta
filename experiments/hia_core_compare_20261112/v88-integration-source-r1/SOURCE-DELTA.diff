+        return get32(w, base + index * 4)
+    bits = get(w, record + 16)
+    mantissa = bits & 4503599627370495
+    if ((bits >> 52) & 2047) != 0:
+        mantissa = mantissa | 4503599627370496
+    if index == 0:
+        return mantissa & 4294967295
+    if index == 1:
+        return mantissa >> 32
+    return 0
