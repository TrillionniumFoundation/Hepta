+    args = parser.parse_args()
+    output = args.output
+    mode = 'x'
+    if output is None:
+        output = Path(__file__).resolve().parents[1] / 'examples/hia_bootstrap/core_compare.hiaasm'
+        mode = 'w'
+    with output.open(mode) as stream:
+        stream.write(render_assembly(document()))
