+def _host_unpack(observed, count):
+    """Retained opcode-14 value policy, independent of the HIA companion."""
+    if count == 1:
+        a, = observed
+        results = (a,)
+    elif count == 2:
+        a, b = observed
+        results = (a, b)
+    elif count == 3:
+        a, b, c = observed
+        results = (a, b, c)
+    elif count == 4:
+        a, b, c, d = observed
+        results = (a, b, c, d)
+    else:
+        raise RuntimeError('native lowering unpack arity differs')
+    return 0, results
