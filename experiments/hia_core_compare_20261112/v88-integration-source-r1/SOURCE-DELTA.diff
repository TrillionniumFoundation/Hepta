+    return choose((bits & 4503599627370495) == 0, 1, 2)
+
+def integer_words(w:mutbuf, record:u64) -> u64:
+    if get(w, record) == 1:
+        return get(w, record + 16)
+    return get(w, record + 8)
+
+def integer_width(w:mutbuf, record:u64) -> u64:
+    if get(w, record) == 1:
+        return get(w, record + 16)
+    return get(w, record + 16) & 63
