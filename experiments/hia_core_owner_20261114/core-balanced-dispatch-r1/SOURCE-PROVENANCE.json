  "canonical_wire_JS_source": "return function pywire(value) {\n function q(s){return JSON.stringify(s).replace(/[\\u007f-\\uffff]/g,c=>\"\\\\u\"+c.charCodeAt(0).toString(16).padStart(4,\"0\"));}\n function py(v,depth=0,key=\"\"){\n  if(typeof v===\"string\")return [\"mtime_ns\",\"ctime_ns\"].includes(key)&&/^\\d+$/.test(v)?v:q(v);\n  if(v===null||typeof v!==\"object\")return JSON.stringify(v);\n  const pad=\"  \".repeat(depth),next=\"  \".repeat(depth+1);\n  if(Array.isArray(v))return v.length?\"[\\n\"+v.map(x=>next+py(x,depth+1)).join(\",\\n\")+\"\\n\"+pad+\"]\":\"[]\";\n  const keys=Object.keys(v).sort();return keys.length?\"{\\n\"+keys.map(key=>next+q(key)+\": \"+py(v[key],depth+1,key)).join(\",\\n\")+\"\\n\"+pad+\"}\":\"{}\";\n }\n return py(value)+\"\\n\";\n};",
