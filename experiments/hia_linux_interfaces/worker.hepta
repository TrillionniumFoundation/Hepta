module linux_worker;

export "C" fn worker_checksum(count:usize,seed:u32)->u64 effects {alloc,block,panic,write} {
    match try_buffer(count) {
        Result::Err(code)=>{return 1000+(code as u64);},
        Result::Ok(initial)=>{
            let mut bytes=move initial;
            for i in 0..count {bytes[i]=wrapping_add(i as u32,seed) as u8;}
            let mut total:u64=0;
            for i in 0..count {total=total+(bytes[i] as u64);}
            drop(move bytes);
            return total;
        },
    }
}
