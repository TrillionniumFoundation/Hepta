{
  "closed_findings": [
    {
      "finding": "A numerically correct Rust scalar implementation with vec/drop tokens in comments previously passed the resource task without using its buffer API.",
      "resolution": "Native audited Vec API records allocation, mutable indexing, actual indexed readback and explicit release; scalar and uncalled-helper controls reject. Exact task length is checked before real allocation."
    },
    {
      "finding": "HIA could place required store/load tokens in an uncalled helper while its target returned a scalar shortcut.",
      "resolution": "Actual VM operation events must witness matching allocation/store/load/drop on the same owner, size, index and value for public and terminal hidden cases."
    },
    {
      "finding": "Malformed action and digest types could cause TypeError and end the study instead of returning repairable RPC feedback.",
      "resolution": "Bounded strict JSON and exact action/digest type checks produce repairable RPC errors."
    },
    {
      "finding": "HIA local parameter names were constrained more tightly than the Rust scalar ABI.",
      "resolution": "Both use two positional u32 inputs and one u32 result; alpha-renamed candidates pass actual native checks."
    },
    {
      "finding": "VM resource evidence needed an independent return-value check.",
      "resolution": "Both public and terminal hidden VM results are checked against the independent task oracle."
    }
  ],
