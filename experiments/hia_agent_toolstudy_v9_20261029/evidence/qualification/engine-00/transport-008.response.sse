act revision and complete query digest.\nInterface policy: preserve. All node IDs below come from public source, not selected repair sites.\nActual editable source, including binding/statement context: {\"api.rs\":\"pub fn touch(mut buf:Vec<u8>,x:u8)->Vec<u8> { buf[0]=x; buf }\",\"client.rs\":\"use crate::api; pub fn entrypoint(a:u32,b:u32,c:u32)->u64 { let _=c; let buf=vec![0u8;((a&7)+1) as usize]; let out=api::touch(buf,b as u8); let value=(buf[0] as u64)+16*(buf.len() as u64); drop(out); value }\"}\nActual parsed interfaces: {\"api.rs\":{\"name\":\"touch\",\"params\":[[\"buf\",\"Vec<u8>\"],[\"x\",\"u8\"]],\"returns\":\"Vec<u8>\"},\"audit.rs\":{\"name\":\"audit_tag\",\"params\":[[\"c\",\"u32\"]],\"returns\":\"u32\"},\"client.rs\":{\"name\":\"entrypoint\",\"params\":[[\"a\",\"u32\"],[\"b\",\"u32\"],[\"c\",\"u32\"]],\"returns\":\"u64\"},\"utility.rs\":{\"name\":\"utility\",\"params\":[[\"x\",\"u32\"]],\"returns\":\"u32\"}}\napi.rs/touch/n0 read-only type parameter_type parameter=buf bytes=21:28 = \"Vec<u8>\"\napi.rs/touch/n1 read-only type parameter_type parameter=x bytes=31:33 = \"u8\"\napi.rs/touch/n2 read-only type return_type bytes=36:43 = \"Vec<u8>\"\napi.rs/touch/n3 edit expression bytes=46:49 = \"buf\"\napi.rs/touch/n4 edit expression bytes=46:52 = \"buf[0]\"\napi.rs/touch/n5 edit expression bytes=50:51 = \"0\"\napi.rs/touch/n6 edit expression bytes=53:54 = \"x\"\napi.rs/touch/n7 edit expression bytes=56:59 = \"buf\"\nclient.rs/entrypoint/n0 read-only type parameter_type parameter=a bytes=36:39 = \"u32\"\nclient.rs/entrypoint/n1 read-only type parameter_type parameter=b bytes=42:45 = \"u32\"\nclient.rs/entrypoint/n2 read-only type parameter_type parameter=c bytes=48:51 = \"u32\"\nclient.rs/entrypoint/n3 read-only type return_type bytes=54:57 = \"u64\"\nclient.rs/entrypoint/n4 edit expression bytes=66:67 = \"c\"\nclient.rs/entrypoint/n5 edit expression bytes=77:105 = \"vec![0u8;((a&7)+1) as usize]\"\nclient.rs/entrypoint/n6 edit expression bytes=82:85 = \"0u8\"\nclient.rs/entrypoint/n7 edit expression bytes=86:95 = \"((a&7)+1)\"\nclient.rs/entrypoint/n8 edit expression bytes=86:104 = \"((a&7)+1) as usize\"\nclient.rs/entrypoint/n9 edit expression bytes=87:92 = \"(a&7)\"\nclient.rs/entrypoint/n10 edit expression bytes=87:94 = \"(a&7)+1\"\nclient.rs/entrypoint/n11 edit expression bytes=88:89 = \"a\"\nclient.rs/entrypoint/n12 edit expression bytes=88:91 = \"a&7\"\nclient.rs/entrypoint/n13 edit expression bytes=90:91 = \"7\"\nclient.rs/entrypoint/n14 edit expression bytes=93:94 = \"1\"\nclient.rs/entrypoint/n15 edit type bytes=99:104 = \"usize\"\nclient.rs/entrypoint/n16 edit expression bytes=115:125 = \"api::touch\"\nclient.rs/entrypoint/n17 edit expression bytes=115:138 = \"api::touch(buf,b as u8)\"\nclient.rs/entrypoint/n18 edit expression bytes=126:129 = \"buf\"\nclient.rs/entrypoint/n19 edit expression bytes=130:131 = \"b\"\nclient.rs/entrypoint/n20 edit expression bytes=130:137 = \"b as u8\"\nclient.rs/entrypoint/n21 edit type bytes=135:137 = \"u8\"\nclient.rs/entrypoint/n22 edit expression bytes=150:165 = \"(buf[0] as u64)\"\nclient.rs/entrypoint/n23 edit expression bytes=150:187 = \"(buf[0] as u64)+16*(buf.len() as u64)\"\nclient.rs/entrypoint/n24 edit expression bytes=151:154 = \"buf\"\nclient.rs/entrypoint/n25 edit expression bytes=151:157 = \"buf[0]\"\nclient.rs/entrypoint/n26 edit expression bytes=151:164 = \"buf[0] as u64\"\nclient.rs/entrypoint/n27 edit expression bytes=155:156 = \"0\"\nclient.rs/entrypoint/n28 edit type bytes=161:164 = \"u64\"\nclient.rs/entrypoint/n29 edit expression bytes=166:168 = \"16\"\nclient.rs/entrypoint/n30 edit expression bytes=166:187 = \"16*(buf.len() as u64)\"\nclient.rs/entrypoint/n31 edit expression bytes=169:187 = \"(buf.len() as u64)\"\nclient.rs/entrypoint/n32 edit expression bytes=170:173 = \"buf\"\nclient.rs/entrypoint/n33 edit expression bytes=170:179 = \"buf.len()\"\nclient.rs/entrypoint/n34 edit expression bytes=170:186 = \"buf.len() as u64\"\nclient.rs/entrypoint/n35 ed