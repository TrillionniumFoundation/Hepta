hia-asm.v1 hepta.hia.program.v8 host_region_scalars
fn hia_region_fold(acc:u64,value:u64) -> (u64) effects() entry(entry)
block entry(acc:u64,value:u64)
  sum:u64 = int.add.wrap(acc,value)
  ret(sum)
end
fn hia_region_byte(seed:u32,index:usize) -> (u8) effects() entry(entry)
block entry(seed:u32,index:usize)
  at:u32 = int.cast(index) {"mode":"wrap"}
  sum:u32 = int.add.wrap(seed,at)
  result:u8 = int.cast(sum) {"mode":"wrap"}
  ret(result)
end
