{
  "schema": "hepta.c-record-views.v1",
  "records": {
    "ring_buffer_t": {
      "buffers": {
        "buffer": {
          "length_field": "buffer_mask",
          "add": 1
        }
      }
    }
  },
  "functions": {
    "ring_buffer_init": {
      "records": {
        "buffer": {
          "access": "mut",
          "initialize": {
            "buffer": "buf"
          }
        }
      },
      "slices": {
        "buf": {
          "access": "mut",
          "length": "buf_size"
        }
      }
    },
    "ring_buffer_queue": {
      "records": {
        "buffer": {
          "access": "mut"
        }
      },
      "slices": {}
    },
    "ring_buffer_queue_arr": {
      "records": {
        "buffer": {
          "access": "mut"
        }
      },
      "slices": {
        "data": {
          "access": "read",
          "length": "size"
        }
      }
    },
    "ring_buffer_dequeue": {
      "records": {
        "buffer": {
          "access": "mut"
        }
      },
      "slices": {
        "data": {
          "access": "mut",
          "length": 1
        }
      }
    },
    "ring_buffer_dequeue_arr": {
      "records": {
        "buffer": {
          "access": "mut"
        }
      },
      "slices": {
        "data": {
          "access": "mut",
          "length": "len"
        }
      }
    },
    "ring_buffer_peek": {
      "records": {
        "buffer": {
          "access": "mut"
        }
      },
      "slices": {
        "data": {
          "access": "mut",
          "length": 1
        }
      }
    },
    "ring_buffer_is_empty": {
      "records": {
        "buffer": {
          "access": "read"
        }
      },
      "slices": {}
    },
    "ring_buffer_is_full": {
      "records": {
        "buffer": {
          "access": "read"
        }
      },
      "slices": {}
    },
    "ring_buffer_num_items": {
      "records": {
        "buffer": {
          "access": "read"
        }
      },
      "slices": {}
    }
  }
}
