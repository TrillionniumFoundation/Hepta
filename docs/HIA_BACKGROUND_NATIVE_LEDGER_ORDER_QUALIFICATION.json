      "text": "from pathlib import Path\nimport argparse,json,sys\nP=Path('/home/qian-qi/.local/state/hia-azi5-b843-qa/native-release-closeout-20261124T0740Z/native-multiversion-proof-source');sys.path.insert(0,str(P));L=P.parent;B=L.parent/'cleanup-audit-20261124T0745Z'\nfrom tools import qualify_hia_multiversion_background_ledger_allocations as q\nBase=q.Ledger\nclass Ordered(Base):\n def run(self,op,*a,**kw):\n  if op==2:\n   raw=bytearray(self.packet(2));raw[:8]=b'HIABLG02';kw['wire']=bytes(raw)\n  out=super().run(op,*a,**kw)\n  if op==2 and kw.get('want',0)!=0:assert out[64:128]==bytes(64)\n  return out\nq.Ledger=Ordered\na=argparse.Namespace(directory=Path('/home/qian-qi/.local/state/hia-native-final-custody-20261125/ledger-order-native-v2'),jobs=L/'native-background-jobs-external-v3/jobs-component.so',future=B/'native-multiversion-future-v2/future-component.so',payload=L/'native-background-payload-v1/payload-component.so',values=B/'native-multiversion-values-v1/values-component.so')\nq.child(a)\n"
