      "text": "from pathlib import Path\nfrom hashlib import sha256\nimport collections,ctypes as C,itertools,json,os,resource,struct,sys,threading,time\nT=Path('/home/qian-qi/.local/state/hia-native-final-custody-20261125')\nP=Path('/home/qian-qi/.local/state/hia-azi5-b843-qa/native-release-closeout-20261124T0740Z/native-multiversion-proof-source')\nL=P.parent;B=L.parent/'cleanup-audit-20261124T0745Z';D=T/'ledger-order-native-v2'\nsys.path.insert(0,str(P));resource.setrlimit(resource.RLIMIT_CORE,(0,0))\nfrom tools.qualify_hia_multiversion_background_ledger import Ledger,STATUSES\nfrom tools.qualify_hia_multiversion_background_jobs import Jobs,get\nfrom tools.qualify_hia_multiversion_values import Owner\nq=Jobs(L/'native-background-jobs-external-v3/jobs-component.so',B/'native-multiversion-future-v2/future-component.so',L/'native-background-payload-v1/payload-component.so')\nvalues=Owner(B/'native-multiversion-values-v1/values-component.so');rows=[];snapshots=0;total_calls=0\ndef observed(l):\n    global snapshots\n    raw=bytearray(l.packet(2));raw[:8]=b'HIABLG02';out=l.run(2,wire=bytes(raw));n=get(out,64);mask=get(out,24)\n    assert n<=6 and out[72+8*n:128]==bytes(56-8*n)\n    indexes=[get(out,72+i*8)for i in range(n)];assert len(set(indexes))==n and all(i<6 for i in indexes)\n    assert sum(1<<i for i in indexes)==mask\n    entries=[];counters=[]\n    try:\n        for i in range(get(out,32)):\n            at=4096+i*48;kind=get(out,at);cap=struct.unpack_from('<3Q',out,at+16);size=get(out,at+40)\n            entries.append((kind,cap,size))\n            if i<8:counters.append(int(values.copy(cap,size)))\n        snapshots+=1\n        return indexes,counters,get(out,16)\n    finally:l.release_entries(entries)\nfor perm in itertools.permutations(range(6)):\n    l=Ledger(D/'ledger-component.so',q,values);expected={};assert observed(l)==([], [0]*8,0)\n    for i,status in enumerate(perm):\n        job=q.create(b'ordered');l.record(job,b'{\"job\":1}',1,status);expected[status]=1\n        if i==0:assert get(l.run(1,job),48)==1\n        q.drop(job)\n        order,counters,recent=observed(l)\n        assert order==list(expected)and counters[0]==i+1 and counters[1]==i+1 and recent==i+1\n        assert counters[2:]==[expected.get(j,0)for j in range(6)]\n        legacy=l.run(2);assert legacy[64:128]==bytes(64)\n        refs=[]\n        for j in range(get(legacy,32)):\n            at=4096+j*48;refs.append((get(legacy,at),struct.unpack_from('<3Q',legacy,at+16),get(legacy,at+40)))\n        l.release_entries(refs)\n    total_calls+=l.calls;l.destroy()\nrows.append({'case':'all-first-occurrence-permutations-and-prefixes','permutations':720,'ordered_snapshots':snapshots,'old_reply_reserved_words_preserved':True})\nprint('LEDGER_ORDER_ALL_PERMUTATIONS_PASS',snapshots,flush=True)\nl=Ledger(D/'ledger-component.so',q,values);checks=0\nfor op in [0,1,3,4,5,9,10,(1<<64)-1]:\n    raw=bytearray(l.packet(op));raw[:8]=b'HIABLG02';prior=l.w.raw;l.run(op,wire=bytes(raw),want=0xfffffffd);assert prior==l.w.raw;checks+=1\nfor at in range(16,128,8):\n    raw=bytearray(l.packet(2));raw[:8]=b'HIABLG02';struct.pack_into('<Q',raw,at,1)\n    prior=l.w.raw;l.run(2,wire=bytes(raw),want=0xfffffffd);assert prior==l.w.raw;checks+=1\nfor n in [0,1,127,129]:\n    raw=bytearray(l.packet(2));raw[:8]=b'HIABLG02';wire=(bytes(raw)+b'x')[:n]\n    prior=l.w.raw;l.run(2,wire=wire,want=0xfffffffd);assert prior==l.w.raw;checks+=1\ntotal_calls+=l.calls;l.destroy()\nrows.append({'case':'new-profile-only-snapshot-and-old-private-domain','controls':checks})\nfor turn in range(16):\n    l=Ledger(D/'ledger-component.so',q,values);barrier=threading.Barrier(9);errors=[];intervals=[None]*8;statuses=[0,1,2,3,4,5,0,3]\n    jobs=[q.create(b'concurrent order')for i in statuses]\n    def work(i):\n        try:\n            barrier.wait();start=time.monotonic_ns();l.record(jobs[i],b'{\"job\":1}',1,statuses[i]);end=time.monotonic_ns()\n            intervals[i]=(start,end);q.drop(jobs[i])\n        except BaseException as e:errors.append(repr(e))\n    threads=[threading.Thread(target=work,args=(i,))for i in range(8)]\n    for thread in threads:thread.start()\n    barrier.wait()\n    for thread in threads:thread.join(20);assert not thread.is_alive()\n    assert not errors,errors\n    order,counters,recent=observed(l)\n    assert len(order)==6 and set(order)==set(range(6))and counters[0:2]==[8,8]and recent==8\n    assert counters[2:]==[statuses.count(i)for i in range(6)]\n    for i in range(8):\n        for j in range(8):\n            if statuses[i]!=statuses[j] and intervals[i][1]<min(intervals[k][0]for k in range(8)if statuses[k]==statuses[j]):\n                assert order.index(statuses[i])<order.index(statuses[j])\n    total_calls+=l.calls;l.destroy()\nrows.append({'case':'actual-first-settlement-races-and-real-time-order','rounds':16,'threads_each':8})\nassert get(values.w.raw,16)==0 and get(q.payload.w.raw,16)==0 and get(q.w.raw,16)==0\nq.destroy();values.run(9)\nreport={'qualified_order_profile':True,'whole_background_qualified':False,'passed':len(rows),'failed':0,'rows':rows,\n'actual_ledger_calls':total_calls,'ordered_snapshots':snapshots,'image_sha256':sha256((D/'ledger-component.so').read_bytes()).hexdigest()}\n(D/'order-qualification.json').write_text(json.dumps(report,indent=2)+'\\n');print('LEDGER_ORDER_QUALIFIED',json.dumps(report),flush=True)\n"
