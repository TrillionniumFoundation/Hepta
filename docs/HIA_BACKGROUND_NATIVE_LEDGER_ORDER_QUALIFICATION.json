      "text": "from pathlib import Path\nfrom hashlib import sha256\nimport ctypes as C,importlib,importlib.util,json,resource,struct,subprocess,sys\nT=Path('/home/qian-qi/.local/state/hia-native-final-custody-20261125')\nP=Path('/home/qian-qi/.local/state/hia-azi5-b843-qa/native-release-closeout-20261124T0740Z/native-multiversion-proof-source')\nB=Path('/home/qian-qi/.local/state/hia-azi5-b843-qa/cleanup-audit-20261124T0745Z')\nD=T/'ledger-order-native-v2';D.mkdir(exist_ok=False);sys.path.insert(0,str(P));resource.setrlimit(resource.RLIMIT_CORE,(0,0))\nfrom hepta.hia_agent_assembly import render_assembly\nfrom tools.build_hia_source_build import _run_captured,_named_source_request,_compiled_sources\nfrom tools.generate_hia_artifact_publication import document\nsp=importlib.util.spec_from_file_location('client',T/'qualify-result-value-core-smoke-v1.py')\nm=importlib.util.module_from_spec(sp);sp.loader.exec_module(m)\nseed=(T/'root-proof/hia-source-build-494833.bin').read_bytes()\nassert sha256(seed).hexdigest()=='494833999e25ac74ea6ad1de41235c01bfa036951f212604026cb8be686c78af'\nroles={};records={}\nfor stem in ['multiversion_background_ledger','multiversion_background_ledger_packer']:\n    mod=importlib.import_module('tools.generate_hia_'+stem)\n    tree=mod.document(mod.source_program(),stem);source=render_assembly(tree).encode();name=stem+'.hepta'\n    (P/'examples/hia_bootstrap'/name).write_bytes(source);(D/name).write_bytes(source)\n    stats={'functions':len(tree['functions']),'blocks':sum(len(f['blocks'])for f in tree['functions']),'ops':sum(len(b['ops'])for f in tree['functions']for b in f['blocks']),'max_block_params':max(len(b['params'])for f in tree['functions']for b in f['blocks'])}\n    assert stats['functions']<=128 and stats['blocks']<=1536 and stats['ops']<=8192 and stats['max_block_params']<=16\n    flats=[]\n    for i in range(2):\n        d=D/(stem+'-compile'+str(i));d.mkdir()\n        r=_run_captured(seed,'sources',_named_source_request({name:source}),d)\n        (d/'stdout').write_bytes(r.stdout);(d/'stderr').write_bytes(r.stderr)\n        assert r.returncode==0 and not r.stderr,(r.returncode,r.stderr)\n        flats.append(_compiled_sources(r.stdout,{name:source})[name])\n    assert flats[0]==flats[1];roles[stem]=flats[0];(D/(stem+'.flat')).write_bytes(flats[0])\n    records[stem]={'source_bytes':len(source),'source_sha256':sha256(source).hexdigest(),'flat_bytes':len(flats[0]),'flat_sha256':sha256(flats[0]).hexdigest(),'profile':stats}\n    print('LEDGER_NATIVE_ROLE',stem,records[stem],flush=True)\npackmod=importlib.import_module('tools.generate_hia_multiversion_background_ledger_packer')\nraw=roles['multiversion_background_ledger'];packer=m.load(D/'multiversion_background_ledger_packer.flat',records['multiversion_background_ledger_packer']['flat_sha256'])\nexpected=packmod.reference_object([raw]);packet=struct.pack('<8sQQ',b'HIABGLP1',1,len(raw))+raw\nlj=json.loads((B/'native-multiversion-future-v2/build.json').read_text());lsha=next(x['flat_sha256']for x in lj['components']if x['role']=='elf_shared_linker')\nlink=m.load(B/'native-multiversion-future-v2/elf_shared_linker.flat',lsha);images=[]\nfor i in range(2):\n    s=C.create_string_buffer(packet);o=C.create_string_buffer(len(expected));w=C.create_string_buffer(1<<20)\n    rc=packer(s,len(packet),o,len(o),w,len(w));assert rc==len(expected)and o.raw==expected\n    inp=C.create_string_buffer(expected);out=C.create_string_buffer(len(expected)+32768)\n    n=link(inp,len(expected),out,len(out),w,len(w));assert 0<n<len(out);images.append(out.raw[:n])\nassert images[0]==images[1];(D/'ledger-component.o').write_bytes(expected);(D/'ledger-component.so').write_bytes(images[0])\nrec={'built':True,'qualified':False,'roles':records,'image_bytes':len(images[0]),'image_sha256':sha256(images[0]).hexdigest(),'compile_pack_link_twice_identical':True,'native_linker_sha256':lsha,'old_packer_and_mechanical_template_unchanged':True}\n(D/'build.json').write_text(json.dumps(rec,indent=2)+'\\n');print('LEDGER_ORDER_NATIVE_BUILT',json.dumps(rec),flush=True)\n"
