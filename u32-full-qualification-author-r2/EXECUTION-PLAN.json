  "loader_projection": {
    "insertions": [
      "# BEGIN EXPLICIT U32 QUALIFICATION OBSERVER: independent evidence only.\ndef _u32_actual_frames(directory, phase, request, source_bytes, output_bytes, workspace_bytes,\n                       *, result_u64=None, native_elapsed_ns=None):\n    if phase == \"before\":\n        directory.mkdir(mode=0o700)\n    observed = {}\n    for name, raw in ((\"source\", source_bytes), (\"output\", output_bytes), (\"workspace\", workspace_bytes)):\n        with (directory / (name + \".\" + phase + \".bin\")).open(\"xb\") as stream:\n            stream.write(raw)\n        observed[name] = {\"bytes\": len(raw), \"sha256\": sha256(raw).hexdigest()}\n    record = {\"schema\": \"hepta.selfhost-seed-loader-actual-frames.v1\", \"phase\": phase,\n              \"child_pid\": os.getpid(), \"request\": request, \"frames\": observed,\n              \"result_u64\": result_u64, \"native_elapsed_ns\": native_elapsed_ns}\n    with (directory / (phase + \".json\")).open(\"x\") as stream:\n        json.dump(record, stream, sort_keys=True, separators=(\",\", \":\"), allow_nan=False)\n        stream.write(\"\\n\")\n# END EXPLICIT U32 QUALIFICATION OBSERVER.\n\n\n",
      "    # BEGIN EXPLICIT U32 ACTUAL PRE-CALL FRAMES.\n    _u32_frame_directory = Path(request[\"output\"] + \".full-frames\")\n    _u32_actual_frames(_u32_frame_directory, \"before\", request,\n                       source_array.raw[:len(source)], output.raw[:capacity], workspace.raw[:workspace_size])\n    # END EXPLICIT U32 ACTUAL PRE-CALL FRAMES.\n",
      "    # BEGIN EXPLICIT U32 ACTUAL POST-RETURN FRAMES.\n    _u32_actual_frames(_u32_frame_directory, \"after\", request,\n                       source_array.raw[:len(source)], output_bytes, workspace_bytes,\n                       result_u64=returned, native_elapsed_ns=elapsed)\n    # END EXPLICIT U32 ACTUAL POST-RETURN FRAMES.\n"
    ],
