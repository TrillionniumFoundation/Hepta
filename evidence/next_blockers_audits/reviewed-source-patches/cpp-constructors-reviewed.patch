+effects {ffi, unsafe, write, alloc, block} {
+    unsafe { return bridge::hepta_cpp_ctors_NoThrowValue_new(value, out); }
+}
+export "C" fn hepta_ctor_nothrow_destroy(handle: u64) -> i32
+effects {ffi, unsafe, write, alloc, block} {
+    unsafe { return bridge::hepta_cpp_ctors_NoThrowValue_destroy(handle); }
+}
