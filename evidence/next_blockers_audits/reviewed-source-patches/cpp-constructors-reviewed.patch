+effects {ffi, unsafe, write, alloc, block} {
+    unsafe { return bridge::hepta_cpp_ctors_IntVector_filled(count, value, out); }
+}
+export "C" fn hepta_ctor_vector_size(handle: u64, out: raw mut usize) -> i32
+effects {ffi, unsafe, write, alloc, block} {
+    unsafe { return bridge::hepta_cpp_ctors_IntVector_size(handle, out); }
+}
+export "C" fn hepta_ctor_vector_at(handle: u64, index: usize, out: raw mut i64) -> i32
+effects {ffi, unsafe, write, alloc, block} {
+    unsafe { return bridge::hepta_cpp_ctors_IntVector_at(handle, index, out); }
+}
+export "C" fn hepta_ctor_vector_destroy(handle: u64) -> i32
+effects {ffi, unsafe, write, alloc, block} {
+    unsafe { return bridge::hepta_cpp_ctors_IntVector_destroy(handle); }
+}
+export "C" fn hepta_ctor_student_new(degrees: f64, out: raw mut u64) -> i32
+effects {ffi, unsafe, write, alloc, block} {
+    unsafe { return bridge::hepta_cpp_ctors_Student_new(degrees, out); }
