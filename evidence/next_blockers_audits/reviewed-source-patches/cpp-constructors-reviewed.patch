+export "C" fn hepta_ctor_student_degrees(handle: u64, out: raw mut f64) -> i32
+effects {ffi, unsafe, write, alloc, block} {
+    unsafe { return bridge::hepta_cpp_ctors_Student_degrees(handle, out); }
+}
+export "C" fn hepta_ctor_student_destroy(handle: u64) -> i32
+effects {ffi, unsafe, write, alloc, block} {
+    unsafe { return bridge::hepta_cpp_ctors_Student_destroy(handle); }
+}
+export "C" fn hepta_ctor_span_new(tag: u64, bias: i64, values: raw const i64, count: usize, out: raw mut u64) -> i32
+effects {ffi, unsafe, write, alloc, block} {
+    let config = bridge::Config {tag: tag, bias: bias};
+    unsafe { return bridge::hepta_cpp_ctors_SpanOwner_new(config, values, count, out); }
