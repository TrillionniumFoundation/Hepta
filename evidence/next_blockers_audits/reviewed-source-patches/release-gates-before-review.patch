+            if not fn["external_symbol"]:
+                continue
+            params, prelude, borrows, args, finish, ranges = [], [], [], [], [], []
+            for param in fn["params"]:
+                name, typ = "b_" + param["name"], self.rust_type(param["type"])
+                if param.get("record"):
