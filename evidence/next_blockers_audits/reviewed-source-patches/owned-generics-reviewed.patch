diff --git a/examples/owned_generics/main.hepta b/examples/owned_generics/main.hepta
new file mode 100644
index 0000000..bccadb9
--- /dev/null
+++ b/examples/owned_generics/main.hepta
@@ -0,0 +1,24 @@
+module owned_generics;
+import operations as owned;
+
+struct Packet<T> { data: T, tag: u32 }
+
+fn main() -> Unit effects {alloc, block, panic} {
+  let success = owned::finish::<Buffer<u8>, u8>(move buffer(7), true, 11);
+  let chosen = owned::recover::<Buffer<u8>, u8>(move success, move buffer(5));
+  assert(len(owned::view::<Buffer<u8>>(read chosen)) == 7);
+  owned::dispose::<Buffer<u8>>(move chosen);
+
+  let failure = owned::finish::<Buffer<u8>, u8>(move buffer(13), false, 19);
+  let recovered = owned::recover::<Buffer<u8>, u8>(move failure, move buffer(17));
+  assert(len(owned::view::<Buffer<u8>>(read recovered)) == 17);
+  owned::dispose::<Buffer<u8>>(move recovered);
+
+  let packet: Packet<Buffer<u8>> = Packet { data: buffer(23), tag: 29 };
+  let outcome = owned::choose::<Packet<Buffer<u8>>, Buffer<u8>>(
+      move packet, move buffer(31), false);
+  match move outcome {
+    Result::Ok(unexpected) => { owned::dispose::<Packet<Buffer<u8>>>(move unexpected); assert(false); },
+    Result::Err(error) => { assert(len(error) == 31); owned::dispose::<Buffer<u8>>(move error); }
+  }
+}
diff --git a/examples/owned_generics/operations.hepta b/examples/owned_generics/operations.hepta
new file mode 100644
index 0000000..751d6fb
--- /dev/null
+++ b/examples/owned_generics/operations.hepta
@@ -0,0 +1,43 @@
+module operations;
+
+pub fn forward<T: Owned>(value: take T) -> T effects {} {
+  return move value;
+}
+
+pub fn dispose<T: Owned>(value: take T) -> Unit effects {alloc, block} {
+  drop(move value);
+}
+
+pub fn finish<T: Owned, E: Copy>(value: take T, ok: bool, error: E)
+    -> Result<T, E> effects {alloc, block} {
+  if !ok {
+    dispose::<T>(move value);
+    return Result::Err(error);
+  }
+  return Result::Ok(move forward::<T>(move value));
+}
+
+pub fn recover<T: Owned, E: Copy>(outcome: take Result<T, E>, backup: take T)
+    -> T effects {alloc, block} {
+  match move outcome {
+    Result::Ok(value) => {
+      dispose::<T>(move backup);
+      return move value;
+    },
+    Result::Err(error) => { return move backup; }
+  }
+}
+
+pub fn choose<T: Owned, E: Owned>(value: take T, error: take E, ok: bool)
+    -> Result<T, E> effects {alloc, block} {
+  if ok {
+    dispose::<E>(move error);
+    return Result::Ok(move value);
+  }
+  dispose::<T>(move value);
+  return Result::Err(move error);
+}
+
+pub fn view<T: Owned>(value: read T) -> read T effects {} {
+  return read value;
+}
