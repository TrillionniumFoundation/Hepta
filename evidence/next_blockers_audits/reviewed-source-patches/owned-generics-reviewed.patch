+    def test_opaque_owned_does_not_imply_methods_or_operators(self):
+        self.reject("fn f<T:Owned>(x:take T)->usize effects {alloc,block} {let n=len(x);drop(move x);return n;}", "E_BUILTIN_TYPE")
