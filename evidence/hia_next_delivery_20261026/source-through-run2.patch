+                # discriminant guard; a changed core cannot reinterpret an
+                # invalid poll result as a pending state.
+                limit = self.constant(run["ops"], "u32", 1)
+                valid = self.fresh()
+                run["ops"].append(_ins("compare.le", [emitted[0], limit], [(valid, "bool")]))
