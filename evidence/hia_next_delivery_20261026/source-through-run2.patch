+    def zeros(self, flat_types, ops):
+        result = []
+        for typ in flat_types:
+            if typ == "buffer":
+                zero = self.constant(ops, "usize", 0)
+                owner, ok = self.fresh(), self.fresh()
+                ops.append(_ins("buffer.try_new", [zero], [(owner, "buffer"), (ok, "bool")]))
+                result.append(owner)
