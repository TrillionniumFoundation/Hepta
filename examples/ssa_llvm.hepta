module ssa_llvm;

// Strict by-value i32 C export for native SSA / PHI / LLVM verification.
// Source is native-checked by pinned rustc before LLVM lowering.
export "C" fn hepta_accumulate(n: i32) -> i32 effects { panic } {
    let mut total: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        if i < 4 {
            total = total + i;
        } else {
            total = total + 1;
        }
        i = i + 1;
    }
    return total;
}
