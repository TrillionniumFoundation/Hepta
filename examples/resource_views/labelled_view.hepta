// Scoped local stored loan + Copy label; independent Resource IR v5 profile.
struct Tagged<'a> {
    data: read 'a [u8],
    tag: u64,
    valid: bool,
}

fn main() -> i32 effects { alloc, block, panic } {
    let owner = buffer(4);
    if true {
        let first = Tagged { valid: true, data: read owner, tag: 9 };
        let copied = first;
        assert(copied.tag == 9);
        assert(copied.valid);
        assert(len(first.data) == 4);
    }
    release(move owner);
    return 0;
}
