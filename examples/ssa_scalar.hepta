module ssa_scalar;

// Real frontend/native fixture for PHI at a loop header and branch join.
pub fn accumulate(n: i32) -> i32 effects { panic } {
    let mut total: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        if i < 4 {
            total = total + i;
        } else {
            total = total + 1;
        }
        i = i + 1;
    }
    return total;
}
