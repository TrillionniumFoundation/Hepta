// Authored caller of the automatically lowered nonconst-lvalue factory.
// This adapter is absent from the 3.1 capture and present in the 4.0 capture.
pub export "C" fn migrated_case(seed: u64, tag: u64, mode: u32, field: u32) -> u64
effects {alloc, block, panic, write} {
    let mut state = GslState {trace: seed, calls: 0};
    let owner = GslFinallyLvalue(tag);
    GslDestroy(move owner, mut state);
    if field == 0 { return state.trace; }
    if field == 1 { return state.calls; }
    return 0;
}
