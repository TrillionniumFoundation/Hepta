module composed_consumer;
import bridge;

export "C" fn hepta_vector_deque(count: usize, initial: i64, appended: i64,
                                 index: usize, other_count: usize,
                                 other_index: usize, out: raw mut i64) -> i32
effects {ffi, unsafe, write, alloc, block} {
    unsafe {
        return bridge::hepta_cpp_composed_vector_deque(count, initial, appended,
                    index, other_count, other_index, out);
    }
}

export "C" fn hepta_json_chain(first: raw const u8, first_len: usize,
                               second: raw const u8, second_len: usize,
                               index: usize, replacement: i64,
                               repeat_count: usize, final_index: usize,
                               out: raw mut i64) -> i32
effects {ffi, unsafe, write, alloc, block} {
    unsafe {
        return bridge::hepta_cpp_composed_json_chain(first, first_len, second,
                    second_len, index, replacement, repeat_count, final_index, out);
    }
}
