export "C" fn hepta_ctor_vector_sized(count: usize, out: raw mut u64) -> i32
effects {ffi, unsafe, write, alloc, block} {
    unsafe { return bridge::hepta_cpp_ctors_IntVector_sized(count, out); }
}
