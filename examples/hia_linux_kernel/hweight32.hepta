// Authored HIA-source translation of Linux __sw_hweight32's fast-multiplier
// arithmetic. This is one implementation body, not a whole-TU C migration.
module linux_hweight32;

export "C" fn hia_sw_hweight32(w: u32) -> u32 effects {panic} {
    let a: u32 = wrapping_sub(w, (w >> 1) & 1431655765);
    let b: u32 = wrapping_add(a & 858993459, (a >> 2) & 858993459);
    let c: u32 = wrapping_add(b, b >> 4) & 252645135;
    return wrapping_mul(c, 16843009) >> 24;
}
