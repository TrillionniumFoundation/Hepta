  jump b2(v11,v12)
block b4(v14:mutbuf,v15:mutbuf)
  v16:readbuf = borrow.read(v14)
  v17:bool = const() {"value":true}
  branch v17 b1(v14,v15,v16) b3(v14,v15,v16)
end
