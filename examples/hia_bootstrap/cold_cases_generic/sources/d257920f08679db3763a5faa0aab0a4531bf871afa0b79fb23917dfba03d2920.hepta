hia-asm.v1 hepta.hia.program.v8 selfhost
fn f0(v0:readbuf,v1:mutbuf,v2:mutbuf) -> (u32) effects(read,write,trap) entry(b0)
block b0(v0:readbuf,v1:mutbuf,v2:mutbuf)
  jump b4(v1,v2)
block b1(v3:mutbuf,v4:mutbuf,v5:readbuf)
  _ = loan.end(v5)
  v6:u32 = const() {"value":0}
  ret(v6)
block b2(v8:mutbuf,v9:mutbuf)
  v10:readbuf = borrow.read(v9)
  jump b1(v8,v9,v10)
block b3(v11:mutbuf,v12:mutbuf,v13:readbuf)
