  v3:readbuf = borrow.read(v1)
  jump b2(v1,v3)
block b1(v4:mutbuf,v5:readbuf)
  v6:readbuf = borrow.read(v4)
  _ = loan.end(v5)
  _ = loan.end(v6)
  v7:mutbuf = borrow.mut(v4)
