  v25:u64 = bit.and(v12,v24)
  v26:usize = int.cast(v23) {"mode":"wrap"}
  v27:u8 = int.cast(v25) {"mode":"wrap"}
  _ = buffer.store(v10,v26,v27)
  v28:u64 = const() {"value":8}
  v29:u64 = int.shr.checked(v12,v28)
  v30:u64 = const() {"value":1}
  v31:u64 = int.add.wrap(v13,v30)
  jump b1(v10,v11,v29,v31)
block b3(v14:mutbuf)
  v32:u64 = const() {"value":0}
  ret(v32)
end
