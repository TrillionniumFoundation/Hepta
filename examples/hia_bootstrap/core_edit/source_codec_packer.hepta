  v12:bool = compare.lt(v11,v10)
  branch v12 b2(v6,v7,v8,v9,v10,v11) b3(v6,v7)
block b2(v13:readbuf,v14:mutbuf,v15:u64,v16:u64,v17:u64,v18:u64)
  v25:u64 = int.add.wrap(v16,v18)
  v26:u64 = int.add.wrap(v15,v18)
  v27:usize = int.cast(v26) {"mode":"wrap"}
  v28:u8 = buffer.load(v13,v27)
  v29:u64 = int.cast(v28) {"mode":"wrap"}
  v30:usize = int.cast(v25) {"mode":"wrap"}
  v31:u8 = int.cast(v29) {"mode":"wrap"}
  _ = buffer.store(v14,v30,v31)
  v32:u64 = const() {"value":1}
  v33:u64 = int.add.wrap(v18,v32)
  jump b1(v13,v14,v15,v16,v17,v33)
block b3(v19:readbuf,v20:mutbuf)
  v34:u64 = const() {"value":0}
  ret(v34)
end
