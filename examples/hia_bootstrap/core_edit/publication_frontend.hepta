fn borrowed_export_binding(events:mutbuf,ordinal:u64) -> (u64) effects(read,write,trap) entry(entry)
block entry(events:mutbuf,ordinal:u64)
  available:usize = buffer.len(events)
  bytes:u64 = int.cast(available) {"mode":"wrap"}
  minimum:u64 = const() {"value":24600}
  enough:bool = compare.ge(bytes,minimum)
  branch enough header(events,ordinal) absent()
block header(packet:mutbuf,index:u64)
  base:u64 = const() {"value":16384}
  tag:u64 = call(packet,base) {"function":"f27"}
  expected:u64 = const() {"value":3544405853576710472}
  recognized:bool = compare.eq(tag,expected)
  branch recognized row(packet,index) absent()
block row(table:mutbuf,i:u64)
  limit:u64 = const() {"value":1024}
  valid:bool = compare.lt(i,limit)
  branch valid read_extent(table,i) absent()
block read_extent(source:mutbuf,position:u64)
  start:u64 = const() {"value":16408}
  step:u64 = const() {"value":8}
  shift:u64 = int.mul.wrap(position,step)
  offset:u64 = int.add.wrap(start,shift)
  extent:u64 = call(source,offset) {"function":"f27"}
  max:u64 = const() {"value":1048576}
  in_range:bool = compare.le(extent,max)
  branch in_range accepted(extent) absent()
block accepted(bound:u64)
  ret(bound)
block absent()
  zero:u64 = const() {"value":0}
  ret(zero)
end
