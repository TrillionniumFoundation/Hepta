block b2(v11:mutbuf,v12:u64,v13:u64,v14:u64,v15:u64)
  v21:u64 = int.add.wrap(v12,v15)
  v22:u64 = const() {"value":8}
  v23:u64 = int.mul.wrap(v22,v15)
  v24:u64 = int.shr.checked(v13,v23)
  v25:u64 = const() {"value":255}
  v26:u64 = bit.and(v24,v25)
  v27:usize = int.cast(v21) {"mode":"wrap"}
  v28:u8 = int.cast(v26) {"mode":"wrap"}
  _ = buffer.store(v11,v27,v28)
  v29:u64 = const() {"value":1}
  v30:u64 = int.add.wrap(v15,v29)
  jump b1(v11,v12,v13,v14,v30)
block b3(v16:mutbuf)
  v31:u64 = const() {"value":0}
  ret(v31)
end
