  v9:bool = compare.lt(v7,v8)
  branch v9 b2(v4,v5,v6,v7) b3(v4,v6)
block b2(v10:mutbuf,v11:u64,v12:u64,v13:u64)
  v18:u64 = int.add.wrap(v11,v13)
  v19:u64 = const() {"value":8}
  v20:u64 = int.mul.wrap(v13,v19)
  v21:u64 = int.shr.checked(v12,v20)
  v22:usize = int.cast(v18) {"mode":"wrap"}
  v23:u8 = int.cast(v21) {"mode":"wrap"}
  _ = buffer.store(v10,v22,v23)
  v24:u64 = const() {"value":1}
  v25:u64 = int.add.wrap(v13,v24)
  jump b1(v10,v11,v12,v25)
block b3(v14:mutbuf,v16:u64)
  ret(v16)
end
