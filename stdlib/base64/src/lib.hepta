// Canonical padded RFC 4648 Base64 over borrowed byte slices.
module hepta_base64;

pub struct Size { bytes: usize, ok: bool }

fn alphabet(value: u8) -> u8 effects { panic }
resources { heap_allocations = 0; may_block = false; may_suspend = false; may_spawn = false; }
{
    if value < 26 { return value + 65; }
    if value < 52 { return value - 26 + 97; }
    if value < 62 { return value - 52 + 48; }
    if value == 62 { return 43; }
    return 47;
}

fn sextet(value: u8) -> u8 effects { panic }
resources { heap_allocations = 0; may_block = false; may_suspend = false; may_spawn = false; }
{
    if value >= 65 && value <= 90 { return value - 65; }
    if value >= 97 && value <= 122 { return value - 97 + 26; }
    if value >= 48 && value <= 57 { return value - 48 + 52; }
    if value == 43 { return 62; }
    if value == 47 { return 63; }
    return 255;
}

pub fn encoded_length(length: usize) -> Size effects { panic }
resources { heap_allocations = 0; may_block = false; may_suspend = false; may_spawn = false; }
{
    let mut groups = length / 3;
    if length % 3 != 0 { groups = groups + 1; }
    // The compiler's qualified usize model is 64-bit. Divide before multiplying.
    if groups > 4611686018427387903 { return Size { bytes: 0, ok: false }; }
    return Size { bytes: groups * 4, ok: true };
}

pub fn decoded_length(input: read [u8], start: usize, end: usize) -> Size effects { panic }
resources { heap_allocations = 0; may_block = false; may_suspend = false; may_spawn = false; }
{
    let failure = Size { bytes: 0, ok: false };
    if start > end { return failure; }
    if end > len(read input) { return failure; }
    let length = end - start;
    if length % 4 != 0 { return failure; }
    let mut cursor = start;
    let mut size: usize = 0;
    while cursor < end {
        let a = sextet(input[cursor]);
        let b = sextet(input[cursor + 1]);
        if a == 255 || b == 255 { return failure; }
        let third = input[cursor + 2];
        let fourth = input[cursor + 3];
        if third == 61 {
            if fourth != 61 || end - cursor != 4 || (b & 15) != 0 { return failure; }
            return Size { bytes: size + 1, ok: true };
        }
        let c = sextet(third);
        if c == 255 { return failure; }
        if fourth == 61 {
            if end - cursor != 4 || (c & 3) != 0 { return failure; }
            return Size { bytes: size + 2, ok: true };
        }
        if sextet(fourth) == 255 { return failure; }
        size = size + 3;
        cursor = cursor + 4;
    }
    return Size { bytes: size, ok: true };
}

pub fn encode(input: read [u8], start: usize, end: usize, output: mut [u8], offset: usize) -> Size
effects { panic, write }
resources { heap_allocations = 0; may_block = false; may_suspend = false; may_spawn = false; }
{
    let failure = Size { bytes: 0, ok: false };
    if start > end { return failure; }
    if end > len(read input) { return failure; }
    if offset > len(read output) { return failure; }
    let size = encoded_length(end - start);
    if !size.ok { return failure; }
    if size.bytes > len(read output) - offset { return failure; }
    let mut cursor = start;
    let mut dest = offset;
    while end - cursor >= 3 {
        let a = input[cursor];
        let b = input[cursor + 1];
        let c = input[cursor + 2];
        output[dest] = alphabet(a >> 2);
        output[dest + 1] = alphabet(((a & 3) << 4) | (b >> 4));
        output[dest + 2] = alphabet(((b & 15) << 2) | (c >> 6));
        output[dest + 3] = alphabet(c & 63);
        cursor = cursor + 3;
        dest = dest + 4;
    }
    if cursor < end {
        let a = input[cursor];
        output[dest] = alphabet(a >> 2);
        if end - cursor == 1 {
            output[dest + 1] = alphabet((a & 3) << 4);
            output[dest + 2] = 61;
        } else {
            let b = input[cursor + 1];
            output[dest + 1] = alphabet(((a & 3) << 4) | (b >> 4));
            output[dest + 2] = alphabet((b & 15) << 2);
        }
        output[dest + 3] = 61;
    }
    return size;
}

pub fn decode(input: read [u8], start: usize, end: usize, output: mut [u8], offset: usize) -> Size
effects { panic, write }
resources { heap_allocations = 0; may_block = false; may_suspend = false; may_spawn = false; }
{
    let failure = Size { bytes: 0, ok: false };
    if offset > len(read output) { return failure; }
    // Validate the complete input and capacity before the first output write.
    let size = decoded_length(read input, start, end);
    if !size.ok { return failure; }
    if size.bytes > len(read output) - offset { return failure; }
    let mut cursor = start;
    let mut dest = offset;
    while cursor < end {
        let a = sextet(input[cursor]);
        let b = sextet(input[cursor + 1]);
        output[dest] = (a << 2) | (b >> 4);
        if input[cursor + 2] != 61 {
            let c = sextet(input[cursor + 2]);
            output[dest + 1] = ((b & 15) << 4) | (c >> 2);
            if input[cursor + 3] != 61 {
                let d = sextet(input[cursor + 3]);
                output[dest + 2] = ((c & 3) << 6) | d;
            }
        }
        cursor = cursor + 4;
        // A padded quartet is always final. Avoid advancing past output capacity.
        if cursor < end { dest = dest + 3; }
    }
    return size;
}
