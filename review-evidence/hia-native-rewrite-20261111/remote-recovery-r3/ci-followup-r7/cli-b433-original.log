2026-11-11T21:59:58.6599336Z HIA_SOURCE_EXPORT {"bytes": 13815, "content": "\"\"\"Shared HIA authoring for the complete GraphLease bounded-wire owner.\n\nThe Python module only authors fixed HIA functions and constants. It never\nreceives a foreign value or chooses a serialization result.\n\"\"\"\nCONSTANTS = {\n    'GRAPH_MAGIC': int.from_bytes(b'HIAGRF01','little'),\n    'COMMAND_MAGIC': int.from_bytes(b'HIAGWC01','little'),\n    'EVENT_MAGIC': int.from_bytes(b'HIAGWE01','little'),\n    'STATE_MAGIC': int.from_bytes(b'HIAGWS01','little'),\n    'BAD': 0xfffffffd, 'MAX': (1 << 64)-1,\n    'MIN_WORK': 32768, 'FRAME_BASE': 16384, 'FLOAT_BASE': 8192,\n    'LITERAL_BASE': 1024,\n}\n_NAMES = ('MAGIC','PHASE','ERROR','BAD','NEED','LEASE','SEQ','ROOT','MAXIMUM',\n          'FLAGS','DIGITS','NODES','EDGES','SCALARS','TOTAL','EDGEBASE','DATABASE',\n          'CUR','DEPTH','LEVEL','STAGE','VISITED','QUEUED','ARENA','BUDGET',\n          'KEYBASE','HASHBASE','HASHMASK','KEYINDEX','KEYMARK','TMPKIND',\n          'TMPOFF','TMPSIZE','CHARS','OUTLEN','OUTBASE','NEXT','SCANEND','CAUSE')\nCONSTANTS.update({'S_'+name:256+8*i for i,name in enumerate(_NAMES)})\n\nCOMMON = r'''\ndef read(s:readbuf, at:u64) -> u64:\n    value = 0\n    i = 0\n    while i < 8:\n        value = value | (byte(s, at + i) << (i * 8))\n        i = i + 1\n    return value\n\ndef get(w:mutbuf, at:u64) -> u64:\n    value = 0\n    i = 0\n    while i < 8:\n        value = value | (byte(w, at + i) << (i * 8))\n        i = i + 1\n    return value\n\ndef put(w:mutbuf, at:u64, value:u64) -> u64:\n    i = 0\n    while i < 8:\n        store(w, at + i, (value >> (i * 8)) & 255)\n        i = i + 1\n    return 0\n\ndef abi(w:mutbuf, reason:u64) -> u64:\n    if get(w, S_BAD) == 0:\n        put(w, S_BAD, reason)\n    return 0\n\ndef error(w:mutbuf, code:u64, cause:u64) -> u64:\n    if get(w, S_ERROR) == 0:\n        put(w, S_ERROR, code)\n        put(w, S_CAUSE, cause)\n    return 0\n\ndef event(w:mutbuf, action:u64) -> u32:\n    put(w, 0, EVENT_MAGIC)\n    put(w, 8, action)\n    put(w, 16, get(w, S_LEASE))\n    put(w, 24, get(w, S_SEQ))\n    put(w, 32, get(w, S_ROOT))\n    put(w, 40, get(w, S_MAXIMUM))\n    put(w, 48, get(w, S_FLAGS))\n    put(w, 56, get(w, S_DIGITS))\n    put(w, 64, get(w, S_ERROR))\n    put(w, 72, get(w, S_CAUSE))\n    put(w, 80, get(w, S_NEED))\n    put(w, 88, choose(action == 0, get(w, S_OUTBASE), 0))\n    put(w, 96, choose(action == 0, get(w, S_OUTLEN), 0))\n    put(w, 104, choose(action == 2, 2, 0))\n    put(w, 112, get(w, S_PHASE))\n    put(w, 120, get(w, S_BAD))\n    return 128\n\ndef refused(w:mutbuf, reason:u64) -> u32:\n    abi(w, reason)\n    put(w, S_PHASE, 99)\n    event(w, 3)\n    return BAD\n\ndef pending(w:mutbuf) -> u32:\n    if get(w, S_BAD) != 0:\n        return refused(w, get(w, S_BAD))\n    if get(w, S_ERROR) != 0:\n        put(w, S_PHASE, 99)\n        return event(w, 3)\n    if get(w, S_NEED) > length(w):\n        return event(w, 1)\n    return refused(w, 90)\n\ndef reserve(w:mutbuf, size:u64) -> u64:\n    at = get(w, S_ARENA)\n    if size > MAX - at:\n        return abi(w, 2)\n    end = at + size\n    if end > length(w):\n        put(w, S_NEED, end)\n        return 0\n    put(w, S_ARENA, end)\n    return at\n\ndef graph(s:readbuf, r:readbuf, w:mutbuf) -> u64:\n    if get(w, S_BAD) != 0 or get(w, S_PHASE) >= 90:\n        return 0\n    if length(s) < 64 or length(r) != 64:\n        return 0\n    if read(s, 0) != GRAPH_MAGIC or read(s, 8) == 0 or read(s, 56) != 0:\n        return 0\n    nodes = read(s, 16)\n    edges = read(s, 32)\n    if nodes == 0 or nodes > (MAX - 64) >> 6:\n        return 0\n    edgebase = 64 + nodes * 64\n    if edges > (MAX - edgebase) >> 3:\n        return 0\n    database = edgebase + edges * 8\n    if database > length(s) or read(s, 48) != length(s):\n        return 0\n    if read(s, 40) != length(s) - database:\n        return 0\n    if read(s, 24) == 0 or read(s, 24) > nodes:\n        return 0\n    if read(r, 0) != COMMAND_MAGIC or read(r, 8) != read(s, 8):\n        return 0\n    if read(r, 16) == 0 or read(r, 24) == 0 or read(r, 24) > nodes:\n        return 0\n    if read(r, 40) > 3 or read(r, 56) != 0:\n        return 0\n    if get(w, S_MAGIC) == 0:\n        fill_range(w, 256, 512, 0)\n        put(w, S_MAGIC, STATE_MAGIC)\n        put(w, S_PHASE, 1)\n        put(w, S_LEASE, read(r, 8))\n        put(w, S_SEQ, read(r, 16))\n        put(w, S_ROOT, read(r, 24))\n        put(w, S_MAXIMUM, read(r, 32))\n        put(w, S_FLAGS, read(r, 40))\n        put(w, S_DIGITS, read(r, 48))\n        put(w, S_NODES, nodes)\n        put(w, S_EDGES, edges)\n        put(w, S_SCALARS, read(s, 40))\n        put(w, S_TOTAL, length(s))\n        put(w, S_EDGEBASE, edgebase)\n        put(w, S_DATABASE, database)\n        put(w, S_CUR, read(r, 24))\n        put(w, S_QUEUED, 1)\n        put(w, S_ARENA, MIN_WORK)\n        maximum = read(r, 32)\n        if maximum > 8388608:\n            error(w, 1, 0)\n        put(w, S_BUDGET, choose(maximum < 262144, maximum, 262144))\n    else:\n        if get(w, S_MAGIC) != STATE_MAGIC or get(w, S_PHASE) >= 90:\n            return 0\n        if get(w, S_LEASE) != read(r, 8) or get(w, S_SEQ) != read(r, 16):\n            return 0\n        if get(w, S_ROOT) != read(r, 24) or get(w, S_MAXIMUM) != read(r, 32):\n            return 0\n        if get(w, S_FLAGS) != read(r, 40) or get(w, S_DIGITS) != read(r, 48):\n            return 0\n        if get(w, S_NODES) != nodes or get(w, S_EDGES) != edges:\n            return 0\n        if get(w, S_SCALARS) != read(s, 40) or get(w, S_TOTAL) != length(s):\n            return 0\n    put(w, S_NEED, 0)\n    return 1\n\ndef node(s:readbuf, w:mutbuf, identifier:u64) -> u64:\n    if identifier == 0 or identifier > get(w, S_NODES):\n        return abi(w, 3)\n    at = 64 + (identifier - 1) * 64\n    kind = read(s, at)\n    if kind > 9 or read(s, at + 56) != 0:\n        return abi(w, 4)\n    if kind == 5 or kind == 6 or kind == 7:\n        if read(s, at + 8) != 0 or read(s, at + 16) != 0:\n            return abi(w, 5)\n        if read(s, at + 40) == 0 or read(s, at + 48) != 0:\n            return abi(w, 6)\n        first = read(s, at + 24)\n        count = read(s, at + 32)\n        if kind == 6:\n            if count > MAX >> 1:\n                return abi(w, 7)\n            count = count * 2\n        if first > get(w, S_EDGES) or count > get(w, S_EDGES) - first:\n            return abi(w, 8)\n        return at\n    if read(s, at + 24) != 0 or read(s, at + 32) != 0 or read(s, at + 40) != 0:\n        return abi(w, 9)\n    begin = read(s, at + 8)\n    size = read(s, at + 16)\n    aux = read(s, at + 48)\n    if kind == 0 or kind == 1 or kind == 8:\n        if begin != 0 or size != 0:\n            return abi(w, 10)\n        if kind == 1:\n            if aux > 1:\n                return abi(w, 11)\n        elif aux != 0:\n            return abi(w, 12)\n        return at\n    if begin < get(w, S_DATABASE) or begin > length(s) or size > length(s) - begin:\n        return abi(w, 13)\n    if kind == 2:\n        if aux > 1 or (size == 0 and aux != 0):\n            return abi(w, 14)\n        if size > 0 and byte(s, begin + size - 1) == 0:\n            return abi(w, 15)\n    elif kind == 3:\n        if size != 8 or aux != 0:\n            return abi(w, 16)\n    elif kind == 9 and aux != 0:\n        return abi(w, 17)\n    return at\n\ndef edge(s:readbuf, w:mutbuf, at:u64, index:u64) -> u64:\n    total = read(s, at + 32)\n    if read(s, at) == 6:\n        total = total * 2\n    if index >= total:\n        return abi(w, 18)\n    value = read(s, get(w, S_EDGEBASE) + (read(s, at + 24) + index) * 8)\n    if value == 0 or value > get(w, S_NODES):\n        return abi(w, 19)\n    return value\n\ndef bit_length(s:readbuf, at:u64) -> u64:\n    size = read(s, at + 16)\n    if size == 0:\n        return 0\n    result = (size - 1) * 8\n    value = byte(s, read(s, at + 8) + size - 1)\n    while value != 0:\n        value = value >> 1\n        result = result + 1\n    return result\n\ndef unit(s:readbuf, w:mutbuf, at:u64, end:u64) -> u64:\n    if at >= end:\n        abi(w, 20)\n        return MAX\n    first = byte(s, at)\n    if first < 128:\n        put(w, S_NEXT, at + 1)\n        return first\n    count = 0\n    point = 0\n    minimum = 0\n    if first >= 194 and first <= 223:\n        count = 2\n        point = first & 31\n        minimum = 128\n    elif first >= 224 and first <= 239:\n        count = 3\n        point = first & 15\n        minimum = 2048\n    elif first >= 240 and first <= 244:\n        count = 4\n        point = first & 7\n        minimum = 65536\n    else:\n        abi(w, 21)\n        return MAX\n    if count > end - at:\n        abi(w, 22)\n        return MAX\n    i = 1\n    while i < count:\n        value = byte(s, at + i)\n        if value < 128 or value > 191:\n            abi(w, 23)\n            return MAX\n        point = (point << 6) | (value & 63)\n        i = i + 1\n    if point < minimum or point > 1114111:\n        abi(w, 24)\n        return MAX\n    put(w, S_NEXT, at + count)\n    return point\n\ndef string_size(s:readbuf, w:mutbuf, at:u64) -> u64:\n    maximum = get(w, S_MAXIMUM)\n    if maximum < 2 or read(s, at + 48) > maximum - 2:\n        return error(w, 2, 0)\n    pos = read(s, at + 8)\n    end = pos + read(s, at + 16)\n    size = 2\n    chars = 0\n    while pos < end:\n        point = unit(s, w, pos, end)\n        if point == MAX:\n            return 0\n        chars = chars + 1\n        width = 1\n        if point < 32:\n            width = choose(point == 8 or point == 9 or point == 10 or point == 12 or point == 13, 2, 6)\n        elif point == 34 or point == 92:\n            width = 2\n        elif point < 128:\n            width = choose(point == 127 and (get(w, S_FLAGS) & 1) != 0, 6, 1)\n        elif point >= 55296 and point <= 57343:\n            return error(w, 3, 0)\n        elif (get(w, S_FLAGS) & 1) != 0:\n            width = choose(point <= 65535, 6, 12)\n        else:\n            width = get(w, S_NEXT) - pos\n        size = size + width\n        if size > maximum:\n            return error(w, 2, 0)\n        pos = get(w, S_NEXT)\n    if chars != read(s, at + 48):\n        return abi(w, 25)\n    return 1\n\ndef literal(w:mutbuf, kind:u64) -> u64:\n    value = 1819047278\n    size = 4\n    if kind == 1:\n        value = 435728179558\n        size = 5\n    elif kind == 2:\n        value = 1702195828\n    i = 0\n    while i < size:\n        store(w, LITERAL_BASE + i, (value >> (i * 8)) & 255)\n        i = i + 1\n    put(w, S_TMPKIND, 2)\n    put(w, S_TMPOFF, LITERAL_BASE)\n    put(w, S_TMPSIZE, size)\n    return 1\n\ndef integer_text(s:readbuf, w:mutbuf, at:u64) -> u64:\n    size = read(s, at + 16)\n    digit_limit = get(w, S_DIGITS)\n    bits = bit_length(s, at)\n    if digit_limit != 0 and digit_limit <= MAX >> 2:\n        if bits > digit_limit * 4:\n            return error(w, 15, 1)\n    if size > (MAX - 64) >> 3:\n        return abi(w, 26)\n    base = reserve(w, size * 7 + 64)\n    if base == 0:\n        return 0\n    begin = read(s, at + 8)\n    i = 0\n    while i < size:\n        store(w, base + i, byte(s, begin + i))\n        i = i + 1\n    reverse = base + size + 16\n    used = size\n    digits = 0\n    while used != 0:\n        carry = 0\n        i = used\n        while i > 0:\n            i = i - 1\n            value = carry * 256 + byte(w, base + i)\n            quotient = (value * 52429) >> 19\n            carry = value - quotient * 10\n            store(w, base + i, quotient)\n        while used > 0 and byte(w, base + used - 1) == 0:\n            used = used - 1\n        store(w, reverse + digits, 48 + carry)\n        digits = digits + 1\n    if digits == 0:\n        store(w, reverse, 48)\n        digits = 1\n    if digit_limit != 0 and digits > digit_limit:\n        return error(w, 15, 1)\n    text = reverse + size * 3 + 8\n    cursor = 0\n    if read(s, at + 48) != 0:\n        store(w, text, 45)\n        cursor = 1\n    i = digits\n    while i > 0:\n        i = i - 1\n        store(w, text + cursor, byte(w, reverse + i))\n        cursor = cursor + 1\n    put(w, S_TMPKIND, 2)\n    put(w, S_TMPOFF, text)\n    put(w, S_TMPSIZE, cursor)\n    return 1\n\ndef floating(s:readbuf, w:mutbuf, at:u64, key:u64) -> u64:\n    bits = read(s, read(s, at + 8))\n    if ((bits >> 52) & 2047) == 2047:\n        if key != 0:\n            return error(w, 10, 0)\n        return error(w, 15, 1)\n    fill_range(w, FLOAT_BASE, 8192, 0)\n    size = fp_render_binary64(w, bits)\n    if size == 0 or size > 32:\n        return abi(w, 27)\n    put(w, S_TMPKIND, 2)\n    put(w, S_TMPOFF, FLOAT_BASE + 6144)\n    put(w, S_TMPSIZE, size)\n    return 1\n\ndef key_text(s:readbuf, w:mutbuf, at:u64) -> u64:\n    kind = read(s, at)\n    if kind == 4:\n        if string_size(s, w, at) == 0:\n            return 0\n        put(w, S_TMPKIND, 1)\n        put(w, S_TMPOFF, read(s, at + 8))\n        put(w, S_TMPSIZE, read(s, at + 16))\n        return 1\n    if kind == 0:\n        literal(w, 0)\n    elif kind == 1:\n        literal(w, read(s, at + 48) + 1)\n    elif kind == 2:\n        if bit_length(s, at) > get(w, S_MAXIMUM) * 4:\n            return error(w, 9, 0)\n        if integer_text(s, w, at) == 0:\n            return 0\n    elif kind == 3:\n        if floating(s, w, at, 1) == 0:\n            return 0\n    else:\n        return error(w, 8, 0)\n    if get(w, S_MAXIMUM) < 2 or get(w, S_TMPSIZE) > get(w, S_MAXIMUM) - 2:\n        return error(w, 11, 0)\n    return 1\n\ndef text_byte(s:readbuf, w:mutbuf, kind:u64, at:u64, i:u64) -> u64:\n    if kind == 1:\n        return byte(s, at + i)\n    return byte(w, at + i)\n\ndef text_hash(s:readbuf, w:mutbuf, kind:u64, at:u64, size:u64) -> u64:\n    result = 14695981039346656037\n    i = 0\n    while i < size:\n        result = (result ^ text_byte(s, w, kind, at, i)) * 1099511628211\n        i = i + 1\n    return result\n\ndef text_equal(s:readbuf, w:mutbuf, record:u64) -> u64:\n    size = get(w, S_TMPSIZE)\n    if get(w, record + 24) != size:\n        return 0\n    i = 0\n    while i < size:\n        a = text_byte(s, w, get(w, S_TMPKIND), get(w, S_TMPOFF), i)\n        b = text_byte(s, w, get(w, record + 8), get(w, record + 16), i)\n        if a != b:\n            return 0\n        i = i + 1\n    return 1\n'''\n\n", "git_blob": "0711ccf18b3838e53b47821c464c3492b802eff6", "path": "tools/generate_hia_graph_wire_common.py", "sha256": "32ceeceb285f9d3d3250a920c40ebd7bac8e1a44460c5321d714f6f5a0da2b3c"}
2026-11-11T21:59:58.6647731Z HIA_SOURCE_EXPORT {"bytes": 9783, "content": "\"\"\"Mechanical GraphLease capture and actual two-image test executor.\n\nCapture preserves object representations and references only. It deliberately\ndoes not perform a JSON size/admission/canonicalization decision. A complete\ncapture is not proof of the public incremental-capture resource boundary.\n\"\"\"\nfrom pathlib import Path\nfrom hashlib import sha256\nimport ctypes, json, struct, sys\nfrom unittest.mock import patch\n\nROOT=Path(__file__).resolve().parents[1]\nBASE=Path('/workspace/scratch/9acdfa9f5639/Hepta-agent-edit-native')\nsys.path.insert(0,str(BASE))\nfrom hepta.hia_json_preflight_native import NativeHiaJsonImage\nfrom hepta.hia_program_tools import bounded_json_wire\n\nMAGIC=lambda word:int.from_bytes(word,'little')\nGRAPH=MAGIC(b'HIAGRF01');COMMAND=MAGIC(b'HIAGWC01');EVENT=MAGIC(b'HIAGWE01')\nBAD=0xfffffffd\nCANARY=b'\\xb9'*32\nERRORS={\n1:'invalid JSON output byte budget',\n2:'JSON string exceeds byte budget before encoding',\n3:'unpaired Unicode surrogate in UTF-8 JSON',\n4:'JSON input exceeds nesting depth before encoding',\n5:'JSON input exceeds node/byte budget',\n6:'JSON container exceeds queued-node/byte budget',\n7:'cyclic JSON container',\n8:'unsupported JSON object key',\n9:'JSON key exceeds numeric byte budget',\n10:'nonfinite JSON object key',\n11:'JSON key exceeds byte budget',\n12:'JSON object key collision after JSON conversion',\n13:'JSON integer exceeds byte budget',\n14:'non-JSON in-process value',\n15:'invalid bounded JSON',\n16:'JSON encoding exceeds byte budget',\n}\n\ndef capture(root,lease=19):\n    objects=[];ids={}\n    def add(value):\n        key=id(value)\n        if key not in ids:\n            ids[key]=len(objects)+1\n            objects.append(value)\n        return ids[key]\n    rootid=add(root)\n    records=[];edges=[];pool=bytearray()\n    position=0\n    while position<len(objects):\n        value=objects[position];kind=type(value)\n        record=[0]*8\n        raw=None\n        if value is None:\n            record[0]=0\n        elif kind is bool:\n            record[0]=1;record[6]=int(value)\n        elif kind is int:\n            record[0]=2;record[6]=int(value<0)\n            magnitude=abs(value);raw=magnitude.to_bytes((magnitude.bit_length()+7)//8,'little')\n        elif kind is float:\n            record[0]=3;raw=struct.pack('<d',value)\n        elif kind is str:\n            record[0]=4;record[6]=len(value);raw=value.encode('utf-8','surrogatepass')\n        elif kind in (list,dict,tuple):\n            record[0]={list:5,dict:6,tuple:7}[kind]\n            record[3]=len(edges);record[4]=len(value);record[5]=position+1\n            if kind is dict:\n                items=list(value.items())\n                for key,child in items:\n                    edges.extend((add(key),add(child)))\n            else:\n                for child in tuple(value):\n                    edges.append(add(child))\n        elif kind is bytes:\n            record[0]=9;raw=value\n        else:\n            record[0]=8\n        if raw is not None:\n            record[1]=len(pool);record[2]=len(raw);pool.extend(raw)\n        records.append(record);position+=1\n    data=64+len(records)*64+len(edges)*8\n    for record in records:\n        if record[0] in (2,3,4,9):\n            record[1]+=data\n    header=(GRAPH,lease,len(records),rootid,len(edges),len(pool),data+len(pool),0)\n    return (struct.pack('<8Q',*header)+b''.join(struct.pack('<8Q',*row) for row in records)\n            +b''.join(struct.pack('<Q',value) for value in edges)+bytes(pool))\n\n\nclass Actual:\n    def __init__(self,out,bundle=None):\n        self.out=Path(out);self.pins={};self.entries={'scan':0,'emit':0}\n        bundle=Path(bundle or ROOT/'development/compile-r3/bundle.json')\n        def read(path):\n            path=Path(path).resolve();raw=path.read_bytes()\n            if path in self.pins:assert self.pins[path]==raw\n            self.pins[path]=raw;return raw\n        rows=json.loads(read(bundle))\n        assert rows['status']=='PASS'\n        assert rows['scope']=='SOURCE_BOUND_GRAPH_WIRE_DEVELOPMENT_NOT_PUBLIC_ADMISSION_OR_COLD'\n        images={}\n        for role,row in rows['components'].items():\n            assert row['schema']=='hepta.hia.graph-json-wire-'+role+'-native.v1'\n            assert row['compiler_sha256']=='0e09ccca227d8f8ed7e7fa37111d2c44e1329517b19763bd9f280d00135591c8'\n            source=read(row['source_path']);current=read(ROOT/('examples/hia_bootstrap/graph_json_wire_'+role+'.hiaasm'))\n            image=read(row['image_path'])\n            assert source==current and sha256(source).hexdigest()==row['source_sha256']\n            assert sha256(image).hexdigest()==row['image_sha256']\n            images[role]=(image,row['image_sha256'])\n        self.readback()\n        self.out.mkdir(parents=True,exist_ok=False)\n        self.images={key:NativeHiaJsonImage(*value) for key,value in images.items()}\n        self.log=(self.out/'entries.jsonl').open('w')\n        self.sources=(self.out/'inputs');self.sources.mkdir()\n        self.digests={}\n        (self.out/'source-before.json').write_text(json.dumps({str(p):sha256(raw).hexdigest() for p,raw in self.pins.items()},indent=2,sort_keys=True)+'\\n')\n\n    def readback(self):\n        for p,raw in self.pins.items():assert p.read_bytes()==raw\n\n    def raw(self,data,extension):\n        digest=sha256(data).hexdigest()\n        if digest not in self.digests:\n            name=digest+extension\n            (self.sources/name).write_bytes(data);self.digests[digest]=name\n        return self.digests[digest]\n\n    def call(self,role,source,command,work,size,case):\n        s=ctypes.create_string_buffer(source+CANARY)\n        r=ctypes.create_string_buffer(command+CANARY)\n        ret=self.images[role]._entry(s,len(source),r,len(command),work,size)\n        self.entries[role]+=1\n        event=struct.unpack_from('<16Q',work,0)\n        assert ctypes.string_at(s,len(source)+32)==source+CANARY\n        assert ctypes.string_at(r,len(command)+32)==command+CANARY\n        assert ctypes.string_at(ctypes.addressof(work)+size,32)==CANARY\n        row={'case':case,'role':role,'return':ret,'event':event,'workspace_bytes':size,\n             'graph':self.raw(source,'.graph'),'command':self.raw(command,'.command'),\n             'input_and_canaries_unchanged':True}\n        self.log.write(json.dumps(row,sort_keys=True)+'\\n');self.log.flush()\n        return ret,event\n\n    def serialize_graph(self,source,maximum,*,flags=3,digits=None,case='case'):\n        if digits is None:digits=sys.get_int_max_str_digits()\n        lease=struct.unpack_from('<Q',source,8)[0]\n        root=struct.unpack_from('<Q',source,24)[0]\n        command=struct.pack('<8Q',COMMAND,lease,1,root,maximum,flags,digits,0)\n        size=32768;work=ctypes.create_string_buffer(size+32)\n        ctypes.memset(ctypes.addressof(work)+size,0xb9,32)\n        role='scan';grows=0;steps=0\n        with patch('hepta.hia_program_tools.bounded_json_wire',side_effect=AssertionError('host wire disabled')):\n            while True:\n                steps+=1\n                assert steps<1000\n                ret,event=self.call(role,source,command,work,size,case)\n                assert ret==128,{'return':ret,'event':event,'case':case}\n                assert event[0]==EVENT and event[2:8]==(lease,1,root,maximum,flags,digits)\n                if event[1]==1:\n                    needed=event[10]\n                    assert needed>size\n                    new_size=max(needed,size*2)\n                    replacement=ctypes.create_string_buffer(new_size+32)\n                    ctypes.memmove(replacement,work,size)\n                    ctypes.memset(ctypes.addressof(replacement)+new_size,0xb9,32)\n                    work=replacement;size=new_size;grows+=1\n                    continue\n                if event[1]==2:\n                    assert role=='scan' and event[13]==2 and event[8:10]==(0,0)\n                    role='emit';continue\n                if event[1]==3:\n                    assert event[8] in ERRORS\n                    result={'error':'E_HIA_EDIT: '+ERRORS[event[8]],'cause_kind':event[9]}\n                    break\n                assert event[1]==0 and role=='emit' and event[8:10]==(0,0)\n                assert event[11]<=size and event[12]<=size-event[11]\n                raw=ctypes.string_at(ctypes.addressof(work)+event[11],event[12])\n                result={'wire':raw}\n                break\n        result['grows']=grows;result['calls']=steps\n        return result\n\n    def check(self,value,maximum=1048576,*,ensure_ascii=True,sort_keys=True,case='case'):\n        graph=capture(value)\n        expected=None\n        try:\n            expected={'wire':bounded_json_wire(value,maximum,ensure_ascii=ensure_ascii,sort_keys=sort_keys)}\n        except Exception as exc:\n            expected={'error':str(exc),'class':type(exc).__name__}\n        actual=self.serialize_graph(graph,maximum,flags=int(ensure_ascii)+2*int(sort_keys),case=case)\n        if 'wire' in expected:\n            assert actual.get('wire')==expected['wire'],(case,expected,actual)\n            expected_path=self.raw(expected['wire'],'.expected-wire')\n            actual_path=self.raw(actual['wire'],'.actual-wire')\n        else:\n            assert actual.get('error')==expected['error'],(case,expected,actual)\n            expected_path=actual_path=None\n        return {'case':case,'status':'PASS','grows':actual['grows'],'calls':actual['calls'],\n                'expected_class':expected.get('class'),'error':expected.get('error'),\n                'expected_wire':expected_path,'actual_wire':actual_path,\n                'wire_bytes':len(expected['wire']) if 'wire' in expected else None}\n\n    def close(self):\n        self.log.close();self.readback()\n        (self.out/'source-after.json').write_text(json.dumps({str(p):sha256(raw).hexdigest() for p,raw in self.pins.items()},indent=2,sort_keys=True)+'\\n')\n\n", "git_blob": "eaf060c8c6870cad0a85a23f6b94ffa39308c45c", "path": "development/graph_harness_r3.py", "sha256": "75fe54554a93e19e30251073ac225deff944d6673d87ccc2b597e47a19e8be7c"}
