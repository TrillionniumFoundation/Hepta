2026-11-11T22:00:50.0333325Z HIA_PROGRAM_INTEGRATION_SOURCE {"bytes": 17529, "git_sha": "1e503f8b9237150ddab2898fde59708e92c3d6a5", "relative": "native-edit-json-next/development/main-compile-r3/source/10/generate_hia_legacy_import_driver.py", "sha256": "53cdf4ce01c8f14ab4894062fdc321a124f0b2ed16e39e284876d7eb37f9968c", "text": "\"\"\"Complete historical nominal importer continuation and report owner in HIA.\"\"\"\nimport json\nfrom tools.legacy_authoring import source,document as build,write_document\nfrom tools.hia_composite_lowering_driver_common import COMMON,CONSTANTS as LOWER\nfrom tools.hia_composite_lowering_driver_services import BODY as SERVICES\n\nCONSTANTS=dict(LOWER)\nCONSTANTS.update({'IMPORT_DRIVER':46,'IMPORT_INIT':int.from_bytes(b'HIALII01','little'),\n    'IMPORT_STATE':int.from_bytes(b'HIALIS01','little'),'PROJECTION':int.from_bytes(b'HIALIP01','little'),\n    'COMPARISON':int.from_bytes(b'HIALCP01','little'),'INPUT_LIMIT':8<<20,\n    'B_PROJECTION':4,'B_PROJECTION_WORK':5,'B_RESPONSE':45,'B_RENAMED_SOURCE':48,\n    'B_SHA_INPUT':49,'B_SHA_OUTPUT':50,'B_SHA_WORK':51,\n    'B_ORIGINAL_JSON':52,'B_RENAMED_JSON':53,'B_OLD_CORE':54,'B_NEW_CORE':55,'B_COMPARE':56})\nFIELDS=('ORIGINAL_PACKET','RENAMED_PACKET','ORIGINAL_BYTES','RENAMED_BYTES','RENAMED_SOURCE',\n        'OLD_BYTES','NEW_BYTES','RESPONSE_BYTES','RELEASE','CHILD_MODE','CHILD_TARGET','CHILD_LEASE',\n        'HASH_SLOT','HASH_BYTES','HASH_TO','HASH_RETURN','HASH_OFFSET','HASH_CHUNK')\nCONSTANTS.update({'M_'+name:24576+8*i for i,name in enumerate(FIELDS)})\nCONSTANTS.update({'M_SOURCE_HASH':24832,'M_OLD_HASH':24864,'M_INPUT_HASH':24896,'M_TARGET_HASH':24928})\n\nBODY=r'''\ndef legacy_import(s:readbuf, o:mutbuf, w:mutbuf) -> u32:\n    if length(w) != MIN_WORK:\n        return ABI\n    if length(o) < 128:\n        return refuse(w, 800)\n    if get(w, C_MAGIC) == 0 and get(w, L_MAGIC) == 0:\n        if import_begin(s, w) == 0:\n            return refuse(w, 801)\n    elif get(w, C_MAGIC) != IMPORT_STATE or acknowledge(s, w, IMPORT_DRIVER) == 0:\n        return refuse(w, 802)\n    while get(w, L_STATUS) == 1:\n        phase = get(w, C_PHASE)\n        if phase >= 26000 and phase < 27000:\n            result = index_step(o, w)\n        elif phase >= 300 and phase < 320:\n            result = import_hash_step(o, w)\n        else:\n            result = import_step(o, w)\n        if result != 0:\n            return result\n    return refuse(w, 803)\n\ndef import_begin(s:readbuf, w:mutbuf) -> u64:\n    if length(s) != 64 or word(s, 0) != IMPORT_INIT:\n        return 0\n    lease = word(s, 8)\n    extent = word(s, 24)\n    if lease == 0 or lease > MAX - 4 or word(s, 16) != 0:\n        return 0\n    if extent < 82 or extent > SOURCE_LEASE_LIMIT or extent != cap(w, B_SOURCE):\n        return 0\n    if cap(w, B_EMPTY) != 1 or cap(w, B_CONTROLLER) != MIN_WORK:\n        return 0\n    at = 32\n    while at < 64:\n        if word(s, at) != 0:\n            return 0\n        at = at + 8\n    slot = 3\n    while slot < 64:\n        if cap(w, slot) != 0:\n            return 0\n        slot = slot + 1\n    zero(w, 0, 4096)\n    zero(w, 8192, MIN_WORK - 8192)\n    put(w, C_MAGIC, IMPORT_STATE)\n    put(w, C_STATUS, 1)\n    put(w, C_LEASE, lease)\n    put(w, C_SOURCE_EXTENT, extent)\n    put(w, L_MAGIC, LOWER_MAGIC)\n    put(w, L_STATUS, 1)\n    put(w, L_DRIVER, IMPORT_DRIVER)\n    put(w, C_PHASE, 1)\n    return 1\n\ndef import_step(o:mutbuf, w:mutbuf) -> u64:\n    phase = get(w, C_PHASE)\n    if phase == 1:\n        return view(o, w, B_SOURCE, 0, 64, 2)\n    if phase == 2:\n        packet = get(w, OBS + 8)\n        if get(w, OBS) != SOURCE_MAGIC or packet < 16 or packet > PACKET_LIMIT - 2:\n            return refuse(w, 804)\n        if get(w, OBS + 40) != cap(w, B_SOURCE) or get(w, OBS + 24) != 64:\n            return refuse(w, 805)\n        put(w, M_ORIGINAL_PACKET, packet)\n        return grow(o, w, B_PROJECTION, 66 + packet, 3)\n    if phase == 3:\n        return grow(o, w, B_PROJECTION_WORK, 64, 4)\n    if phase == 4:\n        return invoke(o, w, 28, B_SOURCE, 0, cap(w, B_SOURCE), B_PROJECTION, cap(w, B_PROJECTION), B_PROJECTION_WORK, 64, B_PROJECTION, 0, 64, 5)\n    if phase == 5:\n        if get(w, OBS) != PROJECTION or get(w, OBS + 16) != 64 or get(w, OBS + 32) != get(w, M_ORIGINAL_PACKET):\n            return refuse(w, 806)\n        if get(w, OBS + 48) != 0 or get(w, OBS + 56) != 0:\n            return refuse(w, 807)\n        error = get(w, OBS + 8)\n        if error != 0:\n            if error > 2 or get(w, C_RETURN) != 64 or get(w, OBS + 24) != 0:\n                return refuse(w, 808)\n            return finish(o, w, 9, error, 0)\n        size = get(w, M_ORIGINAL_PACKET) + 2\n        if get(w, C_RETURN) != 64 + size or get(w, OBS + 24) != size:\n            return refuse(w, 809)\n        put(w, M_RENAMED_PACKET, size)\n        put(w, C_PACKET_SLOT, B_SOURCE)\n        put(w, C_PACKET_OFFSET, 64)\n        put(w, C_PACKET_BYTES, get(w, M_ORIGINAL_PACKET))\n        put(w, L_INDEX_TARGET, 0)\n        put(w, L_INDEX_RETURN, 10)\n        put(w, C_PHASE, 26000)\n        return 0\n    if phase == 10:\n        size = get(w, C_JSON_BYTES)\n        if size == 0 or size > INPUT_LIMIT:\n            return refuse(w, 810)\n        put(w, M_ORIGINAL_BYTES, size)\n        return grow(o, w, B_ORIGINAL_JSON, size, 11)\n    if phase == 11:\n        return copy(o, w, B_PACKET_JSON, 64, B_ORIGINAL_JSON, 0, get(w, M_ORIGINAL_BYTES), 12)\n    if phase == 12:\n        return protect(o, w, B_ORIGINAL_JSON, 1, 13)\n    if phase == 13:\n        put(w, C_PACKET_SLOT, B_PROJECTION)\n        put(w, C_PACKET_OFFSET, 64)\n        put(w, C_PACKET_BYTES, get(w, M_RENAMED_PACKET))\n        put(w, L_INDEX_TARGET, B_RENAMED_SOURCE)\n        put(w, L_INDEX_RETURN, 20)\n        put(w, C_PHASE, 26000)\n        return 0\n    if phase == 20:\n        size = get(w, C_JSON_BYTES)\n        if size != get(w, M_ORIGINAL_BYTES) + 2:\n            return refuse(w, 811)\n        put(w, M_RENAMED_BYTES, size)\n        put(w, M_RENAMED_SOURCE, get(w, L_INDEX_SOURCE_BYTES))\n        return grow(o, w, B_RENAMED_JSON, size, 21)\n    if phase == 21:\n        return copy(o, w, B_PACKET_JSON, 64, B_RENAMED_JSON, 0, get(w, M_RENAMED_BYTES), 22)\n    if phase == 22:\n        return protect(o, w, B_RENAMED_JSON, 1, 23)\n    if phase == 23:\n        return release(o, w, B_PROJECTION, 24)\n    if phase == 24:\n        return release(o, w, B_PROJECTION_WORK, 25)\n    if phase == 25:\n        return release(o, w, B_PACKET_JSON, 26)\n    if phase == 26:\n        return release(o, w, B_PACKET_WORK, 27)\n    if phase == 27:\n        return run_child(o, w, 1, B_RENAMED_SOURCE, get(w, M_RENAMED_SOURCE), B_OLD_CORE, get(w, C_LEASE) + 1, 28)\n    if phase == 28:\n        if child_result(w) == 0:\n            return refuse(w, 812)\n        if get(w, OBS + 32) != 0:\n            return child_error(o, w)\n        put(w, M_OLD_BYTES, get(w, OBS + 88))\n        copy_digest(w, M_OLD_HASH, OBS + 96)\n        # The rename increases the caller-owned canonical input by two bytes.\n        # Its original snapshot byte error is after the complete old Core gate.\n        if get(w, M_RENAMED_BYTES) > INPUT_LIMIT:\n            return finish(o, w, 9, 3, 0)\n        return run_child(o, w, 0, B_RENAMED_JSON, get(w, M_RENAMED_BYTES), B_NEW_CORE, get(w, C_LEASE) + 2, 29)\n    if phase == 29:\n        if child_result(w) == 0:\n            return refuse(w, 813)\n        if get(w, OBS + 32) != 0:\n            return child_error(o, w)\n        put(w, M_NEW_BYTES, get(w, OBS + 88))\n        copy_digest(w, M_TARGET_HASH, OBS + 96)\n        mirror_frame(w)\n        return grow(o, w, B_COMPARE, 64, 30)\n    if phase == 30:\n        return invoke(o, w, 29, B_OLD_CORE, 0, get(w, M_OLD_BYTES), B_NEW_CORE, get(w, M_NEW_BYTES), B_COMPARE, 64, B_COMPARE, 0, 64, 31)\n    if phase == 31:\n        if get(w, C_RETURN) != 64 or get(w, OBS) != COMPARISON or get(w, OBS + 8) > 1:\n            return refuse(w, 814)\n        if get(w, OBS + 16) != get(w, M_OLD_BYTES) or get(w, OBS + 24) != get(w, M_NEW_BYTES):\n            return refuse(w, 815)\n        if get(w, OBS + 32) != 0 or get(w, OBS + 40) != 0 or get(w, OBS + 48) != 0 or get(w, OBS + 56) != 0:\n            return refuse(w, 816)\n        if get(w, OBS + 8) != 0:\n            return finish(o, w, 9, 4, 0)\n        return release(o, w, B_COMPARE, 32)\n    if phase == 32:\n        return hash_start(w, B_ORIGINAL_JSON, get(w, M_ORIGINAL_BYTES), M_SOURCE_HASH, 40)\n    if phase == 40:\n        return hash_start(w, B_RENAMED_JSON, get(w, M_RENAMED_BYTES), M_INPUT_HASH, 41)\n    if phase == 41:\n        size = 8 + get(w, M_NEW_BYTES) + 10 + REPORT_BYTES + 14 + get(w, M_RENAMED_BYTES) + 1\n        put(w, M_RESPONSE_BYTES, size)\n        return grow(o, w, B_RESPONSE, size, 42)\n    if phase == 42:\n        prefix(w)\n        return copy(o, w, B_CONTROLLER, WIRE, B_RESPONSE, 0, 8, 43)\n    if phase == 43:\n        return copy(o, w, B_NEW_CORE, 0, B_RESPONSE, 8, get(w, M_NEW_BYTES), 44)\n    if phase == 44:\n        report_separator(w)\n        return copy(o, w, B_CONTROLLER, WIRE, B_RESPONSE, 8 + get(w, M_NEW_BYTES), 10, 45)\n    if phase == 45:\n        report(w)\n        return copy(o, w, B_CONTROLLER, WIRE, B_RESPONSE, 18 + get(w, M_NEW_BYTES), REPORT_BYTES, 46)\n    if phase == 46:\n        structured_separator(w)\n        return copy(o, w, B_CONTROLLER, WIRE, B_RESPONSE, 18 + get(w, M_NEW_BYTES) + REPORT_BYTES, 14, 47)\n    if phase == 47:\n        return copy(o, w, B_RENAMED_JSON, 0, B_RESPONSE, 32 + get(w, M_NEW_BYTES) + REPORT_BYTES, get(w, M_RENAMED_BYTES), 48)\n    if phase == 48:\n        store(w, WIRE, 125)\n        return copy(o, w, B_CONTROLLER, WIRE, B_RESPONSE, get(w, M_RESPONSE_BYTES) - 1, 1, 49)\n    if phase == 49:\n        return protect(o, w, B_RESPONSE, 1, 50)\n    if phase == 50:\n        return hash_start(w, B_RESPONSE, get(w, M_RESPONSE_BYTES), L_DIGEST0, 51)\n    if phase == 51:\n        put(w, M_RELEASE, 4)\n        put(w, C_PHASE, 52)\n        return 0\n    if phase == 52:\n        slot = get(w, M_RELEASE)\n        if slot == 64:\n            put(w, L_FINAL_BYTES, get(w, M_RESPONSE_BYTES))\n            return finish(o, w, 0, 0, 0)\n        put(w, M_RELEASE, slot + 1)\n        if slot != B_RESPONSE:\n            return release(o, w, slot, 52)\n        return 0\n    return refuse(w, 817)\n\ndef run_child(o:mutbuf, w:mutbuf, mode:u64, source:u64, extent:u64, target:u64, lease:u64, next:u64) -> u32:\n    if mode > 1 or source == target or target < 4 or target >= 64 or cap(w, target) != 0:\n        return refuse(w, 818)\n    if extent == 0 or extent != cap(w, source) or lease == 0 or lease == MAX:\n        return refuse(w, 819)\n    put(w, M_CHILD_MODE, mode)\n    put(w, M_CHILD_TARGET, target)\n    put(w, M_CHILD_LEASE, lease)\n    put(w, C_OBSERVE, 160)\n    args(w, mode, source, 0, extent, target, lease, 0, 0, 0, 0, 0, 0)\n    return event(o, w, 15, next)\n\ndef child_result(w:mutbuf) -> u64:\n    if get(w, C_RETURN) != 128 or get(w, OBS) != EVENT_MAGIC or get(w, OBS + 8) != 7:\n        return 0\n    lease = get(w, M_CHILD_LEASE)\n    if get(w, M_CHILD_MODE) == 0:\n        lease = lease + 1\n    if get(w, OBS + 16) != lease or get(w, OBS + 24) == 0:\n        return 0\n    target = get(w, M_CHILD_TARGET)\n    if get(w, OBS + 136) != target or get(w, OBS + 152) != 0 or cap(w, target) != 0:\n        return 0\n    role = get(w, OBS + 144)\n    if get(w, M_CHILD_MODE) == 1:\n        if role != 40 and role != 47:\n            return 0\n    elif role != 40 and role != 45:\n        return 0\n    group = get(w, OBS + 32)\n    error = get(w, OBS + 40)\n    if group > 8:\n        return 0\n    if group != 0:\n        if error == 0 or get(w, OBS + 128) != 0:\n            return 0\n        return 1\n    if error != 0 or get(w, OBS + 88) == 0 or get(w, OBS + 88) > INPUT_LIMIT:\n        return 0\n    if get(w, OBS + 128) < get(w, OBS + 88):\n        return 0\n    if get(w, M_CHILD_MODE) == 1 and role != 47:\n        return 0\n    if get(w, M_CHILD_MODE) == 0 and role != 45:\n        return 0\n    put(w, CAPS + target * 8, get(w, OBS + 128))\n    return 1\n\ndef mirror_frame(w:mutbuf) -> u64:\n    put(w, L_FN_SERIAL, get(w, OBS + 56))\n    put(w, L_FN_SLOTS, get(w, OBS + 64))\n    put(w, L_FN_COUNT, get(w, OBS + 72))\n    put(w, L_HELP_COUNT, get(w, OBS + 80))\n    put(w, L_FINAL_BYTES, get(w, OBS + 88))\n    copy_digest(w, L_DIGEST0, OBS + 96)\n    return 0\n\ndef child_error(o:mutbuf, w:mutbuf) -> u32:\n    mirror_frame(w)\n    return finish(o, w, get(w, OBS + 32), get(w, OBS + 40), get(w, OBS + 48))\n\ndef copy_digest(w:mutbuf, to:u64, start:u64) -> u64:\n    i = 0\n    while i < 4:\n        put(w, to + i * 8, get(w, start + i * 8))\n        i = i + 1\n    return 0\n\ndef hash_start(w:mutbuf, slot:u64, size:u64, to:u64, next:u64) -> u64:\n    if inside(w, slot, 0, size) == 0 or size == MAX:\n        return refuse(w, 820)\n    put(w, M_HASH_SLOT, slot)\n    put(w, M_HASH_BYTES, size)\n    put(w, M_HASH_TO, to)\n    put(w, M_HASH_RETURN, next)\n    put(w, M_HASH_OFFSET, 0)\n    put(w, C_PHASE, 300)\n    return 0\n\ndef import_hash_step(o:mutbuf, w:mutbuf) -> u64:\n    phase = get(w, C_PHASE)\n    if phase == 300:\n        return grow(o, w, B_SHA_INPUT, minimum(get(w, M_HASH_BYTES), INPUT_LIMIT) + 1, 301)\n    if phase == 301:\n        return grow(o, w, B_SHA_OUTPUT, 32, 302)\n    if phase == 302:\n        return grow(o, w, B_SHA_WORK, 1184, 303)\n    if phase == 303:\n        store(w, WIRE, 0)\n        return invoke(o, w, I_SHA_STREAM, B_CONTROLLER, WIRE, 1, B_SHA_OUTPUT, 32, B_SHA_WORK, 1184, B_EMPTY, 0, 0, 304)\n    if phase == 304:\n        if get(w, C_RETURN) != 0:\n            return refuse(w, 821)\n        store(w, WIRE, 1)\n        return copy(o, w, B_CONTROLLER, WIRE, B_SHA_INPUT, 0, 1, 305)\n    if phase == 305:\n        chunk = minimum(get(w, M_HASH_BYTES) - get(w, M_HASH_OFFSET), INPUT_LIMIT)\n        put(w, M_HASH_CHUNK, chunk)\n        return copy(o, w, get(w, M_HASH_SLOT), get(w, M_HASH_OFFSET), B_SHA_INPUT, 1, chunk, 306)\n    if phase == 306:\n        return invoke(o, w, I_SHA_STREAM, B_SHA_INPUT, 0, get(w, M_HASH_CHUNK) + 1, B_SHA_OUTPUT, 32, B_SHA_WORK, 1184, B_EMPTY, 0, 0, 307)\n    if phase == 307:\n        if get(w, C_RETURN) != 0:\n            return refuse(w, 822)\n        put(w, M_HASH_OFFSET, get(w, M_HASH_OFFSET) + get(w, M_HASH_CHUNK))\n        if get(w, M_HASH_OFFSET) < get(w, M_HASH_BYTES):\n            put(w, C_PHASE, 305)\n            return 0\n        store(w, WIRE, 2)\n        return invoke(o, w, I_SHA_STREAM, B_CONTROLLER, WIRE, 1, B_SHA_OUTPUT, 32, B_SHA_WORK, 1184, B_SHA_OUTPUT, 0, 32, 308)\n    if phase == 308:\n        if get(w, C_RETURN) != 32:\n            return refuse(w, 823)\n        copy_digest(w, get(w, M_HASH_TO), OBS)\n        return release(o, w, B_SHA_INPUT, 309)\n    if phase == 309:\n        return release(o, w, B_SHA_OUTPUT, 310)\n    if phase == 310:\n        return release(o, w, B_SHA_WORK, 311)\n    if phase == 311:\n        put(w, C_PHASE, get(w, M_HASH_RETURN))\n        return 0\n    return refuse(w, 824)\n\ndef hex_digest(w:mutbuf, start:u64, to:u64) -> u64:\n    i = 0\n    while i < 32:\n        value = byte(w, start + i)\n        high = value >> 4\n        low = value & 15\n        if high < 10:\n            high = high + 48\n        else:\n            high = high + 87\n        if low < 10:\n            low = low + 48\n        else:\n            low = low + 87\n        store(w, to + i * 2, high)\n        store(w, to + i * 2 + 1, low)\n        i = i + 1\n    return 0\n'''\n\n\ndef report_template():\n    value={'schema':'hepta.hia.legacy-composite-import.v1','ok':True,\n        'source_schema':'hepta.hia.program.v2',\n        'source_profile':'nominal-products-enums-cooperative-tasks-over-closed-ssa-v2',\n        'source_input_sha256':'A'*64,'source_primitive_schema':'hepta.hia.program.v1',\n        'source_primitive_sha256':'B'*64,'target_schema':'hepta.hia.composite.v1',\n        'target_input_sha256':'C'*64,'target_core_schema':'hepta.hia.program.v6',\n        'target_core_sha256':'D'*64,\n        'claims':{'explicit_nominal_profile_selected':True,'legacy_v1_instruction_set_reverified':True,\n            'nominal_resource_flow_reverified':True,'target_v6_core_reverified':True,\n            'primitive_payload_unchanged_excluding_schema':True,'producer_source_authenticated':False,\n            'whole_language_soundness_proved':False,'backend_refinement_proved':False}}\n    return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()\n\n\ndef literal_function(name,raw):\n    result=f'\\ndef {name}(w:mutbuf) -> u64:\\n'\n    full=(len(raw)//8)*8\n    for i in range(0,full,8):result+=f'    put(w, WIRE + {i}, {int.from_bytes(raw[i:i+8],\"little\")})\\n'\n    for i in range(full,len(raw)):result+=f'    store(w, WIRE + {i}, {raw[i]})\\n'\n    return result+'    return 0\\n'\n\n\ndef source_program():\n    raw=report_template(); constants=dict(CONSTANTS,REPORT_BYTES=len(raw))\n    assert len(raw)<2048\n    extras=''\n    for name,value in [('prefix',b'{\"core\":'),('report_separator',b',\"report\":'),('structured_separator',b',\"structured\":')]:\n        extras+=literal_function(name,value)\n    assert len(b'{\"core\":')==8 and len(b',\"report\":')==10 and len(b',\"structured\":')==14\n    report=literal_function('report',raw)\n    injection=''\n    for marker,field in [('A','M_SOURCE_HASH'),('B','M_OLD_HASH'),('C','M_INPUT_HASH'),('D','M_TARGET_HASH')]:\n        offset=raw.index((marker*64).encode()); assert raw.count((marker*64).encode())==1\n        injection+=f'    hex_digest(w, {field}, WIRE + {offset})\\n'\n    extras+=report.replace('    return 0\\n',injection+'    return 0\\n')\n    common=COMMON.replace('or image > 23:','or image > 29:')\n    common=common.replace('if pending != 1 and pending != 14 and word(s, 40) != 0:',\n        'if pending != 1 and pending != 14 and pending != 15 and word(s, 40) != 0:')\n    return source(BODY+extras+'\\n'+SERVICES+'\\n'+common,constants,'legacy_import')\n\ndef document(): return build(source_program(),'legacy_composite_import_driver')\nif __name__=='__main__': write_document(document(),'legacy_composite_import_driver.hiaasm')\n"}
2026-11-11T22:00:50.0432697Z HIA_PROGRAM_INTEGRATION_SOURCE {"bytes": 2333, "git_sha": "b01b1226799ff856e39a8e302f51c0ee94d16129", "relative": "native-edit-json-next/development/main-compile-r3/source/2/edit_authoring.py", "sha256": "a9040b23586f7bf289fdddb7337a986cf9d207666b46dc2771fa00a0d06e70d9", "text": "\"\"\"Development authoring of new HIA edit controllers, not a runtime owner.\"\"\"\nimport ast\nfrom pathlib import Path\nfrom hepta.hia_agent_assembly import render_assembly\nfrom tools.hia_agent_edit_source_views import CopyBuilder\nfrom tools.generate_hia_selfhost import compact_authoring_cfg,total_scalar_functions\n\nROOT=Path(__file__).resolve().parents[1]\ndef source(body,constants,entry):\n    tree=ast.parse(body)\n    class Expand(ast.NodeTransformer):\n        def visit_Name(self,n):\n            return ast.copy_location(ast.Constant(constants[n.id]),n) if isinstance(n.ctx,ast.Load) and n.id in constants else n\n    tree=ast.fix_missing_locations(Expand().visit(tree));fns={n.name:n for n in tree.body}\n    assert len(fns)==len(tree.body)\n    reachable={entry};pending=[entry]\n    while pending:\n        for n in ast.walk(fns[pending.pop()]):\n            if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id in fns and n.func.id not in reachable:\n                reachable.add(n.func.id);pending.append(n.func.id)\n    tree.body=[fns[entry]]+[n for n in tree.body if n.name!=entry and n.name in reachable]\n    return ast.unparse(tree)+'\\n'\n\ndef document(body,module):\n    nodes=ast.parse(body).body;names={n.name:'f'+str(i) for i,n in enumerate(nodes)}\n    signatures={n.name:([a.annotation.id for a in n.args.args],n.returns.id) for n in nodes}\n    total=total_scalar_functions(nodes);functions=[]\n    for n in nodes:\n        b=CopyBuilder(n,names,signatures,total);b.statements(n.body)\n        functions.append(dict(name=names[n.name],params=[b.param(p) for p in b.params],returns=[b.returns],\n            effects=['read','write','trap'],entry='b0',blocks=b.blocks))\n    return compact_authoring_cfg(dict(schema='hepta.hia.program.v8',module=module,functions=functions))\n\ndef write(doc,name):\n    p=ROOT/'examples/hia_bootstrap'/name;p.parent.mkdir(parents=True,exist_ok=True);p.write_text(render_assembly(doc))\n    profile=dict(functions=len(doc['functions']),blocks=sum(len(f['blocks']) for f in doc['functions']),\n        max_blocks=max(len(f['blocks']) for f in doc['functions']),ops=sum(len(b['ops']) for f in doc['functions'] for b in f['blocks']),\n        max_block_params=max(len(b['params']) for f in doc['functions'] for b in f['blocks']))\n    print(p.name,p.stat().st_size,profile)\n    return p,profile\n"}
2026-11-11T22:00:50.0568133Z HIA_PROGRAM_INTEGRATION_SOURCE {"bytes": 25714, "git_sha": "d4955458d54e39928c4e279a4c6dbe30a90f18a0", "relative": "native-edit-json-next/development/main-compile-r3/source/9/hia_composite_lowering_driver_services.py", "sha256": "a1757f1137571a52b61dc17f6b8258323de1fc7f22c02433fdfbbd783a81ec57", "text": "\"\"\"Native service, source-index, and metadata continuations for full lowering.\n\nRECONSTRUCTED-DEVELOPMENT-r1. This module is paired with the independent helper\ntransport owner; no Python value decoder or type materializer is invoked.\n\"\"\"\nfrom __future__ import annotations\n\nBODY = r'''\ndef lower_services(s:readbuf, o:mutbuf, w:mutbuf) -> u32:\n    if length(w) < MIN_WORK:\n        return ABI\n    if length(o) < 128 or acknowledge(s, w, DRIVER_SERVICES) == 0:\n        return refuse(w, 200)\n    while get(w, L_STATUS) == 1:\n        result = services_step(o, w)\n        if result != 0:\n            return result\n    return refuse(w, 201)\n\ndef services_step(o:mutbuf, w:mutbuf) -> u64:\n    phase = get(w, C_PHASE)\n    if phase >= 20000 and phase < 21000:\n        return ir_step(o, w)\n    if phase >= 21000 and phase < 22000:\n        return owner_projection_step(o, w)\n    if phase >= 22000 and phase < 23000:\n        return type_service_step(o, w)\n    if phase >= 23000 and phase < 24000:\n        return helper_service_step(o, w)\n    if phase >= 25000 and phase < 26000:\n        return metadata_step(o, w)\n    if phase >= 26000 and phase < 27000:\n        return index_step(o, w)\n    if phase >= 28000 and phase < 29000:\n        return query_step(o, w)\n    return refuse(w, 202)\n\ndef producer_frame(w:mutbuf) -> u64:\n    size = get(w, C_RETURN)\n    if size < 64 or size > OWNER_OUTPUT_BYTES or get(w, OBS) != get(w, L_PRODUCER_MAGIC):\n        return 0\n    kind = get(w, OBS + 8)\n    if get(w, L_PRODUCER_KIND) == MAX:\n        if get(w, L_PRODUCER_MAGIC) != FN_STREAM or kind < 2 or kind > 6:\n            return 0\n        put(w, L_PRODUCER_KIND, kind)\n    elif kind != get(w, L_PRODUCER_KIND):\n        return 0\n    if get(w, OBS + 16) != get(w, L_PRODUCER_SEQUENCE) or get(w, OBS + 24) > 1:\n        return 0\n    if get(w, OBS + 32) != get(w, L_PRODUCER_SERIAL) or get(w, OBS + 40) != get(w, L_PRODUCER_SLOTS):\n        return 0\n    if get(w, OBS + 48) != get(w, L_PRODUCER_REQUEST) or get(w, OBS + 56) != size - 64:\n        return 0\n    put(w, L_PRODUCER_BYTES, size)\n    put(w, L_PRODUCER_FINAL, get(w, OBS + 24))\n    return 1\n\ndef ir_event(w:mutbuf, initial:u64) -> u64:\n    if get(w, C_RETURN) != 1152 or get(w, OBS) != IR_EVENT:\n        return 0\n    if get(w, OBS + 24) != get(w, C_LEASE) or get(w, OBS + 32) != get(w, C_IR_STREAM):\n        return 0\n    if get(w, C_IR_ESEQ) == MAX or get(w, OBS + 48) != get(w, C_IR_ESEQ) + 1:\n        return 0\n    if get(w, OBS + 88) != 0 or get(w, OBS + 96) != 0 or get(w, OBS + 104) != 0 or get(w, OBS + 112) != 0 or get(w, OBS + 120) != 0:\n        return 0\n    action = get(w, OBS + 8)\n    if initial != 0:\n        if action != 1 or get(w, OBS + 16) != 1 or get(w, OBS + 40) != 0:\n            return 0\n        if get(w, OBS + 56) != 0 or get(w, OBS + 64) != 0 or get(w, OBS + 72) != 131328 or get(w, OBS + 80) != 0:\n            return 0\n    elif action == 3:\n        if get(w, OBS + 16) != 1 or get(w, OBS + 40) != get(w, L_PRODUCER_SEQUENCE):\n            return 0\n        if get(w, OBS + 80) <= cap(w, B_IR):\n            return 0\n    elif action == 1 or action == 5:\n        if get(w, L_PRODUCER_SEQUENCE) == MAX or get(w, OBS + 40) != get(w, L_PRODUCER_SEQUENCE) + 1:\n            return 0\n        if get(w, OBS + 80) != 0:\n            return 0\n        if action == 1:\n            if get(w, OBS + 16) != 1 or get(w, L_PRODUCER_FINAL) != 0:\n                return 0\n        else:\n            if get(w, OBS + 16) != 2 or get(w, L_PRODUCER_FINAL) != 1 or get(w, OBS + 64) == 0:\n                return 0\n    else:\n        return 0\n    if get(w, OBS + 72) < 131328 or get(w, OBS + 72) > cap(w, B_IR):\n        return 0\n    put(w, C_IR_ESEQ, get(w, OBS + 48))\n    put(w, C_IR_PSEQ, get(w, OBS + 40))\n    put(w, C_IR_ROOT, get(w, OBS + 56))\n    put(w, C_IR_NODES, get(w, OBS + 64))\n    put(w, C_IR_EXTENT, get(w, OBS + 72))\n    put(w, L_IR_ACTION, action)\n    return 1\n\ndef ir_step(o:mutbuf, w:mutbuf) -> u64:\n    phase = get(w, C_PHASE)\n    if phase == 20000:\n        if advance(w, L_STREAM_NUMBER) == 0:\n            return ABI\n        put(w, C_IR_STREAM, get(w, L_STREAM_NUMBER))\n        put(w, C_IR_ESEQ, 0)\n        put(w, C_IR_PSEQ, 0)\n        put(w, C_IR_ROOT, 0)\n        put(w, C_IR_NODES, 0)\n        put(w, C_IR_EXTENT, 0)\n        return release(o, w, B_IR, 20001)\n    if phase == 20001:\n        return grow(o, w, B_IR, 131328, 20002)\n    if phase == 20002 or phase == 20020:\n        return invoke(o, w, get(w, L_PRODUCER_IMAGE), B_EMPTY, 0, 0, get(w, L_PRODUCER_OUTPUT), OWNER_OUTPUT_BYTES, get(w, L_PRODUCER_WORK), cap(w, get(w, L_PRODUCER_WORK)), get(w, L_PRODUCER_OUTPUT), 0, 64, 20003)\n    if phase == 20003:\n        if producer_frame(w) == 0:\n            return refuse(w, 203)\n        if get(w, C_IR_ESEQ) != 0:\n            put(w, C_PHASE, 20006)\n            return 0\n        wire8(w, IR_INIT, get(w, C_LEASE), get(w, C_IR_STREAM), get(w, L_PRODUCER_MAGIC), get(w, L_PRODUCER_KIND), get(w, L_PRODUCER_REQUEST), get(w, L_PRODUCER_SERIAL), get(w, L_PRODUCER_SLOTS))\n        return invoke(o, w, I_IR, B_CONTROLLER, WIRE, 64, get(w, L_STREAM_SOURCE), get(w, L_STREAM_SOURCE_EXTENT), B_IR, cap(w, B_IR), B_IR, 1024, 128, 20004)\n    if phase == 20004:\n        if ir_event(w, 1) == 0:\n            return refuse(w, 204)\n        put(w, C_PHASE, 20006)\n        return 0\n    if phase == 20006:\n        return invoke(o, w, I_IR, get(w, L_PRODUCER_OUTPUT), 0, get(w, L_PRODUCER_BYTES), get(w, L_STREAM_SOURCE), get(w, L_STREAM_SOURCE_EXTENT), B_IR, cap(w, B_IR), B_IR, 1024, 128, 20007)\n    if phase == 20007:\n        if ir_event(w, 0) == 0:\n            return refuse(w, 205)\n        if get(w, L_IR_ACTION) == 3:\n            return grow(o, w, B_IR, get(w, OBS + 80), 20008)\n        if advance(w, L_PRODUCER_SEQUENCE) == 0:\n            return ABI\n        if get(w, L_IR_ACTION) == 1:\n            put(w, C_PHASE, 20020)\n            return 0\n        return switch(o, w, DRIVER_MAIN, get(w, L_IR_RETURN))\n    if phase == 20008:\n        wire8(w, IR_CONT, get(w, C_LEASE), get(w, C_IR_STREAM), get(w, C_IR_ESEQ), 0, 0, 0, 0)\n        return invoke(o, w, I_IR, B_CONTROLLER, WIRE, 32, get(w, L_STREAM_SOURCE), get(w, L_STREAM_SOURCE_EXTENT), B_IR, cap(w, B_IR), B_IR, 1024, 128, 20007)\n    return refuse(w, 206)\n\ndef owner_projection_step(o:mutbuf, w:mutbuf) -> u64:\n    phase = get(w, C_PHASE)\n    if phase == 21000:\n        if get(w, C_OWNER_TARGET) != 3 or get(w, L_PRODUCER_MAGIC) != OUT_STREAM or get(w, L_PRODUCER_KIND) != 1:\n            return refuse(w, 207)\n        return release(o, w, B_PROJECTOR, 21001)\n    if phase == 21001:\n        return grow(o, w, B_PROJECTOR, 512, 21002)\n    if phase == 21002:\n        wire8(w, OWNER_CONFIG, 3, get(w, C_LEASE), get(w, C_IR_STREAM), get(w, L_PRODUCER_REQUEST), 0, 0, 0)\n        zero(w, WIRE + 64, 64)\n        return copy(o, w, B_CONTROLLER, WIRE, B_PROJECTOR, 128, 128, 21003)\n    if phase == 21003:\n        return invoke(o, w, I_OWNER_PACKET, B_IR, 0, get(w, C_IR_EXTENT), get(w, L_STREAM_SOURCE), get(w, L_STREAM_SOURCE_EXTENT), B_PROJECTOR, cap(w, B_PROJECTOR), B_PROJECTOR, 0, 128, 21004)\n    if phase == 21004:\n        if get(w, C_RETURN) != 128 or get(w, OBS) != OWNER_EVENT or get(w, OBS + 16) != 3:\n            return refuse(w, 208)\n        if get(w, OBS + 24) != get(w, C_LEASE) or get(w, OBS + 32) != get(w, C_IR_STREAM) or get(w, OBS + 40) != get(w, L_PRODUCER_REQUEST):\n            return refuse(w, 209)\n        if get(w, OBS + 48) != 0 or get(w, OBS + 56) != 0 or get(w, OBS + 88) != 0:\n            return refuse(w, 210)\n        if get(w, OBS + 96) != 0 or get(w, OBS + 104) != 0 or get(w, OBS + 112) != 0 or get(w, OBS + 120) != 0:\n            return refuse(w, 211)\n        if get(w, OBS + 8) == 1:\n            if get(w, OBS + 80) <= cap(w, B_PROJECTOR):\n                return refuse(w, 212)\n            return grow(o, w, B_PROJECTOR, get(w, OBS + 80), 21003)\n        if get(w, OBS + 8) != 0 or get(w, OBS + 72) < 17 or get(w, OBS + 72) > 144:\n            return refuse(w, 213)\n        if inside(w, B_PROJECTOR, get(w, OBS + 64), get(w, OBS + 72)) == 0:\n            return refuse(w, 214)\n        if get(w, OBS + 80) != get(w, OBS + 64) + get(w, OBS + 72):\n            return refuse(w, 215)\n        put(w, C_PACKET_SLOT, B_PROJECTOR)\n        put(w, C_PACKET_OFFSET, get(w, OBS + 64))\n        put(w, C_PACKET_BYTES, get(w, OBS + 72))\n        return switch(o, w, DRIVER_MAIN, get(w, C_PACKET_RETURN))\n    return refuse(w, 216)\n\ndef json_workspace(w:mutbuf, size:u64) -> u64:\n    slots = 2\n    while slots < (size >> 5) * 2:\n        slots = slots * 2\n    index = 128 + slots * 16\n    bitmap = (size + 7) >> 3\n    stack = (index + bitmap + 7) & (MAX - 7)\n    frames = ((size * 2863311531) >> 36) + 1\n    put(w, C_BITMAP_OFFSET, index)\n    put(w, C_BITMAP_BYTES, bitmap)\n    return stack + frames * 32\n\ndef index_step(o:mutbuf, w:mutbuf) -> u64:\n    phase = get(w, C_PHASE)\n    if phase == 26000:\n        size = get(w, C_PACKET_BYTES)\n        if size < 16 or size > PACKET_LIMIT or inside(w, get(w, C_PACKET_SLOT), get(w, C_PACKET_OFFSET), size) == 0:\n            return refuse(w, 217)\n        put(w, L_INDEX_PACKET_SLOT, get(w, C_PACKET_SLOT))\n        put(w, L_INDEX_PACKET_OFFSET, get(w, C_PACKET_OFFSET))\n        put(w, L_INDEX_PACKET_BYTES, size)\n        put(w, L_INDEX_WORK_BYTES, json_workspace(w, size))\n        put(w, L_INDEX_OUTPUT_BYTES, 64 + size * 6)\n        return grow(o, w, B_PACKET_WORK, get(w, L_INDEX_WORK_BYTES), 26001)\n    if phase == 26001:\n     