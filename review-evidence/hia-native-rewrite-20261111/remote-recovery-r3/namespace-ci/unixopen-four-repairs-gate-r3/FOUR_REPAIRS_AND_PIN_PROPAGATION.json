        "mode": "100644"
      },
      "exact_edits": [
        {
          "before": "def document():",
          "after": "def _dense_db_steady_ssa(document, function_name):\n    \"\"\"Alpha-rename only db_steady after CFG compaction; preserve every operation.\"\"\"\n    import copy\n    assert document[\"schema\"] == \"hepta.hia.program.v8\"\n    assert document[\"module\"] == \"agent_namespace_db_node_reuse_r3\"\n    indices = [i for i, fn in enumerate(document[\"functions\"]) if fn[\"name\"] == function_name]\n    assert len(indices) == 1\n    index = indices[0]\n    original = document[\"functions\"][index]\n    assert set(original) == {\"name\", \"params\", \"returns\", \"effects\", \"entry\", \"blocks\"}\n    entries = [block for block in original[\"blocks\"] if block[\"id\"] == original[\"entry\"]]\n    assert len(entries) == 1 and original[\"params\"] == entries[0][\"params\"]\n    definitions = {}\n    for block in original[\"blocks\"]:\n        assert set(block) == {\"id\", \"params\", \"ops\", \"term\"}\n        values = list(block[\"params\"])\n        for op in block[\"ops\"]:\n            assert set(op) == {\"op\", \"args\", \"out\", \"attrs\"}\n            values.extend(op[\"out\"])\n        for value in values:\n            assert set(value) == {\"name\", \"type\"}\n            name = value[\"name\"]\n            assert type(name) is str and name.startswith(\"v\") and name[1:]\n            assert name[1:].isascii() and name[1:].isdigit()\n            assert name == \"v\" + str(int(name[1:])) and name not in definitions\n            definitions[name] = value[\"type\"]\n    ordered = sorted(definitions, key=lambda name: int(name[1:]))\n    mapping = {name: \"v\" + str(i) for i, name in enumerate(ordered)}\n    inverse = {new: old for old, new in mapping.items()}\n    assert len(mapping) == len(inverse) == len(definitions)\n    assert all(int(name[1:]) < 2048 for name in inverse)\n\n    def renamed(fn, table):\n        fn = copy.deepcopy(fn)\n        def refs(values):\n            assert type(values) is list and all(type(x) is str and x in table for x in values)\n            return [table[x] for x in values]\n        def params(values):\n            for value in values:\n                value[\"name\"] = table[value[\"name\"]]\n        params(fn[\"params\"])\n        for block in fn[\"blocks\"]:\n            params(block[\"params\"])\n            for op in block[\"ops\"]:\n                op[\"args\"] = refs(op[\"args\"])\n                params(op[\"out\"])\n            term = block[\"term\"]\n            if term[\"op\"] == \"ret\":\n                assert set(term) == {\"op\", \"values\"}\n                term[\"values\"] = refs(term[\"values\"])\n            elif term[\"op\"] == \"jump\":\n                assert set(term) == {\"op\", \"target\", \"args\"}\n                term[\"args\"] = refs(term[\"args\"])\n            elif term[\"op\"] == \"branch\":\n                assert set(term) == {\"op\", \"cond\", \"then\", \"else\"}\n                term[\"cond\"] = table[term[\"cond\"]]\n                for edge_name in (\"then\", \"else\"):\n                    edge = term[edge_name]\n                    assert set(edge) == {\"target\", \"args\"}\n                    edge[\"args\"] = refs(edge[\"args\"])\n            else:\n                raise ValueError(\"unexpected db_steady terminator\")\n        return fn\n\n    rewritten = renamed(original, mapping)\n    assert renamed(rewritten, inverse) == original\n    result = copy.deepcopy(document)\n    result[\"functions\"][index] = rewritten\n    return result\n\ndef document():"
        },
        {
          "before": "    return compact_authoring_cfg({\"schema\":\"hepta.hia.program.v8\",\"module\":\"agent_namespace_db_node_reuse_r3\",\"functions\":functions})",
          "after": "    return _dense_db_steady_ssa(compact_authoring_cfg({\"schema\":\"hepta.hia.program.v8\",\"module\":\"agent_namespace_db_node_reuse_r3\",\"functions\":functions}), names[\"db_steady\"])"
        }
      ],
      "forward_full_bytes_equal": true,
      "inverse_full_bytes_equal": true
    },
