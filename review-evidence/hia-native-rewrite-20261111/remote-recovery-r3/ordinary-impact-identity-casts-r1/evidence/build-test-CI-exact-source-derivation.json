        "before": "def core_profile(document):",
        "after": "def check_changes(old,new,row):\n    check_pin(old,row[\"original\"]);check_pin(new,row[\"candidate\"])\n    new_header,new_fns=split_functions(new)\n    lines=new.splitlines(keepends=True);restored=list(lines)\n    changes=row[\"changes\"];helpers=row[\"identity_helpers\"]\n    assert changes and helpers and len({x[\"line_index\"] for x in changes})==len(changes)\n    names=set()\n    for helper in helpers:\n        name=helper[\"name\"];assert name not in names\n        names.add(name);body=new_fns[name]\n        check_pin(body,helper)\n        assert body==helper[\"source\"].encode(\"ascii\")\n        parameter=helper[\"parameter\"]\n        expected=(\"fn \"+name+\"(\"+parameter+\":u64) -> (u64) effects(read,write,trap) entry(b0)\\n\"\n            \"block b0(\"+parameter+\":u64)\\n  ret(\"+parameter+\")\\nend\\n\").encode(\"ascii\")\n        assert body==expected\n    for change in changes:\n        at=change[\"line_index\"];before=change[\"before\"].encode(\"ascii\");after=change[\"after\"].encode(\"ascii\")\n        assert type(at) is int and 0<=at<len(lines) and lines[at]==after\n        match=re.fullmatch(rb'  (v\\d+):u64 = call\\((v\\d+)\\) \\{\"function\":\"(f\\d+)\"\\}\\n',before)\n        assert match is not None and match[3].decode(\"ascii\") in names\n        assert change[\"result\"]==match[1].decode(\"ascii\")\n        assert change[\"argument\"]==match[2].decode(\"ascii\")\n        assert change[\"identity_helper\"]==match[3].decode(\"ascii\")\n        wanted=b'  '+match[1]+b':u64 = int.cast('+match[2]+b') {\"mode\":\"wrap\"}\\n'\n        assert after==wanted\n        current=None\n        for line in lines[:at]:\n            if line.startswith(b\"fn \"):current=line.split(b\"(\",1)[0][3:].decode(\"ascii\")\n        assert current==change[\"function\"]\n        restored[at]=before\n    predecessor=b\"\".join(restored);check_pin(predecessor,row[\"predecessor\"])\n    prior_header,prior_fns=split_functions(predecessor)\n    assert new_header==prior_header and list(new_fns)==list(prior_fns)\n    for helper in helpers:assert prior_fns[helper[\"name\"]]==new_fns[helper[\"name\"]]\n    forward=list(restored)\n    for change in changes:\n        at=change[\"line_index\"];assert forward[at]==change[\"before\"].encode(\"ascii\")\n        forward[at]=change[\"after\"].encode(\"ascii\")\n    assert b\"\".join(forward)==new\n    for name in names:\n        assert re.search(rb' = call\\([^\\n]*\\) \\{\"function\":\"'+name.encode(\"ascii\")+rb'\"\\}',new) is None\n    if row[\"role\"] in ASCII_CHANGED:\n        check_ascii_changes(old,predecessor,ascii_proof_rows[row[\"role\"]])\n    else:\n        assert row[\"role\"] in (2,25) and predecessor==old\n        source_checks.append(dict(role=row[\"role\"],original=pin(old),\n            candidate=pin(new),exact_complete_inverse=True))\n    source_checks[-1].update(candidate=pin(new),identity_predecessor=pin(predecessor),\n        exact_zero_operation_identity_calls=len(changes),identity_helpers=sorted(names),\n        complete_identity_call_cast_forward_inverse=True,\n        all_original_memory_operations_and_order_preserved=True,\n        no_mutable_workspace_cursor_cache=True,no_bulk_access=True,\n        arbitrary_VM_fuel_and_stack_limit_equivalence_claimed=False)\n\ndef core_profile(document):"
