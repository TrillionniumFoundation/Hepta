+"""HIA graph and private-map primitives for the heap resource owner.
+
+All graph order, edge sets and SCC decisions are executable HIA. This module
+is authoring input and is never imported by an installed runtime. The caller
+supplies get/put, same_text, size_of, tag and ordinary typed transport readers.
+Arena offsets 64/72 hold used bytes and the minimum requested extent. A zero
+allocation result requests more private storage; it never authorizes a bound.
+Graphs have a two-word header followed by six-word node records. Names refer
+to immutable text nodes in the copied source packet. No source-node quota or
+fixed graph capacity is introduced here.
+"""
+
+BODY = r'''
+def heap_alloc(w:mutbuf, amount:u64) -> u64:
+    at = get(w, 64)
+    if at > length(w) or amount > 18446744073709551615 - at - 7:
+        put(w, 80, 1)
+        return 0
+    stop = (at + amount + 7) & 18446744073709551608
+    if stop > length(w):
+        if stop > get(w, 72):
+            put(w, 72, stop)
+        return 0
+    put(w, 64, stop)
+    fill_range(w, at, stop - at, 0)
+    return at
+
+def heap_copy(w:mutbuf, dest:u64, source:u64, count:u64) -> u64:
+    index = 0
+    while index < count:
+        store(w, dest + index, byte(w, source + index))
+        index = index + 1
+    return 0
+
+def heap_text_cmp(w:mutbuf, left:u64, right:u64) -> u64:
+    a = size_of(w, left)
+    b = size_of(w, right)
+    index = 0
+    while index < a and index < b:
+        first = byte(w, left + 16 + index)
+        second = byte(w, right + 16 + index)
+        if first != second:
+            return choose(first < second, 1, 2)
+        index = index + 1
+    if a == b:
+        return 0
+    return choose(a < b, 1, 2)
+
+def heap_graph(w:mutbuf, count:u64) -> u64:
+    if count > (18446744073709551615 - 16) // 48:
+        put(w, 80, 1)
+        return 0
+    graph = heap_alloc(w, 16 + count * 48)
+    if graph == 0:
+        return 0
+    put(w, graph, count)
+    put(w, graph + 8, graph + 16)
+    return graph
+
+def heap_node(w:mutbuf, graph:u64, index:u64) -> u64:
+    return get(w, graph + 8) + index * 48
+
+def heap_name(w:mutbuf, graph:u64, index:u64) -> u64:
+    return get(w, heap_node(w, graph, index))
+
+def heap_named(w:mutbuf, graph:u64, name:u64) -> u64:
+    index = 0
+    while index < get(w, graph):
+        if same_text(w, heap_name(w, graph, index), name) != 0:
+            return index
+        index = index + 1
+    return 18446744073709551615
+
+def heap_has_edge(w:mutbuf, graph:u64, source:u64, target:u64) -> u64:
+    edge = get(w, heap_node(w, graph, source) + 16)
+    while edge != 0:
+        if get(w, edge + 8) == target:
+            return 1
+        edge = get(w, edge)
+    return 0
+
+def heap_edge(w:mutbuf, graph:u64, source:u64, target:u64) -> u64:
+    if source >= get(w, graph) or target >= get(w, graph):
+        put(w, 80, 2)
+        return 0
+    if heap_has_edge(w, graph, source, target) != 0:
+        return 1
+    edge = heap_alloc(w, 16)
+    if edge == 0:
+        return 0
+    node = heap_node(w, graph, source)
+    put(w, edge, get(w, node + 16))
+    put(w, edge + 8, target)
+    put(w, node + 16, edge)
+    node = heap_node(w, graph, target)
+    put(w, node + 24, get(w, node + 24) + 1)
+    return 1
+
+def heap_sort_ids(w:mutbuf, graph:u64, values:u64, count:u64) -> u64:
+    index = 1
+    while index < count:
+        value = get(w, values + index * 8)
+        at = index
+        going = True
+        while going and at != 0:
+            previous = get(w, values + (at - 1) * 8)
+            if heap_text_cmp(w, heap_name(w, graph, value), heap_name(w, graph, previous)) != 1:
+                going = False
+            else:
+                put(w, values + at * 8, previous)
+                at = at - 1
+        put(w, values + at * 8, value)
+        index = index + 1
+    return 0
+
+def heap_neighbors(w:mutbuf, graph:u64, source:u64) -> u64:
+    count = 0
+    edge = get(w, heap_node(w, graph, source) + 16)
+    while edge != 0:
+        count = count + 1
+        edge = get(w, edge)
+    values = heap_alloc(w, 8 + count * 8)
+    if values == 0:
+        return 0
+    put(w, values, count)
+    edge = get(w, heap_node(w, graph, source) + 16)
+    index = 0
+    while edge != 0:
+        put(w, values + 8 + index * 8, get(w, edge + 8))
+        index = index + 1
+        edge = get(w, edge)
+    heap_sort_ids(w, graph, values + 8, count)
+    return values
+
+def heap_topological(w:mutbuf, graph:u64) -> u64:
+    count = get(w, graph)
+    output = heap_alloc(w, 8 + count * 8)
+    queue = heap_alloc(w, count * 8)
+    degrees = heap_alloc(w, count * 8)
+    if output == 0 or queue == 0 or degrees == 0:
+        return 0
+    tail = 0
+    index = 0
+    while index < count:
+        degree = get(w, heap_node(w, graph, index) + 24)
+        put(w, degrees + index * 8, degree)
+        if degree == 0:
+            put(w, queue + tail * 8, index)
+            tail = tail + 1
+        index = index + 1
+    heap_sort_ids(w, graph, queue, tail)
+    head = 0
+    used = 0
+    while head < tail:
+        source = get(w, queue + head * 8)
+        head = head + 1
+        put(w, output + 8 + used * 8, source)
+        used = used + 1
+        neighbors = heap_neighbors(w, graph, source)
+        if neighbors == 0:
+            return 0
+        index = 0
+        while index < get(w, neighbors):
+            target = get(w, neighbors + 8 + index * 8)
+            degree = get(w, degrees + target * 8) - 1
+            put(w, degrees + target * 8, degree)
+            if degree == 0:
+                put(w, queue + tail * 8, target)
+                tail = tail + 1
+            index = index + 1
+    put(w, output, used)
+    if used != count:
+        put(w, 80, 3)
+        return 18446744073709551615
+    return output
+
+def heap_reverse_graph(w:mutbuf, graph:u64) -> u64:
+    count = get(w, graph)
+    reverse = heap_graph(w, count)
+    if reverse == 0:
+        return 0
+    source = 0
+    while source < count:
+        put(w, heap_node(w, reverse, source), heap_name(w, graph, source))
+        source = source + 1
+    source = 0
+    while source < count:
+        edge = get(w, heap_node(w, graph, source) + 16)
+        while edge != 0:
+            if heap_edge(w, reverse, get(w, edge + 8), source) == 0:
+                return 0
+            edge = get(w, edge)
+        source = source + 1
+    return reverse
+
+def heap_finish_order(w:mutbuf, graph:u64) -> u64:
+    count = get(w, graph)
+    names = heap_alloc(w, count * 8)
+    seen = heap_alloc(w, count * 8)
+    stack = heap_alloc(w, count * 24)
+    finished = heap_alloc(w, 8 + count * 8)
+    if names == 0 or seen == 0 or stack == 0 or finished == 0:
+        return 0
+    index = 0
+    while index < count:
+        put(w, names + index * 8, index)
+        index = index + 1
+    heap_sort_ids(w, graph, names, count)
+    used = 0
+    index = 0
+    while index < count:
+        start = get(w, names + index * 8)
+        if get(w, seen + start * 8) == 0:
+            neighbors = heap_neighbors(w, graph, start)
+            if neighbors == 0:
+                return 0
+            put(w, seen + start * 8, 1)
+            put(w, stack, start)
+            put(w, stack + 8, neighbors)
+            put(w, stack + 16, 0)
+            depth = 1
+            while depth != 0:
+                frame = stack + (depth - 1) * 24
+                node = get(w, frame)
+                targets = get(w, frame + 8)
+                cursor = get(w, frame + 16)
+                if cursor == get(w, targets):
+                    put(w, finished + 8 + used * 8, node)
+                    used = used + 1
+                    depth = depth - 1
+                else:
+                    target = get(w, targets + 8 + cursor * 8)
+                    put(w, frame + 16, cursor + 1)
+                    if get(w, seen + target * 8) == 0:
+                        neighbors = heap_neighbors(w, graph, target)
+                        if neighbors == 0:
+                            return 0
+                        put(w, seen + target * 8, 1)
+                        frame = stack + depth * 24
+                        put(w, frame, target)
+                        put(w, frame + 8, neighbors)
+                        put(w, frame + 16, 0)
+                        depth = depth + 1
+        index = index + 1
+    put(w, finished, used)
+    return finished
+
+def heap_components(w:mutbuf, graph:u64) -> u64:
+    count = get(w, graph)
+    reverse = heap_reverse_graph(w, graph)
+    finished = heap_finish_order(w, graph)
+    seen = heap_alloc(w, count * 8)
+    pending = heap_alloc(w, count * 8)
+    members = heap_alloc(w, count * 8)
+    components = heap_alloc(w, 8 + count * 8)
+    if reverse == 0 or finished == 0 or seen == 0 or pending == 0 or members == 0 or components == 0:
+        return 0
+    cursor = get(w, finished)
+    used = 0
+    while cursor != 0:
+        cursor = cursor - 1
+        start = get(w, finished + 8 + cursor * 8)
+        if get(w, seen + start * 8) == 0:
+            put(w, seen + start * 8, 1)
+            put(w, pending, start)
+            tail = 1
+            size = 0
+            while tail != 0:
+                tail = tail - 1
+                node = get(w, pending + tail * 8)
+                put(w, members + size * 8, node)
+                size = size + 1
+                neighbors = heap_neighbors(w, reverse, node)
+                if neighbors == 0:
+                    return 0
+                index = 0
+                while index < get(w, neighbors):
+                    source = get(w, neighbors + 8 + index * 8)
+                    if get(w, seen + source * 8) == 0:
+                        put(w, seen + source * 8, 1)
+                        put(w, pending + tail * 8, source)
+                        tail = tail + 1
+                    index = index + 1
+            component = heap_alloc(w, 8 + size * 8)
+            if component == 0:
+                return 0
+            put(w, component, size)
+            heap_copy(w, component + 8, members, size * 8)
+            heap_sort_ids(w, graph, component + 8, size)
+            put(w, components + 8 + used * 8, component)
+            used = used + 1
+    put(w, components, used)
+    index = 1
+    while index < used:
+        value = get(w, components + 8 + index * 8)
+        at = index
+        going = True
+        while going and at != 0:
+            previous = get(w, components + at * 8)
+            first = heap_name(w, graph, get(w, value + 8))
+            second = heap_name(w, graph, get(w, previous + 8))
+            if heap_text_cmp(w, first, second) != 1:
+                going = False
+            else:
+                put(w, components + 8 + at * 8, previous)
+                at = at - 1
+        put(w, components + 8 + at * 8, value)
+        index = index + 1
+    return components
+
+def heap_map(w:mutbuf) -> u64:
+    return heap_alloc(w, 16)
+
+def heap_map_entry(w:mutbuf, table:u64, key:u64) -> u64:
+    entry = get(w, table)
+    while entry != 0:
+        if same_text(w, get(w, entry + 8), key) != 0:
+            return entry
+        entry = get(w, entry)
+    return 0
+
+def heap_map_get(w:mutbuf, table:u64, key:u64) -> u64:
+    entry = heap_map_entry(w, table, key)
+    if entry == 0:
+        return 18446744073709551615
+    return get(w, entry + 16)
+
+def heap_map_put(w:mutbuf, table:u64, key:u64, value:u64) -> u64:
+    entry = heap_map_entry(w, table, key)
+    if entry == 0:
+        entry = heap_alloc(w, 24)
+        if entry == 0:
+            return 0
+        put(w, entry, get(w, table))
+        put(w, entry + 8, key)
+        put(w, table, entry)
+        put(w, table + 8, get(w, table + 8) + 1)
+    put(w, entry + 16, value)
+    return 1
+
+def heap_map_drop(w:mutbuf, table:u64, key:u64) -> u64:
+    previous = 0
+    entry = get(w, table)
+    while entry != 0:
+        if same_text(w, get(w, entry + 8), key) != 0:
+            if previous == 0:
+                put(w, table, get(w, entry))
+            else:
+                put(w, previous, get(w, entry))
+            put(w, table + 8, get(w, table + 8) - 1)
+            return 1
+        previous = entry
+        entry = get(w, entry)
+    return 0
+
+def heap_map_copy(w:mutbuf, table:u64) -> u64:
+    target = heap_map(w)
+    if target == 0:
+        return 0
+    entry = get(w, table)
+    while entry != 0:
+        if heap_map_put(w, target, get(w, entry + 8), get(w, entry + 16)) == 0:
+            return 0
+        entry = get(w, entry)
+    return target
+'''
diff --git a/tools/hia_native_bigints.py b/tools/hia_native_bigints.py
new file mode 100644
index 0000000..f33e7f2
--- /dev/null
+++ b/tools/hia_native_bigints.py
@@ -0,0 +1,293 @@
+"""Shared HIA sign/magnitude arithmetic for resource-analysis owners.
+
+This is authoring input, never a hosted arithmetic fallback. Callers provide
+the ordinary byte-addressed ``get``/``put`` helpers and an owned ``mutbuf``.
+
+An object occupies ``24 + 8 * capacity`` bytes. Its header is sign (0/1),
+used limb count, and capacity; little-endian base-2**32 limbs follow, each in
+one u64 storage word. Zero has sign=used=0. A nonzero highest limb is required.
+Capacity comes from the caller's actual representation/storage proof; this
+module has no numeric, source-node, bit-width or limb-count quota.
+
+Except big_init/big_valid, arithmetic requires canonical live objects whose
+storage regions do not overlap. Output may be exactly an operand for copy,
+add, sub and shl. Mul requires a distinct output and capacity >= len(a)+len(b)
+for nonzero operands. Every insufficient-capacity or prohibited-alias refusal
+returns zero before changing output. Successful writes return one; comparisons
+return 0 for equal, 1 for less and 2 for greater. Byte export returns one/zero.
+Import reads raw little-endian magnitude bytes already held in the same arena;
+its source range must not overlap the destination object. Export uses a
+separate output buffer. Neither operation applies a decimal-digit policy.
+"""
+
+BODY = r'''
+def big_init(w:mutbuf, out:u64, capacity:u64) -> u64:
+    if out > length(w) or length(w) - out < 24:
+        return 0
+    if capacity > (length(w) - out - 24) // 8:
+        return 0
+    put(w, out, 0)
+    put(w, out + 8, 0)
+    put(w, out + 16, capacity)
+    return 1
+
+def big_valid(w:mutbuf, value:u64) -> u64:
+    if value > length(w) or length(w) - value < 24:
+        return 0
+    count = get(w, value + 8)
+    capacity = get(w, value + 16)
+    if capacity > (length(w) - value - 24) // 8 or count > capacity or get(w, value) > 1:
+        return 0
+    if count == 0:
+        return choose(get(w, value) == 0, 1, 0)
+    if get(w, value + 16 + count * 8) == 0:
+        return 0
+    index = 0
+    while index < count:
+        if get(w, value + 24 + index * 8) > 4294967295:
+            return 0
+        index = index + 1
+    return 1
+
+def big_set_u64(w:mutbuf, out:u64, negative:u64, value:u64) -> u64:
+    count = choose(value == 0, 0, 1)
+    if value > 4294967295:
+        count = 2
+    if negative > 1 or count > get(w, out + 16):
+        return 0
+    if count != 0:
+        put(w, out + 24, value & 4294967295)
+    if count == 2:
+        put(w, out + 32, value >> 32)
+    put(w, out, choose(count == 0, 0, negative))
+    put(w, out + 8, count)
+    return 1
+
+def big_limb(w:mutbuf, value:u64, index:u64) -> u64:
+    if index >= get(w, value + 8):
+        return 0
+    return get(w, value + 24 + index * 8)
+
+def big_copy(w:mutbuf, out:u64, value:u64) -> u64:
+    count = get(w, value + 8)
+    negative = get(w, value)
+    if count > get(w, out + 16):
+        return 0
+    index = 0
+    while index < count:
+        put(w, out + 24 + index * 8, get(w, value + 24 + index * 8))
+        index = index + 1
+    put(w, out, negative)
+    put(w, out + 8, count)
+    return 1
+
+def big_bit_length(w:mutbuf, value:u64) -> u64:
+    count = get(w, value + 8)
+    if count == 0:
+        return 0
+    high = get(w, value + 16 + count * 8)
+    bits = (count - 1) * 32
+    while high != 0:
+        high = high >> 1
+        bits = bits + 1
+    return bits
+
+def big_cmp_abs(w:mutbuf, left:u64, right:u64) -> u64:
+    count = get(w, left + 8)
+    other = get(w, right + 8)
+    if count != other:
+        return choose(count < other, 1, 2)
+    while count != 0:
+        count = count - 1
+        a = big_limb(w, left, count)
+        b = big_limb(w, right, count)
+        if a != b:
+            return choose(a < b, 1, 2)
+    return 0
+
+def big_cmp(w:mutbuf, left:u64, right:u64) -> u64:
+    negative = get(w, left)
+    if negative != get(w, right):
+        return choose(negative != 0, 1, 2)
+    result = big_cmp_abs(w, left, right)
+    if negative != 0 and result != 0:
+        return 3 - result
+    return result
+
+def big_add_abs(w:mutbuf, out:u64, left:u64, right:u64) -> u64:
+    count = choose(get(w, left + 8) > get(w, right + 8), get(w, left + 8), get(w, right + 8))
+    index = 0
+    carry = 0
+    while index < count:
+        value = big_limb(w, left, index) + big_limb(w, right, index) + carry
+        carry = value >> 32
+        index = index + 1
+    used = count + carry
+    if used > get(w, out + 16):
+        return 0
+    index = 0
+    carry = 0
+    while index < count:
+        value = big_limb(w, left, index) + big_limb(w, right, index) + carry
+        put(w, out + 24 + index * 8, value & 4294967295)
+        carry = value >> 32
+        index = index + 1
+    if carry != 0:
+        put(w, out + 24 + count * 8, carry)
+    put(w, out, 0)
+    put(w, out + 8, used)
+    return 1
+
+def big_sub_abs(w:mutbuf, out:u64, left:u64, right:u64) -> u64:
+    if big_cmp_abs(w, left, right) == 1:
+        return 0
+    count = get(w, left + 8)
+    index = 0
+    borrow = 0
+    used = 0
+    while index < count:
+        a = big_limb(w, left, index)
+        b = big_limb(w, right, index) + borrow
+        value = (a - b) & 4294967295
+        borrow = choose(a < b, 1, 0)
+        if value != 0:
+            used = index + 1
+        index = index + 1
+    if used > get(w, out + 16):
+        return 0
+    index = 0
+    borrow = 0
+    while index < used:
+        a = big_limb(w, left, index)
+        b = big_limb(w, right, index) + borrow
+        put(w, out + 24 + index * 8, (a - b) & 4294967295)
+        borrow = choose(a < b, 1, 0)
+        index = index + 1
+    put(w, out, 0)
+    put(w, out + 8, used)
+    return 1
+
+def big_add_signed(w:mutbuf, out:u64, left:u64, right:u64, subtract:u64) -> u64:
+    negative = get(w, left)
+    other = get(w, right) ^ subtract
+    result = 0
+    if negative == other:
+        result = big_add_abs(w, out, left, right)
+    else:
+        order = big_cmp_abs(w, left, right)
+        if order != 1:
+            result = big_sub_abs(w, out, left, right)
+        else:
+            result = big_sub_abs(w, out, right, left)
+            negative = other
+    if result != 0:
+        put(w, out, choose(get(w, out + 8) == 0, 0, negative))
+    return result
+
+def big_add(w:mutbuf, out:u64, left:u64, right:u64) -> u64:
+    return big_add_signed(w, out, left, right, 0)
+
+def big_sub(w:mutbuf, out:u64, left:u64, right:u64) -> u64:
+    return big_add_signed(w, out, left, right, 1)
+
+def big_mul(w:mutbuf, out:u64, left:u64, right:u64) -> u64:
+    if out == left or out == right:
+        return 0
+    a_count = get(w, left + 8)
+    b_count = get(w, right + 8)
+    if a_count == 0 or b_count == 0:
+        return big_set_u64(w, out, 0, 0)
+    if a_count > get(w, out + 16) or b_count > get(w, out + 16) - a_count:
+        return 0
+    count = a_count + b_count
+    index = 0
+    while index < count:
+        put(w, out + 24 + index * 8, 0)
+        index = index + 1
+    index = 0
+    while index < a_count:
+        inner = 0
+        carry = 0
+        while inner < b_count:
+            at = out + 24 + (index + inner) * 8
+            value = big_limb(w, left, index) * big_limb(w, right, inner) + get(w, at) + carry
+            put(w, at, value & 4294967295)
+            carry = value >> 32
+            inner = inner + 1
+        put(w, out + 24 + (index + b_count) * 8, carry)
+        index = index + 1
+    while count != 0 and get(w, out + 16 + count * 8) == 0:
+        count = count - 1
+    put(w, out, choose(count == 0, 0, get(w, left) ^ get(w, right)))
+    put(w, out + 8, count)
+    return 1
+
+def big_shl(w:mutbuf, out:u64, value:u64, amount:u64) -> u64:
+    count = get(w, value + 8)
+    negative = get(w, value)
+    if count == 0:
+        return big_set_u64(w, out, 0, 0)
+    words = amount // 32
+    bits = amount % 32
+    if words > get(w, out + 16) or count > get(w, out + 16) - words:
+        return 0
+    used = count + words
+    if bits != 0 and (big_limb(w, value, count - 1) >> (32 - bits)) != 0:
+        used = used + 1
+    if used > get(w, out + 16):
+        return 0
+    index = used
+    while index != 0:
+        index = index - 1
+        limb = 0
+        if index >= words:
+            limb = (big_limb(w, value, index - words) << bits) & 4294967295
+            if bits != 0 and index > words:
+                limb = limb | (big_limb(w, value, index - words - 1) >> (32 - bits))
+        put(w, out + 24 + index * 8, limb)
+    put(w, out, negative)
+    put(w, out + 8, used)
+    return 1
+
+def big_import_le(w:mutbuf, out:u64, source:u64, count:u64, negative:u64) -> u64:
+    if source > length(w) or count > length(w) - source or negative > 1:
+        return 0
+    if count == 0:
+        if negative != 0:
+            return 0
+        return big_set_u64(w, out, 0, 0)
+    if byte(w, source + count - 1) == 0:
+        return 0
+    used = count // 4 + choose(count % 4 != 0, 1, 0)
+    if used > get(w, out + 16):
+        return 0
+    index = 0
+    while index < used:
+        value = 0
+        inner = 0
+        while inner < 4 and index * 4 + inner < count:
+            value = value | (byte(w, source + index * 4 + inner) << (inner * 8))
+            inner = inner + 1
+        put(w, out + 24 + index * 8, value)
+        index = index + 1
+    put(w, out, negative)
+    put(w, out + 8, used)
+    return 1
+
+def big_byte_length(w:mutbuf, value:u64) -> u64:
+    bits = big_bit_length(w, value)
+    return bits // 8 + choose(bits % 8 != 0, 1, 0)
+
+def big_byte(w:mutbuf, value:u64, index:u64) -> u64:
+    return (big_limb(w, value, index // 4) >> ((index % 4) * 8)) & 255
+
+def big_export_le(w:mutbuf, value:u64, out:mutbuf, at:u64, extent:u64) -> u64:
+    count = big_byte_length(w, value)
+    if at > length(out) or extent > length(out) - at or count > extent:
+        return 0
+    index = 0
+    while index < count:
+        store(out, at + index, big_byte(w, value, index))
+        index = index + 1
+    return 1
+'''
