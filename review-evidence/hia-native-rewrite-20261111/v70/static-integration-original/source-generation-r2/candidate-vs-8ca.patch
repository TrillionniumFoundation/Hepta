+            (['exit', 'cycle-z', 'cycle-a', 'entry'], [[3, 1], [1, 2], [2, 1], [2, 0]]),
+            (['中', '\ud800', '\ue000', 'a', '😀', ''], [[3, 0], [0, 4]])]:
+            self.compare(names, edges, vm=len(names) <= 4)
