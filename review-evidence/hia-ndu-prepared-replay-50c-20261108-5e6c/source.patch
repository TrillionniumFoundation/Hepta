+class PreparedRankingReplayAnalysisTests(unittest.TestCase):
+    def fixture(self):
+        cells, analysis = [], []
+        # Hand-specified differences include losses, a tie and gains. Their
+        # six-value mean/median is -0.5, sample variance 3.5, with two wins.
+        for horizon in (1, 4, 16, 64):
+            pairs = []
+            for pair, difference in enumerate((-3, -2, -1, 0, 1, 2), 1):
+                base = 100 * horizon + pair
+                costs = {"one_shot_ndu": base + difference * horizon,
+                         "prepared_ndu": base,
+                         "ordinary_scalar": base - (10 + pair) * horizon}
+                for arm, cost in costs.items():
+                    cells.append({"horizon": horizon, "pair": pair, "arm": arm,
+                                  "status": "completed", "completed_calls": horizon,
+                                  "wall_ns": cost})
+                pairs.append({"pair": pair, "complete": True, "all_attempt_arm_wall_ns": costs,
+                              "one_shot_minus_prepared_ns": difference * horizon,
+                              "ordinary_minus_prepared_ns": -(10 + pair) * horizon})
+            analysis.append({"horizon": horizon, "all_registered_cells_completed": True,
+                             "pairs": pairs, "prepared_saving_summary_ns": {
+                                 "observations": 6, "sum": -3 * horizon,
+                                 "mean": -0.5 if horizon == 1 else -(horizon // 2),
+                                 "median": -0.5 * horizon, "min": -3 * horizon, "max": 2 * horizon,
+                                 "sample_stdev": 1.8708286933869707 * horizon, "positive_pairs": 2}})
+        return cells, analysis
+
+    def test_negative_zero_and_positive_pairs_keep_the_exact_denominator(self):
+        prepared_replay.check_analysis(*self.fixture())
+
+    def test_original_review_counterexample_is_refused(self):
+        cells, analysis = self.fixture()
+        analysis[0]["pairs"][0]["one_shot_minus_prepared_ns"] = -999999999999999999
+        analysis[0]["prepared_saving_summary_ns"]["sum"] = -999999999999999999
+        with self.assertRaisesRegex(ValueError, "reported paired analysis"):
+            prepared_replay.check_analysis(cells, analysis)
+
+    def test_every_reported_pair_cost_difference_and_completion_is_checked(self):
+        cells, original = self.fixture()
+        for horizon in range(4):
+            for pair in range(6):
+                for field in ("one_shot_minus_prepared_ns", "ordinary_minus_prepared_ns", "complete",
+                              "one_shot_ndu", "prepared_ndu", "ordinary_scalar"):
+                    changed = deepcopy(original)
+                    row = changed[horizon]["pairs"][pair]
+                    if field in row["all_attempt_arm_wall_ns"]:
+                        row["all_attempt_arm_wall_ns"][field] += 1
+                    elif field == "complete":
+                        row[field] = False
+                    else:
+                        row[field] += 1
+                    with self.subTest(horizon=horizon, pair=pair, field=field), \
+                            self.assertRaisesRegex(ValueError, "reported paired analysis"):
+                        prepared_replay.check_analysis(cells, changed)
+
+    def test_every_summary_statistic_is_recomputed(self):
+        cells, original = self.fixture()
+        for horizon in range(4):
+            for field in original[horizon]["prepared_saving_summary_ns"]:
+                changed = deepcopy(original)
+                changed[horizon]["prepared_saving_summary_ns"][field] += 1
+                with self.subTest(horizon=horizon, field=field), \
+                        self.assertRaisesRegex(ValueError, "reported paired analysis"):
+                    prepared_replay.check_analysis(cells, changed)
+
+    def test_missing_extra_reordered_or_relabelled_report_structure_is_refused(self):
+        cells, original = self.fixture()
+        for mutation in range(10):
+            changed = deepcopy(original)
+            if mutation == 0:
+                changed.pop()
+            elif mutation == 1:
+                changed.append(deepcopy(changed[-1]))
+            elif mutation == 2:
+                changed.reverse()
+            elif mutation == 3:
+                changed[0]["pairs"].pop()
+            elif mutation == 4:
+                changed[0]["pairs"].append(deepcopy(changed[0]["pairs"][-1]))
+            elif mutation == 5:
+                changed[0]["pairs"].reverse()
+            elif mutation == 6:
+                del changed[0]["prepared_saving_summary_ns"]["min"]
+            elif mutation == 7:
+                changed[0]["prepared_saving_summary_ns"]["unregistered"] = 0
+            elif mutation == 8:
+                changed[0]["pairs"][0]["pair"] = 2
+            else:
+                changed[0]["all_registered_cells_completed"] = False
+            with self.subTest(mutation=mutation), self.assertRaisesRegex(ValueError, "reported paired analysis"):
+                prepared_replay.check_analysis(cells, changed)
+
+    def test_equal_python_boolean_and_float_coercions_do_not_pass_json_identity(self):
