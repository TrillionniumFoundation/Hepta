        "text": "\"\"\"Pinned support and source identities for the bounded native HIA compiler.\n\nThe contract is generated from checked-in source bytes. It is an input identity\nand a support declaration, not a successful execution or correctness receipt.\n\"\"\"\nfrom __future__ import annotations\n\nfrom hashlib import sha256\nimport json\nimport io\nimport warnings\nimport types as _source_types\nimport pathlib as _source_pathlib\nimport io as _source_io\nfrom pathlib import Path\nfrom tools.hia_selfhost_limits import (MAX_INSTRUCTIONS, MAX_CORE_NODES,\n    MAX_FUNCTIONS, MAX_BLOCKS, MAX_RELOCATIONS, RELOCATION_UPPER_BOUND, CORE_BYTES_UPPER_BOUND)\n\nROOT = Path(__file__).resolve().parents[1]\nCONTRACT_PATH = \"docs/HIA_SELFHOST_CORE_SUPPORT.json\"\nPROFILE = 'selfhost-core-linux-x86_64-v93-merged-native-development-pending'\nSOURCE_FILES = (\n    \"docs/HIA_WORKER_SCHEDULING_CUSTODY.md\",\n    \"tools/build_hia_worker_scheduling_bundle.py\",\n    \"tests/test_hia_worker_scheduling_bundle.py\",\n    \"docs/HIA_NATIVE_CONTINUATION_DEVELOPMENT.md\",\n    \"docs/HIA_NATIVE_CONTINUATION_ABI.json\",\n    \"tests/test_hia_continuation_native.py\",\n    \"tests/test_hia_installed_fixture_resources.py\",\n    \"tools/generate_hia_continuation.py\",\n    \"tools/hia_continuation_syscalls.S\",\n    \"tools/hia_continuation_inprocess.S\",\n    \"tools/qualify_hia_continuation_no_child.py\",\n    \"examples/hia_bootstrap/continuation_inprocess_packer.hepta\",\n    \"tools/build_hia_native_continuation.py\",\n    \"tools/hia_continuation_pack_child.py\",\n    \"examples/hia_bootstrap/continuation_policy.hepta\",\n    \"examples/hia_bootstrap/continuation_packer.hepta\",\n    \"docs/HIA_EXECUTION_OBSERVATION_NATIVE.md\",\n    \"docs/HIA_EXECUTION_OBSERVATION_ABI.json\",\n    \"tests/test_hia_execution_observation_native.py\",\n    \"tests/fixtures/hia_opcodes_99d6567.py.txt\",\n    \"tools/hia_execution_observation_policy.py\",\n    \"tools/hia_execution_observation_ir.py\"