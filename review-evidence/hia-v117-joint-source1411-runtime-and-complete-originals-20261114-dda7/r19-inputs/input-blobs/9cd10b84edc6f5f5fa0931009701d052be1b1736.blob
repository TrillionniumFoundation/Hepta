borator_replaced': False,\n            'whole_native_delivery_qualified': False,\n        },\n        'native_slot_ledger_continuation': {\n            'source': 'examples/hia_bootstrap/slot_ledger_continuation.hepta',\n            'selection': 'explicit HEPTA_HIA_SLOT_LEDGER_CONTINUATION_MANIFEST with admitted namespace and request owners',\n            'integration_status': 'PENDING_MATCHING_SOURCE_COLD_AND_COMPLETE_CALLER_QUALIFICATION',\n            'native_owners': ['slot observation and generation/epoch CAS',\n                              'first baseline and maximum retained generation',\n                              'rollback and reusable active lease admission/release',\n                              'exact effect preclaims, readback and namespace commit certificate',\n                              'direct slot snapshot, acquisition, lease admission and release',\n                              'opaque original objects, short-circuit comparisons and consumed temporary lifetimes'],\n            'durable_state': 'original main.slots, main.versions and main.leases; original database and WAL',\n            'borrowed_request_commit': False,\n            'store_lock_held_across_child': False,\n            'original_reference_bodies_retained': True,\n            'direct_api_transport': 'original Python and SQLite objects are held by operation-local identities; no slot-length cap, coercion or adapter-result cache',\n            'direct_api_lifetime': 'HIA consumes temporary operands and row scopes at the original expression boundary; completed diagnostics retain no foreign object or traceback',\n            'original_failures_retained': ['69e direct long-slot refusal', '84d temporary comparison lifetime changed public release',\n                                           'remote original 48-test caller failures remain separate'],\n            'pre_merge_development_checkpoint': '66681872 product and tests; 24 scoped native plus 9 independent source/VM controls, not matching-source cold or whole qualification',\n            'arbitrary_direct_input_equivalence_qualified': False,\n            'default_changed': False,\n            'old_host_owners_removed': False,\n            'whole_native_delivery_qualified': False,\n            'builder': 'tools/build_hia_slot_ledger_continuation.py',\n            'main_slot_ledger_protocol_preserved_separately': True,\n            'simultaneous_main_and_continuation_selection': 'refuse before owner admission',\n        },\n        'native_machine_plan_control': {\n            'source': 'examples/hia_bootstrap/machine_plan_control.hepta',\n            'manifest_schema': 'hepta.hia.machine-plan-control-native.v1',\n            'builder': 'tools/build_hia_machine_plan_control.py',\n            'selection': 'explicit HEPTA_HIA_MACHINE_PLAN_CONTROL_MANIFEST',\n            'original_main_witness_selector_preserved': 'HEPTA_HIA_MACHINE_PLAN_MANIFEST',\n            'simultaneous_family_selection': 'refuse before owner admission',\n            'integration_status': 'PENDING_MATCHING_SOURCE_COLD_AND_COMPLETE_CALLER_QUALIFICATION',\n            'default_changed': False,\n            'old_host_owners_removed': False,\n            'whole_native_delivery_qualified': False,\n        },\n        'native_backend_bundle_protocols': {\n            'original_main_families': {\n                'core_lowering': 'HEPTA_HIA_CORE_LOWERING_MANIFEST',\n                'core_emitter': 'HEPTA_HIA_CORE_EMITTER_MANIFEST',\n                'byte_wrapper': 'HEPTA_HIA_BYTE_WRAPPER_MANIFEST',\n                'machine_object': 'HEPTA_HIA_MACHINE_OBJECT_MANIFEST',\n                'execution_observation': 'HEPTA_HIA_EXECUTION_OBSERVATION_MANIFEST',\n            },\n            'custody': 'original source-bound bundle, immutable unit images and actual mapped pool capabilities',\n            'scheduling_and_continuation': 'preserve original main pinned bundle and scheduling scopes',\n            'independent_single_image_control_families': True,\n            'simultaneous_competing_family_selection': 'refuse before manifest or executable admission',\n            'whole_emission_absence_is_captured': True,\n            'original_reference_bodies_retained': True,\n            'integration_status': 'PENDING_MATCHING_SOURCE_COLD_AND_COMPLETE_NATIVE_QUALIFICATION',\n            'default_changed': False,\n            'old_host_owners_removed': False,\n            'whole_native_delivery_qualified': False,\n        },\n    }\n\n\ndef validate_contract(root=ROOT):\n    root = Path(root)\n    path = root / CONTRACT_PATH\n    declared = json.loads(path.read_text())\n    expected = support_contract(root)\n    if declared != expected:\n        raise ValueError(\"Selfhost-Core support contract differs from the current source closure\")\n    return declared\n"
      },
      "before": {
        "bytes": 204836,
        "git_blob": "8fa1577270bf6e0765ea0a10b68ff8a7dccb3c02",
        "mode": "100644",
        "sha256": "561c61be8958f0c1fe092f1d891caf971c025dda56015adf431588acad2159e1"
