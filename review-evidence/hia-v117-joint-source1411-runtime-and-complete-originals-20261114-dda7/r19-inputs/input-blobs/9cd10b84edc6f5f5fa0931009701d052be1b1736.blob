        "sha256": "eabe7d9ea3247b85c91b7905cb2a29ee948746a326d0937b688502cbbd387f9a",
        "text": "\"\"\"Current-source cold custody for the explicit bounded roundtrip profile.\n\nThe original complete cold source domain is retained. The optional five-asset\nprofile is additionally read through its own versioned resource inventory; it\ndoes not enlarge any default worker resource role. Frozen test observations,\ndevelopment compiler pins and serialized fixture dictionaries grant no cold\nauthority. Every public admission performs the original fresh checks.\n\"\"\"\nfrom __future__ import annotations\n\nimport base64\nfrom hashlib import sha256\nfrom pathlib import Path\nimport stat\nimport zlib\nimport os\nimport sys\nimport sysconfig\n\nfrom hepta.hia_linux_file_roundtrip import PROFILE, PROFILE_SOURCE_FILES\nfrom tools import hia_linux_stdio_cold as original\n\nROOT = Path(__file__).resolve().parents[1]\nCAPACITY = 1048576\nAUTHORITY_SCHEMA = 'hepta.hia.linux-file-roundtrip-current-cold-inputs.v1'\nCOMPILER_SOURCE, PACKER_SOURCE, CONTROLLER_SOURCE, REPRESENTATION_SOURCE, SEMANTIC_SOURCE = PROFILE_SOURCE_FILES\nORDINARY_SOURCE = original.ORDINARY_SOURCE\nRETAINED = 'tests/fixtures/hia_linux_file_roundtrip_retained.zlib.json'\nRETAINED_SHA256 = '46030d20ec9431b76af4a551e489da5d508d6c8c31d70978cf9dc8a24d649323'\nRETAINED_LOGICAL_SHA256 = 'bd2557ea678fd2e010e2ca3f1b462ce5a60a06d8db1cae37a6a8fd725b821c2a'\nRETAINED_LOGICAL_BYTES = 3311433\nKNOWN_SEPARATE_SEMANTIC_SUITE = {'addendum_git_blob': '23613b922b93db45f7023f031e583a1beef763dc', 'development_image_sha256': '47c710c755c8eb5fb351190a057ccc5fd754c3124501474a602c2ff2d137474a', 'failed': 1, 'failed_case': 'root-v8-cross-target-loans', 'fuel_limit': 10000000, 'logical_vm_cases': 6, 'passed': 5, 'reports_git_blob': '5a6db721b5b19c158884a8fee71c5c84a01ef2c4', 'source_sha256': '2fbedf12008851e7f428fbc60fed144c0d0ebd99d7cc93e004058a8d5e375aa9', 'status': 'ORIGINAL_FUEL_FAILURE_RETAINED_NOT_RECLASSIFIED', 'this_pipeline_seven_is_a_distinct_fixed_group': True}\nOWN_SOURCES = (\n    *PROFILE_SOURCE_FILES,\n    'hepta/hia_optional_profiles.py', 'hepta/hia_linux_file_roundtrip.py',\n    'hepta/hia_linux_file.py', 'hepta/hia_linux_file_render.py',\n    'hepta/hia_linux_process.py', 'hepta/hia_linux_stdio.py',\n    'tools/build_hia_linux_file_roundtrip_program.py',\n    'tools/generate_hia_selfhost_linux_file_roundtrip.py',\n    'tools/generate_hia_linux_file_roundtrip_entry.py',\n    'tools/generate_hia_linux_file_render_entry.py',\n    'tools/generate_hia_linux_file_entry.py',\n    'tools/generate_hia_native_file_roundtrip.py',\n    'tools/generate_hia_core_representation_private.py',\n    'tools/generate_hia_file_render_checker_v4.py',\n    'tools/hia_linux_file_roundtrip_cold.py',\n    'tools/build_hia_linux_file_roundtrip_cold.py',\n    'tools/qualify_hia_linux_file_roundtrip.py',\n    'tools/hia_linux_file_roundtrip_readback.py',\n    'tests/hia_linux_file_roundtrip_cases.py',\n    'tests/hia_linux_file_roundtrip_ids.py',\n    'tests/hia_linux_file_roundtrip_observer.py',\n    'tests/hia_linux_file_roundtrip_exec.py',\n    'tests/hia_linux_file_roundtrip_portable.py',\n    'tests/hia_linux_file_roundtrip_installed.py',\n    'tests/test_hia_linux_file_roundtrip_cold.py',\n    'tests/test_hia_linux_file_roundtrip_source.py',\n    'tests/hia_linux_process_cases.py',\n    'tests/test_hia_agent_installed_resources.py',\n    RETAINED, 'docs/HIA_LINUX_FILE_ROUNDTRIP_COLD.md',\n    'setup.py', 'pyproject.toml', 'MANIFEST.in',\n)\nREQUIRED_SOURCES = tuple(dict.fromkeys((*original.REQUIRED_SOURCES, *OWN_SOURCES)))\nrequire = original.require\ndecode = original.decode\nwire = original.wire\npublish = original.publish\npin = original.pin\ncheck_bindings = original.check_bindings\nobservation = original.observation\ncapture = original.capture\ndigest = original.digest\n\n\ndef _runtime_stat_identity(value):\n    return (value.st_dev, value.st_ino, value.st_mode, value.st_size,\n            value.st_mtime_ns, value.st_ctime_ns)\n\n\ndef _runtime_file(path):\n    \"\"\"Read an ordinary runtime file and bind descriptor/path identity.\"\"\"\n    path = Path(path)\n    require(path.is_absolute(), 'runtime file must be absolute')\n    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK)\n    try:\n        before = os.fstat(descriptor)\n        require(stat.S_ISREG(before.st_mode) and before.st_size > 0,\n                'runtime file must be nonempty and ordinary')\n        require(_runtime_stat_identity(path.lstat()) == _runtime_stat_identity(before),\n                'runtime named file differs from actual descriptor')\n        parts = []\n        remaining = before.st_size + 1\n        while remaining:\n            part = os.read(descriptor, min(1048576, remaining))\n            if not part:\n                break\n            parts.append(part)\n            remaining -= len(part)\n        raw = b''.join(parts)\n        after = os.fstat(descriptor)\n        require(_runtime_stat_identity(before) == _runtime_stat_identity(after)\n                == _runtime_stat_identity(path.lstat()) and len(raw) == before.st_size,\n                'runtime file changed during actual read')\n    finally:\n        os.close(descriptor)\n    return {'path': str(path), 'bytes': len(raw), 'sha256': digest(raw),\n            'mode': stat.S_IMODE(before.st_mode), 'device': before.st_dev,\n            'inode': before.st_ino, 'mtime_ns': before.st_mtime_ns, 'ctime_ns': before.st_ctime_ns}\n\n\ndef _runtime_library_mappings(raw, expected_names):\n    \"\"\"Read only actual libpython map identities; addresses are not authority.\"\"\"\n    require(type(raw) is bytes and type(expected_names) is tuple,\n            'actual runtime mapping bytes and exact library names required')\n    rows = []\n    for line in raw.splitlines():\n        fields = line.split(maxsplit=5)\n        if len(fields) != 6:\n            continue\n        encoded = fields[5]\n        name = os.fsdecode(encoded).removesuffix(' (deleted)').rsplit('/', 1)[-1]\n        if not name.startswith('libpython'):\n            continue\n        require(not encoded.endswith(b' (deleted)') and encoded.startswith(b'/')\n                and b'\\\\' not in encoded and b'\\0' not in encoded,\n                'deleted, relative or ambiguous runtime library mapping refused')\n        path = Path(os.fsdecode(encoded))\n        require(path.name in expected_names, 'mapped libpython does not match actual sysconfig names')\n        device = fields[3].split(b':')\n        require(len(device) == 2, 'complete runtime map device required')\n        rows.append({'path': str(path), 'major': int(device[0], 16),\n                     'minor': int(device[1], 16), 'inode': int(fields[4]),\n                     'executable': b'x' in fields[1]})\n    return rows\n\n\ndef capture_runtime_context():\n    \"\"\"Bind this running interpreter and its actual necessary shared library.\n\n    The original venv invocation path is retained. No ambient LD_LIBRARY_PATH\n    or LD_PRELOAD value is read. A statically linked interpreter is recognized\n    only by explicit sysconfig=0 plus the absence of any libpython mapping.\n    This is launch evidence, not a replacement for current-cold authority.\n    \"\"\"\n    require(sys.platform == 'linux' and type(sys.executable) is str\n            and Path(sys.executable).is_absolute(), 'actual absolute Linux interpreter required')\n    invocation = sys.executable\n    executable_path = Path(invocation).resolve(strict=True)\n    current_exe = os.readlink('/proc/self/exe')\n    require(not current_exe.endswith(' (deleted)') and Path(current_exe).is_absolute()\n            and Path(current_exe) == executable_path,\n            'selected interpreter differs from the actually running executable')\n    config = {name: sysconfig.get_config_var(name)\n              for name in ('Py_ENABLE_SHARED', 'LDLIBRARY', 'INSTSONAME')}\n    require(type(config['Py_ENABLE_SHARED']) is int and config['Py_ENABLE_SHARED'] in (0, 1),\n            'explicit actual interpreter linkage required')\n    names = tuple(dict.fromkeys(value for value in (config['LDLIBRARY'], config['INSTSONAME'])\n                                if type(value) is str and value))\n    require(names and all(Path(name).name == name and name.startswith('libpython') for name in names),\n            'actual sysconfig libpython names required')\n    rows = _runtime_library_mappings(Path('/proc/self/maps').read_bytes(), names)\n    executable = _runtime_file(executable_path)\n    require((os.stat('/proc/self/exe').st_dev, os.stat('/proc/self/exe').st_ino)\n            == (executable['device'], executable['inode']),\n            'actual executable mapping differs from named interpreter bytes')\n    library = None\n    if config['Py_ENABLE_SHARED'] == 1:\n        keys = {(row['path'], row['major'], row['minor'], row['inode']) for row in rows}\n        require(len(keys) == 1 and any(row['executable'] for row in rows),\n                'exactly one actual executable libpython mapping required')\n        library = _runtime_file(rows[0]['path'])\n        require(all((row['major'], row['minor'], row['inode']) ==\n                    (os.major(library['device']), os.minor(library['device']), library['inode'])\n                    for row in rows), 'actual libpython mapping and named bytes differ')\n    else:\n        require(not rows, 'static interpreter unexpectedly maps libpython')\n    require(Path(invocation).resolve(strict=True) == executable_path\n            and os.readlink('/proc/self/exe') == current_exe,\n            'interpreter invocation changed during runtime capture')\n    return {'schema': 'hepta.hia.roundtrip-runtime-launch-context.v1',\n            'launch_executable': invocation, 'executable': executable,\n            'python': sys.version, 'version': list(sys.version_info[:3]),\n            'prefix': sys.prefix, 'base_prefix': sys.base_prefix,\n            'sysconfig': config, 'library': library,\n            'library_directory': None if library is None else str(Path(library['path']).parent)}\n\n\ndef guard_runtime_context(context):\n    fresh = capture_runtime_context()\n    require(type(context) is dict and fresh == context,\n            'actual interpreter or libpython changed from the frozen launch context')\n    return fresh\n\n\ndef runtime_child_environment(base, context):\n    require(type(base) is dict and all(type(k) is str and type(v) is str for k, v in base.items())\n            and 'LD_LIBRARY_PATH' not in base and 'LD_PRELOAD' not in base,\n            'fixed original child environment required; ambient loader values refused')\n    current = guard_runtime_context(context)\n    result = dict(base)\n    if current['library_directory'] is not None:\n        result['LD_LIBRARY_PATH'] = current['library_directory']\n    return result\n\n\ndef retained():\n    raw = (ROOT / RETAINED).read_bytes()\n    require(digest(raw) == RETAINED_SHA256, 'complete original roundtrip fixture changed')\n    wrapper = decode(raw)\n    require(type(wrapper) is dict and set(wrapper) == {'schema', 'logical', 'zlib_base64'}\n            and wrapper['schema'] == 'hepta.hia.retained-zlib.v1'\n            and type(wrapper['logical']) is dict\n            and type(wrapper['logical'].get('bytes')) is int\n            and wrapper['logical']['bytes'] == RETAINED_LOGICAL_BYTES\n            and wrapper['logical'].get('sha256') == RETAINED_LOGICAL_SHA256,\n            'fixed complete retained wrapper required')\n    compressed = base64.b64decode(wrapper['zlib_base64'], validate=True)\n    stream = zlib.decompressobj()\n    logical = stream.decompress(compressed, RETAINED_LOGICAL_BYTES + 1)\n    require(stream.eof and not stream.unconsumed_tail and not stream.unused_data\n            and len(logical) == RETAINED_LOGICAL_BYTES\n            and digest(logical) == RETAINED_LOGICAL_SHA256,\n            'complete retained fixture extent or bytes differ')\n    value = decode(logical)\n    require(value.get('schema') == 'hepta.hia.linux-file-roundtrip-retained-controls.v1'\n            and value.get('scope') == 'ORIGINAL_INPUTS_AND_OBSERVATIONS_NOT_CURRENT_QUALIFICATION'\n            and value.get('matching_cold') is False and value.get('whole_native') is False,\n            'original observations are not current cold qualification')\n    require(value.get('known_separate_semantic_suite') == KNOWN_SEPARATE_SEMANTIC_SUITE,\n            'original separate semantic fuel failure changed or disappeared')\n    cases = value.get('kernel_cases')\n    require(type(cases) is list and len(cases) == 130\n            and len({row['name'] for row in cases}) == 130,\n            'all original 130 ordered kernel controls required')\n    for row in cases:\n        for key in ('input', 'stdout', 'stderr'):\n            retained_bytes(row[key])\n        require(type(row['declared']['expected']) is int\n                and row['declared']['name'] == row['original_observation']['name'] == row['name']\n                and row['original_observation']['pass'] is True,\n                'original control identity or outcome changed')\n    return value\n\n\ndef retained_bytes(row):\n    require(type(row) is dict and type(row.get('bytes')) is int\n            and type(row.get('base64')) is str, 'exact retained byte record required')\n    raw = base64.b64decode(row['base64'], validate=True)\n    require(len(raw) == row['bytes'] and digest(raw) == row['sha256'],\n            'retained bytes differ from original identity')\n    return raw\n\n\ndef profile_capture(profile=PROFILE, *, resource_root=None):\n    \"\"\"Return the bytes from one safe capture; do not reopen their paths.\n\n    The returned dictionary is source data, not cold or execution authority.\n    The final guard remains a fresh read of the entire explicit profile.\n    \"\"\"\n    from hepta.hia_optional_profiles import (\n        OPTIONAL_PROFILE_FILES, fresh_profile_capture, guard_profile_identity,\n    )\n    root = ROOT if resource_root is None else Path(resource_root)\n    require(type(profile) is str and profile in OPTIONAL_PROFILE_FILES,\n            'exact declared optional profile required')\n    names = OPTIONAL_PROFILE_FILES[profile]\n    if profile == PROFILE:\n        require(tuple(names) == PROFILE_SOURCE_FILES,\n                'explicit roundtrip profile requires its exact five resources')\n    observed, captures = fresh_profile_capture(profile, resource_root=root)\n    require(type(observed) is dict and observed.get('profile') == profile\n            and type(observed.get('files')) is dict and set(observed['files']) == set(names)\n            and type(captures) is dict and set(captures) == set(names),\n            'complete current profile capture required')\n    for name in names:\n        raw = captures[name]\n        require(type(raw) is bytes and observed['files'][name] == {\n            'bytes': len(raw), 'sha256': digest(raw)},\n            'captured profile bytes differ from the actual safe-read identity: ' + name)\n    guard_profile_identity(profile, observed, resource_root=root)\n    return observed, captures\n\n\ndef profile_identity():\n    return profile_capture()[0]\n\n\ndef captured_source_binding(path, raw):\n    \"\"\"Record captured bytes plus a non-opening path-mode observation.\n\n    Mode is explicitly observed by lstat after capture; this metadata helper\n    grants no cold authority and never reopens the source content.\n    \"\"\"\n    path = Path(path).absolute()\n    observed = path.lstat()\n    require(type(raw) is bytes and stat.S_ISREG(observed.st_mode),\n            'regular captured source with immutable bytes required')\n    return {'path': str(path), 'bytes': len(raw), 'sha256': digest(raw),\n            'mode': stat.S_IMODE(observed.st_mode)}\n\n\ndef admit_required_sources(sources):\n    other_names = tuple(name for name in REQUIRED_SOURCES if name not in PROFILE_SOURCE_FILES)\n    original.admit_required_sources(sources, root=ROOT, names=other_names)\n    _, captures = profile_capture()\n    for name in PROFILE_SOURCE_FILES:\n        require(name in sources, 'roundtrip input missing from cold source map: ' + name)\n        require(sources[name] == digest(captures[name]),\n                'roundtrip captured input differs from cold source map: ' + name)\n\n\ndef admit_cold(cold_report, *, compiler=None):\n    authority = original.admit_cold(cold_report, compiler=compiler)\n    admit_required_sources(authority['source_manifest'])\n    # The original authority already bound the actual outer/nested reports and\n    # B1/B2/B3. No fixture boolean or caller digest can substitute for it.\n    authority = {**authority, 'schema': AUTHORITY_SCHEMA, 'physical_profile': PROFILE,\n                 'optional_profile': profile_identity()}\n    guard_authority(authority)\n    return authority\n\n\ndef guard_authority(authority):\n    require(type(authority) is dict and authority.get('schema') == AUTHORITY_SCHEMA\n            and authority.get('physical_profile') == PROFILE,\n            'explicit current-cold roundtrip authority required')\n    original.guard_authority(authority)\n    admit_required_sources(authority['source_manifest'])\n    require(profile_identity() == authority['optional_profile'],\n            'roundtrip optional profile changed during qualification')\n\n\ndef re_admit_authority(authority):\n    require(type(authority) is dict and authority.get('schema') == AUTHORITY_SCHEMA\n            and authority.get('physical_profile') == PROFILE,\n            'development or serialized fixture is not cold authority')\n    fresh = admit_cold(authority['cold_report'], compiler=authority['compiler'])\n    require(fresh == authority, 'fixture differs from fresh original cold authority')\n    return fresh\n\n\ndef compile_bound(folder, label, provider, payload, authority, *, extension='.image.bin'):\n    from tools.qualify_hia_selfhost import compile_stage\n    guard_authority(authority)\n    before = Path(provider).read_bytes()\n    path, returned = compile_stage(Path(folder), label, Path(provider), payload,\n                                   output_extension=extension)\n    actual_path, produced, observed = observation(folder, label, provider, payload, extension=extension)\n    require(path == actual_path and returned == observed and Path(provider).read_bytes() == before,\n            'actual roundtrip compile request/receipt/provider changed: ' + label)\n    guard_authority(authority)\n    return path, produced, observed\n\n\ndef all_files(folder, exclude=()):\n    folder = Path(folder)\n    return [pin(path) for path in sorted(folder.rglob('*'))\n            if path.is_file() and path.relative_to(folder).as_posix() not in exclude]\n\n\ndef owner_pass(owner):\n    return (type(owner) is dict and owner.get('schema') == 'hepta.hia.selfhost-process-owner.v1'\n        and owner.get('status') == 'OWNED_PROCESS_COMPLETED'\n        and type(owner.get('returncode')) is int and owner['returncode'] == 0\n        and type(owner.get('qualification_seconds')) is int and owner['qualification_seconds'] == 180\n        and type(owner.get('cleanup_seconds')) is int and owner['cleanup_seconds'] == 3\n        and owner.get('timed_out') is False and owner.get('exit_observed_before_deadline') is True\n        and type(owner.get('cleanup')) is dict and owner['cleanup'].get('complete') is True\n        and owner['cleanup'].get('observed_echild') is True)\n"
      },
      "before": null,
      "path": "tools/hia_linux_file_roundtrip_cold.py"
    },
    {
      "after": {
        "bytes": 19319,
        "git_blob": "1b934714eec112e5366940331a9ae3cc505cf3a2",
        "mode": "100644",
        "sha256": "ac6244f0654df93cc7eec65a7d1fc83ff7aa6a9b0072fc6ac67ce172afa881d9",
        "text": "\"\"\"Independent raw-record readback for the bounded roundtrip qualifier.\n\nThese functions do not execute a payload or produce observed buffers. They\nre-read the actual requests, full compile observations, kernel output files,\ncomplete VM frames, fixed original inputs and final cold/source bindings.\nA comparison boolean or a serialized fixture never substitutes for those.\n\"\"\"\nfrom pathlib import Path\nimport os\nimport struct\nimport sys\n\nfrom tools.hia_linux_file_roundtrip_cold import (\n    ROOT, PROFILE, CAPACITY, REPRESENTATION_SOURCE, SEMANTIC_SOURCE,\n    require, decode, digest, wire, pin, check_bindings, retained_bytes, observation, profile_capture,\n)\n\nLIMITS = {'wall': 20, 'cleanup': 3, 'cpu': 10, 'address': 256 << 20,\n          'stack': 8 << 20, 'filesize': 16 << 20, 'fds': 32, 'core': 0}\nEXTENTS = {'file': 8388609, 'output': CAPACITY, 'workspace': CAPACITY}\n\n\ndef actual_kernel(folder, executable, argv, *, observer=False):\n    folder, executable = Path(folder), Path(executable)\n    actual = decode((folder / 'OBSERVATION.json').read_bytes())\n    request = decode((folder / 'EXEC-REQUEST.json').read_bytes())\n    expected = {'elf': str(executable.resolve()), 'elf_sha256': digest(executable.read_bytes()),\n        'argv_hex': [value.hex() for value in argv],\n        'environment_hex': [b'LC_ALL=C.UTF-8'.hex()],\n        'exec_failure': str((folder / 'EXEC-FAILURE.json').resolve())}\n    if observer:\n        expected['observations'] = {name: {'fd': 29 + index, 'extent': length,\n            'path': str((folder / (name + '.bin')).resolve())}\n            for index, (name, length) in enumerate(EXTENTS.items())}\n        module = 'hia_linux_file_roundtrip_exec.py'\n    else:\n        expected.update(sigpipe_ignored=False, close_fds=[])\n        module = 'hia_linux_process_cases.py'\n    command = [sys.executable, '-I', '-S', '-B', str((ROOT / 'tests' / module).resolve()),\n               '--raw-exec', str((folder / 'EXEC-REQUEST.json').resolve())]\n    require(wire(request) == wire(expected) and actual.get('command') == command\n            and actual.get('payload') == expected['elf']\n            and actual.get('image_sha256') == actual.get('image_after_sha256') == expected['elf_sha256']\n            and actual.get('limits') == LIMITS and all(type(v) is int for v in actual['limits'].values())\n            and actual.get('timed_out') is False and actual.get('reaped_ECHILD') is True\n            and actual.get('preexec_python_ctypes') is True\n            and actual.get('runtime_payload_python_or_ctypes') is False\n            and type(actual.get('returncode')) is int and actual.get('stdin_consumed') == 0\n            and type(actual.get('stdin_consumed')) is int\n            and (folder / 'stdin.bin').read_bytes() == b''\n            and actual.get('stdout_hex') == (folder / 'stdout.bin').read_bytes().hex()\n            and actual.get('stderr_hex') == (folder / 'stderr.bin').read_bytes().hex()\n            and actual.get('exec_failure') is None and not (folder / 'EXEC-FAILURE.json').exists(),\n            'actual complete kernel request/output/cleanup differs: ' + str(folder))\n    buffers = {}\n    if observer:\n        require(actual.get('native_startup_capability_from_actual_kernel') is True\n                and type(actual.get('postreturn_buffers')) is dict\n                and set(actual['postreturn_buffers']) == set(EXTENTS),\n                'pure HIA postreturn observer metadata missing')\n        for index, (name, length) in enumerate(EXTENTS.items()):\n            path = folder / (name + '.bin'); bound = pin(path); raw = path.read_bytes()\n            require(actual['postreturn_buffers'][name] == {\n                'path': str(path), 'bytes': len(raw), 'sha256': digest(raw),\n                'complete': True, 'expected_extent': length, 'descriptor': 29 + index}\n                and bound['bytes'] == length, 'actual whole native buffer differs: ' + name)\n            buffers[name] = raw\n    return actual, buffers\n\n\ndef read_vm(folder, program, components, raw, path, mode, expected):\n    folder = Path(folder)\n    request = decode((folder / 'VM-REQUEST.json').read_bytes())\n    wanted = {'schema': 'hepta.hia.roundtrip-vm-inputs.v1', 'program_sha256': program.sha256,\n        'component_sha256': [digest(value) for value in components],\n        'input': pin(folder / 'reference-input.bin'), 'path': str(path), 'mode': mode,\n        'stat': pin(folder / 'stat-before.bin'), 'max_steps': 10000000,\n        'initial_buffers': {name: {'bytes': extent, 'fill': 0} for name, extent in EXTENTS.items()},\n        'actual_kernel_execution': False}\n    require(wire(request) == wire(wanted) and (folder / 'reference-input.bin').read_bytes() == raw\n            and wanted['stat']['bytes'] == 144, 'full original VM input binding differs')\n    result = decode((folder / 'VM.json').read_bytes())\n    require(result.get('schema') == 'hepta.hia.linux-file-roundtrip-execution.v1'\n            and result.get('profile') == PROFILE and result.get('function') == 'f0'\n            and result.get('program_sha256') == result.get('input_sha256') == program.sha256\n            and result.get('status') == 'returned' and result.get('values') == [expected]\n            and all(type(value) is int for value in result['values'])\n            and type(result.get('steps')) is int and 0 < result['steps'] <= 10000000\n            and result.get('actual_kernel_execution') is False and result.get('whole') is False\n            and result.get('matching_cold') is False and result.get('default_core_authority') is False\n            and result.get('explicit_effect_provider') is True\n            and type(result.get('effects')) is list, 'actual bounded VM terminal differs')\n    refs = result.get('complete_buffer_members')\n    require(type(refs) is dict and set(refs) == set(EXTENTS), 'three full VM buffers required')\n    buffers = {}\n    for name, extent in EXTENTS.items():\n        target = folder / (name + '.vm.bin')\n        require(refs[name] == pin(target) and refs[name]['bytes'] == extent,\n                'complete VM buffer identity differs: ' + name)\n        buffers[name] = target.read_bytes()\n    stdout, stderr = (folder / 'stdout.bin').read_bytes(), (folder / 'stderr.bin').read_bytes()\n    calls = decode((folder / 'PROVIDER.json').read_bytes())\n    require(type(calls) is list and all(type(row) is dict for row in calls), 'actual provider events required')\n    effects = [row for row in result['effects'] if row['operation'].startswith('linux.file.')\n               or row['operation'] in ('linux.stdout.write', 'linux.stderr.write')]\n    projected = []\n    for effect in effects:\n        response = bytes.fromhex(effect.get('read_hex', ''))\n        projected.append({key: effect[key] for key in ('operation', 'fd', 'offset', 'count', 'extent', 'result')})\n        projected[-1].update(payload_bytes=len(response), payload_sha256=digest(response))\n    require(calls == projected, 'independent original provider rows differ from actual VM effects')\n    for fd, output in ((1, stdout), (2, stderr)):\n        name = 'linux.stdout.write' if fd == 1 else 'linux.stderr.write'\n        pieces = []\n        for row in effects:\n            if row['operation'] == name:\n                require(type(row.get('result')) is int, 'integer effect result required')\n                if row['result'] > 0:\n                    written = bytes.fromhex(row['write_hex'])\n                    require(row['result'] <= len(written), 'effect returned more bytes than supplied')\n                    pieces.append(written[:row['result']])\n        require(b''.join(pieces) == output, 'recorded provider stdout/stderr differs')\n    return result, buffers, stdout, stderr, calls\n\n\ndef _row(folder, checks):\n    row = decode((Path(folder) / 'COMPARISON.json').read_bytes())\n    require(type(row) is dict and row.get('pass') is True\n            and row.get('checks') == checks and all(value is True for value in checks.values()),\n            'original complete comparison differs from raw readback: ' + str(folder))\n    return row\n\n\ndef kernel(ctx, directory):\n    executable = Path(ctx['production']['executable']['path']); rows = []\n    for original in ctx['retained']['kernel_cases']:\n        fixture, old = original['declared'], original['original_observation']\n        folder = Path(directory) / original['name']; path = folder / 'input.json'\n        raw = retained_bytes(original['input'])\n        require(path.read_bytes() == raw, 'original kernel input changed')\n        actual, _ = actual_kernel(folder / 'native', executable,\n            (b'hia-native-file-roundtrip', b'render-assembly', os.fsencode(path)))\n        stdout, stderr = bytes.fromhex(actual['stdout_hex']), bytes.fromhex(actual['stderr_hex'])\n        checks = {'expected_return': actual['returncode'] == fixture['expected'] == old['native_returncode'],\n            'same_complete_stdout': stdout == retained_bytes(original['stdout']),\n            'same_complete_stderr': stderr == retained_bytes(original['stderr']),\n            'no_timeout': not actual['timed_out'], 'reaped': actual['reaped_ECHILD'],\n            'exec_succeeded': actual['exec_failure'] is None,\n            'ELF_unchanged': actual['image_sha256'] == actual['image_after_sha256'] == ctx['production']['executable']['sha256']}\n        if fixture['expected'] != 0:\n            checks['no_failure_stdout'] = stdout == b''\n        row = _row(folder, checks)\n        require(row['name'] == original['name'] and row['input_sha256'] == digest(raw)\n                and row['expected'] == fixture['expected'] and type(row['expected']) is int\n                and row['declared_scope_exclusion'] == fixture['excluded'], 'original kernel mapping differs')\n        rows.append({'name': original['name'], 'observation': pin(folder / 'native/OBSERVATION.json'),\n                     'comparison': pin(folder / 'COMPARISON.json')})\n    return rows\n\n\ndef pipeline(ctx, directory):\n    from hepta.hia_agent_assembly import assemble_program\n    from hepta.hia_program import verify_program\n    _, captured_sources = profile_capture()\n    program = assemble_program(captured_sources['examples/hia_bootstrap/native_file_roundtrip.hepta'], profile=PROFILE)\n    components = tuple(captured_sources[name] for name in (REPRESENTATION_SOURCE, SEMANTIC_SOURCE))\n    cases = {r['name']: r for r in ctx['retained']['kernel_cases']}\n    rows = []\n    for label, original_name, mode, expected, expected_calls in ctx['retained']['pipeline_rows']:\n        folder = Path(directory) / label; path = folder / 'input.json'\n        raw = retained_bytes(cases[original_name]['input']) if original_name else b'{}'\n        require((not path.exists()) if mode == 'open-refused' else path.read_bytes() == raw,\n                'original pipeline input domain differs')\n        result, buffers, stdout, stderr, calls = read_vm(folder, program, components, raw, path, mode, expected)\n        residents = [r for r in result['effects'] if r['operation'].startswith('linux.roundtrip.')]\n        checks = {'VM_return': result['status'] == 'returned' and result['values'] == [expected],\n            'all_three_buffers_retained': set(buffers) == set(EXTENTS),\n            'exact_resident_call_count': len(residents) == expected_calls,\n            'original_shared_fuel': result['steps'] <= 10000000, 'no_VM_exception': True}\n        if mode != 'read-error-close-error':\n            native, native_buffers = actual_kernel(folder / 'native', ctx['observer']['executable']['path'],\n                (b'hia-native-file-roundtrip', b'render-assembly', os.fsencode(path)), observer=True)\n            require(native['returncode'] == expected, 'actual pipeline native return differs')\n            if original_name:\n                original = cases[original_name]\n                require(native['returncode'] == original['original_observation']['native_returncode']\n                        and bytes.fromhex(native['stdout_hex']) == retained_bytes(original['stdout'])\n                        and bytes.fromhex(native['stderr_hex']) == retained_bytes(original['stderr']),\n                        'actual pipeline differs from original native oracle')\n            checks['same_complete_stdout'] = stdout.hex() == native['stdout_hex']\n            checks['same_complete_stderr'] = stderr.hex() == native['stderr_hex']\n            checks.update({'same_complete_' + name: buffers[name] == native_buffers[name] for name in EXTENTS})\n        else:\n            require(not (folder / 'native').exists(), 'VM-only original row cannot invent a kernel observation')\n        if expected == 0:\n            canonical = verify_program(raw).canonical_bytes\n            checks.update(original_JSON_preserved=buffers['file'][:len(raw)] == raw,\n                first_canonical_exact_original_Core=buffers['file'][CAPACITY:CAPACITY + len(canonical)] == canonical,\n                second_canonical_exact_original_Core=buffers['output'][:len(canonical)] == canonical,\n                independent_assembly_preserved=buffers['file'][2*CAPACITY:2*CAPACITY + len(stdout)] == stdout,\n                two_canonical_resident_returns=[residents[i]['result'] for i in (2, 4)] == [len(canonical)] * 2,\n                five_actual_fixed_resident_calls=[r['operation'] for r in residents] == [\n                    'linux.roundtrip.representation', 'linux.roundtrip.semantic', 'linux.roundtrip.representation',\n                    'linux.roundtrip.representation', 'linux.roundtrip.representation'])\n        if mode == 'partial-and-EINTR':\n            checks['real_reference_EINTR_branch'] = any(r['operation'] == 'linux.file.read' and r['result'] == -4 for r in calls)\n            checks['real_reference_partial_write_branch'] = sum(r['operation'] == 'linux.stdout.write' for r in calls) > 1\n        if mode == 'open-refused':\n            checks['no_close_without_acquisition'] = not any(r['operation'] == 'linux.file.close' for r in calls)\n        if mode == 'read-error-close-error':\n            checks['original_read_error_priority'] = len(stderr) == 32 and struct.unpack('<4Q', stderr)[1:] == (66, 1, 4)\n            checks['one_revoked_close'] = sum(r['operation'] == 'linux.file.close' for r in calls) == 1\n        row = _row(folder, checks)\n        require(row['name'] == label and row['original_name'] == original_name and row['mode'] == mode\n                and row['error'] is None and row['VM_steps'] == result['steps']\n                and row['residents'] == residents, 'pipeline observation binding differs')\n        rows.append({'name': label, 'VM': pin(folder / 'VM.json'), 'comparison': pin(folder / 'COMPARISON.json'),\n                     'actual_kernel_full_buffers': mode != 'read-error-close-error'})\n    return rows\n\n\ndef tail_faults(ctx, directory):\n    from hepta.hia_agent_assembly import assemble_program, render_assembly\n    from hepta.hia_program import verify_program\n    from tests.hia_linux_file_roundtrip_cases import projected_document\n    from tools.build_hia_linux_file_roundtrip_program import _frame, _elf_structure\n    original = next(r for r in ctx['retained']['kernel_cases'] if r['name'] == 'exports-metadata-empty')\n    raw = retained_bytes(original['input']); canonical = verify_program(raw).canonical_bytes\n    _, captured_sources = profile_capture()\n    components = tuple(captured_sources[name] for name in (REPRESENTATION_SOURCE, SEMANTIC_SOURCE))\n    actual_components = tuple(Path(r['path']).read_bytes() for r in ctx['production']['components'][1:])\n    provider = ctx['toolchain']['compiler_image']['path']\n    packer = Path(ctx['observer']['executable']['path']).parent / 'observer-packer.image.bin'\n    rows = []\n    for side in ('C1', 'C2'):\n        folder = Path(directory) / side; path = folder / 'input.json'\n        document, author, statement = projected_document(side)\n        source = render_assembly(document, profile=PROFILE).encode()\n        require((folder / 'fault-author.py.txt').read_text() == author\n                and (folder / 'fault-controller.hepta').read_bytes() == source and path.read_bytes() == raw,\n                'exact last-byte fault author/source/input differs')\n        program = assemble_program(source, profile=PROFILE)\n        _, image, compile_receipt = observation(folder, 'fault-controller', provider, source)\n        images = (image, *actual_components); frame = _frame(images)\n        require((folder / 'packer-input.bin').read_bytes() == frame, 'fault packer frame differs')\n        _, elf, packed = observation(folder, 'fault-packed', packer, frame, extension='.elf.bin')\n        executable = folder / 'fault-observer.elf'\n        require(executable.read_bytes() == elf and pin(executable)['mode'] == 0o500,\n                'fault observer is not actual packed ELF')\n        inspection = _elf_structure(elf, images)\n        native, native_buffers = actual_kernel(folder / 'native', executable,\n            (b'hia-native-file-roundtrip', b'render-assembly', os.fsencode(path)), observer=True)\n        result, buffers, stdout, stderr, calls = read_vm(folder, program, components, raw, path, 'ordinary', 72)\n        first = buffers['file'][CAPACITY:CAPACITY + len(canonical)]\n        second = buffers['output'][:len(canonical)]; tampered = canonical[:-1] + bytes([canonical[-1] ^ 1])\n        residents = [e for e in result['effects'] if e['operation'].startswith('linux.roundtrip.')]\n        checks = {'actual_kernel_return_72': native['returncode'] == 72,\n            'VM_return_72': result['status'] == 'returned' and result['values'] == [72],\n            'no_stdout': stdout == b'' and native['stdout_hex'] == '',\n            'same_complete_stderr': stderr.hex() == native['stderr_hex'],\n            'byte_equality_phase_7': len(stderr) == 32 and struct.unpack('<4Q', stderr)[1:] == (72, 7, len(canonical)),\n            'same_lengths': len(first) == len(second) == len(canonical),\n            'equal_all_but_last': first[:-1] == second[:-1] == canonical[:-1],\n            'last_bytes_different': first[-1] != second[-1],\n            'exact_C1_injection': first == (tampered if side == 'C1' else canonical),\n            'exact_C2_injection': second == (tampered if side == 'C2' else canonical),\n            'original_JSON_preserved': buffers['file'][:len(raw)] == raw,\n            'five_actual_residents': len(residents) == 5 and all(e['status'] == 'returned' for e in residents),\n            'two_equal_canonical_returns_before_injection': [residents[i]['result'] for i in (2,4)] == [len(canonical)]*2,\n            'within_original_fuel': result['steps'] <= 10000000, 'no_VM_exception': True}\n        checks.update({'same_complete_' + name: buffers[name] == native_buffers[name] for name in EXTENTS})\n        row = _row(folder, checks)\n        require(row['name'] == side + '-last-byte' and row['compile'] == compile_receipt\n                and row['packed'] == packed and row['injection'] == statement\n                and row['fault_source_sha256'] == digest(source) and row['image_sha256'] == digest(image)\n                and row['ELF_bytes'] == len(elf) and row['ELF_sha256'] == digest(elf)\n                and row['elf_inspection'] == inspection and row['error'] is None,\n                'actual fault projection/compilation/observation differs')\n        rows.append({'name': row['name'], 'comparison': pin(folder / 'COMPARISON.json'), 'VM': pin(folder / 'VM.json')})\n    return rows\n"
      },
