        "text": "\"\"\"Emit the seven complete VerifiedProgram representation/report policies.\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nfrom hashlib import sha256\nfrom pathlib import Path\nimport sys\n\nROOT = Path(__file__).resolve().parents[1]\nif __package__ in (None, ''):\n    sys.path.insert(0, str(ROOT))\n\nfrom hepta.hia_agent_assembly import render_assembly\nfrom tools.hia_front_control import compile_policy\nfrom tools.hia_front_generator import document as _document, ports_source\nfrom tools.generate_hia_machine_plan_control import table\n\nENTRIES = ('sha256', 'canonical_json', 'input_sha256', 'scalar_entrypoints',\n           'normalization_report', 'as_dict', 'report')\nIMPORTS = {}\n\n\ndef program():\n    return compile_policy((ROOT / 'tools/hia_verified_report_policy.py').read_text(), ENTRIES, IMPORTS)\n\n\ndef document(policy=None):\n    return _document(program() if policy is None else policy, 'verified_report')\n\n\ndef generated():\n    policy = program()\n    data = table(policy)\n    return (render_assembly(document(policy)).encode('utf-8'),\n            ports_source(policy, data, ENTRIES, IMPORTS).encode('utf-8'), policy, data)\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('--output', type=Path, default=ROOT / 'examples/hia_bootstrap/verified_report.hepta')\n    parser.add_argument('--ports', type=Path, default=ROOT / 'hepta/hia_verified_report_ports.py')\n    parser.add_argument('--check', action='store_true')\n    args = parser.parse_args()\n    assembly, ports, policy, data = generated()\n    if args.check:\n        if args.output.read_bytes() != assembly or args.ports.read_bytes() != ports:\n            raise AssertionError('verified_report generated bytes differ')\n    else:\n        args.output.write_bytes(assembly)\n        args.ports.write_bytes(ports)\n    print({'roots': len(ENTRIES), 'functions': len(policy.functions),\n           'instructions': sum(len(f.instructions) for f in policy.functions),\n           'table_bytes': len(data), 'table_sha256': sha256(data).hexdigest(),\n           'source_sha256': sha256(assembly).hexdigest(),\n           'ports_sha256': sha256(ports).hexdigest(),\n           'whole_verify_closed': False, 'current_source_cold': False})\n\n\nif __name__ == '__main__':\n    main()\n"
