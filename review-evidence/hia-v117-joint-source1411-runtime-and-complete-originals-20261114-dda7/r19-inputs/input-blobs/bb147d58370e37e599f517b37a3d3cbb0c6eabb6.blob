        "sha256": "858cfa25387af02d54dad96f63f51652fb1eb2f92341411cc35a23bf22b68c84",
        "text": "\"\"\"Standalone HIA v1-v8: closed, typed SSA blocks with checked resource flow.\n\nThe authority is this program's operations, not a source file, producer hash,\nclaim, or source-checker receipt.  Blocks are closed: all incoming values are\nexplicit block parameters.  The profile has 64-bit usize/isize, byte owners,\nlexical/reborrowed views and finite machine integers. V8 admits explicitly\nparameter-bound returned loans through the return_loans contract; v1-v7 keep\nnon-escaping call loans. Versioned bulk-byte operations and v7 recursive\nbyte-owner chains follow the shared schema registry. Composite v1/v2/v3/v4\nnormalize to their explicitly versioned primitive v6/v7/v8 target before the\ncomplete resource flow is checked.\n\nThis is an executable checker, not a machine-checked soundness/refinement proof.\nIn particular explicit/arithmetic traps abort; cleanup is required at ordinary\nreturns (including error-as-value returns), not promised after an abort.\n\"\"\"\nfrom __future__ import annotations\n\nfrom collections import deque\nfrom dataclasses import dataclass\nfrom hashlib import sha256\nimport json\nimport re\n\nfrom .hia_json_preflight import preflight_hia_json\nfrom .hia_json_decode import decode_hia_json, decode_internal_canonical\nfrom .hia_json_canonical_native import selected_canonical_wire\nfrom .hia_sha256_native import payload_sha256\nfrom .hia_capability_flow import (Capability as _Capability,\n                                  CapabilityFlowRejected, rename_capabilities)\nfrom .hia_schema import (\n    COMPOSITE_SCHEMA, COMPOSITE_SCHEMAS, PRIMITIVE_SCHEMAS, PROFILE, PROFILE_V2, PROFILE_V3,\n    PROFILE_V4, PROFILE_V5, PROFILE_V6, PROFILE_V7, PROFILE_V8, SCHEMA, SCHEMA_V2, SCHEMA_V3,\n    SCHEMA_V4, SCHEMA_V5, SCHEMA_V6, SCHEMA_V7, SCHEMA_V8, profile_for_schema, supports_feature,\n)\nfrom .hia_opcodes import (\n    BYTE_RESOURCES, EFFECTS, OWNERS, RESOURCES, SCALARS, TRAP_CODES, TYPES, WIDTHS,\n    TERMINATORS, OpcodeRejected, check_instruction, opcode_spec,\n    scalar_value_valid as _catalog_scalar_value_valid,\n)\nWORD_BITS = 64\n_IDENT = re.compile(r\"[A-Za-z_][A-Za-z_0-9]{0,127}\\Z\")\n_JSON_ESCAPE = re.compile(r'[\\x00-\\x1f\"\\\\]')\n_RESERVED_FUNCTIONS = frozenset({\"abort\", \"calloc\", \"malloc\", \"free\", \"memcpy\", \"memmove\", \"memset\"})\nMAX_BYTES = 8 * 1024 * 1024\nMAX_NODES = 262144\nMAX_DEPTH = 64\nMAX_FUNCTIONS = 1024\nMAX_BLOCKS = 4096\n\n\nclass HIAProgramRejected(ValueError):\n    \"\"\"Malformed, unsupported or statically unsafe standalone core.\"\"\"\n\n    def __init__(self, message, code=\"E_HIA_PROGRAM\"):\n        self.code = code\n        super().__init__(f\"{code}: {message}\")\n\n\ndef _reject(message, code=\"E_HIA_PROGRAM\"):\n    raise HIAProgramRejected(message, code)\n\n\ndef _keys(value, fields, where):\n    if type(value) is not dict or set(value) != set(fields):\n        _reject(f\"{where}: expected exactly {', '.join(sorted(fields))}\", \"E_HIA_FORMAT\")\n\n\ndef _ident(value, where):\n    if (type(value) is not str or _IDENT.fullmatch(value) is None\n            or value.startswith(\"__hia_\")):\n        _reject(f\"{where}: invalid/reserved ASCII identifier\", \"E_HIA_NAME\")\n    return value\n\n\ndef _type(value):\n    if type(value) is not str or value not in TYPES:\n        _reject(\"type is outside the closed primitive profile\", \"E_HIA_TYPE\")\n    return value\n\n\ndef integer_range(typ):\n    if typ not in WIDTHS:\n        _reject(\"expected integer type\", \"E_HIA_TYPE\")\n    width = WIDTHS[typ]\n    signed = typ.startswith(\"i\")\n    return (-(1 << (width - 1)), (1 << (width - 1)) - 1) if signed else (0, (1 << width) - 1)\n\n\ndef scalar_value_valid(value, typ):\n    return _catalog_scalar_value_valid(value, typ)\n\n\ndef _unique_pairs(pairs):\n    result = {}\n    for key, value in pairs:\n        if key in result:\n            _reject(\"duplicate JSON object field\", \"E_HIA_FORMAT\")\n        result[key] = value\n    return result\n\n\ndef _bad_constant(value):\n    _reject(\"nonfinite JSON value\", \"E_HIA_FORMAT\")\n\n\ndef _json_string_bytes(value, remaining):\n    \"\"\"Exact UTF-8 length of ensure_ascii=False compact JSON string output.\n\n    No escaped/encoded string is materialized during this preflight. In\n    particular a short sequence of control characters may require six\n    serialized bytes for every source character.\n    \"\"\"\n    if len(value) + 2 > remaining:\n        _reject(\"program exceeds byte budget before encoding\", \"E_HIA_LIMIT\")\n    # The common identifier/opcode/key case needs no per-code-point Python loop.\n    # The lower-bound budget check above remains first; no encoded copy or\n    # verified-object cache is introduced, and every unsafe/non-ASCII string\n    # still follows the complete original escape/surrogate/UTF-8 accounting.\n    if value.isascii() and _JSON_ESCAPE.search(value) is None:\n        return len(value) + 2\n    size = 2  # opening and closing JSON quotes\n    for char in value:\n        point = ord(char)\n        if point < 32:\n            width = 2 if point in (8, 9, 10, 12, 13) else 6\n        elif point in (34, 92):  # escaped double quote/backslash\n            width = 2\n        elif point < 0x80:\n            width = 1\n        elif 0xD800 <= point <= 0xDFFF:\n            _reject(\"unpaired Unicode surrogate\", \"E_HIA_FORMAT\")\n        elif point < 0x800:\n            width = 2\n        elif point < 0x10000:\n            width = 3\n        else:\n            width = 4\n        size += width\n        if size > remaining:\n            _reject(\"program exceeds byte budget before encoding\", \"E_HIA_LIMIT\")\n    return size\n\n\ndef _bounded_input_utf8_bytes(text):\n    \"\"\"Count encoded JSON-input bytes without materializing the entire wire.\n\n    HIA accepts at most MAX_BYTES of UTF-8 input.  Encoding a large caller\n    string just to check its size creates an unbounded pre-admission copy.\n    Exact built-in str values are immutable; count them in bounded chunks.\n    Each encoded temporary is at most 16 KiB (4096 Unicode code points).\n    \"\"\"\n    if len(text) > MAX_BYTES:\n        _reject(\"program exceeds byte budget\", \"E_HIA_LIMIT\")\n    if text.isascii():\n        return len(text)\n    total = 0\n    for offset in range(0, len(text), 4096):\n        total += len(text[offset:offset + 4096].encode(\"utf-8\"))\n        if total > MAX_BYTES:\n            _reject(\"program exceeds byte budget\", \"E_HIA_LIMIT\")\n    return total\n\n\ndef _structure(value):\n    \"\"\"Count exact canonical JSON bytes AND nodes before json.dumps.\n\n    In-process dicts are not byte-bounded by the text preflight. The active\n    identity set also refuses cycles, and queued leaf counts refuse huge\n    container fanout before extending the work stack. This is a size gate,\n    not a replacement for the canonical HIA typed SSA/ownership verifier.\n    \"\"\"\n    # Repeated immutable keys/strings need the same arithmetic, not a second\n    # character scan. This bounded table belongs to this one full traversal;\n    # every occurrence still consumes its own nodes/bytes. A smaller remaining\n    # budget always goes through the original helper, preserving its exact\n    # lower-bound/escape/surrogate rejection order. No admission is memoized.\n    string_sizes = {}\n\n    def string_bytes(value, remaining):\n        # Do not hash a caller's oversized string just to look it up. Preserve\n        # the original constant-time lower-bound refusal before any full scan.\n        if len(value) + 2 > remaining:\n            return _json_string_bytes(value, remaining)\n        size = string_sizes.get(value)\n        if size is not None and size <= remaining:\n            return size\n        size = _json_string_bytes(value, remaining)\n        if len(string_sizes) < 1024:\n            string_sizes[value] = size\n        return size\n\n    # Keep node references directly, rather than allocating a task tuple for\n    # every scalar. A private marker closes each active container and restores\n    # its depth; it cannot be confused with any caller-provided JSON value.\n    leaving = object()\n    pending = [value]\n    active = set()\n    count, queued, size, depth = 0, 1, 0, 0\n    while pending:\n        current = pending.pop()\n        if current is leaving:\n            depth = pending.pop()\n            active.remove(id(pending.pop()))\n            continue\n        queued -= 1\n        count += 1\n        if count > MAX_NODES or depth > MAX_DEPTH:\n            _reject(\"program exceeds structural budget\", \"E_HIA_LIMIT\")\n        kind = type(current)\n        if kind in (dict, list):\n            identity = id(current)\n            if identity in active:\n                _reject(\"cyclic HIA JSON structure\", \"E_HIA_FORMAT\")\n            active.add(identity)\n            children = len(current)\n            if children > MAX_NODES - count - queued:\n                _reject(\"program exceeds queued-node budget\", \"E_HIA_LIMIT\")\n            queued += children\n            size += 2 + max(0, children - 1)  # container plus commas\n            if kind is dict:\n                size += children  # colons\n                for key in current:\n                    if type(key) is not str:\n                        _reject(\"non-string JSON key\", \"E_HIA_FORMAT\")\n                    size += string_bytes(key, MAX_BYTES - size)\n                values = current.values()\n            else:\n                values = current\n            # Retain the original container until its active-path scope ends.\n            # Children are still captured before descent, in the same order;\n            # the stack therefore visits them right to left as before.\n            pending.extend((current, depth, leaving))\n            pending.extend(values)\n            depth += 1\n        elif kind is str:\n            size += string_bytes(current, MAX_BYTES - size)\n        elif kind is bool:\n            size += 4 if current else 5\n        elif kind is int:\n            # Fail without converting a potentially enormous host integer\n            # into a decimal string merely to discover it exceeds 8 MiB.\n            if current.bit_length() > MAX_BYTES * 4:\n                _reject(\"integer exceeds JSON byte budget\", \"E_HIA_LIMIT\")\n            size += len(str(current))\n        elif current is None:\n            size += 4\n        else:\n            _reject(\"only bounded integer JSON values are supported\", \"E_HIA_FORMAT\")\n        if size > MAX_BYTES:\n            _reject(\"program exceeds byte budget before encoding\", \"E_HIA_LIMIT\")\n    return size\n\n\n\ndef _bounded_detached_snapshot(root):\n    \"\"\"Capture caller-owned JSON containers before byte accounting/encoding.\n\n    `_structure(original)` followed by `json.dumps(original)` is a check/use\n    race if another thread mutates the original dict or list. Instead retain\n    bounded references to each container's children, build a separate plain\n    dict/list tree, and validate/serialize *that exact detached tree*.\n    A nested caller tree is not claimed to be atomically snapshotted.\n    Every supported capture is independently rechecked by _structure.\n    \"\"\"\n    # Frames contain only active containers. Their iterators traverse the\n    # bounded, already captured child references, never the live caller tree.\n    # No per-leaf (node, parent, slot, depth, leaving) tasks or reversed\n    # enumerate lists are needed. Retaining each original container also\n    # prevents its identity being recycled while it remains on the active path.\n    frames = []\n    active = set()\n    count, queued = 0, 1\n    result = None\n    node, parent, slot = root, None, None\n    while True:\n        queued -= 1\n        count += 1\n        if count > MAX_NODES or len(frames) > MAX_DEPTH:\n            _reject(\"caller-owned tree exceeds snapshot budget\", \"E_HIA_LIMIT\")\n        kind = type(node)\n        if kind in (dict, list):\n            identity = id(node)\n            if identity in active:\n                _reject(\"cyclic caller-owned HIA tree\", \"E_HIA_FORMAT\")\n            active.add(identity)\n            available = MAX_NODES - count - queued\n            if len(node) > available:\n                _reject(\"caller-owned tree exceeds queued-node budget\", \"E_HIA_LIMIT\")\n            children = []\n            try:\n                if kind is dict:\n                    for key, child in node.items():\n                        if type(key) is not str:\n                            _reject(\"non-string caller-owned JSON key\", \"E_HIA_FORMAT\")\n                        if len(children) >= available:\n                            _reject(\"caller-owned dictionary grew past node budget\",\n                                    \"E_HIA_LIMIT\")\n                        children.append((key, child))\n                    copy = {}\n                else:\n                    for child in node:\n                        if len(children) >= available:\n                            _reject(\"caller-owned list grew past node budget\",\n                                    \"E_HIA_LIMIT\")\n                        children.append(child)\n                    copy = [None] * len(children)\n            except RuntimeError as exc:\n                raise HIAProgramRejected(\n                    \"caller-owned tree mutated during bounded snapshot\",\n                    \"E_HIA_FORMAT\") from exc\n            if parent is None:\n                result = copy\n            else:\n                parent[slot] = copy\n            queued += len(children)\n            frames.append((node, iter(children) if kind is dict else enumerate(children), copy))\n        else:\n            if kind not in (str, int, bool) and node is not None:\n                _reject(\"unsupported caller-owned JSON node\", \"E_HIA_FORMAT\")\n            if parent is None:\n                result = node\n            else:\n                parent[slot] = node\n        while frames:\n            original, children, parent = frames[-1]\n            try:\n                slot, node = next(children)\n                break\n            except StopIteration:\n                active.remove(id(original))\n                frames.pop()\n        else:\n            return result\n\ndef _decode(value):\n    if isinstance(value, VerifiedProgram):\n        value = value.canonical_bytes\n    try:\n        caller_owned = type(value) in (dict, list)\n        submitted_text = None\n        if type(value) is bytes:\n            if len(value) > MAX_BYTES:\n                _reject(\"program exceeds byte budget\", \"E_HIA_LIMIT\")\n            value = value.decode(\"utf-8\")\n        if type(value) is str:\n            _bounded_input_utf8_bytes(value)\n            submitted_text = value\n            # Bound value allocation before either selected decoder builds a\n            # graph. An optional HIA value arena does not bypass the canonical\n            # v7/composite Core verifier or rewrite its semantic checks.\n            try:\n                value = decode_hia_json(value, max_nodes=MAX_NODES, max_depth=MAX_DEPTH,\n                                        object_pairs_hook=_unique_pairs, parse_constant=_bad_constant)\n            except OverflowError as exc:\n                raise HIAProgramRejected(\n                    \"program exceeds structural budget before JSON allocation\",\n                    \"E_HIA_LIMIT\") from exc\n        if caller_owned:\n            value = _bounded_detached_snapshot(value)\n        _structure(value)\n        raw = (selected_canonical_wire(submitted_text, max_nodes=MAX_NODES, max_depth=MAX_DEPTH)\n               if submitted_text is not None else None)\n        if raw is None:\n            raw = json.dumps(value, sort_keys=True, separators=(\",\", \":\"),\n                             ensure_ascii=False, allow_nan=False).encode(\"utf-8\")\n        if len(raw) > MAX_BYTES:\n            _reject(\"program exceeds byte budget\", \"E_HIA_LIMIT\")\n        # Validation uses a detached snapshot, never the caller's mutable dict.\n        # This is our own already-structured, byte-bounded canonical output,\n        # not a submitted wire. Preserve the existing detached-object bridge\n        # without redundantly preflighting the same checked graph a second time.\n        return decode_internal_canonical(raw, max_nodes=MAX_NODES, max_depth=MAX_DEPTH), raw\n    except HIAProgramRejected:\n        raise\n    except (ValueError, TypeError, UnicodeError, RecursionError, OverflowError) as exc:\n        raise HIAProgramRejected(\"invalid/deep UTF-8 JSON\", \"E_HIA_FORMAT\") from exc\n\n\n@dataclass(frozen=True, slots=True)\nclass VerifiedProgram:\n    \"\"\"Immutable bytes, not an unforgeable receipt; consumers reverify them.\"\"\"\n\n    canonical_bytes: bytes\n    structured_bytes: bytes | None = None\n\n    @property\n    def sha256(self):\n        return payload_sha256(self.canonical_bytes).hex()\n\n    @property\n    def canonical_json(self):\n        return self.canonical_bytes.decode(\"utf-8\")\n\n    @property\n    def input_sha256(self):\n        return payload_sha256(self.structured_bytes if self.structured_bytes is not None\n                              else self.canonical_bytes).hex()\n\n    @property\n    def scalar_entrypoints(self):\n        # A nominal aggregate erased into scalar slots is still not a scalar\n        # public signature.  Generated protocol helpers are internal too.\n        document = self.as_dict()\n        if \"exports\" in document:\n            return frozenset(document[\"exports\"])\n        return frozenset(fn[\"name\"] for fn in document[\"functions\"]\n                         if all(type(p[\"type\"]) is str and p[\"type\"] in SCALARS for p in fn[\"params\"])\n                         and all(type(t) is str and t in SCALARS for t in fn[\"returns\"]))\n\n    @property\n    def normalization_report(self):\n        checked = verify_program(self)\n        core = checked.as_dict()\n        original = (decode_internal_canonical(checked.structured_bytes, max_nodes=MAX_NODES, max_depth=MAX_DEPTH)\n                    if checked.structured_bytes is not None else core)\n        return {\"input_sha256\": checked.input_sha256,\n                \"core_sha256\": checked.sha256,\n                \"input_schema\": original[\"schema\"],\n                \"input_profile\": profile_for_schema(original[\"schema\"]),\n                \"core_schema\": core[\"schema\"],\n                \"core_profile\": profile_for_schema(core[\"schema\"]),\n                \"structured_elaboration_rechecked\": checked.structured_bytes is not None,\n                \"primitive_core_rechecked\": True,\n                \"source_ast_required\": False,\n                \"public_scalar_entrypoints\": sorted(checked.scalar_entrypoints)}\n\n    def as_dict(self):\n        return decode_internal_canonical(self.canonical_bytes, max_nodes=MAX_NODES, max_depth=MAX_DEPTH)\n\n    def report(self):\n        # This public constructor is intentionally not an authority. Even a\n        # report rechecks the immutable bytes instead of trusting its class.\n        checked = verify_program(self)\n        data = checked.as_dict()\n        profile = profile_for_schema(data[\"schema\"])\n        return {\"schema\": \"hepta.hia.program-verification.v1\", \"ok\": True,\n                \"profile\": profile, \"program_sha256\": checked.sha256,\n                \"input_sha256\": checked.input_sha256,\n                \"normalization\": checked.normalization_report,\n                \"word_bits\": WORD_BITS, \"functions_checked\": len(data[\"functions\"]),\n                \"blocks_checked\": sum(len(f[\"blocks\"]) for f in data[\"functions\"]),\n                \"source_required\": False,\n                \"claims\": {\"typed_closed_ssa_checked\": True,\n                           \"linear_resources_and_loan_provenance_checked\": True,\n                           \"whole_language_soundness_proved\": False,\n                           \"backend_refinement_proved\": False,\n                           \"foreign_code_supported\": False,\n                           \"escaping_loans_supported\": False,\n                           \"parameter_bound_loan_returns_supported\": supports_feature(data[\"schema\"], \"parameter_loan_returns\"),\n                           \"concurrency_supported\": False,\n                           \"nominal_products_and_enums_checked\": checked.structured_bytes is not None,\n                           \"local_stored_loan_identity_checked\": checked.structured_bytes is not None,\n                           \"record_field_borrow_provenance_checked\": checked.structured_bytes is not None,\n                           \"cooperative_task_protocol_checked\": checked.structured_bytes is not None,\n                           \"background_tasks_supported\": False,\n                           \"recursive_heap_adts_supported\": False,\n                           \"recursive_buffer_chains_supported\": supports_feature(data[\"schema\"], \"recursive_chain\"),\n                           \"preemptive_or_async_cancellation_supported\": False}}\n\n# Definition-time anchors for the explicitly selected report owner.\n_NATIVE_VERIFIED_REPORT_CLASS = VerifiedProgram\n_NATIVE_VERIFIED_REPORT_ANCHORS = {\n    'sha256': (VerifiedProgram.__dict__['sha256'], VerifiedProgram.__dict__['sha256'].fget, VerifiedProgram.__dict__['sha256'].fget.__code__),\n    'canonical_json': (VerifiedProgram.__dict__['canonical_json'], VerifiedProgram.__dict__['canonical_json'].fget, VerifiedProgram.__dict__['canonical_json'].fget.__code__),\n    'input_sha256': (VerifiedProgram.__dict__['input_sha256'], VerifiedProgram.__dict__['input_sha256'].fget, VerifiedProgram.__dict__['input_sha256'].fget.__code__),\n    'scalar_entrypoints': (VerifiedProgram.__dict__['scalar_entrypoints'], VerifiedProgram.__dict__['scalar_entrypoints'].fget, VerifiedProgram.__dict__['scalar_entrypoints'].fget.__code__),\n    'normalization_report': (VerifiedProgram.__dict__['normalization_report'], VerifiedProgram.__dict__['normalization_report'].fget, VerifiedProgram.__dict__['normalization_report'].fget.__code__),\n    'as_dict': (VerifiedProgram.__dict__['as_dict'], VerifiedProgram.__dict__['as_dict'], VerifiedProgram.__dict__['as_dict'].__code__),\n    'report': (VerifiedProgram.__dict__['report'], VerifiedProgram.__dict__['report'], VerifiedProgram.__dict__['report'].__code__),\n}\n_NATIVE_VERIFIED_REPORT_ENTRIES = {name: item[1] for name, item in _NATIVE_VERIFIED_REPORT_ANCHORS.items()}\n_NATIVE_VERIFIED_REPORT_LOOKUP = (VerifiedProgram.__mro__, VerifiedProgram.__dict__.get('__dict__'), VerifiedProgram.__getattribute__)\n\n\n\ndef _parameters(value, where):\n    if type(value) is not list:\n        _reject(f\"{where}: expected parameter list\", \"E_HIA_FORMAT\")\n    seen = set()\n    for param in value:\n        _keys(param, {\"name\", \"type\"}, where)\n        name = _ident(param[\"name\"], where)\n        _type(param[\"type\"])\n        if name in seen:\n            _reject(f\"{where}: duplicate parameter {name}\", \"E_HIA_SSA\")\n        seen.add(name)\n    return value\n\n\ndef _names(value, where):\n    if type(value) is not list:\n        _reject(f\"{where}: expected value list\", \"E_HIA_FORMAT\")\n    for name in value:\n        _ident(name, where)\n    return value\n\n\ndef _edge(value):\n    _keys(value, {\"target\", \"args\"}, \"CFG edge\")\n    _ident(value[\"target\"], \"edge target\")\n    _names(value[\"args\"], \"edge arguments\")\n    return value\n\n\ndef _edges(term):\n    if type(term) is not dict or type(term.get(\"op\")) is not str:\n        _reject(\"missing terminator\", \"E_HIA_CFG\")\n    op = term[\"op\"]\n    if op not in TERMINATORS:\n        _reject(\"unknown terminator\", \"E_HIA_CFG\")\n    _keys(term, TERMINATORS[op], op)\n    if op == \"jump\":\n        return [_edge({\"target\": term[\"target\"], \"args\": term[\"args\"]})]\n    if op == \"branch\":\n        _ident(term[\"cond\"], \"branch condition\")\n        return [_edge(term[\"then\"]), _edge(term[\"else\"])]\n    if op == \"ret\":\n        _names(term[\"values\"], \"return values\")\n        return []\n    if op == \"trap\":\n        if type(term[\"code\"]) is not str or term[\"code\"] not in TRAP_CODES:\n            _reject(\"unknown trap code\", \"E_HIA_CFG\")\n        return []\n    _reject(\"unknown terminator\", \"E_HIA_CFG\")\n\n\ndef _function_shape(fn, *, recursive_chain=False, parameter_loan_returns=False):\n    from .hia_function_shape_native import selected_function_shape\n    selected=selected_function_shape(fn,recursive_chain=recursive_chain,\n                                     parameter_loan_returns=parameter_loan_returns)\n    if selected is not None:\n        return selected\n    return _reference_function_shape(fn,recursive_chain=recursive_chain,\n                                     parameter_loan_returns=parameter_loan_returns)\n\n\ndef _reference_function_shape(fn, *, recursive_chain=False, parameter_loan_returns=False, profile=None):\n    fields = {\"name\", \"params\", \"returns\", \"effects\", \"entry\", \"blocks\"}\n    if parameter_loan_returns and type(fn) is dict and \"return_loans\" in fn:\n        fields.add(\"return_loans\")\n    _keys(fn, fields, \"function\")\n    name = _ident(fn[\"name\"], \"function\")\n    if name in _RESERVED_FUNCTIONS:\n        _reject(\"function collides with native runtime symbol\", \"E_HIA_NAME\")\n    _parameters(fn[\"params\"], \"function parameters\")\n    if type(fn[\"returns\"]) is not list:\n        _reject(\"returns must be a list\", \"E_HIA_TYPE\")\n    for typ in fn[\"returns\"]:\n        _type(typ)\n        if typ in {\"readbuf\", \"mutbuf\"} and not parameter_loan_returns:\n            _reject(\"call loans require the v8 parameter-return contract\", \"E_HIA_LOAN\")\n    if parameter_loan_returns:\n        origins = fn.get(\"return_loans\", [None] * len(fn[\"returns\"]))\n        if type(origins) is not list or len(origins) != len(fn[\"returns\"]):\n            _reject(\"return_loans must match the return arity\", \"E_HIA_LOAN\")\n        parameters = {p[\"name\"]: p[\"type\"] for p in fn[\"params\"]}\n        for typ, origin in zip(fn[\"returns\"], origins):\n            if typ not in {\"readbuf\", \"mutbuf\"}:\n                if origin is not None:\n                    _reject(\"nonloan result requires a null return_loans entry\", \"E_HIA_LOAN\")\n            elif (type(origin) is not str or parameters.get(origin) not in {\"readbuf\", \"mutbuf\"}\n                  or typ == \"mutbuf\" and parameters[origin] != \"mutbuf\"):\n                _reject(\"borrowed result must name an input loan with sufficient permission\", \"E_HIA_LOAN\")\n    allowed_effects = EFFECTS\n    if profile is not None:\n        if type(profile) is str and profile == \"hepta.hia.linux-file-roundtrip.v2\":\n            from .hia_linux_file_roundtrip import profile_effects\n        elif type(profile) is str and profile == \"hepta.hia.linux-file-render.v3\":\n            from .hia_linux_file_render import profile_effects\n        elif type(profile) is str and profile == \"hepta.hia.linux-file.v1\":\n            from .hia_linux_file import profile_effects\n        elif type(profile) is str and profile == \"hepta.hia.linux-cli-process.v1\":\n            from .hia_linux_cli_process import profile_effects\n        elif type(profile) is str and profile == \"hepta.hia.linux-process.v1\":\n            from .hia_linux_process import profile_effects\n        else:\n            from .hia_linux_stdio import profile_effects\n        allowed_effects = profile_effects(profile)\n    effects = fn[\"effects\"]\n    if (type(effects) is not list or any(type(e) is not str or e not in allowed_effects for e in effects)\n            or len(effects) != len(set(effects))):\n        _reject(\"unknown/duplicate function effect\", \"E_HIA_EFFECT\")\n    _ident(fn[\"entry\"], \"entry\")\n    if type(fn[\"blocks\"]) is not list or not 1 <= len(fn[\"blocks\"]) <= MAX_BLOCKS:\n        _reject(\"invalid block inventory\", \"E_HIA_CFG\")\n    by_id, definitions = {}, set()\n    for block in fn[\"blocks\"]:\n        _keys(block, {\"id\", \"params\", \"ops\", \"term\"}, \"block\")\n        ident = _ident(block[\"id\"], \"block id\")\n        if ident in by_id:\n            _reject(\"duplicate block\", \"E_HIA_CFG\")\n        by_id[ident] = block\n        params = _parameters(block[\"params\"], \"block parameters\")\n        if type(block[\"ops\"]) is not list:\n            _reject(\"block operations must be a list\", \"E_HIA_FORMAT\")\n        current = [p[\"name\"] for p in params]\n        for instruction in block[\"ops\"]:\n            _keys(instruction, {\"op\", \"args\", \"out\", \"attrs\"}, \"instruction\")\n            if type(instruction[\"op\"]) is not str:\n                _reject(\"opcode must be text\", \"E_HIA_FORMAT\")\n            _names(instruction[\"args\"], \"instruction arguments\")\n            outputs = _parameters(instruction[\"out\"], \"instruction outputs\")\n            if type(instruction[\"attrs\"]) is not dict:\n                _reject(\"instruction attributes must be an object\", \"E_HIA_FORMAT\")\n            current.extend(p[\"name\"] for p in outputs)\n        for value in current:\n            if value in definitions:\n                _reject(f\"SSA value {value} is defined more than once\", \"E_HIA_SSA\")\n            definitions.add(value)\n        _edges(block[\"term\"])\n    if fn[\"entry\"] not in by_id or by_id[fn[\"entry\"]][\"params\"] != fn[\"params\"]:\n        _reject(\"entry parameters must equal the function signature\", \"E_HIA_CFG\")\n    graph = {}\n    for ident, block in by_id.items():\n        graph[ident] = []\n        for edge in _edges(block[\"term\"]):\n            if edge[\"target\"] not in by_id:\n                _reject(\"jump to missing block\", \"E_HIA_CFG\")\n            if edge[\"target\"] == fn[\"entry\"]:\n                _reject(\"entry cannot have incoming CFG edges; use a loop header\", \"E_HIA_CFG\")\n            if len(edge[\"args\"]) != len(by_id[edge[\"target\"]][\"params\"]):\n                _reject(\"edge arity differs from block parameters\", \"E_HIA_CFG\")\n            graph[ident].append(edge[\"target\"])\n    pending, reached = [fn[\"entry\"]], set()\n    while pending:\n        ident = pending.pop()\n        if ident in reached:\n            continue\n        reached.add(ident)\n        pending.extend(graph[ident])\n    if reached != set(by_id):\n        _reject(\"unreachable blocks are not admitted\", \"E_HIA_CFG\")\n    if not recursive_chain:\n        declared = [p[\"type\"] for p in fn[\"params\"]] + fn[\"returns\"]\n        declared += [p[\"type\"] for block in fn[\"blocks\"] for p in block[\"params\"]]\n        declared += [p[\"type\"] for block in fn[\"blocks\"] for ins in block[\"ops\"] for p in ins[\"out\"]]\n        if \"chain\" in declared:\n            _reject(\"recursive chain types require HIA program v7\", \"E_HIA_TYPE\")\n    return by_id\n\n\n@dataclass(frozen=True, slots=True)\nclass _FunctionInterface:\n    # Original formal identities are semantic inputs in v8: return_loans names\n    # a formal, not whichever same-typed or aliased argument happens to survive.\n    params: tuple[str, ...]\n    param_names: tuple[str, ...]\n    returns: tuple[str, ...]\n    return_loans: tuple[str | None, ...]\n    effects: frozenset[str]\n\n\nclass _BlockCheck:\n    def __init__(self, fn, block, capabilities, functions, *, schema, profile=None):\n        self.fn, self.block, self.functions = fn, block, functions\n        self.schema = schema\n        self.profile = profile\n        self.env = {p[\"name\"]: p[\"type\"] for p in block[\"params\"]}\n        self.caps = dict(capabilities)\n        self.required = set()\n\n    def value(self, name):\n        if name not in self.env:\n            _reject(f\"{self.fn['name']}/{self.block['id']}: undefined/nonlocal value {name}\", \"E_HIA_SSA\")\n        typ = self.env[name]\n        if typ in RESOURCES and name not in self.caps:\n            _reject(f\"use of consumed resource {name}\", \"E_HIA_RESOURCE\")\n        return typ\n\n    def children(self, name):\n        return [n for n, cap in self.caps.items() if cap.parent == name]\n\n    def ancestors(self, name):\n        out = set()\n        while self.caps[name].parent is not None:\n            name = self.caps[name].parent\n            if name in out or name not in self.caps:\n                _reject(\"invalid loan parent graph\", \"E_HIA_LOAN\")\n            out.add(name)\n        return out\n\n    def owner_free(self, name):\n        if self.value(name) not in OWNERS:\n            _reject(\"operation requires an owner\", \"E_HIA_TYPE\")\n        if any(cap.root == name and other != name for other, cap in self.caps.items()):\n            _reject(\"owner moved/dropped/returned while borrowed\", \"E_HIA_LOAN\")\n\n    def access(self, name, mutable=False):\n        typ = self.value(name)\n        if typ not in ({\"mutbuf\"} if mutable else {\"readbuf\", \"mutbuf\"}):\n            _reject(\"memory access requires appropriate view\", \"E_HIA_TYPE\")\n        if self.children(name):\n            _reject(\"parent view is suspended until child loans end\", \"E_HIA_LOAN\")\n\n    def borrow(self, source, output, mutable, *, chain_head=False):\n        typ = self.value(source)\n        allowed = {\"chain\"} if chain_head else ({\"buffer\", \"mutbuf\"} if mutable else BYTE_RESOURCES)\n        if typ not in allowed:\n            _reject(\"invalid borrow permission\", \"E_HIA_LOAN\")\n        root = self.caps[source].root\n        allowed_ancestors = self.ancestors(source) | {source}\n        others = [cap for name, cap in self.caps.items()\n                  if cap.root == root and name not in allowed_ancestors]\n        if mutable and others or not mutable and any(c.typ == \"mutbuf\" for c in others):\n            _reject(\"conflicting live borrow\", \"E_HIA_LOAN\")\n        self.caps[output] = _Capability(\"mutbuf\" if mutable else \"readbuf\", root, source,\n                                        origin=self.caps[source].origin)\n\n    def instruction(self, ins):\n        op, args, out, attrs = ins[\"op\"], ins[\"args\"], ins[\"out\"], ins[\"attrs\"]\n        actual = [self.value(a) for a in args]\n        names, types = [o[\"name\"] for o in out], [o[\"type\"] for o in out]\n        try:\n            spec = None\n            if self.profile is not None:\n                if type(self.profile) is str and self.profile == \"hepta.hia.linux-file-roundtrip.v2\":\n                    from .hia_linux_file_roundtrip import profile_opcode\n                elif type(self.profile) is str and self.profile == \"hepta.hia.linux-file-render.v3\":\n                    from .hia_linux_file_render import profile_opcode\n                elif type(self.profile) is str and self.profile == \"hepta.hia.linux-file.v1\":\n                    from .hia_linux_file import profile_opcode\n                elif type(self.profile) is str and self.profile == \"hepta.hia.linux-cli-process.v1\":\n                    from .hia_linux_cli_process import profile_opcode\n                elif type(self.profile) is str and self.profile == \"hepta.hia.linux-process.v1\":\n                    from .hia_linux_process import profile_opcode\n                else:\n                    from .hia_linux_stdio import profile_opcode\n                spec = profile_opcode(self.profile, op, self.schema)\n            if spec is not None:\n                self.required.update(check_instruction(spec, actual, types, attrs))\n            else:\n                from .hia_instruction_policy_native import selected_instruction_policy\n                native_effects = selected_instruction_policy(op, self.schema, actual, types, attrs)\n                if native_effects is None:\n                    spec = opcode_spec(op, self.schema)\n                    self.required.update(check_instruction(spec, actual, types, attrs))\n                else:\n                    # Read already-admitted resource guard/transition metadata;\n                    # no old opcode/version/signature/attribute/effect decision.\n                    from .hia_opcodes import OPCODES\n                    spec = OPCODES[op]\n                    self.required.update(native_effects)\n        except OpcodeRejected as exc:\n            _reject(str(exc), exc.code)\n\n        # The catalog selects the guards. These small context-dependent checks\n        # still inspect actual capabilities, never declarations or receipts.\n        for guard in spec.guards:\n            parts = guard.split(\":\")\n            rule = parts[0]\n            if rule == \"callee_interface\":\n                continue\n            name = args[int(parts[1])]\n            if rule == \"free\":\n                self.owner_free(name)\n            elif rule in {\"read\", \"write\"}:\n                self.access(name, rule == \"write\")\n            elif rule == \"distinct\":\n                if self.caps[name].root == self.caps[args[int(parts[2])]].root:\n                    _reject(op + \" may not alias one owner\", \"E_HIA_LOAN\")\n            elif rule == \"end_local_loan\":\n                if self.caps[name].external:\n                    _reject(\"callee cannot end its caller's loan\", \"E_HIA_LOAN\")\n                if self.children(name):\n                    _reject(\"end child loans before their parent\", \"E_HIA_LOAN\")\n            else:\n                _reject(\"unsupported catalog resource guard\", \"E_HIA_OPCODE\")\n        if spec.resource_transition == \"call\":\n            callee_name = _ident(attrs[\"function\"], \"callee\")\n            if callee_name not in self.functions:\n                _reject(\"unknown callee\", \"E_HIA_CALL\")\n            callee = self.functions[callee_name]\n            if len(args) != len(callee.params):\n                _reject(\"call arity mismatch\", \"E_HIA_CALL\")\n            used_owners, views = set(), []\n            for name, typ, formal in zip(args, actual, callee.params):\n                if typ != formal and not (formal == \"readbuf\" and typ == \"mutbuf\"):\n                    _reject(\"call argument type mismatch\", \"E_HIA_CALL\")\n                if typ in OWNERS:\n                    self.owner_free(name)\n                    if name in used_owners:\n                        _reject(\"owner supplied twice to call\", \"E_HIA_RESOURCE\")\n                    used_owners.add(name)\n                elif typ in {\"readbuf\", \"mutbuf\"}:\n                    self.access(name, formal == \"mutbuf\")\n                    root = self.caps[name].root\n                    if any(r == root and (m or formal == \"mutbuf\") for r, m in views):\n                        _reject(\"aliased exclusive call arguments\", \"E_HIA_LOAN\")\n                    views.append((root, formal == \"mutbuf\"))\n            if types != list(callee.returns):\n                _reject(f\"{op}: output types must be {list(callee.returns)}\", \"E_HIA_TYPE\")\n            self.required.update(callee.effects)\n\n        # Resource transitions happen only after all operand/output checks.\n        transition = spec.resource_transition\n        if transition == \"allocate\":\n            self.caps[names[0]] = _Capability(\"buffer\", names[0])\n        elif transition == \"empty_chain\":\n            self.caps[names[0]] = _Capability(\"chain\", names[0])\n        elif transition == \"chain_transfer\":\n            for name in args:\n                del self.caps[name]\n            for name, typ in zip(names, types):\n                if typ in OWNERS:\n                    self.caps[name] = _Capability(typ, name)\n        elif transition == \"chain_borrow\":\n            self.borrow(args[0], names[0], op == \"chain.head_mut\", chain_head=True)\n        elif transition == \"borrow\":\n            self.borrow(args[0], names[0], op == \"borrow.mut\")\n        elif transition in {\"end_loan\", \"drop_owner\"}:\n            del self.caps[args[0]]\n        elif transition == \"move_owner\":\n            del self.caps[args[0]]\n            self.caps[names[0]] = _Capability(actual[0], names[0])\n        elif transition == \"call\":\n            for name, typ in zip(args, actual):\n                if typ in OWNERS:\n                    del self.caps[name]\n            bindings = dict(zip(callee.param_names, args))\n            for name, typ, origin in zip(names, types, callee.return_loans):\n                if typ in OWNERS:\n                    self.caps[name] = _Capability(typ, name)\n                elif typ in {\"readbuf\", \"mutbuf\"}:\n                    self.borrow(bindings[origin], name, typ == \"mutbuf\")\n        elif transition != \"none\":\n            _reject(\"unsupported catalog resource transition\", \"E_HIA_OPCODE\")\n        self.env.update(zip(names, types))\n\n    def transfer(self, edge, target):\n        arguments = edge[\"args\"]\n        actual = [self.value(a) for a in arguments]\n        if actual != [p[\"type\"] for p in target[\"params\"]]:\n            _reject(\"edge values do not match block parameter types\", \"E_HIA_CFG\")\n        resources = [a for a, t in zip(arguments, actual) if t in RESOURCES]\n        if len(resources) != len(set(resources)):\n            _reject(\"linear capability duplicated across an edge\", \"E_HIA_RESOURCE\")\n        required = {name for name, cap in self.caps.items() if not cap.external}\n        if not required.issubset(resources):\n            _reject(\"edge drops a live owner or local loan\", \"E_HIA_RESOURCE\")\n        remap = {a: p[\"name\"] for a, p in zip(arguments, target[\"params\"])\n                 if p[\"type\"] in RESOURCES}\n        try:\n            return rename_capabilities(self.caps, remap)\n        except CapabilityFlowRejected as error:\n            _reject(str(error), error.code)\n\n    def finish(self):\n        term = self.block[\"term\"]\n        if term[\"op\"] == \"branch\" and self.value(term[\"cond\"]) != \"bool\":\n            _reject(\"branch condition is not bool\", \"E_HIA_CFG\")\n        if term[\"op\"] == \"ret\":\n            names = term[\"values\"]\n            types = [self.value(n) for n in names]\n            if types != self.fn[\"returns\"]:\n                _reject(\"return type/arity mismatch\", \"E_HIA_TYPE\")\n            loans = [n for n, t in zip(names, types) if t in {\"readbuf\", \"mutbuf\"}]\n            if len(loans) != len(set(loans)):\n                _reject(\"same loan capability returned twice\", \"E_HIA_LOAN\")\n            for name, typ, origin in zip(names, types, self.fn.get(\"return_loans\", [None] * len(types))):\n                if typ not in {\"readbuf\", \"mutbuf\"}:\n                    continue\n                cap = self.caps[name]\n                parent = self.caps.get(cap.parent)\n                if (cap.origin != origin or self.children(name)\n                        or not (cap.external or parent is not None and parent.external)):\n                    _reject(\"returned loan must be its declared parameter or a direct child\", \"E_HIA_LOAN\")\n            for name in loans:\n                del self.caps[name]\n            owners = [n for n, t in zip(names, types) if t in OWNERS]\n            if len(owners) != len(set(owners)):\n                _reject(\"same owner returned twice\", \"E_HIA_RESOURCE\")\n            for name in owners:\n                self.owner_free(name)\n                del self.caps[name]\n            if any(not cap.external for cap in self.caps.values()):\n                _reject(\"return leaves live owner/local loan\", \"E_HIA_RESOURCE\")\n        elif term[\"op\"] == \"trap\":\n            self.required.add(\"trap\")\n        if not self.required.issubset(self.fn[\"effects\"]):\n            _reject(f\"missing effects {sorted(self.required - set(self.fn['effects']))}\", \"E_HIA_EFFECT\")\n\n\ndef _primitive_structure(data):\n    from .hia_program_shape_native import selected_program_shape\n    selected=selected_program_shape(data)\n    if selected is not None:\n        return selected\n    return _reference_primitive_structure(data)\n\n\ndef _reference_primitive_structure(data, *, profile=None):\n    \"\"\"Check every declaration, shape, SSA identity, CFG edge and export.\n\n    Incremental admission never caches this pass. It establishes every\n    function interface before any function body can be reused or checked.\n    \"\"\"\n    fields = {\"schema\", \"module\", \"functions\"}\n    if type(data) is dict and \"exports\" in data:\n        fields.add(\"exports\")\n    _keys(data, fields, \"program\")\n    if type(data[\"schema\"]) is not str or data[\"schema\"] not in PRIMITIVE_SCHEMAS:\n        _reject(\"unsupported program schema\", \"E_HIA_SCHEMA\")\n    _ident(data[\"module\"], \"module\")\n    if type(data[\"functions\"]) is not list or not 1 <= len(data[\"functions\"]) <= MAX_FUNCTIONS:\n        _reject(\"invalid function inventory\", \"E_HIA_FORMAT\")\n    functions, block_maps = {}, {}\n    for fn in data[\"functions\"]:\n        if profile is None:\n            blocks = _function_shape(fn, recursive_chain=supports_feature(data[\"schema\"], \"recursive_chain\"),\n                                     parameter_loan_returns=supports_feature(data[\"schema\"], \"parameter_loan_returns\"))\n        else:\n            blocks = _reference_function_shape(fn,\n                recursive_chain=supports_feature(data[\"schema\"], \"recursive_chain\"),\n                parameter_loan_returns=supports_feature(data[\"schema\"], \"parameter_loan_returns\"),\n                profile=profile)\n        if fn[\"name\"] in functions:\n            _reject(\"duplicate function\", \"E_HIA_NAME\")\n        functions[fn[\"name\"]], block_maps[fn[\"name\"]] = fn, blocks\n    if \"exports\" in data:\n        _names(data[\"exports\"], \"explicit scalar exports\")\n        if len(data[\"exports\"]) != len(set(data[\"exports\"])):\n            _reject(\"duplicate explicit scalar export\", \"E_HIA_NAME\")\n        for name in data[\"exports\"]:\n            if name not in functions:\n                _reject(\"explicit export names a missing function\", \"E_HIA_CALL\")\n            fn = functions[name]\n            if any(p[\"type\"] not in SCALARS for p in fn[\"params\"]) or any(t not in SCALARS for t in fn[\"returns\"]):\n                _reject(\"public exports cannot carry resource descriptors\", \"E_HIA_TYPE\")\n    return functions, block_maps\n\n\ndef _function_interfaces(functions):\n    \"\"\"Detached immutable facts visible across a body-checking boundary.\"\"\"\n    return {name: _FunctionInterface(\n                tuple(p[\"type\"] for p in fn[\"params\"]),\n                tuple(p[\"name\"] for p in fn[\"params\"]),\n                tuple(fn[\"returns\"]),\n                tuple(fn.get(\"return_loans\", [None] * len(fn[\"returns\"]))),\n                frozenset(fn[\"effects\"]))\n            for name, fn in functions.items()}\n\n\ndef _verify_function(schema, fn, blocks, interfaces, *, profile=None):\n    \"\"\"Verify a closed body using its bytes and immutable callee interfaces.\n\n    V8 formal identities and returned-loan declarations are dependencies.\n    Callee bodies, caller receipts and hidden global summaries are not inputs.\n    Any future cross-function obligation must extend the cache contract first.\n    \"\"\"\n    track_origins = supports_feature(schema, \"parameter_loan_returns\") and any(\n        typ in {\"readbuf\", \"mutbuf\"} for typ in fn[\"returns\"])\n    initial = {p[\"name\"]: _Capability(p[\"type\"], p[\"name\"], external=p[\"type\"] not in OWNERS,\n                                     origin=p[\"name\"] if track_origins and p[\"type\"] not in OWNERS else None)\n               for p in fn[\"params\"] if p[\"type\"] in RESOURCES}\n    incoming = {fn[\"entry\"]: initial}\n    pending = deque([fn[\"entry\"]])\n    processed = set()\n    while pending:\n        ident = pending.popleft()\n        if ident in processed:\n            continue\n        processed.add(ident)\n        block = blocks[ident]\n        if profile is None:\n            check = _BlockCheck(fn, block, incoming[ident], interfaces, schema=schema)\n        else:\n            check = _BlockCheck(fn, block, incoming[ident], interfaces, schema=schema, profile=profile)\n        for ins in block[\"ops\"]:\n            check.instruction(ins)\n        check.finish()\n        for edge in _edges(block[\"term\"]):\n            target = edge[\"target\"]\n            state = check.transfer(edge, blocks[target])\n            if target in incoming and incoming[target] != state:\n                _reject(\"predecessors disagree on loan origins/permissions\", \"E_HIA_LOAN\")\n            if target not in incoming:\n                incoming[target] = state\n                pending.append(target)\n    if processed != set(blocks):\n        _reject(\"not all blocks were checked\", \"E_HIA_CFG\")\n\n\ndef verify_program(program) -> VerifiedProgram:\n    \"\"\"Check standalone operations and every CFG edge; no source/hash authority.\n\n    Even a manually constructed VerifiedProgram is parsed and fully rechecked.\n    Caller-owned dictionaries and decoded dictionaries never back execution.\n    \"\"\"\n    if isinstance(program, VerifiedProgram) and program.structured_bytes is not None:\n        if type(program.structured_bytes) is not bytes:\n            _reject(\"structured input must be immutable canonical bytes\", \"E_HIA_FORMAT\")\n        checked = verify_program(program.structured_bytes)\n        if (checked.structured_bytes != program.structured_bytes\n                or checked.canonical_bytes != program.canonical_bytes):\n            _reject(\"structured input and executable core differ\", \"E_HIA_CORE\")\n        return checked\n    data, raw = _decode(program)\n    if (type(data) is dict and type(data.get(\"schema\")) is str\n            and data[\"schema\"] in COMPOSITE_SCHEMAS):\n        from .hia_program_composite import elaborate_program\n        # The entire input was bounded/strictly decoded above.  The whole\n        # generated program is independently checked, with no receipt bypass.\n        core = verify_program(elaborate_program(data))\n        return VerifiedProgram(core.canonical_bytes, raw)\n    if type(data) is dict and data.get(\"schema\") == SCHEMA_V2 and \"types\" in data:\n        _reject(\"historical nominal v2 requires import_legacy_composite_v2; \"\n                \"the primitive v2 namespace cannot infer a producer profile\",\n                \"E_HIA_VERSION_COLLISION\")\n    from .hia_core_admission_native import selected_core_structure\n    selected = selected_core_structure(data, raw)\n    if selected is not None:\n        return VerifiedProgram(raw)\n    functions, block_maps = _primitive_structure(data)\n    interfaces = _function_interfaces(functions)\n    for fn in functions.values():\n        _verify_function(data[\"schema\"], fn, block_maps[fn[\"name\"]], interfaces)\n    return VerifiedProgram(raw)\n\n\ndef execute_program(program, function, arguments, **kwargs):\n    \"\"\"Convenience entry point; implementation is an independent core consumer.\"\"\"\n    from .hia_program_runtime import execute_program as execute\n    return execute(program, function, arguments, **kwargs)\n\n\n# Public language-level spelling: verification of a program, not source replay.\nverify_core = verify_program\n\n# Explicit HIA selection; original function bodies remain the default.\nfrom .hia_core_verification_selection import native_core_verification_scope as _native_core_verification_scope\n\n_core_verification_reference_reject = _reject\n\ndef _reject(message, code='E_HIA_PROGRAM'):\n    with _native_core_verification_scope() as owner:\n        if owner is None:\n            carrier = {'callee': _core_verification_reference_reject, 'message': message, 'code': code}\n            del message, code, owner\n            return carrier.pop('callee')(carrier.pop('message'), carrier.pop('code'))\n        frame = owner.prepare('_reject', (message, code))\n        del message, code\n        return owner.finish(frame)\n\n_core_verification_referenceverify_program = verify_program\n\ndef verify_program(program, *, profile=None):\n    if profile is not None:\n        if type(profile) is str and profile == \"hepta.hia.linux-file-roundtrip.v2\":\n            from .hia_linux_file_roundtrip import verify_linux_file_roundtrip_program\n            return verify_linux_file_roundtrip_program(program)\n        elif type(profile) is str and profile == \"hepta.hia.linux-file-render.v3\":\n            from .hia_linux_file_render import verify_linux_file_render_program\n            return verify_linux_file_render_program(program)\n        if type(profile) is str and profile == \"hepta.hia.linux-file.v1\":\n            from .hia_linux_file import verify_linux_file_program\n            return verify_linux_file_program(program)\n        elif type(profile) is str and profile == \"hepta.hia.linux-cli-process.v1\":\n            from .hia_linux_cli_process import verify_linux_cli_process_program\n            return verify_linux_cli_process_program(program)\n        elif type(profile) is str and profile == \"hepta.hia.linux-process.v1\":\n            from .hia_linux_process import verify_linux_process_program\n            return verify_linux_process_program(program)\n        from .hia_linux_stdio import require_profile, verify_linux_stdio_program\n        require_profile(profile)\n        return verify_linux_stdio_program(program)\n    with _native_core_verification_scope() as owner:\n        if owner is None:\n            carrier = {'callee': _core_verification_referenceverify_program, 'program': program}\n            del program, owner\n            return carrier.pop('callee')(carrier.pop('program'))\n        frame = owner.prepare('verify_program', (program,))\n        del program\n        return owner.finish(frame)\n\nverify_core = verify_program\n\n# Definition anchors never follow late global replacement or deletion.\n_NATIVE_CORE_VERIFICATION_ENTRIES = {\n    '_reject': _reject,\n    'verify_program': verify_program,\n}\n"
      },
      "before": {
        "bytes": 50055,
        "git_blob": "c3573d0588e51f576e0afa4567e684409e16acc7",
        "mode": "100644",
        "sha256": "52ded90e4ae69ceeaad54eb64378256e8bd7243646b01e65e068aeb5f22698d8"
      },
      "path": "hepta/hia_program.py"
    },
    {
      "after": {
        "bytes": 36770,
        "git_blob": "d1c95d4ea30fe9cc5a368017a61439049c74d925",
        "mode": "100644",
        "sha256": "fd47a108d8fcf55f1e0688ef1e7682b5ca808ec3dc83b751f50d4ae8e717924f",
        "text": "\"\"\"Finite direct interpreter for standalone typed HIA operations.\n\nNo source AST, source compiler, LLVM, or producer receipt participates.  Defined\nprogram traps and analysis budgets are different outcomes.  Resource counters\ndescribe the stopped program state; traps/budget stops do not pretend that an\naborting native process performed normal-path destructor cleanup.\n\"\"\"\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\n\nfrom .hia_program import (HIAProgramRejected, OWNERS, RESOURCES, SCALARS, WIDTHS,\n                          integer_range, scalar_value_valid, verify_program)\nfrom .hia_bounded_memory import fill_bytes, move_bytes\nfrom .hia_schema import supports_feature\nfrom .hia_opcodes import ExecutionObservationRejected, validate_execution_observation\n\n\nclass HIAProgramTrap(ArithmeticError):\n    \"\"\"A specified aborting program operation, not an interpreter budget.\"\"\"\n\n    def __init__(self, code, message):\n        self.code, self.report = code, None\n        super().__init__(f\"E_HIA_TRAP_{code.upper()}: {message}\")\n\n\nclass HIAProgramBudgetExceeded(RuntimeError):\n    \"\"\"A finite evaluator resource limit; says nothing about termination.\"\"\"\n\n    def __init__(self, code, message):\n        self.code, self.report = code, None\n        super().__init__(f\"E_HIA_BUDGET_{code.upper()}: {message}\")\n\n\n@dataclass(eq=False)\nclass _Owner:\n    ident: int\n    data: bytearray\n    active: bool = True\n\n\n@dataclass(eq=False)\nclass _View:\n    parent: _Owner | _View\n    mutable: bool\n    active: bool = True\n\n\n@dataclass(eq=False)\nclass _ChainNode:\n    storage: _Owner\n    payload: _Owner\n    tail: _ChainNode | None\n\n\n@dataclass(eq=False)\nclass _Chain:\n    ident: int\n    head: _ChainNode | None\n    active: bool = True\n\n\n# The native v7 object model has a 16-byte buffer descriptor and one 8-byte\n# successor pointer. Node storage is charged to the same live-byte budget as\n# user buffers, and consumes the same allocation-failure sequence.\nCHAIN_NODE_BYTES = 24\n\n\ndef _underlying(value):\n    seen = set()\n    while isinstance(value, _View):\n        if not value.active or id(value) in seen:\n            raise HIAProgramRejected(\"expired/cyclic runtime view\", \"E_HIA_RUNTIME_INVARIANT\")\n        seen.add(id(value))\n        value = value.parent\n    if not isinstance(value, _Owner) or not value.active:\n        raise HIAProgramRejected(\"expired runtime owner\", \"E_HIA_RUNTIME_INVARIANT\")\n    return value\n\n\ndef _wrap(value, typ):\n    width = WIDTHS[typ]\n    value &= (1 << width) - 1\n    if typ.startswith(\"i\") and value >= (1 << (width - 1)):\n        value -= 1 << width\n    return value\n\n\ndef _checked(value, typ):\n    lo, hi = integer_range(typ)\n    if not lo <= value <= hi:\n        raise HIAProgramTrap(\"overflow\", f\"result is outside {typ}\")\n    return value\n\n\nclass _Machine:\n    def __init__(self, program, max_steps, max_heap_bytes, allocation_fail_at, max_call_depth):\n        self.program = program\n        document = program.as_dict()\n        self.functions = {f[\"name\"]: f for f in document[\"functions\"]}\n        self.recursive_chain = supports_feature(document[\"schema\"], \"recursive_chain\")\n        self.max_steps, self.max_heap_bytes = max_steps, max_heap_bytes\n        self.allocation_fail_at, self.max_call_depth = allocation_fail_at, max_call_depth\n        self.steps = self.allocations = self.frees = self.allocation_attempts = 0\n        self.live_bytes = self.peak_bytes = self.owner_count = self.drops = 0\n        self.loans_started = self.loans_ended = 0\n        self.owners = {}\n        self.chains = {}\n        self.chains_created = self.chains_consumed = 0\n        self.chain_nodes_created = self.chain_nodes_dropped = 0\n\n    def tick(self):\n        self.steps += 1\n        if self.steps > self.max_steps:\n            raise HIAProgramBudgetExceeded(\"steps\", \"finite step limit reached\")\n\n    def resources(self):\n        result = {\"allocations\": self.allocations, \"frees\": self.frees,\n                \"allocation_attempts\": self.allocation_attempts,\n                \"owners_created\": self.owner_count, \"owners_dropped\": self.drops,\n                \"live_owners\": len(self.owners), \"live_bytes\": self.live_bytes,\n                \"peak_bytes\": self.peak_bytes,\n                \"loans_started\": self.loans_started, \"loans_ended\": self.loans_ended,\n                \"live_local_loans\": self.loans_started - self.loans_ended}\n        # Existing profiles retain the original report shape. New counters\n        # describe the recursive data structure independently of byte owners.\n        if self.recursive_chain:\n            result.update({\"chains_created\": self.chains_created,\n                           \"chains_consumed\": self.chains_consumed,\n                           \"live_chains\": len(self.chains),\n                           \"chain_nodes_created\": self.chain_nodes_created,\n                           \"chain_nodes_dropped\": self.chain_nodes_dropped,\n                           \"live_chain_nodes\": self.chain_nodes_created - self.chain_nodes_dropped})\n        return result\n\n    def new_chain(self, head=None):\n        self.chains_created += 1\n        chain = _Chain(self.chains_created, head)\n        self.chains[chain.ident] = chain\n        return chain\n\n    def chain_head(self, chain):\n        if not isinstance(chain, _Chain) or not chain.active or self.chains.get(chain.ident) is not chain:\n            raise HIAProgramRejected(\"expired runtime chain\", \"E_HIA_RUNTIME_INVARIANT\")\n        return chain.head\n\n    def consume_chain(self, chain):\n        head = self.chain_head(chain)\n        del self.chains[chain.ident]\n        chain.active, chain.head = False, None\n        self.chains_consumed += 1\n        return head\n\n    def drop_chain(self, chain):\n        head = self.consume_chain(chain)\n        # Destruction is iterative. A runtime-sized list does not consume one\n        # Python/native stack frame per node. Charge work to the step budget;\n        # an interrupted destruction is a budget stop, not claimed cleanup.\n        while head is not None:\n            self.tick()\n            tail = head.tail\n            self.drop(head.payload)\n            self.drop(head.storage)\n            self.chain_nodes_dropped += 1\n            head.tail = None\n            head = tail\n\n    def new_owner(self, data):\n        self.owner_count += 1\n        owner = _Owner(self.owner_count, data)\n        self.owners[owner.ident] = owner\n        if data:\n            self.allocations += 1\n        self.live_bytes += len(data)\n        self.peak_bytes = max(self.peak_bytes, self.live_bytes)\n        return owner\n\n    def allocate(self, size, optional):\n        # Zero-size owners are real capabilities but require no allocator call,\n        # cannot fail, and do not consume the deterministic failure injection.\n        if size == 0:\n            return self.new_owner(bytearray()), True\n        if size > (1 << 63) - 1:\n            if optional:\n                return self.new_owner(bytearray()), False\n            raise HIAProgramTrap(\"allocation\", \"allocation exceeds the 64-bit object-size model\")\n        # A host evaluator budget is not reported as a program malloc failure.\n        if size > self.max_heap_bytes - self.live_bytes:\n            raise HIAProgramBudgetExceeded(\"heap\", \"finite live-byte limit reached\")\n        self.allocation_attempts += 1\n        failed = self.allocation_fail_at == self.allocation_attempts\n        if not failed:\n            try:\n                return self.new_owner(bytearray(size)), True\n            except (MemoryError, OverflowError):\n                failed = True\n        if failed and optional:\n            return self.new_owner(bytearray()), False\n        raise HIAProgramTrap(\"allocation\", \"allocator returned failure\")\n\n    def drop(self, owner):\n        owner = _underlying(owner)\n        if owner.ident not in self.owners:\n            raise HIAProgramRejected(\"duplicate runtime drop\", \"E_HIA_RUNTIME_INVARIANT\")\n        del self.owners[owner.ident]\n        self.drops += 1\n        if owner.data:\n            self.frees += 1\n        self.live_bytes -= len(owner.data)\n        owner.active = False\n        owner.data = bytearray()\n\n    def operation(self, ins, env, depth):\n        op, attrs = ins[\"op\"], ins[\"attrs\"]\n        names = ins[\"args\"]\n        args = [env[name] for name in names]\n        outputs = ins[\"out\"]\n        typ = outputs[0][\"type\"] if outputs else None\n        result = []\n        if op == \"const\":\n            result = [attrs[\"value\"]]\n        elif op in {f\"int.{a}.{m}\" for a in (\"add\", \"sub\", \"mul\") for m in (\"checked\", \"wrap\")}:\n            a, b = args\n            kind = op.split(\".\")[1]\n            value = a + b if kind == \"add\" else a - b if kind == \"sub\" else a * b\n            result = [(_checked if op.endswith(\"checked\") else _wrap)(value, typ)]\n        elif op in {\"int.div.checked\", \"int.rem.checked\"}:\n            a, b = args\n            if b == 0:\n                raise HIAProgramTrap(\"division_by_zero\", \"integer divisor is zero\")\n            lo, _ = integer_range(typ)\n            if typ.startswith(\"i\") and a == lo and b == -1:\n                raise HIAProgramTrap(\"overflow\", \"signed minimum divided by minus one\")\n            quotient = abs(a) // abs(b)\n            if (a < 0) != (b < 0):\n                quotient = -quotient\n            result = [quotient if op == \"int.div.checked\" else a - quotient * b]\n        elif op in {\"int.shl.checked\", \"int.shr.checked\"}:\n            a, b = args\n            if not 0 <= b < WIDTHS[typ]:\n                raise HIAProgramTrap(\"overflow\", \"shift count is outside the word width\")\n            result = [_wrap(a << b, typ) if op == \"int.shl.checked\" else a >> b]\n        elif op == \"int.neg.checked\":\n            result = [_checked(-args[0], typ)]\n        elif op in {\"bit.and\", \"bit.or\", \"bit.xor\"}:\n            a, b = args\n            value = a & b if op == \"bit.and\" else a | b if op == \"bit.or\" else a ^ b\n            result = [_wrap(value, typ)]\n        elif op == \"bit.not\":\n            result = [_wrap(~args[0], typ)]\n        elif op.startswith(\"compare.\"):\n            a, b = args\n            result = [{\"compare.eq\": a == b, \"compare.ne\": a != b,\n                       \"compare.lt\": a < b, \"compare.le\": a <= b,\n                       \"compare.gt\": a > b, \"compare.ge\": a >= b}[op]]\n        elif op == \"bool.not\":\n            result = [not args[0]]\n        elif op == \"bool.and\":\n            result = [args[0] and args[1]]\n        elif op == \"bool.or\":\n            result = [args[0] or args[1]]\n        elif op == \"int.cast\":\n            result = [(_checked if attrs[\"mode\"] == \"checked\" else _wrap)(args[0], typ)]\n        elif op == \"select\":\n            result = [args[1] if args[0] else args[2]]\n        elif op in {\"buffer.new\", \"buffer.try_new\"}:\n            owner, ok = self.allocate(args[0], op == \"buffer.try_new\")\n            result = [owner] + ([ok] if op == \"buffer.try_new\" else [])\n        elif op == \"buffer.len\":\n            result = [len(_underlying(args[0]).data)]\n        elif op == \"chain.empty\":\n            result = [self.new_chain()]\n        elif op == \"chain.try_push\":\n            chain, payload = args\n            head = self.chain_head(chain)\n            _underlying(payload)\n            storage, ok = self.allocate(CHAIN_NODE_BYTES, True)\n            if ok:\n                node = _ChainNode(storage, payload, head)\n                self.chain_nodes_created += 1\n                fallback = self.new_owner(bytearray())\n                self.consume_chain(chain)\n                result = [self.new_chain(node), fallback, True]\n            else:\n                # The failed allocation's logical empty owner is internal.\n                # Both caller-owned inputs survive in fresh output names.\n                self.drop(storage)\n                self.consume_chain(chain)\n                result = [self.new_chain(head), payload, False]\n            for name in names:\n                del env[name]\n        elif op == \"chain.pop\":\n            head = self.consume_chain(args[0])\n            if head is None:\n                result = [self.new_chain(), self.new_owner(bytearray()), False]\n            else:\n                tail, payload = head.tail, head.payload\n                self.drop(head.storage)\n                self.chain_nodes_dropped += 1\n                head.tail = None\n                result = [self.new_chain(tail), payload, True]\n            del env[names[0]]\n        elif op == \"chain.is_empty\":\n            result = [self.chain_head(args[0]) is None]\n        elif op in {\"chain.head_read\", \"chain.head_mut\"}:\n            head = self.chain_head(args[0])\n            if head is None:\n                raise HIAProgramTrap(\"bounds\", \"head borrow of an empty chain\")\n            _underlying(head.payload)\n            result = [_View(head.payload, op == \"chain.head_mut\")]\n            self.loans_started += 1\n        elif op in {\"borrow.read\", \"borrow.mut\"}:\n            _underlying(args[0])\n            result = [_View(args[0], op == \"borrow.mut\")]\n            self.loans_started += 1\n        elif op == \"loan.end\":\n            view = args[0]\n            _underlying(view)\n            if not isinstance(view, _View):\n                raise HIAProgramRejected(\"end of non-view\", \"E_HIA_RUNTIME_INVARIANT\")\n            view.active = False\n            self.loans_ended += 1\n            del env[names[0]]\n        elif op == \"owner.move\":\n            if isinstance(args[0], _Chain):\n                self.chain_head(args[0])\n            else:\n                _underlying(args[0])\n            result = [env.pop(names[0])]\n        elif op == \"owner.drop\":\n            if isinstance(args[0], _Chain):\n                self.drop_chain(args[0])\n            else:\n                self.drop(args[0])\n            del env[names[0]]\n        elif op == \"buffer.load\":\n            owner, index = _underlying(args[0]), args[1]\n            if index >= len(owner.data):\n                raise HIAProgramTrap(\"bounds\", \"byte load outside the borrowed buffer\")\n            result = [owner.data[index]]\n        elif op == \"buffer.store\":\n            owner, index, value = _underlying(args[0]), args[1], args[2]\n            if not isinstance(args[0], _View) or not args[0].mutable:\n                raise HIAProgramRejected(\"write through non-mutable view\", \"E_HIA_RUNTIME_INVARIANT\")\n            if index >= len(owner.data):\n                raise HIAProgramTrap(\"bounds\", \"byte store outside the borrowed buffer\")\n            owner.data[index] = value\n        elif op == \"buffer.fill\":\n            owner, value = _underlying(args[0]), args[1]\n            if not isinstance(args[0], _View) or not args[0].mutable:\n                raise HIAProgramRejected(\"fill without a mutable view\", \"E_HIA_RUNTIME_INVARIANT\")\n            # Bounded host scratch, not an O(owner_length) temporary.\n            # The HIA Owner allocation and its declared effects are unchanged.\n            try:\n                fill_bytes(owner.data, 0, len(owner.data), value)\n            except MemoryError as exc:\n                raise HIAProgramBudgetExceeded(\"host_memory\", \"bulk fill exceeds host memory\") from exc\n        elif op == \"buffer.copy\":\n            destination, source, size = _underlying(args[0]), _underlying(args[1]), args[2]\n            if not isinstance(args[0], _View) or not args[0].mutable or not isinstance(args[1], _View):\n                raise HIAProgramRejected(\"copy requires checked mutable and shared loans\", \"E_HIA_RUNTIME_INVARIANT\")\n            if destination is source:\n                raise HIAProgramRejected(\"copy alias escaped static owner verification\", \"E_HIA_RUNTIME_INVARIANT\")\n            if size > len(destination.data) or size > len(source.data):\n                raise HIAProgramTrap(\"bounds\", \"bulk copy exceeds an owner extent\")\n            # Distinct live allocations are guaranteed by the verified roots.\n            memoryview(destination.data)[:size] = memoryview(source.data)[:size]\n        elif op == \"buffer.move_within\":\n            # Exact memmove semantics, including overlapping byte ranges.\n            # All offsets are already verified usize; prove each subrange\n            # fits before any write (subtraction cannot underflow here).\n            owner = _underlying(args[0])\n            destination, source, size = args[1:]\n            if not isinstance(args[0], _View) or not args[0].mutable:\n                raise HIAProgramRejected(\"in-place move needs a unique mutable loan\",\n                                         \"E_HIA_RUNTIME_INVARIANT\")\n            extent = len(owner.data)\n            if (destination > extent or source > extent\n                    or size > extent - destination or size > extent - source):\n                raise HIAProgramTrap(\"bounds\", \"in-place byte range exceeds owned extent\")\n            if size:\n                # Match memmove overlap semantics without O(size) host scratch.\n                try:\n                    move_bytes(owner.data, destination, source, size)\n                except MemoryError as exc:\n                    raise HIAProgramBudgetExceeded(\n                        \"host_memory\", \"in-place copy exceeds host memory\") from exc\n        elif op == \"buffer.fill_range\":\n            view, offset, size, value = args\n            owner = _underlying(view)\n            if not isinstance(view, _View) or not view.mutable:\n                raise HIAProgramRejected(\"range fill requires unique mutable loan\",\n                                         \"E_HIA_RUNTIME_INVARIANT\")\n            extent = len(owner.data)\n            if offset > extent or size > extent - offset:\n                raise HIAProgramTrap(\"bounds\", \"fill range exceeds owned extent\")\n            if size:\n                try:\n                    fill_bytes(owner.data, offset, size, value)\n                except MemoryError as exc:\n                    raise HIAProgramBudgetExceeded(\n                        \"host_memory\", \"range fill exceeds host memory\") from exc\n        elif op == \"buffer.copy_range\":\n            dest_view, src_view = args[:2]\n            destination, source = _underlying(dest_view), _underlying(src_view)\n            dst_offset, src_offset, size = args[2:]\n            if (not isinstance(dest_view, _View) or not dest_view.mutable\n                    or not isinstance(src_view, _View) or destination is source):\n                raise HIAProgramRejected(\"range copy violates checked distinct-owner loans\",\n                                         \"E_HIA_RUNTIME_INVARIANT\")\n            dst_size, src_size = len(destination.data), len(source.data)\n            if (dst_offset > dst_size or src_offset > src_size\n                    or size > dst_size - dst_offset or size > src_size - src_offset):\n                raise HIAProgramTrap(\"bounds\", \"cross-owner range copy exceeds byte extent\")\n            if size:\n                memoryview(destination.data)[dst_offset:dst_offset + size] = (\n                    memoryview(source.data)[src_offset:src_offset + size])\n        elif op == \"buffer.swap\":\n            owner = _underlying(args[0])\n            left, right = args[1:]\n            if not isinstance(args[0], _View) or not args[0].mutable:\n                raise HIAProgramRejected(\"swap needs one live mutable borrow\",\n                                         \"E_HIA_RUNTIME_INVARIANT\")\n            # Snapshot both source bytes before modifying either position.\n            if left >= len(owner.data) or right >= len(owner.data):\n                raise HIAProgramTrap(\"bounds\", \"swap byte offset outside owner extent\")\n            a, b = owner.data[left], owner.data[right]\n            owner.data[left], owner.data[right] = b, a\n        elif op == \"call\":\n            callee = self.functions[attrs[\"function\"]]\n            for name, param in zip(names, callee[\"params\"]):\n                if param[\"type\"] in OWNERS:\n                    del env[name]\n            result = self.invoke(callee, args, depth + 1)\n        else:\n            raise HIAProgramRejected(\"unhandled verified opcode\", \"E_HIA_RUNTIME_INVARIANT\")\n        if len(result) != len(outputs):\n            raise HIAProgramRejected(\"runtime result arity mismatch\", \"E_HIA_RUNTIME_INVARIANT\")\n        for output, value in zip(outputs, result):\n            if output[\"type\"] in SCALARS and not scalar_value_valid(value, output[\"type\"]):\n                raise HIAProgramRejected(\"runtime produced an invalid scalar\", \"E_HIA_RUNTIME_INVARIANT\")\n            env[output[\"name\"]] = value\n\n    def invoke(self, fn, arguments, depth=0):\n        # Root invocation occupies frame 1 (depth=0), matching the static\n        # max_call_depth budget. A limit of N admits exactly N live frames.\n        # Refuse the (N+1)th BEFORE its call-entry tick or any side effect.\n        if depth >= self.max_call_depth:\n            raise HIAProgramBudgetExceeded(\"calls\", \"finite call-depth limit reached\")\n        self.tick()\n        blocks = {b[\"id\"]: b for b in fn[\"blocks\"]}\n        current = fn[\"entry\"]\n        env = {p[\"name\"]: a for p, a in zip(fn[\"params\"], arguments)}\n        while True:\n            block = blocks[current]\n            for ins in block[\"ops\"]:\n                self.tick()\n                self.operation(ins, env, depth)\n            self.tick()\n            term = block[\"term\"]\n            if term[\"op\"] == \"ret\":\n                values = [env[name] for name in term[\"values\"]]\n                bindings = {p[\"name\"]: a for p, a in zip(fn[\"params\"], arguments)}\n                for index, (typ, origin) in enumerate(zip(fn[\"returns\"], fn.get(\"return_loans\", [None] * len(values)))):\n                    if typ not in {\"readbuf\", \"mutbuf\"}:\n                        continue\n                    value, parent = values[index], bindings[origin]\n                    _underlying(value)\n                    _underlying(parent)\n                    if (not isinstance(value, _View) or not isinstance(parent, _View)\n                            or typ == \"mutbuf\" and (not value.mutable or not parent.mutable)):\n                        raise HIAProgramRejected(\"returned view permission invariant\", \"E_HIA_RUNTIME_INVARIANT\")\n                    if value is parent:\n                        # Forwarding must not expose one consumable runtime view\n                        # as both the caller's parent and its returned child.\n                        values[index] = _View(parent, typ == \"mutbuf\")\n                        self.loans_started += 1\n                    elif value.parent is not parent:\n                        raise HIAProgramRejected(\"returned view origin invariant\", \"E_HIA_RUNTIME_INVARIANT\")\n                return values\n            if term[\"op\"] == \"trap\":\n                raise HIAProgramTrap(term[\"code\"], \"explicit core trap\")\n            edge = term if term[\"op\"] == \"jump\" else term[\"then\"] if env[term[\"cond\"]] else term[\"else\"]\n            target = blocks[edge[\"target\"]]\n            values = [env[name] for name in edge[\"args\"]]\n            # All block inputs are evaluated simultaneously. Loop iterations\n            # create new dynamic instances of the same static SSA names.\n            env = {p[\"name\"]: a for p, a in zip(target[\"params\"], values)}\n            current = target[\"id\"]\n\n    def report(self, function, status, values=None, error=None, *, external_roots=()):\n        # Borrowed entry storage belongs to its caller, not this VM's heap.\n        # Accept actual live roots from the reference adapter, not a producer's\n        # reported count. This preserves the aggregate loan-backing invariant;\n        # it is not a new proof of the complete dynamic view graph.\n        if (type(external_roots) is not tuple\n                or any(type(root) is not _Owner or type(root.ident) is not int\n                       or root.ident >= 0 or root.active is not True\n                       or type(root.data) is not bytearray for root in external_roots)\n                or len({id(root) for root in external_roots}) != len(external_roots)\n                or len({root.ident for root in external_roots}) != len(external_roots)\n                or len({id(root.data) for root in external_roots}) != len(external_roots)\n                or any(root.ident in self.owners\n                       or any(root is owner for owner in self.owners.values())\n                       for root in external_roots)):\n            raise HIAProgramRejected(\"invalid external runtime roots\", \"E_HIA_RUNTIME_INVARIANT\")\n        resources = self.resources()\n        try:\n            validate_execution_observation(status, resources, steps=self.steps,\n                max_steps=self.max_steps, max_heap_bytes=self.max_heap_bytes,\n                error_code=error.code if error is not None else None,\n                with_chains=self.recursive_chain, allow_host_memory=True,\n                live_external_roots=len(external_roots))\n        except ExecutionObservationRejected as exc:\n            raise HIAProgramRejected(str(exc), \"E_HIA_RUNTIME_INVARIANT\") from exc\n        result = {\"schema\": \"hepta.hia.program-execution.v1\", \"status\": status,\n                  \"program_sha256\": self.program.sha256, \"function\": function,\n                  \"input_sha256\": self.program.input_sha256,\n                  \"steps\": self.steps, \"resources\": resources,\n                  \"word_bits\": 64, \"source_used\": False,\n                  \"claims\": {\"finite_core_execution\": True,\n                             \"whole_language_soundness_proved\": False,\n                             \"backend_refinement_proved\": False}}\n        if values is not None:\n            result[\"values\"] = values\n            result[\"result\"] = values[0] if len(values) == 1 else values\n        if error is not None:\n            result[\"error\"] = {\"code\": error.code, \"message\": str(error)}\n        return result\n\n\ndef execute_program(program, function, arguments, *, max_steps=1_000_000,\n                    max_heap_bytes=16 * 1024 * 1024, allocation_fail_at=None,\n                    max_call_depth=256, bounded_resource_limits=None,\n                    profile=None, linux_stdio_provider=None,\n                    linux_process_startup=None, linux_process_provider=None, linux_cli_components=None, linux_file_provider=None,\n                    linux_file_render_components=None, linux_file_roundtrip_components=None):\n    \"\"\"Verify immutable bytes, then execute a scalar public entry point.\n\n    Owners and views can be created, moved and called internally. Python callers\n    cannot fabricate them: public interpreter inputs/outputs are scalar values.\n    Resource-returning functions remain available as internal core functions.\n    \"\"\"\n    if linux_file_roundtrip_components is not None and not (\n            type(profile) is str and profile == \"hepta.hia.linux-file-roundtrip.v2\"):\n        raise HIAProgramRejected(\"roundtrip components require their exact profile\",\n                                 \"E_HIA_LINUX_FILE_ROUNDTRIP_PROFILE\")\n    if profile is not None:\n        if type(profile) is str and profile == \"hepta.hia.linux-file-roundtrip.v2\":\n            from .hia_linux_file_roundtrip import execute_linux_file_roundtrip\n            if (bounded_resource_limits is not None or linux_stdio_provider is not None\n                    or linux_process_provider is not None or linux_cli_components is not None\n                    or linux_file_render_components is not None):\n                raise HIAProgramRejected(\"separate file-render authority required\", \"E_HIA_LINUX_FILE_RENDER_PROFILE\")\n            return execute_linux_file_roundtrip(program, function, arguments,\n                provider=linux_file_provider, startup=linux_process_startup,\n                components=linux_file_roundtrip_components,\n                max_steps=max_steps, max_heap_bytes=max_heap_bytes,\n                allocation_fail_at=allocation_fail_at, max_call_depth=max_call_depth)\n        elif type(profile) is str and profile == \"hepta.hia.linux-file-render.v3\":\n            from .hia_linux_file_render import execute_linux_file_render\n            if (bounded_resource_limits is not None or linux_stdio_provider is not None\n                    or linux_process_provider is not None or linux_cli_components is not None):\n                raise HIAProgramRejected(\"separate file-render authority required\", \"E_HIA_LINUX_FILE_RENDER_PROFILE\")\n            return execute_linux_file_render(program, function, arguments,\n                provider=linux_file_provider, startup=linux_process_startup,\n                components=linux_file_render_components,\n                max_steps=max_steps, max_heap_bytes=max_heap_bytes,\n                allocation_fail_at=allocation_fail_at, max_call_depth=max_call_depth)\n        if linux_file_render_components is not None:\n            raise HIAProgramRejected(\"file-render components require their exact profile\", \"E_HIA_LINUX_FILE_RENDER_PROFILE\")\n        if type(profile) is str and profile == \"hepta.hia.linux-file.v1\":\n            from .hia_linux_file import execute_linux_file\n            if (bounded_resource_limits is not None or linux_stdio_provider is not None\n                    or linux_process_provider is not None or linux_cli_components is not None):\n                raise HIAProgramRejected(\"separate file-profile authority required\", \"E_HIA_LINUX_FILE_PROFILE\")\n            return execute_linux_file(program, function, arguments,\n                provider=linux_file_provider, startup=linux_process_startup,\n                max_steps=max_steps, max_heap_bytes=max_heap_bytes,\n                allocation_fail_at=allocation_fail_at, max_call_depth=max_call_depth)\n        if linux_file_provider is not None:\n            raise HIAProgramRejected(\"file provider requires exact file profile\", \"E_HIA_LINUX_FILE_PROFILE\")\n        if type(profile) is str and profile == \"hepta.hia.linux-cli-process.v1\":\n            from .hia_linux_cli_process import execute_linux_cli_process\n            if bounded_resource_limits is not None or linux_stdio_provider is not None:\n                raise HIAProgramRejected(\"separate CLI-process authority required\", \"E_HIA_LINUX_CLI_PROCESS_PROFILE\")\n            return execute_linux_cli_process(program, function, arguments,\n                provider=linux_process_provider, startup=linux_process_startup, components=linux_cli_components,\n                max_steps=max_steps, max_heap_bytes=max_heap_bytes,\n                allocation_fail_at=allocation_fail_at, max_call_depth=max_call_depth)\n        if linux_cli_components is not None:\n            raise HIAProgramRejected(\"CLI components require exact CLI profile\", \"E_HIA_LINUX_CLI_PROCESS_PROFILE\")\n        if type(profile) is str and profile == \"hepta.hia.linux-process.v1\":\n            from .hia_linux_process import execute_linux_process\n            if bounded_resource_limits is not None or linux_stdio_provider is not None:\n                raise HIAProgramRejected(\"separate process-profile authority and provider required\",\n                                         \"E_HIA_LINUX_PROCESS_PROFILE\")\n            return execute_linux_process(program, function, arguments,\n                provider=linux_process_provider, startup=linux_process_startup,\n                max_steps=max_steps, max_heap_bytes=max_heap_bytes,\n                allocation_fail_at=allocation_fail_at, max_call_depth=max_call_depth)\n        if linux_process_startup is not None or linux_process_provider is not None:\n            raise HIAProgramRejected(\"startup authority requires the exact process profile\",\n                                     \"E_HIA_LINUX_PROCESS_PROFILE\")\n        from .hia_linux_stdio import require_profile, execute_linux_stdio\n        require_profile(profile)\n        if bounded_resource_limits is not None:\n            raise HIAProgramRejected(\"ordinary Core budget receipts do not admit Linux I/O\",\n                                     \"E_HIA_LINUX_STDIO_PROFILE\")\n        return execute_linux_stdio(program, function, arguments, provider=linux_stdio_provider,\n            max_steps=max_steps, max_heap_bytes=max_heap_bytes,\n            allocation_fail_at=allocation_fail_at, max_call_depth=max_call_depth)\n    if linux_stdio_provider is not None or linux_process_startup is not None or linux_process_provider is not None or linux_cli_components is not None or linux_file_provider is not None or linux_file_render_components is not None:\n        raise HIAProgramRejected(\"physical-effect provider requires an explicit profile\",\n                                 \"E_HIA_LINUX_STDIO_PROFILE\")\n    checked = verify_program(program)\n    if (type(function) is not str or type(arguments) not in (list, tuple)\n            or type(max_steps) is not int or not 1 <= max_steps <= 10_000_000\n            or type(max_heap_bytes) is not int or not 0 <= max_heap_bytes <= 1024 * 1024 * 1024\n            or type(max_call_depth) is not int or not 1 <= max_call_depth <= 256\n            or allocation_fail_at is not None and\n               (type(allocation_fail_at) is not int or allocation_fail_at < 1)):\n        raise HIAProgramRejected(\"invalid entry arguments/evaluator limits\", \"E_HIA_INPUT\")\n    # Validate and execute one immutable invocation. The caller may mutate an\n    # exact list while scalar validation runs; rereading it after validation\n    # could substitute an untyped value, change arity or alter an allocation\n    # extent. Admitted scalar values themselves are immutable built-ins.\n    arguments = tuple(arguments)\n    if function not in checked.scalar_entrypoints:\n        raise HIAProgramRejected(\"nominal/internal signatures are not public scalar entries\", \"E_HIA_INPUT\")\n    budget = None\n    if bounded_resource_limits is not None:\n        from .hia_static_budget import HIAStaticBudgetRejected, qualify_bounded_resources\n        budget = qualify_bounded_resources(checked, limits=bounded_resource_limits)\n        row = next(row for row in budget[\"exports\"] if row[\"function\"] == function)\n        # Smaller evaluator limits remain meaningful, but cannot silently\n        # invalidate the finite profile promised for this invocation.\n        if (max_steps < row[\"max_vm_ticks\"] or max_heap_bytes < row[\"max_live_heap_bytes\"]\n                or max_call_depth < row[\"max_call_depth\"]):\n            raise HIAStaticBudgetRejected(\"E_HIA_BUDGET_POLICY\",\n                \"evaluator limits are below the selected entry's qualified resource bounds\")\n        max_steps = min(max_steps, budget[\"limits\"][\"max_vm_ticks\"])\n        max_heap_bytes = min(max_heap_bytes, budget[\"limits\"][\"max_live_heap_bytes\"])\n        max_call_depth = min(max_call_depth, budget[\"limits\"][\"max_call_depth\"])\n    from .hia_program_execution_native import selected_program_execution\n    native = selected_program_execution()\n    if native is not None:\n        try:\n            observed = native.execute(checked, function, arguments, max_steps=max_steps,\n                max_