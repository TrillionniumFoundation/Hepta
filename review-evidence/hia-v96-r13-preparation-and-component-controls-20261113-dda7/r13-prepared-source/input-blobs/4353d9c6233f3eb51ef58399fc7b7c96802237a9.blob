                           'private_workspace_bytes': 67108864,\n                                     'maximum_result_bytes': 67108864,\n                                     'continuation_kinds': 12,\n                                     'issued_frame_custody': 'exact current result and bound graph before '\n                                                             'service; public counter/admission permission '\n                                                             'is consumed once before owner writes',\n                                     'downstream_image_custody': 'each requested image is held through '\n                                                                 'execution; selector replacement cannot '\n                                                                 'choose a hosted path',\n                                     'task_helper_cache': 'selected HIA cache is required at helper '\n                                                          'continuation, including hits; exact image '\n                                                          'forwarded privately',\n                                     'host_boundaries': ['opaque foreign values, ordered native services '\n                                                         'and complete object transport'],\n                                     'public_program_limits_unchanged': True,\n                                     'default_changed': False,\n                                     'old_host_owners_removed': False,\n                                     'whole_native_delivery_qualified': False},\n         'native_task_helper_cache': {'source': 'examples/hia_bootstrap/task_helper_cache.hepta',\n                                      'selection': 'explicit HEPTA_HIA_TASK_HELPER_CACHE_MANIFEST; exact '\n                                                   'held image from native function continuations',\n                                      'native_owners': ['cache key admission and 