HEPTA_HIA_MACHINE_PLAN_MANIFEST',\n            'simultaneous_family_selection': 'refuse before owner admission',\n            'integration_status': 'PENDING_MATCHING_SOURCE_COLD_AND_COMPLETE_CALLER_QUALIFICATION',\n            'default_changed': False,\n            'old_host_owners_removed': False,\n            'whole_native_delivery_qualified': False,\n        },\n        'native_backend_bundle_protocols': {\n            'original_main_families': {\n                'core_lowering': 'HEPTA_HIA_CORE_LOWERING_MANIFEST',\n                'core_emitter': 'HEPTA_HIA_CORE_EMITTER_MANIFEST',\n                'byte_wrapper': 'HEPTA_HIA_BYTE_WRAPPER_MANIFEST',\n                'machine_object': 'HEPTA_HIA_MACHINE_OBJECT_MANIFEST',\n                'execution_observation': 'HEPTA_HIA_EXECUTION_OBSERVATION_MANIFEST',\n            },\n            'custody': 'original source-bound bundle, immutable unit images and actual mapped pool capabilities',\n            'scheduling_and_continuation': 'preserve original main pinned bundle and scheduling scopes',\n            'independent_single_image_control_families': True,\n            'simultaneous_competing_family_selection': 'refuse before manifest or executable admission',\n            'whole_emission_absence_is_captured': True,\n            'original_reference_bodies_retained': True,\n            'integration_status': 'PENDING_MATCHING_SOURCE_COLD_AND_COMPLETE_NATIVE_QUALIFICATION',\n            'default_changed': False,\n            'old_host_owners_removed': False,\n            'whole_native_delivery_qualified': False,\n        },\n    }\n\n\ndef validate_contract(root=ROOT):\n    root = Path(root)\n    path = root / CONTRACT_PATH\n    declared = json.loads(path.read_text())\n    expected = support_contract(root)\n    if declared != expected:\n        raise ValueError(\"Selfhost-Core support contract differs from the current source closure\")\n    return declared\n"
