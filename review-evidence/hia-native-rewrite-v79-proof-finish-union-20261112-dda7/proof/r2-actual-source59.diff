+            except StopIteration: return False
+            return True
+        elif action == 802:
+            if d['item']['type'] in set(d['WIDTHS'])|{'bool'}: return True
+            return False
+        elif action == 852:
+            if d['item'] in set(d['WIDTHS'])|{'bool','unit'}: return True
+            return False
