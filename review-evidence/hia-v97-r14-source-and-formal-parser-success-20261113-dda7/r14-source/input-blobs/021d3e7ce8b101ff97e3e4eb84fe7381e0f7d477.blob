lue\":0}\n  v67:bool = compare.le(v59,v66)\n  branch v67 b9(v54) b10(v54,v55,v56,v57,v58,v59)\nblock b9(v68:mutbuf)\n  v80:u64 = const() {\"value\":1}\n  ret(v80)\nblock b10(v74:mutbuf,v75:u64,v76:u64,v77:u64,v78:u64,v79:i64)\n  v81:u64 = int.cast(v79) {\"mode\":\"wrap\"}\n  v82:u64 = int.add.wrap(v78,v81)\n  jump b1(v74,v75,v76,v77,v82)\nend\nfn f5(v0:mutbuf,v1:u64,v2:u64) -> (u64) effects(read,write,trap,linux_io,linux_startup,linux_file,linux_render) entry(b0)\nblock b0(v0:mutbuf,v1:u64,v2:u64)\n  v3:u64 = const() {\"value\":0}\n  jump b1(v0,v1,v2,v3,v3)\nblock b1(v4:mutbuf,v5:u64,v6:u64,v7:u64,v8:u64)\n  v9:bool = compare.lt(v8,v6)\n  branch v9 b2(v4,v5,v6,v7,v8) b3(v4,v7)\nblock b2(v10:mutbuf,v11:u64,v12:u64,v13:u64,v14:u64)\n  v20:u64 = int.add.wrap(v11,v14)\n  v21:usize = int.cast(v20) {\"mode\":\"wrap\"}\n  v22:u8 = buffer.load(v10,v21)\n  v23:u64 = int.cast(v22) {\"mode\":\"wrap\"}\n  v24:u64 = const() {\"value\":8}\n  v25:u64 = int.mul.wrap(v14,v24)\n  v26:u64 = int.shl.checked(v23,v25)\n  v27:u64 = bit.or(v13,v26)\n  v28:u64 = const() {\"value\":1}\n  v29:u64 = int.add.wrap(v14,v28)\n  jump b1(v10,v11,v12,v27,v29)\nblock b3(v15:mutbuf,v18:u64)\n  ret(v18)\nend\nfn f6(v0:mutbuf,v1:u64,v2:u64,v3:u64) -> (u64) effects(read,write,trap,linux_io,linux_startup,linux_file,linux_render) entry(b0)\nblock b0(v0:mutbuf,v1:u64,v2:u64,v3:u64)\n  v4:u64 = const() {\"value\":0}\n  jump b1(v0,v1,v2,v3,v4)\nblock b1(v5:mutbuf,v6:u64,v7:u64,v8:u64,v9:u64)\n  v10:bool = compare.lt(v9,v8)\n  branch v10 b2(v5,v6,v7,v8,v9) b3(v5)\nblock b2(v11:mutbuf,v12:u64,v13:u64,v14:u64,v15:u64)\n  v21:u64 = int.add.wrap(v12,v15)\n  v22:u64 = const() {\"value\":8}\n  v23:u64 = int.mul.wrap(v15,v22)\n  v24:u64 = int.shr.checked(v13,v23)\n  v25:u64 = const() {\"value\":255}\n  v26:u64 = bit.and(v24,v25)\n  v27:usize = int.cast(v21) {\"mode\":\"wrap\"}\n  v28:u8 = int.cast(v26) {\"mode\":\"wrap\"}\n  _ = buffer.store(v11,v27,v28)\n  v29:u64 = const() {\"value\":1}\n  v30:u64 = int.add.wrap(v15,v29)\n  jump b1(v11,v12,v13,v14,v30)\nblock b3(v16:mutbuf)\n  v31:u64 = const() {\"value\":0}\n  ret(v31)\nend\n"
