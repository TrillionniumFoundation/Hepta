    {
      "after": {
        "bytes": 23861,
        "git_blob": "a5aa0d83d952ea947214e95cbb9fdb41916afe5f",
        "mode": "100644",
        "sha256": "da02c234abb788e19065aae1b889ed5b0daef66951553b98073364809b0d5c12",
        "text": "\"\"\"Compact, deterministic spelling of checked primitive HIA Core.\n\nThis frontend supplies syntax only. Types, effects, ownership, calls, CFG edges,\ninteger modes and attributes stay explicit, and the existing whole-program\nverifier remains the sole semantic authority. No expression synthesis, repair,\nautomatic cast, inferred cleanup, optimizer, or second evaluator lives here.\n\"\"\"\nfrom __future__ import annotations\n\nfrom hashlib import sha256\nimport json\nimport re\n\nfrom .hia_json_preflight import preflight_hia_json\nfrom .hia_program import HIAProgramRejected, VerifiedProgram, verify_program\nfrom .hia_program_tools import HIAEditRejected, decode_json\nfrom .hia_schema import SCHEMA_V6, SCHEMA_V7, SCHEMA_V8\n\nASSEMBLY_SCHEMA = \"hepta.hia.agent-assembly.v1\"\nWIRE_HEADER = \"hia-asm.v1\"\nCORE_SCHEMAS = frozenset({SCHEMA_V6, SCHEMA_V7, SCHEMA_V8})\nMAX_SOURCE_BYTES = 1024 * 1024\nMAX_LINES = 16384\nMAX_LINE_BYTES = 16384\nMAX_FUNCTIONS = 256\nMAX_BLOCKS = 4096\nMAX_OPERATIONS = 16384\nMAX_LIST_ITEMS = 256\nMAX_ATTRIBUTE_NODES = 2048\nMAX_ATTRIBUTE_DEPTH = 16\n\n_NAME = r\"[A-Za-z_][A-Za-z_0-9]{0,127}\"\n_OPCODE = r\"[A-Za-z_][A-Za-z_0-9.]{0,127}\"\n_HEADER = re.compile(rf\"{re.escape(WIRE_HEADER)}\\s+(\\S+)\\s+({_NAME})\")\n_FUNCTION = re.compile(\n    rf\"fn\\s+({_NAME})\\(([^()]*)\\)\\s*->\\s*\\(([^()]*)\\)\"\n    rf\"\\s+effects\\(([^()]*)\\)\\s+entry\\(({_NAME})\\)\"\n    rf\"(?:\\s+return_loans\\(([^()]*)\\))?\")\n_BLOCK = re.compile(rf\"block\\s+({_NAME})\\(([^()]*)\\)\")\n_INSTRUCTION = re.compile(rf\"([^=]+)\\s*=\\s*({_OPCODE})\\(([^()]*)\\)(?:\\s+(.*))?\")\n_RETURN = re.compile(r\"ret\\(([^()]*)\\)\")\n_JUMP = re.compile(rf\"jump\\s+({_NAME})\\(([^()]*)\\)\")\n_BRANCH = re.compile(rf\"branch\\s+({_NAME})\\s+({_NAME})\\(([^()]*)\\)\\s+({_NAME})\\(([^()]*)\\)\")\n_TRAP = re.compile(rf\"trap\\s+({_NAME})\")\n_SOURCE_CONTROL = re.compile(r\"[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\ufeff]\")\n\n\nclass HIAAssemblyRejected(HIAProgramRejected):\n    \"\"\"A bounded syntax/representation refusal or the original Core refusal.\"\"\"\n\n    def __init__(self, message, code=\"E_HIA_ASSEMBLY\", *, line=None, phase=\"syntax\"):\n        self.line = line\n        self.phase = phase\n        super().__init__((f\"line {line}: \" if line is not None else \"\") + message, code)\n\n\ndef _reject(message, *, line=None, limit=False):\n    raise HIAAssemblyRejected(message, \"E_HIA_ASSEMBLY_LIMIT\" if limit else \"E_HIA_ASSEMBLY\",\n                              line=line)\n\n\ndef _source(value):\n    if type(value) not in (str, bytes):\n        _reject(\"source must be UTF-8 text or bytes\")\n    if len(value) > MAX_SOURCE_BYTES:\n        _reject(\"source exceeds byte budget\", limit=True)\n    try:\n        raw = value.encode(\"utf-8\") if type(value) is str else value\n        if len(raw) > MAX_SOURCE_BYTES:\n            _reject(\"source exceeds byte budget\", limit=True)\n        text = raw.decode(\"utf-8\")\n    except UnicodeError as exc:\n        raise HIAAssemblyRejected(\"source is not valid UTF-8\") from exc\n    # LF and optional CRLF are the only line separators. Do not let Unicode\n    # splitlines(), NUL, BOM or terminal controls change visible tokenization.\n    # The pattern is the exact rejected set from the character-wise check:\n    # ASCII controls except TAB/LF/CR, plus BOM. UTF-8 and source-size checks\n    # still precede it, and the separate CRLF/line checks still follow it.\n    if _SOURCE_CONTROL.search(text) is not None:\n        _reject(\"unsupported control character or byte-order mark\")\n    lines = text.split(\"\\n\")\n    if len(lines) > MAX_LINES:\n        _reject(\"source exceeds line budget\", limit=True)\n    for number, line in enumerate(lines, 1):\n        if len(line.encode(\"utf-8\")) > MAX_LINE_BYTES:\n            _reject(\"line exceeds byte budget\", line=number, limit=True)\n        if \"\\r\" in line.removesuffix(\"\\r\"):\n            _reject(\"carriage return must be part of CRLF\", line=number)\n    return raw, lines\n\n\ndef _items(value, line):\n    if not value.strip():\n        return []\n    parts = [part.strip() for part in value.split(\",\")]\n    if len(parts) > MAX_LIST_ITEMS:\n        _reject(\"list exceeds item budget\", line=line, limit=True)\n    if any(not part for part in parts):\n        _reject(\"empty list item\", line=line)\n    return parts\n\n\ndef _names(value, line):\n    parts = _items(value, line)\n    if any(re.fullmatch(_NAME, part) is None for part in parts):\n        _reject(\"expected explicit ASCII names\", line=line)\n    return parts\n\n\ndef _parameters(value, line):\n    result = []\n    for part in _items(value, line):\n        match = re.fullmatch(rf\"({_NAME})\\s*:\\s*({_NAME})\", part)\n        if match is None:\n            _reject(\"expected name:type for every value\", line=line)\n        result.append({\"name\": match[1], \"type\": match[2]})\n    return result\n\n\ndef _attrs(value, line):\n    if value is None:\n        return {}\n    try:\n        preflight_hia_json(value, max_nodes=MAX_ATTRIBUTE_NODES,\n                          max_depth=MAX_ATTRIBUTE_DEPTH)\n        attrs = decode_json(value)\n    except (ValueError, OverflowError, HIAEditRejected) as exc:\n        raise HIAAssemblyRejected(\"attributes require bounded strict JSON\", line=line) from exc\n    if type(attrs) is not dict:\n        _reject(\"attributes must be one JSON object\", line=line)\n    return attrs\n\n\ndef _parse_assembly_document(source: str | bytes) -> dict:\n    \"\"\"Construct a fresh syntax document without granting Core authority.\n\n    The same source, syntax and attribute bounds apply. The returned mutable\n    document is not verified; public callers use assemble_program. Internal\n    fixture authors may transform it before their final independent admission.\n    No parsed document, VerifiedProgram or admission result is cached.\n    \"\"\"\n    _, lines = _source(source)\n    document = None\n    function = block = None\n    blocks = operations = 0\n    for number, raw in enumerate(lines, 1):\n        line = raw.removesuffix(\"\\r\").strip(\" \\t\")\n        if not line:\n            continue\n        if document is None:\n            match = _HEADER.fullmatch(line)\n            if match is None or match[1] not in CORE_SCHEMAS:\n                _reject(\"expected hia-asm.v1, explicit primitive v6/v7/v8 schema, and module\", line=number)\n            document = {\"schema\": match[1], \"module\": match[2], \"functions\": []}\n            continue\n        if function is None:\n            exports = re.fullmatch(r\"exports\\(([^()]*)\\)\", line)\n            if exports is not None:\n                if \"exports\" in document or document[\"functions\"]:\n                    _reject(\"exports may occur once, before all functions\", line=number)\n                document[\"exports\"] = _names(exports[1], number)\n                continue\n            match = _FUNCTION.fullmatch(line)\n            if match is None:\n                _reject(\"expected explicit function header\", line=number)\n            if len(document[\"functions\"]) >= MAX_FUNCTIONS:\n                _reject(\"function inventory exceeds budget\", line=number, limit=True)\n            function = {\"name\": match[1], \"params\": _parameters(match[2], number),\n                        \"returns\": _names(match[3], number), \"effects\": _names(match[4], number),\n                        \"entry\": match[5], \"blocks\": []}\n            if match[6] is not None:\n                if document[\"schema\"] != SCHEMA_V8:\n                    _reject(\"return_loans requires explicit Core v8\", line=number)\n                try:\n                    preflight_hia_json(match[6], max_nodes=MAX_LIST_ITEMS + 1, max_depth=2)\n                    origins = decode_json(match[6])\n                except (ValueError, OverflowError, HIAEditRejected) as exc:\n                    raise HIAAssemblyRejected(\"return_loans requires bounded strict JSON\", line=number) from exc\n                if (type(origins) is not list or len(origins) > MAX_LIST_ITEMS\n                        or any(x is not None and (type(x) is not str or re.fullmatch(_NAME, x) is None)\n                               for x in origins)):\n                    _reject(\"return_loans requires a list of formal names or null\", line=number)\n                function[\"return_loans\"] = origins\n            document[\"functions\"].append(function)\n            block = None\n            continue\n        if line == \"end\":\n            if block is None or \"term\" not in block:\n                _reject(\"function must end after a block terminator\", line=number)\n            function = block = None\n            continue\n        match = _BLOCK.fullmatch(line)\n        if match is not None:\n            if block is not None and \"term\" not in block:\n                _reject(\"previous block has no terminator\", line=number)\n            blocks += 1\n            if blocks > MAX_BLOCKS:\n                _reject(\"block inventory exceeds budget\", line=number, limit=True)\n            block = {\"id\": match[1], \"params\": _parameters(match[2], number), \"ops\": []}\n            function[\"blocks\"].append(block)\n            continue\n        if block is None or \"term\" in block:\n            _reject(\"expected block header or function end\", line=number)\n        if match := _RETURN.fullmatch(line):\n            block[\"term\"] = {\"op\": \"ret\", \"values\": _names(match[1], number)}\n        elif match := _JUMP.fullmatch(line):\n            block[\"term\"] = {\"op\": \"jump\", \"target\": match[1], \"args\": _names(match[2], number)}\n        elif match := _BRANCH.fullmatch(line):\n            block[\"term\"] = {\"op\": \"branch\", \"cond\": match[1],\n                             \"then\": {\"target\": match[2], \"args\": _names(match[3], number)},\n                             \"else\": {\"target\": match[4], \"args\": _names(match[5], number)}}\n        elif match := _TRAP.fullmatch(line):\n            block[\"term\"] = {\"op\": \"trap\", \"code\": match[1]}\n        elif match := _INSTRUCTION.fullmatch(line):\n            operations += 1\n            if operations > MAX_OPERATIONS:\n                _reject(\"operation inventory exceeds budget\", line=number, limit=True)\n            block[\"ops\"].append({\"op\": match[2], \"args\": _names(match[3], number),\n                                 \"out\": [] if match[1].strip() == \"_\" else _parameters(match[1], number),\n                                 \"attrs\": _attrs(match[4], number)})\n        else:\n            _reject(\"expected typed instruction or explicit terminator\", line=number)\n    if document is None:\n        _reject(\"missing assembly header\")\n    if function is not None:\n        _reject(\"unterminated function; explicit end required\", line=len(lines))\n    return document\n\n\ndef assemble_program(source: str | bytes) -> VerifiedProgram:\n    \"\"\"Translate explicit assembly to Core and reverify the entire program.\n\n    v6/v7/v8 are the text targets. Historical schemas require their existing\n    explicit adapters, and nominal layouts require their existing elaborator.\n    \"\"\"\n    document = _parse_assembly_document(source)\n    try:\n        return verify_program(document)\n    except HIAProgramRejected as exc:\n        # Core errors are kept as Core errors. An absent location is honest:\n        # assigning a guessed syntax line would misidentify cross-block errors.\n        raise HIAAssemblyRejected(str(exc).removeprefix(exc.code + \": \"), exc.code,\n                                  phase=\"core_verification\") from exc\n\n\ndef _render_parameters(parameters):\n    return \",\".join(p[\"name\"] + \":\" + p[\"type\"] for p in parameters)\n\n\ndef _render_assembly_document(data: dict) -> str:\n    \"\"\"Spell a construction document without claiming it is valid Core.\n\n    The input remains owned by the caller and is only read. This helper grants\n    no VerifiedProgram or execution authority and performs no admission. The\n    public renderer below still fully verifies both the input and round trip.\n    \"\"\"\n    lines = [f'{WIRE_HEADER} {data[\"schema\"]} {data[\"module\"]}']\n    if \"exports\" in data:\n        lines.append(\"exports(\" + \",\".join(data[\"exports\"]) + \")\")\n    for function in data[\"functions\"]:\n        lines.append(f'fn {function[\"name\"]}({_render_parameters(function[\"params\"])}) -> '\n                     f'({\",\".join(function[\"returns\"])}) effects({\",\".join(function[\"effects\"])}) '\n                     f'entry({function[\"entry\"]})')\n        if \"return_loans\" in function:\n            lines[-1] += \" return_loans(\" + json.dumps(function[\"return_loans\"], separators=(\",\", \":\")) + \")\"\n        for block in function[\"blocks\"]:\n            lines.append(f'block {block[\"id\"]}({_render_parameters(block[\"params\"])})')\n            for instruction in block[\"ops\"]:\n                outputs = _render_parameters(instruction[\"out\"]) or \"_\"\n                text = f'  {outputs} = {instruction[\"op\"]}({\",\".join(instruction[\"args\"])})'\n                if instruction[\"attrs\"]:\n                    text += \" \" + json.dumps(instruction[\"attrs\"], sort_keys=True, separators=(\",\", \":\"),\n                                             ensure_ascii=False, allow_nan=False)\n                lines.append(text)\n            term = block[\"term\"]\n            if term[\"op\"] == \"ret\":\n                text = \"ret(\" + \",\".join(term[\"values\"]) + \")\"\n            elif term[\"op\"] == \"jump\":\n                text = f'jump {term[\"target\"]}({\",\".join(term[\"args\"])})'\n            elif term[\"op\"] == \"branch\":\n                left, right = term[\"then\"], term[\"else\"]\n                text = (f'branch {term[\"cond\"]} {left[\"target\"]}({\",\".join(left[\"args\"])}) '\n                        f'{right[\"target\"]}({\",\".join(right[\"args\"])})')\n            else:\n                text = \"trap \" + term[\"code\"]\n            lines.append(\"  \" + text)\n        lines.append(\"end\")\n    return \"\\n\".join(lines) + \"\\n\"\n\n\ndef render_assembly(document) -> str:\n    \"\"\"Canonical compact text whose exact primitive Core round trip is checked.\"\"\"\n    checked = verify_program(document)\n    data = checked.as_dict()\n    if checked.structured_bytes is not None or data[\"schema\"] not in CORE_SCHEMAS:\n        raise HIAAssemblyRejected(\"render requires explicit primitive v6/v7/v8 Core; use the existing adapter first\",\n                                  \"E_HIA_ASSEMBLY_PROFILE\", phase=\"representation\")\n    rendered = _render_assembly_document(data)\n    if assemble_program(rendered).canonical_bytes != checked.canonical_bytes:\n        raise HIAAssemblyRejected(\"renderer changed canonical Core\", \"E_HIA_ASSEMBLY_ROUNDTRIP\",\n                                  phase=\"representation\")\n    return rendered\n\n\ndef diagnose_assembly(source: str | bytes) -> dict:\n    \"\"\"Stable Agent diagnostic; accepted syntax/Core grants no native authority.\"\"\"\n    result = {\"schema\": \"hepta.hia.assembly-diagnostic.v1\", \"accepted\": False,\n              \"deployment_authority\": False, \"safety_certificate\": False,\n              \"native_artifact_created\": False}\n    try:\n        raw, _ = _source(source)\n        result.update(source_sha256=sha256(raw).hexdigest(), source_bytes=len(raw))\n        checked = assemble_program(raw)\n    except HIAProgramRejected as exc:\n        result[\"diagnostic\"] = {\"code\": exc.code, \"message\": str(exc),\n                                \"phase\": getattr(exc, \"phase\", \"core_verification\"),\n                                \"line\": getattr(exc, \"line\", None)}\n        return result\n    result.update(accepted=True, core_sha256=checked.sha256,\n                  core_schema=checked.as_dict()[\"schema\"], diagnostic=None)\n    return result\n\n# Explicit HIA selection; original function bodies remain the default.\nfrom .hia_assembly_front_selection import native_assembly_front_scope as _native_assembly_front_scope\n\n_assembly_front_reference_reject = _reject\n\ndef _reject(message, *, line=None, limit=False):\n    with _native_assembly_front_scope() as owner:\n        if owner is None:\n            carrier = {'callee': _assembly_front_reference_reject, 'message': message, 'line': line, 'limit': limit}\n            del message, line, limit, owner\n            return carrier.pop('callee')(carrier.pop('message'), line=carrier.pop('line'), limit=carrier.pop('limit'))\n        frame = owner.prepare('_reject', (message, line, limit))\n        del message, line, limit\n        return owner.finish(frame)\n\n_assembly_front_reference_source = _source\n\ndef _source(value):\n    with _native_assembly_front_scope() as owner:\n        if owner is None:\n            carrier = {'callee': _assembly_front_reference_source, 'value': value}\n            del value, owner\n            return carrier.pop('callee')(carrier.pop('value'))\n        frame = owner.prepare('_source', (value,))\n        del value\n        return owner.finish(frame)\n\n_assembly_front_reference_items = _items\n\ndef _items(value, line):\n    with _native_assembly_front_scope() as owner:\n        if owner is None:\n            carrier = {'callee': _assembly_front_reference_items, 'value': value, 'line': line}\n            del value, line, owner\n            return carrier.pop('callee')(carrier.pop('value'), carrier.pop('line'))\n        frame = owner.prepare('_items', (value, line))\n        del value, line\n        return owner.finish(frame)\n\n_assembly_front_reference_names = _names\n\ndef _names(value, line):\n    with _native_assembly_front_scope() as owner:\n        if owner is None:\n            carrier = {'callee': _assembly_front_reference_names, 'value': value, 'line': line}\n            del value, line, owner\n            return carrier.pop('callee')(carrier.pop('value'), carrier.pop('line'))\n        frame = owner.prepare('_names', (value, line))\n        del value, line\n        return owner.finish(frame)\n\n_assembly_front_reference_parameters = _parameters\n\ndef _parameters(value, line):\n    with _native_assembly_front_scope() as owner:\n        if owner is None:\n            carrier = {'callee': _assembly_front_reference_parameters, 'value': value, 'line': line}\n            del value, line, owner\n            return carrier.pop('callee')(carrier.pop('value'), carrier.pop('line'))\n        frame = owner.prepare('_parameters', (value, line))\n        del value, line\n        return owner.finish(frame)\n\n_assembly_front_reference_attrs = _attrs\n\ndef _attrs(value, line):\n    with _native_assembly_front_scope() as owner:\n        if owner is None:\n            carrier = {'callee': _assembly_front_reference_attrs, 'value': value, 'line': line}\n            del value, line, owner\n            return carrier.pop('callee')(carrier.pop('value'), carrier.pop('line'))\n        frame = owner.prepare('_attrs', (value, line))\n        del value, line\n        return owner.finish(frame)\n\n_assembly_front_reference_parse_assembly_document = _parse_assembly_document\n\ndef _parse_assembly_document(source: str | bytes) -> dict:\n    with _native_assembly_front_scope() as owner:\n        if owner is None:\n            carrier = {'callee': _assembly_front_reference_parse_assembly_document, 'source': source}\n            del source, owner\n            return carrier.pop('callee')(carrier.pop('source'))\n        frame = owner.prepare('_parse_assembly_document', (source,))\n        del source\n        return owner.finish(frame)\n\n_assembly_front_referenceassemble_program = assemble_program\n\ndef assemble_program(source: str | bytes, *, profile=None):\n    if profile is not None:\n        if type(profile) is str and profile == \"hepta.hia.linux-file-render.v3\":\n            from .hia_linux_file_render import assemble_linux_file_render\n            return assemble_linux_file_render(source)\n        if type(profile) is str and profile == \"hepta.hia.linux-file.v1\":\n            from .hia_linux_file import assemble_linux_file\n            return assemble_linux_file(source)\n        elif type(profile) is str and profile == \"hepta.hia.linux-cli-process.v1\":\n            from .hia_linux_cli_process import assemble_linux_cli_process\n            return assemble_linux_cli_process(source)\n        elif type(profile) is str and profile == \"hepta.hia.linux-process.v1\":\n            from .hia_linux_process import assemble_linux_process\n            return assemble_linux_process(source)\n        from .hia_linux_stdio import require_profile, assemble_linux_stdio\n        require_profile(profile)\n        return assemble_linux_stdio(source)\n    with _native_assembly_front_scope() as owner:\n        if owner is None:\n            carrier = {'callee': _assembly_front_referenceassemble_program, 'source': source}\n            del source, owner\n            return carrier.pop('callee')(carrier.pop('source'))\n        frame = owner.prepare('assemble_program', (source,))\n        del source\n        return owner.finish(frame)\n\n_assembly_front_reference_render_parameters = _render_parameters\n\ndef _render_parameters(parameters):\n    with _native_assembly_front_scope() as owner:\n        if owner is None:\n            carrier = {'callee': _assembly_front_reference_render_parameters, 'parameters': parameters}\n            del parameters, owner\n            return carrier.pop('callee')(carrier.pop('parameters'))\n        frame = owner.prepare('_render_parameters', (parameters,))\n        del parameters\n        return owner.finish(frame)\n\n_assembly_front_reference_render_assembly_document = _render_assembly_document\n\ndef _render_assembly_document(data: dict) -> str:\n    with _native_assembly_front_scope() as owner:\n        if owner is None:\n            carrier = {'callee': _assembly_front_reference_render_assembly_document, 'data': data}\n            del data, owner\n            return carrier.pop('callee')(carrier.pop('data'))\n        frame = owner.prepare('_render_assembly_document', (data,))\n        del data\n        return owner.finish(frame)\n\n_assembly_front_referencerender_assembly = render_assembly\n\ndef render_assembly(document, *, profile=None) -> str:\n    if profile is not None:\n        if type(profile) is str and profile == \"hepta.hia.linux-file-render.v3\":\n            from .hia_linux_file_render import render_linux_file_render\n            return render_linux_file_render(document)\n        if type(profile) is str and profile == \"hepta.hia.linux-file.v1\":\n            from .hia_linux_file import render_linux_file\n            return render_linux_file(document)\n        elif type(profile) is str and profile == \"hepta.hia.linux-cli-process.v1\":\n            from .hia_linux_cli_process import render_linux_cli_process\n            return render_linux_cli_process(document)\n        elif type(profile) is str and profile == \"hepta.hia.linux-process.v1\":\n            from .hia_linux_process import render_linux_process\n            return render_linux_process(document)\n        from .hia_linux_stdio import require_profile, render_linux_stdio\n        require_profile(profile)\n        return render_linux_stdio(document)\n    with _native_assembly_front_scope() as owner:\n        if owner is None:\n            carrier = {'callee': _assembly_front_referencerender_assembly, 'document': document}\n            del document, owner\n            return carrier.pop('callee')(carrier.pop('document'))\n        frame = owner.prepare('render_assembly', (document,))\n        del document\n        return owner.finish(frame)\n\n_assembly_front_referencediagnose_assembly = diagnose_assembly\n\ndef diagnose_assembly(source: str | bytes) -> dict:\n    with _native_assembly_front_scope() as owner:\n        if owner is None:\n            carrier = {'callee': _assembly_front_referencediagnose_assembly, 'source': source}\n            del source, owner\n            return carrier.pop('callee')(carrier.pop('source'))\n        frame = owner.prepare('diagnose_assembly', (source,))\n        del source\n        return owner.finish(frame)\n\n# Definition anchors never follow late global replacement or deletion.\n_NATIVE_ASSEMBLY_FRONT_ENTRIES = {\n    '_reject': _reject,\n    '_source': _source,\n    '_items': _items,\n    '_names': _names,\n    '_parameters': _parameters,\n    '_attrs': _attrs,\n    '_parse_assembly_document': _parse_assembly_document,\n    'assemble_program': assemble_program,\n    '_render_parameters': _render_parameters,\n    '_render_assembly_document': _render_assembly_document,\n    'render_assembly': render_assembly,\n    'diagnose_assembly': diagnose_assembly,\n}\n"
      },
      "before": {
        "bytes": 23861,
        "git_blob": "ee416b6f884245ba7b1c0be7adaee228a93e20ce",
        "mode": "100644",
        "sha256": "07cd8cc3457c48c196371eac7112f3524cbd7f8d40776858ae52fe4973011ceb"
      },
      "path": "hepta/hia_agent_assembly.py"
    },
    {
      "after": {
        "bytes": 30133,
        "git_blob": "9cb42ee758e4c6762b6ee735e48cbf7369e9a856",
        "mode": "100644",
        "sha256": "78de93178ee0fff9b2ff256f13141fef22ea92c836fcfc75762ade49f79a1290",
        "text": "\"\"\"Independent v3 file/render authority with a version-aware HIA frontend.\n\nThe new frontend admits a bounded primitive v6/v7/v8 domain, preserves schema and\nabsent/empty/nonempty exports, and rejects version-unavailable types, opcodes\nand loan-return declarations before a reversible private normalization\nfeeds a separately pinned HIA semantic resident. It retains both signature/CFG\npasses and the later edge/call/effect/result checks, without a machine-entry ABI.\nThe ordinary B3 is unchanged. Whole old CLI, canonical-roundtrip proof,\nPython diagnostics/providers and output publication remain unclaimed.\nThe frozen v1/v2 packages and ordinary compiler sources are not modified.\n\"\"\"\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom hashlib import sha256\nfrom types import MappingProxyType\n\nfrom .hia_opcodes import EFFECTS, OpcodeSpec\nfrom .hia_program import (\n    HIAProgramRejected, _decode, _reference_primitive_structure,\n    _function_interfaces, _verify_function,\n)\nfrom .hia_schema import SCHEMA_V8\n\nPROFILE = \"hepta.hia.linux-file-render.v3\"\nMODULE = \"selfhost_linux_file_render\"\nPROFILE_SOURCE_FILES = (\n    \"examples/hia_bootstrap/selfhost_linux_file_render.hepta\",\n    \"examples/hia_bootstrap/linux_file_render_entry_packer.hepta\",\n    \"examples/hia_bootstrap/native_file_render.hepta\",\n    \"examples/hia_bootstrap/file_render_frontend.hepta\",\n    \"examples/hia_bootstrap/file_render_checker.hepta\",\n)\nSOURCE_LIMIT = WORKSPACE_LIMIT = 1048576\nOUTPUT_LIMIT = 1048576\nFILE_BUFFER_LIMIT = 8388609\nFUNCTION_LIMIT = 128\nSEMANTIC_INPUT_FUNCTION_LIMIT = 256\nBLOCK_LIMIT = 1536\nINSTRUCTION_LIMIT = 8192\nREAD = \"linux.stdin.read\"\nWRITE = \"linux.stdout.write\"\nSTDERR = \"linux.stderr.write\"\nSTARTUP_EFFECT = \"linux_startup\"\nPROFILE_EFFECTS = EFFECTS | {\"linux_io\", STARTUP_EFFECT, \"linux_file\", \"linux_render\"}\nIO_OPCODES = MappingProxyType({\n    READ: OpcodeSpec(READ, (\"mutbuf\", \"usize\", \"usize\"), (\"i64\",),\n                     effects=(\"linux_io\", \"write\", \"trap\"), traps=(\"bounds\",),\n                     since=8, guards=(\"write:0\",),\n                     semantic_rule=\"single_linux_read_fd0_raw_signed_result\"),\n    WRITE: OpcodeSpec(WRITE, (\"view\", \"usize\", \"usize\"), (\"i64\",),\n                      effects=(\"linux_io\", \"read\", \"trap\"), traps=(\"bounds\",),\n                      since=8, guards=(\"read:0\",),\n                      semantic_rule=\"single_linux_write_fd1_raw_signed_result\"),\n    STDERR: OpcodeSpec(STDERR, (\"view\", \"usize\", \"usize\"), (\"i64\",),\n                       effects=(\"linux_io\", \"read\", \"trap\"), traps=(\"bounds\",),\n                       since=8, guards=(\"read:0\",),\n                       semantic_rule=\"single_linux_write_fd2_raw_signed_result\"),\n})\nSTARTUP_OPCODES = MappingProxyType({\n    **{name: OpcodeSpec(name, (), (\"usize\",),\n        effects=(STARTUP_EFFECT, \"read\", \"trap\"), traps=(\"bounds\",), since=8,\n        semantic_rule=\"immutable_kernel_startup_ordered_count\")\n       for name in (\"linux.argv.count\", \"linux.env.count\")},\n    **{name: OpcodeSpec(name, (\"usize\",), (\"usize\",),\n        effects=(STARTUP_EFFECT, \"read\", \"trap\"), traps=(\"bounds\",), since=8,\n        semantic_rule=\"immutable_kernel_startup_raw_string_length\")\n       for name in (\"linux.argv.length\", \"linux.env.length\")},\n    **{name: OpcodeSpec(name, (\"mutbuf\", \"usize\", \"usize\", \"usize\", \"usize\"), (\"usize\",),\n        effects=(STARTUP_EFFECT, \"read\", \"write\", \"trap\"), traps=(\"bounds\",),\n        since=8, guards=(\"write:0\",),\n        semantic_rule=\"immutable_kernel_startup_bounded_raw_string_copy\")\n       for name in (\"linux.argv.copy\", \"linux.env.copy\")},\n})\nFILE_OPCODES = MappingProxyType({\n    \"linux.file.open\": OpcodeSpec(\"linux.file.open\", (\"view\", \"usize\", \"usize\"), (\"i64\",),\n        effects=(\"linux_file\", \"read\", \"trap\"), traps=(\"bounds\",), since=8,\n        guards=(\"read:0\",), semantic_rule=\"fixed_readonly_openat_one_private_descriptor\"),\n    **{name: OpcodeSpec(name, (\"mutbuf\", \"usize\", \"usize\"), (\"i64\",),\n        effects=(\"linux_file\", \"write\", \"trap\"), traps=(\"bounds\",), since=8,\n        guards=(\"write:0\",), semantic_rule=\"fixed_active_descriptor_stat_or_read\")\n       for name in (\"linux.file.stat\", \"linux.file.read\")},\n    **{name: OpcodeSpec(name, (), (\"i64\",), effects=(\"linux_file\", \"trap\"),\n        traps=(\"bounds\",), since=8, semantic_rule=\"fixed_active_descriptor_close_or_flags\")\n       for name in (\"linux.file.close\", \"linux.file.fdflags\", \"linux.file.statusflags\")},\n})\nRESIDENT_OPCODES = MappingProxyType({\n    name: OpcodeSpec(name, (\"view\", \"usize\", \"usize\", \"mutbuf\", \"usize\", \"usize\", \"mutbuf\", \"usize\", \"usize\"),\n        (\"u32\",), effects=(\"linux_render\", \"read\", \"write\", \"trap\"), traps=(\"bounds\",), since=8,\n        guards=(\"read:0\", \"write:3\", \"write:6\", \"distinct:0:3\", \"distinct:0:6\", \"distinct:3:6\"),\n        semantic_rule=\"fixed_captured_file_render_resident_three_buffer_call\")\n    for name in (\"linux.render.frontend\", \"linux.render.compiler\")\n})\nPROFILE_OPCODES = MappingProxyType({**IO_OPCODES, **STARTUP_OPCODES, **FILE_OPCODES, **RESIDENT_OPCODES})\n# The physical second-resident opcode retains its historical name. In this\n# independent v3 profile its exact source authority is semantic validation;\n# it neither accepts an arbitrary compiler nor produces a runnable user image.\nCOMPONENT_PINS = {'linux.render.frontend': '691489ed7f491b690d791514b0ffc72b44449945f62e9d8b6544cb45c4ba3f5e', 'linux.render.compiler': '4bd7daad4f746b4a75d8aa1fa61fa94735d103be416d2f9119b1b0507605deb8'}\n\n\ndef _checked_components(values):\n    from .hia_agent_assembly import assemble_program\n    if type(values) is not tuple or len(values) != 2:\n        raise HIAProgramRejected(\"exact two frozen HIA component sources required\", \"E_HIA_LINUX_FILE_RENDER_COMPONENT\")\n    result = {}\n    for (name, expected), raw in zip(COMPONENT_PINS.items(), values):\n        if type(raw) is not bytes or sha256(raw).hexdigest() != expected:\n            raise HIAProgramRejected(\"frozen component source mismatch\", \"E_HIA_LINUX_FILE_RENDER_COMPONENT\")\n        result[name] = assemble_program(raw)\n    return result\n\nFILE_FLAGS = 0x20000 | 0x800 | 0x80000\n\n@dataclass(frozen=True, slots=True)\nclass LinuxFileRenderRequest:\n    operation: str\n    fd: int | None\n    path: bytes\n    offset: int\n    count: int\n    extent: int\n    flags: int\n\n\n\n@dataclass(frozen=True, slots=True)\nclass LinuxStartupSnapshot:\n    \"\"\"Explicit immutable VM reference data; never a native kernel capability.\"\"\"\n\n    argv: tuple[bytes, ...]\n    environment: tuple[bytes, ...]\n\n\ndef _checked_startup(snapshot):\n    if type(snapshot) is not LinuxStartupSnapshot:\n        raise HIAProgramRejected(\"an explicit reference startup snapshot is required\",\n                                 \"E_HIA_LINUX_FILE_RENDER_STARTUP\")\n    for values in (snapshot.argv, snapshot.environment):\n        if (type(values) is not tuple or any(type(value) is not bytes or b\"\\x00\" in value\n                                             for value in values)):\n            raise HIAProgramRejected(\"ordered immutable NUL-free startup byte strings required\",\n                                     \"E_HIA_LINUX_FILE_RENDER_STARTUP\")\n    # Do not collapse duplicates, decode bytes, select environment names or add\n    # the existing 1MiB per-buffer ceiling to the total kernel-startup domain.\n    return LinuxStartupSnapshot(snapshot.argv, snapshot.environment)\n\n\n\ndef profile_resource_path(name):\n    \"\"\"Resolve one declared build asset in this checkout or installed package.\n\n    Missing installed assets never fall back to another checkout, cwd or HOME.\n    Resolving a path grants no compiler, cold, execution or default authority.\n    \"\"\"\n    if type(name) is not str or name not in PROFILE_SOURCE_FILES:\n        raise ValueError(\"an exact declared Linux stdio build resource is required\")\n    from .hia_json_preflight_native import _source_resource_path\n    return _source_resource_path(name)\n\n\ndef require_profile(profile):\n    if type(profile) is not str or profile != PROFILE:\n        raise HIAProgramRejected(\"an exact explicit Linux stdio profile is required\",\n                                 \"E_HIA_LINUX_FILE_RENDER_PROFILE\")\n\n\ndef profile_effects(profile):\n    require_profile(profile)\n    return PROFILE_EFFECTS\n\n\ndef profile_opcode(profile, opcode, schema):\n    require_profile(profile)\n    if schema != SCHEMA_V8:\n        raise HIAProgramRejected(\"Linux stdio requires explicit primitive v8\",\n                                 \"E_HIA_LINUX_FILE_RENDER_PROFILE\")\n    return PROFILE_OPCODES.get(opcode)\n\n\n@dataclass(frozen=True, slots=True)\nclass VerifiedLinuxFileRenderProgram:\n    \"\"\"Detached bytes only. All consumers recheck; this is not VerifiedProgram.\"\"\"\n\n    canonical_bytes: bytes\n\n    def as_dict(self):\n        if type(self.canonical_bytes) is not bytes:\n            raise HIAProgramRejected(\"profile bytes must be immutable\", \"E_HIA_FORMAT\")\n        return _decode(self.canonical_bytes)[0]\n\n    @property\n    def sha256(self):\n        return sha256(self.canonical_bytes).hexdigest()\n\n    @property\n    def input_sha256(self):\n        return self.sha256\n\n    def report(self):\n        checked = verify_linux_file_render_program(self)\n        doc = checked.as_dict()\n        return {\"schema\": \"hepta.hia.linux-file-render-verification.v1\", \"profile\": PROFILE,\n                \"program_sha256\": checked.sha256,\n                \"functions_checked\": len(doc[\"functions\"]),\n                \"blocks_checked\": sum(len(f[\"blocks\"]) for f in doc[\"functions\"]),\n                \"operations_checked\": sum(len(b[\"ops\"]) for f in doc[\"functions\"]\n                                           for b in f[\"blocks\"]),\n                \"typed_closed_ssa_checked\": True,\n                \"linear_resources_and_loan_provenance_checked\": True,\n                \"fixed_descriptors\": {READ: 0, WRITE: 1, STDERR: 2},\n                \"private_file_capability\": \"only actual open result; readonly; single active\",\n                \"file_buffer_extent\": FILE_BUFFER_LIMIT,\n                \"resident_compiler_and_output_extent\": OUTPUT_LIMIT,\n                \"startup_reference_is_native_authority\": False,\n                \"default_core_authority\": False, \"kernel_authority\": False,\n                \"native_artifact_created\": False, \"matching_cold\": False,\n                \"whole\": False}\n\n\ndef verify_linux_file_render_program(program):\n    if type(program) is VerifiedLinuxFileRenderProgram:\n        if type(program.canonical_bytes) is not bytes:\n            raise HIAProgramRejected(\"profile bytes must be immutable\", \"E_HIA_FORMAT\")\n        program = program.canonical_bytes\n    data, raw = _decode(program)\n    if (type(data) is not dict or data.get(\"schema\") != SCHEMA_V8\n            or data.get(\"module\") != MODULE):\n        raise HIAProgramRejected(\"explicit primitive v8 Linux stdio module required\",\n                                 \"E_HIA_LINUX_FILE_RENDER_PROFILE\")\n    functions, blocks = _reference_primitive_structure(data, profile=PROFILE)\n    if (len(functions) > FUNCTION_LIMIT\n            or sum(len(v) for v in blocks.values()) > BLOCK_LIMIT\n            or sum(len(b[\"ops\"]) for f in functions.values()\n                   for b in f[\"blocks\"]) > INSTRUCTION_LIMIT):\n        raise HIAProgramRejected(\"original selfhost structural limits exceeded\", \"E_HIA_LIMIT\")\n    entry = data[\"functions\"][0]\n    if (entry[\"name\"] != \"f0\"\n            or [p[\"type\"] for p in entry[\"params\"]] != [\"mutbuf\", \"mutbuf\", \"mutbuf\"]\n            or entry[\"returns\"] != [\"u32\"]):\n        raise HIAProgramRejected(\"Linux stdio uses the original f0 three-buffer ABI\",\n                                 \"E_HIA_LINUX_FILE_RENDER_ABI\")\n    interfaces = _function_interfaces(functions)\n    for fn in functions.values():\n        _verify_function(data[\"schema\"], fn, blocks[fn[\"name\"]], interfaces, profile=PROFILE)\n    return VerifiedLinuxFileRenderProgram(raw)\n\n\ndef assemble_linux_file_render(source):\n    from .hia_agent_assembly import _source, _parse_assembly_document\n    raw, _ = _source(source)\n    if len(raw) > SOURCE_LIMIT:\n        raise HIAProgramRejected(\"Linux stdio source exceeds 1 MiB\", \"E_HIA_LIMIT\")\n    return verify_linux_file_render_program(_parse_assembly_document(raw))\n\n\ndef render_linux_file_render(program):\n    from .hia_agent_assembly import _render_assembly_document\n    checked = verify_linux_file_render_program(program)\n    rendered = _render_assembly_document(checked.as_dict())\n    if len(rendered.encode(\"utf-8\")) > SOURCE_LIMIT:\n        raise HIAProgramRejected(\"Linux stdio source exceeds 1 MiB\", \"E_HIA_LIMIT\")\n    if assemble_linux_file_render(rendered).canonical_bytes != checked.canonical_bytes:\n        raise HIAProgramRejected(\"profile rendering changed verified bytes\",\n                                 \"E_HIA_LINUX_FILE_RENDER_ROUNDTRIP\")\n    return rendered\n\n\n@dataclass(frozen=True, slots=True)\nclass LinuxFileRenderIORequest:\n    operation: str\n    fd: int\n    offset: int\n    count: int\n    extent: int\n    write_bytes: bytes\n\n\nclass LinuxFileRenderProviderRejected(ValueError):\n    \"\"\"The supplied observation is outside one fixed Linux I/O result.\"\"\"\n\n\nclass LinuxFileRenderSignal(Exception):\n    \"\"\"An explicit reference-provider signal, never an implicit OS action.\"\"\"\n\n    def __init__(self, number):\n        if type(number) is not int or not 1 <= number <= 64:\n            raise ValueError(\"exact Linux signal number required\")\n        self.number = number\n        super().__init__(number)\n\n\ndef _execute(checked, function, buffers, provider, startup, components, *, max_steps, max_heap_bytes,\n             allocation_fail_at, max_call_depth):\n    from .hia_program_runtime import (\n        _Machine, _Owner, _View, _underlying, HIAProgramTrap, HIAProgramBudgetExceeded,\n    )\n\n    class LinuxFileRenderMachine(_Machine):\n        def __init__(self):\n            super().__init__(checked, max_steps, max_heap_bytes, allocation_fail_at, max_call_depth)\n            self.effects = []\n            self.file_fd = None\n\n        def operation(self, ins, env, depth):\n            operation = ins[\"op\"]\n            if operation in RESIDENT_OPCODES:\n                args = [env[name] for name in ins[\"args\"]]\n                spans = []\n                for i in (0, 3, 6):\n                    view, offset, count = args[i:i + 3]\n                    if (type(view) is not _View or i and not view.mutable\n                            or type(offset) is not int or type(count) is not int\n                            or offset < 0 or count < 0):\n                        raise HIAProgramRejected(\"invalid resident borrow\", \"E_HIA_RUNTIME_INVARIANT\")\n                    owner = _underlying(view)\n                    if offset > len(owner.data) or count > len(owner.data) - offset:\n                        raise HIAProgramTrap(\"bounds\", \"resident call exceeds borrowed extent\")\n                    spans.append((owner, offset, count))\n                if len({id(item[0]) for item in spans}) != 3:\n                    raise HIAProgramRejected(\"resident buffers must have distinct roots\", \"E_HIA_LOAN\")\n                remaining = max_steps - self.steps\n                if remaining <= 0:\n                    raise HIAProgramBudgetExceeded(\"steps\", \"shared process VM fuel exhausted\")\n                roots_child = tuple(_Owner(-(i + 1), bytearray(owner.data[offset:offset + count]))\n                    for i, (owner, offset, count) in enumerate(spans))\n                child = _Machine(components[operation], remaining, max_heap_bytes, None, max_call_depth)\n                child_args = [_View(roots_child[0], False), _View(roots_child[1], True), _View(roots_child[2], True)]\n                event = {\"operation\": operation, \"status\": \"issued\", \"source_sha256\": components[operation].sha256,\n                    \"spans\": [{\"offset\": offset, \"bytes\": count} for _, offset, count in spans]}\n                self.effects.append(event)\n                try:\n                    values = child.invoke(child.functions[\"f0\"], child_args)\n                    if len(values) != 1 or type(values[0]) is not int or not 0 <= values[0] <= 0xffffffff:\n                        raise HIAProgramRejected(\"invalid resident u32 return\", \"E_HIA_RUNTIME_INVARIANT\")\n                    if child.owners or child.chains or child.loans_started != child.loans_ended:\n                        raise HIAProgramRejected(\"resident retained local resources\", \"E_HIA_RUNTIME_INVARIANT\")\n                    env[ins[\"out\"][0][\"name\"]] = values[0]\n                    event.update(status=\"returned\", result=values[0])\n                except BaseException:\n                    event[\"status\"] = \"raised\"\n                    raise\n                finally:\n                    self.steps += child.steps\n                    event[\"VM_steps\"] = child.steps\n                    for i in (1, 2):\n                        owner, offset, count = spans[i]\n                        owner.data[offset:offset + count] = roots_child[i].data\n                    if bytes(roots_child[0].data) != bytes(spans[0][0].data[spans[0][1]:spans[0][1] + spans[0][2]]):\n                        raise HIAProgramRejected(\"resident modified readonly source\", \"E_HIA_RUNTIME_INVARIANT\")\n                return\n            if operation in FILE_OPCODES:\n                args = [env[name] for name in ins[\"args\"]]\n                view = None\n                owner = None\n                offset = count = extent = 0\n                path = b\"\"\n                if operation in (\"linux.file.open\", \"linux.file.stat\", \"linux.file.read\"):\n                    view, offset, count = args\n                    if (type(view) is not _View\n                            or operation != \"linux.file.open\" and not view.mutable\n                            or type(offset) is not int or type(count) is not int\n                            or offset < 0 or count < 0):\n                        raise HIAProgramRejected(\"invalid file borrow\", \"E_HIA_RUNTIME_INVARIANT\")\n                    owner = _underlying(view)\n                    extent = len(owner.data)\n                    if offset > extent or count > extent - offset:\n                        raise HIAProgramTrap(\"bounds\", \"file operation exceeds borrowed extent\")\n                    if operation == \"linux.file.stat\" and count != 144:\n                        raise HIAProgramTrap(\"bounds\", \"exact x86-64 stat extent required\")\n                if operation == \"linux.file.open\":\n                    if self.file_fd is not None:\n                        raise HIAProgramTrap(\"bounds\", \"cannot replace an active file capability\")\n                    if count == 0 or owner.data[offset + count - 1] != 0:\n                        raise HIAProgramTrap(\"bounds\", \"borrowed pathname lacks terminal NUL\")\n                    path = bytes(owner.data[offset:offset + count])\n                elif self.file_fd is None:\n                    raise HIAProgramTrap(\"bounds\", \"file capability is closed or absent\")\n                request = LinuxFileRenderRequest(operation, self.file_fd, path, offset, count,\n                                           extent, FILE_FLAGS if path else 0)\n                row = {\"operation\": operation, \"fd\": self.file_fd, \"path_hex\": path.hex(),\n                       \"offset\": offset, \"count\": count, \"extent\": extent,\n                       \"flags\": request.flags, \"status\": \"issued\"}\n                self.effects.append(row)\n                if operation == \"linux.file.close\":\n                    # Revoke before invoking the finite physical provider. A\n                    # failing/unknown close never grants the old fd again.\n                    self.file_fd = None\n                try:\n                    response = provider(request)\n                except BaseException:\n                    row[\"status\"] = \"provider_raised\"\n                    raise\n                if (type(response) is not tuple or len(response) != 2\n                        or type(response[0]) is not int or type(response[1]) is not bytes):\n                    raise LinuxFileRenderProviderRejected(\"exact signed result/bytes required\")\n                result, payload = response\n                if not -4095 <= result <= 2147483647:\n                    raise LinuxFileRenderProviderRejected(\"result outside fixed Linux file domain\")\n                if operation == \"linux.file.read\":\n                    valid = result <= count and len(payload) == max(0, result)\n                elif operation == \"linux.file.stat\":\n                    valid = (result == 0 and len(payload) == 144) or (result < 0 and not payload)\n                elif operation == \"linux.file.close\":\n                    valid = result <= 0 and not payload\n                else:\n                    valid = not payload\n                if not valid:\n                    raise LinuxFileRenderProviderRejected(\"payload/result disagree with file operation\")\n                if operation == \"linux.file.open\" and result >= 0:\n                    self.file_fd = result\n                if payload:\n                    owner.data[offset:offset + len(payload)] = payload\n                row.update(status=\"returned\", result=result, read_hex=payload.hex(),\n                           active_fd_after=self.file_fd)\n                env[ins[\"out\"][0][\"name\"]] = result\n                return\n            if operation in STARTUP_OPCODES:\n                values = startup.argv if operation.startswith(\"linux.argv.\") else startup.environment\n                kind = operation.rsplit(\".\", 1)[1]\n                args = [env[name] for name in ins[\"args\"]]\n                if kind == \"count\":\n                    result = len(values)\n                    event = {\"operation\": operation, \"result\": result}\n                else:\n                    index = args[0] if kind == \"length\" else args[2]\n                    if type(index) is not int or index < 0 or index >= len(values):\n                        raise HIAProgramTrap(\"bounds\", \"startup string index is outside the selected vector\")\n                    raw = values[index]\n                    if kind == \"length\":\n                        result = len(raw)\n                        event = {\"operation\": operation, \"index\": index, \"result\": result}\n                    else:\n                        view, destination, _, offset, count = args\n                        if (type(view) is not _View or not view.mutable\n                                or any(type(v) is not int or v < 0 for v in (destination, offset, count))):\n                            raise HIAProgramRejected(\"invalid startup copy capability\",\n                                                     \"E_HIA_RUNTIME_INVARIANT\")\n                        owner = _underlying(view)\n                        # Same order as the native primitive: selected string,\n                        # source offset/count, then destination offset/count.\n                        if offset > len(raw) or count > len(raw) - offset:\n                            raise HIAProgramTrap(\"bounds\", \"startup copy exceeds its source string\")\n                        if destination > len(owner.data) or count > len(owner.data) - destination:\n                            raise HIAProgramTrap(\"bounds\", \"startup copy exceeds its destination borrow\")\n                        payload = raw[offset:offset + count]\n                        owner.data[destination:destination + count] = payload\n                        result = count\n                        event = {\"operation\": operation, \"index\": index, \"offset\": offset,\n                                 \"destination\": destination, \"count\": count, \"result\": result,\n                                 \"copied_hex\": payload.hex()}\n                self.effects.append({**event, \"status\": \"returned\", \"reference_snapshot\": True})\n                env[ins[\"out\"][0][\"name\"]] = result\n                return\n            if operation not in IO_OPCODES:\n                return super().operation(ins, env, depth)\n            view, offset, count = (env[name] for name in ins[\"args\"])\n            owner = _underlying(view)\n            if (type(view) is not _View or operation == READ and not view.mutable\n                    or type(offset) is not int or type(count) is not int\n                    or offset < 0 or count < 0):\n                raise HIAProgramRejected(\"invalid typed physical effect borrow\",\n                                         \"E_HIA_RUNTIME_INVARIANT\")\n            extent = len(owner.data)\n            # Match generated native code: prove offset first, then subtract.\n            if offset > extent or count > extent - offset:\n                raise HIAProgramTrap(\"bounds\", \"physical I/O exceeds the borrowed extent\")\n            request = LinuxFileRenderIORequest(operation, {READ: 0, WRITE: 1, STDERR: 2}[operation],\n                offset, count, extent,\n                bytes(owner.data[offset:offset + count]) if operation != READ else b\"\")\n            row = {\"operation\": operation, \"fd\": request.fd, \"offset\": offset,\n                   \"count\": count, \"extent\": extent, \"write_hex\": request.write_bytes.hex(),\n                   \"status\": \"issued\"}\n            self.effects.append(row)\n            try:\n                response = provider(request)\n            except BaseException:\n                row[\"status\"] = \"provider_raised\"\n                raise\n            if (type(response) is not tuple or len(response) != 2\n                    or type(response[0]) is not int or type(response[1]) is not bytes):\n                raise LinuxFileRenderProviderRejected(\"exact integer/bytes response required\")\n            result, payload = response\n            if (not -4095 <= result <= count or result < 0 and payload\n                    or operation != READ and payload\n                    or operation == READ and len(payload) != max(0, result)):\n                raise LinuxFileRenderProviderRejected(\"response outside one Linux I/O observation\")\n            # No mutation happens before the complete provider result is admitted.\n            row.update(status=\"returned\", result=result, read_hex=payload.hex())\n            if operation == READ and result > 0:\n                owner.data[offset:offset + result] = payload\n            env[ins[\"out\"][0][\"name\"]] = result\n\n    roots = tuple(_Owner(-(i + 1), bytearray(raw)) for i, raw in enumerate(buffers))\n    arguments = [_View(root, True) for root in roots]\n    machine = LinuxFileRenderMachine()\n\n    def observation(status, values=None, error=None):\n        result = machine.report(function, status, values, error, external_roots=roots)\n        result.update(schema=\"hepta.hia.linux-file-render-execution.v1\", profile=PROFILE,\n            source_hex=roots[0].data.hex(), output_hex=roots[1].data.hex(),\n            workspace_hex=roots[2].data.hex(), effects=machine.effects,\n            explicit_effect_provider=True, actual_kernel_execution=False,\n            default_core_authority=False, matching_cold=False, whole=False)\n        return result\n\n    try:\n        values = machine.invoke(machine.functions[function], arguments)\n    except HIAProgramTrap as exc:\n        exc.report = observation(\"trapped\", error=exc)\n        raise\n    except HIAProgramBudgetExceeded as exc:\n        exc.report = observation(\"budget_exceeded\", error=exc)\n        raise\n    except (LinuxFileRenderSignal, LinuxFileRenderProviderRejected) as exc:\n        # These are profile-owned reference outcomes, not ordinary Core traps\n        # or a claim that a real kernel signal/provider was observed.\n        exc.report = {\"schema\": \"hepta.hia.linux-file-render-external-outcome.v1\",\n            \"profile\": PROFILE, \"program_sha256\": checked.sha256,\n            \"status\": \"external_signal\" if type(exc) is LinuxFileRenderSignal else \"provider_refused\",\n            \"signal\": exc.number if type(exc) is LinuxFileRenderSignal else None,\n            \"steps\": machine.steps, \"resources\": machine.resources(),\n            \"source_hex\": roots[0].data.hex(), \"output_hex\": roots[1].data.hex(),\n            \"workspace_hex\": roots[2].data.hex(), \"effects\": machine.effects,\n            \"actual_kernel_execution\": False, \"matching_cold\": False, \"whole\": False}\n        raise\n    except RecursionError as exc:\n        limit = HIAProgramBudgetExceeded(\"calls\", \"host recursion limit reached\")\n        limit.report = observation(\"budget_exceeded\", error=limit)\n        raise limit from exc\n    if machine.file_fd is not None or machine.owners or machine.chains or machine.loans_started != machine.loans_ended:\n        raise HIAProgramRejected(\"profile return retains local resources\", \"E_HIA_RUNTIME_INVARIANT\")\n    return observation(\"returned\", values)\n\n\ndef execute_linux_file_render(program, function, arguments, *, provider, startup, components,\n                        max_steps=1000000, max_heap_bytes=16 * 1024 * 1024,\n                        allocation_fail_at=None, max_call_depth=256):\n    checked = verify_linux_file_render_program(program)\n    startup = _checked_startup(startup)\n    components = _checked_components(components)\n    if (type(function) is not str or function != \"f0\"\n            or type(arguments) not in (list, tuple) or not callable(provider)\n            or type(max_steps) is not int or not 1 <= max_steps <= 10000000\n            or type(max_heap_bytes) is not int or not 0 <= max_heap_bytes <= 1024 * 1024 * 1024\n            or type(max_call_depth) is not int or not 1 <= max_call_depth <= 256\n            or allocation_fail_at is not None\n               and (type(allocation_fail_at) is not int or allocation_fail_at < 1)):\n        raise HIAProgramRejected(\"invalid profile boundary/provider/limits\", \"E_HIA_INPUT\")\n    buffers = tuple(arguments)\n    if len(buffers) != 3 or any(type(raw) is not bytes or len(raw) > limit\n            for raw, limit in zip(buffers, (FILE_BUFFER_LIMIT, OUTPUT_LIMIT, WORKSPACE_LIMIT))):\n        raise HIAProgramRejected(\"exact file borrow <=8 MiB+1 and output/workspace <=1 MiB required\",\n                                 \"E_HIA_LINUX_FILE_RENDER_ABI\")\n    return _execute(checked, function, buffers, provider, startup, components, max_steps=max_steps,\n        max_heap_bytes=max_heap_bytes, allocation_fail_at=allocation_fail_at,\n        max_call_depth=max_call_depth)\n"
      },
      "before": {
        "bytes": 30106,
        "git_blob": "b5e29ab1977479fb5dfe4022c552812f02db1503",
        "mode": "100644",
        "sha256": "a52f483572df094009d8319a921e042e3ee1ac71153e96912bfddc99b69322e3"
      },
      "path": "hepta/hia_linux_file_render.py"
    },
    {
      "after": {
        "bytes": 50055,
        "git_blob": "c3573d0588e51f576e0afa4567e684409e16acc7",
        "mode": "100644",
        "sha256": "52ded90e4ae69ceeaad54eb64378256e8bd7243646b01e65e068aeb5f22698d8",
        "text": "\"\"\"Standalone HIA v1-v8: closed, typed SSA blocks with checked resource flow.\n\nThe authority is this program's operations, not a source file, producer hash,\nclaim, or source-checker receipt.  Blocks are closed: all incoming values are\nexplicit block parameters.  The profile has 64-bit usize/isize, byte owners,\nlexical/reborrowed views and finite machine integers. V8 admits explicitly\nparameter-bound returned loans through the return_loans contract; v1-v7 keep\nnon-escaping call loans. Versioned bulk-byte operations and v7 recursive\nbyte-owner chains follow the shared schema registry. Composite v1/v2/v3/v4\nnormalize to their explicitly versioned primitive v6/v7/v8 target before the\ncomplete resource flow is checked.\n\nThis is an executable checker, not a machine-checked soundness/refinement proof.\nIn particular explicit/arithmetic traps abort; cleanup is required at ordinary\nreturns (including error-as-value returns), not promised after an abort.\n\"\"\"\nfrom __future__ import annotations\n\nfrom collections import deque\nfrom dataclasses import dataclass\nfrom hashlib import sha256\nimport json\nimport re\n\nfrom .hia_json_preflight import preflight_hia_json\nfrom .hia_json_decode import decode_hia_json, decode_internal_canonical\nfrom .hia_json_canonical_native import selected_canonical_wire\nfrom .hia_sha256_native import payload_sha256\nfrom .hia_capability_flow import (Capability as _Capability,\n                                  CapabilityFlowRejected, rename_capabilities)\nfrom .hia_schema import (\n    COMPOSITE_SCHEMA, COMPOSITE_SCHEMAS, PRIMITIVE_SCHEMAS, PROFILE, PROFILE_V2, PROFILE_V3,\n    PROFILE_V4, PROFILE_V5, PROFILE_V6, PROFILE_V7, PROFILE_V8, SCHEMA, SCHEMA_V2, SCHEMA_V3,\n    SCHEMA_V4, SCHEMA_V5, SCHEMA_V6, SCHEMA_V7, SCHEMA_V8, profile_for_schema, supports_feature,\n)\nfrom .hia_opcodes import (\n    BYTE_RESOURCES, EFFECTS, OWNERS, RESOURCES, SCALARS, TRAP_CODES, TYPES, WIDTHS,\n    TERMINATORS, OpcodeRejected, check_instruction, opcode_spec,\n    scalar_value_valid as _catalog_scalar_value_valid,\n)\nWORD_BITS = 64\n_IDENT = re.compile(r\"[A-Za-z_][A-Za-z_0-9]{0,127}\\Z\")\n_JSON_ESCAPE = re.compile(r'[\\x00-\\x1f\"\\\\]')\n_RESERVED_FUNCTIONS = frozenset({\"abort\", \"calloc\", \"malloc\", \"free\", \"memcpy\", \"memmove\", \"memset\"})\nMAX_BYTES = 8 * 1024 * 1024\nMAX_NODES = 262144\nMAX_DEPTH = 64\nMAX_FUNCTIONS = 1024\nMAX_BLOCKS = 4096\n\n\nclass HIAProgramRejected(ValueError):\n    \"\"\"Malformed, unsupported or statically unsafe standalone core.\"\"\"\n\n    def __init__(self, message, code=\"E_HIA_PROGRAM\"):\n        self.code = code\n        super().__init__(f\"{code}: {message}\")\n\n\ndef _reject(message, code=\"E_HIA_PROGRAM\"):\n    raise HIAProgramRejected(message, code)\n\n\ndef _keys(value, fields, where):\n    if type(value) is not dict or set(value) != set(fields):\n        _reject(f\"{where}: expected exactly {', '.join(sorted(fields))}\", \"E_HIA_FORMAT\")\n\n\ndef _ident(value, where):\n    if (type(value) is not str or _IDENT.fullmatch(value) is None\n            or value.startswith(\"__hia_\")):\n        _reject(f\"{where}: invalid/reserved ASCII identifier\", \"E_HIA_NAME\")\n    return value\n\n\ndef _type(value):\n    if type(value) is not str or value not in TYPES:\n        _reject(\"type is outside the closed primitive profile\", \"E_HIA_TYPE\")\n    return value\n\n\ndef integer_range(typ):\n    if typ not in WIDTHS:\n        _reject(\"expected integer type\", \"E_HIA_TYPE\")\n    width = WIDTHS[typ]\n    signed = typ.startswith(\"i\")\n    return (-(1 << (width - 1)), (1 << (width - 1)) - 1) if signed else (0, (1 << width) - 1)\n\n\ndef scalar_value_valid(value, typ):\n    return _catalog_scalar_value_valid(value, typ)\n\n\ndef _unique_pairs(pairs):\n    result = {}\n    for key, value in pairs:\n        if key in result:\n            _reject(\"duplicate JSON object field\", \"E_HIA_FORMAT\")\n        result[key] = value\n    return result\n\n\ndef _bad_constant(value):\n    _reject(\"nonfinite JSON value\", \"E_HIA_FORMAT\")\n\n\ndef _json_string_bytes(value, remaining):\n    \"\"\"Exact UTF-8 length of ensure_ascii=False compact JSON string output.\n\n    No escaped/encoded string is materialized during this preflight. In\n    particular a short sequence of control characters may require six\n    serialized bytes for every source character.\n    \"\"\"\n    if len(value) + 2 > remaining:\n        _reject(\"program exceeds byte budget before encoding\", \"E_HIA_LIMIT\")\n    # The common identifier/opcode/key case needs no per-code-point Python loop.\n    # The lower-bound budget check above remains first; no encoded copy or\n    # verified-object cache is introduced, and every unsafe/non-ASCII string\n    # still follows the complete original escape/surrogate/UTF-8 accounting.\n    if value.isascii() and _JSON_ESCAPE.search(value) is None:\n        return len(value) + 2\n    size = 2  # opening and closing JSON quotes\n    for char in value:\n        point = ord(char)\n        if point < 32:\n            width = 2 if point in (8, 9, 10, 12, 13) else 6\n        elif point in (34, 92):  # escaped double quote/backslash\n            width = 2\n        elif point < 0x80:\n            width = 1\n        elif 0xD800 <= point <= 0xDFFF:\n            _reject(\"unpaired Unicode surrogate\", \"E_HIA_FORMAT\")\n        elif point < 0x800:\n            width = 2\n        elif point < 0x10000:\n            width = 3\n        else:\n            width = 4\n        size += width\n        if size > remaining:\n            _reject(\"program exceeds byte budget before encoding\", \"E_HIA_LIMIT\")\n    return size\n\n\ndef _bounded_input_utf8_bytes(text):\n    \"\"\"Count encoded JSON-input bytes without materializing the entire wire.\n\n    HIA accepts at most MAX_BYTES of UTF-8 input.  Encoding a large caller\n    string just to check its size creates an unbounded pre-admission copy.\n    Exact built-in str values are immutable; count them in bounded chunks.\n    Each encoded temporary is at most 16 KiB (4096 Unicode code points).\n    \"\"\"\n    if len(text) > MAX_BYTES:\n        _reject(\"program exceeds byte budget\", \"E_HIA_LIMIT\")\n    if text.isascii():\n        return len(text)\n    total = 0\n    for offset in range(0, len(text), 4096):\n        total += len(text[offset:offset + 4096].encode(\"utf-8\"))\n        if total > MAX_BYTES:\n            _reject(\"program exceeds byte budget\", \"E_HIA_LIMIT\")\n    return total\n\n\ndef _structure(value):\n    \"\"\"Count exact canonical JSON bytes AND nodes before json.dumps.\n\n    In-process dicts are not byte-bounded by the text preflight. The active\n    identity set also refuses cycles, and queued leaf counts refuse huge\n    container fanout before extending the work stack. This is a size gate,\n    not a replacement for the canonical HIA typed SSA/ownership verifier.\n    \"\"\"\n    # Repeated immutable keys/strings need the same arithmetic, not a second\n    # character scan. This bounded table belongs to this one full traversal;\n    # every occurrence still consumes its own nodes/bytes. A smaller remaining\n    # budget always goes through the original helper, preserving its exact\n    # lower-bound/escape/surrogate rejection order. No admission is memoized.\n    string_sizes = {}\n\n    def string_bytes(value, remaining):\n        # Do not hash a caller's oversized string just to look it up. Preserve\n        # the original constant-time lower-bound refusal before any full scan.\n        if len(value) + 2 > remaining:\n            return _json_string_bytes(value, remaining)\n        size = string_sizes.get(value)\n        if size is not None and size <= remaining:\n            return size\n        size = _json_string_bytes(value, remaining)\n        if len(string_sizes) < 1024:\n            string_sizes[value] = size\n        return size\n\n    # Keep node references directly, rather than allocating a task tuple for\n    # every scalar. A private marker closes each active container and restores\n    # its depth; it cannot be confused with any caller-provided JSON value.\n    leaving = object()\n    pending = [value]\n    active = set()\n    count, queued, size, depth = 0, 1, 0, 0\n    while pending:\n        current = pending.pop()\n        if current is leaving:\n            depth = pending.pop()\n            active.remove(id(pending.pop()))\n            continue\n        queued -= 1\n        count += 1\n        if count > MAX_NODES or depth > MAX_DEPTH:\n            _reject(\"program exceeds structural budget\", \"E_HIA_LIMIT\")\n        kind = type(current)\n        if kind in (dict, list):\n            identity = id(current)\n            if identity in active:\n                _reject(\"cyclic HIA JSON structure\", \"E_HIA_FORMAT\")\n            active.add(identity)\n            children = len(current)\n            if children > MAX_NODES - count - queued:\n                _reject(\"program exceeds queued-node budget\", \"E_HIA_LIMIT\")\n            queued += children\n            size += 2 + max(0, children - 1)  # container plus commas\n            if kind is dict:\n                size += children  # colons\n                for key in current:\n                    if type(key) is not str:\n                        _reject(\"non-string JSON key\", \"E_HIA_FORMAT\")\n                    size += string_bytes(key, MAX_BYTES - size)\n                values = current.values()\n            else:\n                values = current\n            # Retain the original container until its active-path scope ends.\n            # Children are still captured before descent, in the same order;\n            # the stack therefore visits them right to left as before.\n            pending.extend((current, depth, leaving))\n            pending.extend(values)\n            depth += 1\n        elif kind is str:\n            size += string_bytes(current, MAX_BYTES - size)\n        elif kind is bool:\n            size += 4 if current else 5\n        elif kind is int:\n            # Fail without converting a potentially enormous host integer\n            # into a decimal string merely to discover it exceeds 8 MiB.\n            if current.bit_length() > MAX_BYTES * 4:\n                _reject(\"integer exceeds JSON byte budget\", \"E_HIA_LIMIT\")\n            size += len(str(current))\n        elif current is None:\n            size += 4\n        else:\n            _reject(\"only bounded integer JSON values are supported\", \"E_HIA_FORMAT\")\n        if size > MAX_BYTES:\n            _reject(\"program exceeds byte budget before encoding\", \"E_HIA_LIMIT\")\n    return size\n\n\n\ndef _bounded_detached_snapshot(root):\n    \"\"\"Capture caller-owned JSON containers before byte accounting/encoding.\n\n    `_structure(original)` followed by `json.dumps(original)` is a check/use\n    race if another thread mutates the original dict or list. Instead retain\n    bounded references to each container's children, build a separate plain\n    dict/list tree, and validate/serialize *that exact detached tree*.\n    A nested caller tree is not claimed to be atomically snapshotted.\n    Every supported capture is independently rechecked by _structure.\n    \"\"\"\n    # Frames contain only active containers. Their iterators traverse the\n    # bounded, already captured child references, never the live caller tree.\n    # No per-leaf (node, parent, slot, depth, leaving) tasks or reversed\n    # enumerate lists are needed. Retaining each original container also\n    # prevents its identity being recycled while it remains on the active path.\n    frames = []\n    active = set()\n    count, queued = 0, 1\n    result = None\n    node, parent, slot = root, None, None\n    while True:\n        queued -= 1\n        count += 1\n        if count > MAX_NODES or len(frames) > MAX_DEPTH:\n            _reject(\"caller-owned tree exceeds snapshot budget\", \"E_HIA_LIMIT\")\n        kind = type(node)\n        if kind in (dict, list):\n            identity = id(node)\n            if identity in active:\n                _reject(\"cyclic caller-owned HIA tree\", \"E_HIA_FORMAT\")\n            active.add(identity)\n            available = MAX_NODES - count - queued\n            if len(node) > available:\n                _reject(\"caller-owned tree exceeds queued-node budget\", \"E_HIA_LIMIT\")\n            children = []\n            try:\n                if kind is dict:\n                    for key, child in node.items():\n                        if type(key) is not str:\n                            _reject(\"non-string caller-owned JSON key\", \"E_HIA_FORMAT\")\n                        if len(children) >= available:\n                            _reject(\"caller-owned dictionary grew past node budget\",\n                                    \"E_HIA_LIMIT\")\n                        children.append((key, child))\n                    copy = {}\n                else:\n                    for child in node:\n                        if len(children) >= available:\n                            _reject(\"caller-owned list grew past node budget\",\n                                    \"E_HIA_LIMIT\")\n                        children.append(child)\n                    copy = [None] * len(children)\n            except RuntimeError as exc:\n                raise HIAProgramRejected(\n                    \"caller-owned tree mutated during bounded snapshot\",\n                    \"E_HIA_FORMAT\") from exc\n            if parent is None:\n                result = copy\n            else:\n                parent[slot] = copy\n            queued += len(children)\n            frames.append((node, iter(children) if kind is dict else enumerate(children), copy))\n        else:\n            if kind not in (str, int, bool) and node is not None:\n                _reject(\"unsupported caller-owned JSON node\", \"E_HIA_FORMAT\")\n            if parent is None:\n                result = node\n            else:\n                parent[slot] = node\n        while frames:\n            original, children, parent = frames[-1]\n            try:\n                slot, node = next(children)\n                break\n            except StopIteration:\n                active.remove(id(original))\n                frames.pop()\n        else:\n            return result\n\ndef _decode(value):\n    if isinstance(value, VerifiedProgram):\n        value = value.canonical_bytes\n    try:\n        caller_owned = type(value) in (dict, list)\n        submitted_text = None\n        if type(value) is bytes:\n            if len(value) > MAX_BYTES:\n                _reject(\"program exceeds byte budget\", \"E_HIA_LIMIT\")\n            value = value.decode(\"utf-8\")\n        if type(value) is str:\n            _bounded_input_utf8_bytes(value)\n            submitted_text = value\n            # Bound value allocation before either selected decoder builds a\n            # graph. An optional HIA value arena does not bypass the canonical\n            # v7/composite Core verifier or rewrite its semantic checks.\n            try:\n                value = decode_hia_json(value, max_nodes=MAX_NODES, max_depth=MAX_DEPTH,\n                                        object_pairs_hook=_unique_pairs, parse_constant=_bad_constant)\n            except OverflowError as exc:\n                raise HIAProgramRejected(\n                    \"program exceeds structural budget before JSON allocation\",\n                    \"E_HIA_LIMIT\") from exc\n        if caller_owned:\n            value = _bounded_detached_snapshot(value)\n        _structure(value)\n        raw = (selected_canonical_wire(submitted_text, max_nodes=MAX_NODES, max_depth=MAX_DEPTH)\n               if submitted_text is not None else None)\n        if raw is None:\n            raw = json.dumps(value, sort_keys=True, separators=(\",\", \":\"),\n                             ensure_ascii=False, allow_nan=False).encode(\"utf-8\")\n        if len(raw) > MAX_BYTES:\n            _reject(\"program exceeds byte budget\", \"E_HIA_LIMIT\")\n        # Validation uses a detached snapshot, never the caller's mutable dict.\n        # This is our own already-structured, byte-bounded canonical output,\n        # not a submitted wire. Preserve the existing detached-object bridge\n        # without redundantly preflighting the same checked graph a second time.\n        return decode_internal_canonical(raw, max_nodes=MAX_NODES, max_depth=MAX_DEPTH), raw\n    except HIAProgramRejected:\n        raise\n    except (ValueError, TypeError, UnicodeError, RecursionError, OverflowError) as exc:\n        raise HIAProgramRejected(\"invalid/deep UTF-8 JSON\", \"E_HIA_FORMAT\") from exc\n\n\n@dataclass(frozen=True, slots=True)\nclass VerifiedProgram:\n    \"\"\"Immutable bytes, not an unforgeable receipt; consumers reverify them.\"\"\"\n\n    canonical_bytes: bytes\n    structured_bytes: bytes | None = None\n\n    @property\n    def sha256(self):\n        return payload_sha256(self.canonical_bytes).hex()\n\n    @property\n    def canonical_json(self):\n        return self.canonical_bytes.decode(\"utf-8\")\n\n    @property\n    def input_sha256(self):\n        return payload_sha256(self.structured_bytes if self.structured_bytes is not None\n                              else self.canonical_bytes).hex()\n\n    @property\n    def scalar_entrypoints(self):\n        # A nominal aggregate erased into scalar slots is still not a scalar\n        # public signature.  Generated protocol helpers are internal too.\n        document = self.as_dict()\n        if \"exports\" in document:\n            return frozenset(document[\"exports\"])\n        return frozenset(fn[\"name\"] for fn in document[\"functions\"]\n                         if all(type(p[\"type\"]) is str and p[\"type\"] in SCALARS for p in fn[\"params\"])\n                         and all(type(t) is str and t in SCALARS for t in fn[\"returns\"]))\n\n    @property\n    def normalization_report(self):\n        checked = verify_program(self)\n        core = checked.as_dict()\n        original = (decode_internal_canonical(checked.structured_bytes, max_nodes=MAX_NODES, max_depth=MAX_DEPTH)\n                    if checked.structured_bytes is not None else core)\n        return {\"input_sha256\": checked.input_sha256,\n                \"core_sha256\": checked.sha256,\n                \"input_schema\": original[\"schema\"],\n                \"input_profile\": profile_for_schema(original[\"schema\"]),\n                \"core_schema\": core[\"schema\"],\n                \"core_profile\": profile_for_schema(core[\"schema\"]),\n                \"structured_elaboration_rechecked\": checked.structured_bytes is not None,\n                \"primitive_core_rechecked\": True,\n                \"source_ast_required\": False,\n                \"public_scalar_entrypoints\": sorted(checked.scalar_entrypoints)}\n\n    def as_dict(self):\n        return decode_internal_canonical(self.canonical_bytes, max_nodes=MAX_NODES, max_depth=MAX_DEPTH)\n\n    def report(self):\n        # This public constructor is intentionally not an authority. Even a\n        # report rechecks the immutable bytes instead of trusting its class.\n        checked = verify_program(self)\n        data = checked.as_dict()\n        profile = profile_for_schema(data[\"schema\"])\n        return {\"schema\": \"hepta.hia.program-verification.v1\", \"ok\": True,\n                \"profile\": profile, \"program_sha256\": checked.sha256,\n                \"input_sha256\": checked.input_sha256,\n                \"normalization\": checked.normalization_report,\n                \"word_bits\": WORD_BITS, \"functions_checked\": len(data[\"functions\"]),\n                \"blocks_checked\": sum(len(f[\"blocks\"]) for f in data[\"functions\"]),\n                \"source_required\": False,\n                \"claims\": {\"typed_closed_ssa_checked\": True,\n                           \"linear_resources_and_loan_provenance_checked\": True,\n                           \"whole_language_soundness_proved\": False,\n                           \"backend_refinement_proved\": False,\n                           \"foreign_code_supported\": False,\n                           \"escaping_loans_supported\": False,\n                           \"parameter_bound_loan_returns_supported\": supports_feature(data[\"schema\"], \"parameter_loan_returns\"),\n                           \"concurrency_supported\": False,\n                           \"nominal_products_and_enums_checked\": checked.structured_bytes is not None,\n                           \"local_stored_loan_identity_checked\": checked.structured_bytes is not None,\n                           \"record_field_borrow_provenance_checked\": checked.structured_bytes is not None,\n                           \"cooperative_task_protocol_checked\": checked.structured_bytes is not None,\n                           \"background_tasks_supported\": False,\n                           \"recursive_heap_adts_supported\": False,\n                           \"recursive_buffer_chains_supported\": supports_feature(data[\"schema\"], \"recursive_chain\"),\n                           \"preemptive_or_async_cancellation_supported\": False}}\n\n\ndef _parameters(value, where):\n    if type(value) is not list:\n        _reject(f\"{where}: expected parameter list\", \"E_HIA_FORMAT\")\n    seen = set()\n    for param in value:\n        _keys(param, {\"name\", \"type\"}, where)\n        name = _ident(param[\"name\"], where)\n        _type(param[\"type\"])\n        if name in seen:\n            _reject(f\"{where}: duplicate parameter {name}\", \"E_HIA_SSA\")\n        seen.add(name)\n    return value\n\n\ndef _names(value, where):\n    if type(value) is not list:\n        _reject(f\"{where}: expected value list\", \"E_HIA_FORMAT\")\n    for name in value:\n        _ident(name, where)\n    return value\n\n\ndef _edge(value):\n    _keys(value, {\"target\", \"args\"}, \"CFG edge\")\n    _ident(value[\"target\"], \"edge target\")\n    _names(value[\"args\"], \"edge arguments\")\n    return value\n\n\ndef _edges(term):\n    if type(term) is not dict or type(term.get(\"op\")) is not str:\n        _reject(\"missing terminator\", \"E_HIA_CFG\")\n    op = term[\"op\"]\n    if op not in TERMINATORS:\n        _reject(\"unknown terminator\", \"E_HIA_CFG\")\n    _keys(term, TERMINATORS[op], op)\n    if op == \"jump\":\n        return [_edge({\"target\": term[\"target\"], \"args\": term[\"args\"]})]\n    if op == \"branch\":\n        _ident(term[\"cond\"], \"branch condition\")\n        return [_edge(term[\"then\"]), _edge(term[\"else\"])]\n    if op == \"ret\":\n        _names(term[\"values\"], \"return values\")\n        return []\n    if op == \"trap\":\n        if type(term[\"code\"]) is not str or term[\"code\"] not in TRAP_CODES:\n            _reject(\"unknown trap code\", \"E_HIA_CFG\")\n        return []\n    _reject(\"unknown terminator\", \"E_HIA_CFG\")\n\n\ndef _function_shape(fn, *, recursive_chain=False, parameter_loan_returns=False):\n    from .hia_function_shape_native import selected_function_shape\n    selected=selected_function_shape(fn,recursive_chain=recursive_chain,\n                                     parameter_loan_returns=parameter_loan_returns)\n    if selected is not None:\n        return selected\n    return _reference_function_shape(fn,recursive_chain=recursive_chain,\n                                     parameter_loan_returns=parameter_loan_returns)\n\n\ndef _reference_function_shape(fn, *, recursive_chain=False, parameter_loan_returns=False, profile=None):\n    fields = {\"name\", \"params\", \"returns\", \"effects\", \"entry\", \"blocks\"}\n    if parameter_loan_returns and type(fn) is dict and \"return_loans\" in fn:\n        fields.add(\"return_loans\")\n    _keys(fn, fields, \"function\")\n    name = _ident(fn[\"name\"], \"function\")\n    if name in _RESERVED_FUNCTIONS:\n        _reject(\"function collides with native runtime symbol\", \"E_HIA_NAME\")\n    _parameters(fn[\"params\"], \"function parameters\")\n    if type(fn[\"returns\"]) is not list:\n        _reject(\"returns must be a list\", \"E_HIA_TYPE\")\n    for typ in fn[\"returns\"]:\n        _type(typ)\n        if typ in {\"readbuf\", \"mutbuf\"} and not parameter_loan_returns:\n            _reject(\"call loans require the v8 parameter-return contract\", \"E_HIA_LOAN\")\n    if parameter_loan_returns:\n        origins = fn.get(\"return_loans\", [None] * len(fn[\"returns\"]))\n        if type(origins) is not list or len(origins) != len(fn[\"returns\"]):\n            _reject(\"return_loans must match the return arity\", \"E_HIA_LOAN\")\n        parameters = {p[\"name\"]: p[\"type\"] for p in fn[\"params\"]}\n        for typ, origin in zip(fn[\"returns\"], origins):\n            if typ not in {\"readbuf\", \"mutbuf\"}:\n                if origin is not None:\n                    _reject(\"nonloan result requires a null return_loans entry\", \"E_HIA_LOAN\")\n            elif (type(origin) is not str or parameters.get(origin) not in {\"readbuf\", \"mutbuf\"}\n                  or typ == \"mutbuf\" and parameters[origin] != \"mutbuf\"):\n                _reject(\"borrowed result must name an input loan with sufficient permission\", \"E_HIA_LOAN\")\n    allowed_effects = EFFECTS\n    if profile is not None:\n        if type(profile) is str and profile == \"hepta.hia.linux-file-render.v3\":\n            from .hia_linux_file_render import profile_effects\n        elif type(profile) is str and profile == \"hepta.hia.linux-file.v1\":\n            from .hia_linux_file import profile_effects\n        elif type(profile) is str and profile == \"hepta.hia.linux-cli-process.v1\":\n            from .hia_linux_cli_process import profile_effects\n        elif type(profile) is str and profile == \"hepta.hia.linux-process.v1\":\n            from .hia_linux_process import profile_effects\n        else:\n            from .hia_linux_stdio import profile_effects\n        allowed_effects = profile_effects(profile)\n    effects = fn[\"effects\"]\n    if (type(effects) is not list or any(type(e) is not str or e not in allowed_effects for e in effects)\n            or len(effects) != len(set(effects))):\n        _reject(\"unknown/duplicate function effect\", \"E_HIA_EFFECT\")\n    _ident(fn[\"entry\"], \"entry\")\n    if type(fn[\"blocks\"]) is not list or not 1 <= len(fn[\"blocks\"]) <= MAX_BLOCKS:\n        _reject(\"invalid block inventory\", \"E_HIA_CFG\")\n    by_id, definitions = {}, set()\n    for block in fn[\"blocks\"]:\n        _keys(block, {\"id\", \"params\", \"ops\", \"term\"}, \"block\")\n        ident = _ident(block[\"id\"], \"block id\")\n        if ident in by_id:\n            _reject(\"duplicate block\", \"E_HIA_CFG\")\n        by_id[ident] = block\n        params = _parameters(block[\"params\"], \"block parameters\")\n        if type(block[\"ops\"]) is not list:\n            _reject(\"block operations must be a list\", \"E_HIA_FORMAT\")\n        current = [p[\"name\"] for p in params]\n        for instruction in block[\"ops\"]:\n            _keys(instruction, {\"op\", \"args\", \"out\", \"attrs\"}, \"instruction\")\n            if type(instruction[\"op\"]) is not str:\n                _reject(\"opcode must be text\", \"E_HIA_FORMAT\")\n            _names(instruction[\"args\"], \"instruction arguments\")\n            outputs = _parameters(instruction[\"out\"], \"instruction outputs\")\n            if type(instruction[\"attrs\"]) is not dict:\n                _reject(\"instruction attributes must be an object\", \"E_HIA_FORMAT\")\n            current.extend(p[\"name\"] for p in outputs)\n        for value in current:\n            if value in definitions:\n                _reject(f\"SSA value {value} is defined more than once\", \"E_HIA_SSA\")\n            definitions.add(value)\n        _edges(block[\"term\"])\n    if fn[\"entry\"] not in by_id or by_id[fn[\"entry\"]][\"params\"] != fn[\"params\"]:\n        _reject(\"entry parameters must equal the function signature\", \"E_HIA_CFG\")\n    graph = {}\n    for ident, block in by_id.items():\n        graph[ident] = []\n        for edge in _edges(block[\"term\"]):\n            if edge[\"target\"] not in by_id:\n                _reject(\"jump to missing block\", \"E_HIA_CFG\")\n            if edge[\"target\"] == fn[\"entry\"]:\n                _reject(\"entry cannot have incoming CFG edges; use a loop header\", \"E_HIA_CFG\")\n            if len(edge[\"args\"]) != len(by_id[edge[\"target\"]][\"params\"]):\n                _reject(\"edge arity differs from block parameters\", \"E_HIA_CFG\")\n            graph[ident].append(edge[\"target\"])\n    pending, reached = [fn[\"entry\"]], set()\n    while pending:\n        ident = pending.pop()\n        if ident in reached:\n            continue\n        reached.add(ident)\n        pending.extend(graph[ident])\n    if reached != set(by_id):\n        _reject(\"unreachable blocks are not admitted\", \"E_HIA_CFG\")\n    if not recursive_chain:\n        declared = [p[\"type\"] for p in fn[\"params\"]] + fn[\"returns\"]\n        declared += [p[\"type\"] for block in fn[\"blocks\"] for p in block[\"params\"]]\n        declared += [p[\"type\"] for block in fn[\"blocks\"] for ins in block[\"ops\"] for p in ins[\"out\"]]\n        if \"chain\" in declared:\n            _reject(\"recursive chain types require HIA program v7\", \"E_HIA_TYPE\")\n    return by_id\n\n\n@dataclass(frozen=True, slots=True)\nclass _FunctionInterface:\n    # Original formal identities are semantic inputs in v8: return_loans names\n    # a formal, not whichever same-typed or aliased argument happens to survive.\n    params: tuple[str, ...]\n    param_names: tuple[str, ...]\n    returns: tuple[str, ...]\n    return_loans: tuple[str | None, ...]\n    effects: frozenset[str]\n\n\nclass _BlockCheck:\n    def __init__(self, fn, block, capabilities, functions, *, schema, profile=None):\n        self.fn, self.block, self.functions = fn, block, functions\n        self.schema = schema\n        self.profile = profile\n        self.env = {p[\"name\"]: p[\"type\"] for p in block[\"params\"]}\n        self.caps = dict(capabilities)\n        self.required = set()\n\n    def value(self, name):\n        if name not in self.env:\n            _reject(f\"{self.fn['name']}/{self.block['id']}: undefined/nonlocal value {name}\", \"E_HIA_SSA\")\n        typ = self.env[name]\n        if typ in RESOURCES and name not in self.caps:\n            _reject(f\"use of consumed resource {name}\", \"E_HIA_RESOURCE\")\n        return typ\n\n    def children(self, name):\n        return [n for n, cap in self.caps.items() if cap.parent == name]\n\n    def ancestors(self, name):\n        out = set()\n        while self.caps[name].parent is not None:\n            name = self.caps[name].parent\n            if name in out or name not in self.caps:\n                _reject(\"invalid loan parent graph\", \"E_HIA_LOAN\")\n            out.add(name)\n        return out\n\n    def owner_free(self, name):\n        if self.value(name) not in OWNERS:\n            _reject(\"operation requires an owner\", \"E_HIA_TYPE\")\n        if any(cap.root == name and other != name for other, cap in self.caps.items()):\n            _reject(\"owner moved/dropped/returned while borrowed\", \"E_HIA_LOAN\")\n\n    def access(self, name, mutable=False):\n        typ = self.value(name)\n        if typ not in ({\"mutbuf\"} if mutable else {\"readbuf\", \"mutbuf\"}):\n            _reject(\"memory access requires appropriate view\", \"E_HIA_TYPE\")\n        if self.children(name):\n            _reject(\"parent view is suspended until child loans end\", \"E_HIA_LOAN\")\n\n    def borrow(self, source, output, mutable, *, chain_head=False):\n        typ = self.value(source)\n        allowed = {\"chain\"} if chain_head else ({\"buffer\", \"mutbuf\"} if mutable else BYTE_RESOURCES)\n        if typ not in allowed:\n            _reject(\"invalid borrow permission\", \"E_HIA_LOAN\")\n        root = self.caps[source].root\n        allowed_ancestors = self.ancestors(source) | {source}\n        others = [cap for name, cap in self.caps.items()\n                  if cap.root == root and name not in allowed_ancestors]\n        if mutable and others or not mutable and any(c.typ == \"mutbuf\" for c in others):\n            _reject(\"conflicting live borrow\", \"E_HIA_LOAN\")\n        self.caps[output] = _Capability(\"mutbuf\" if mutable else \"readbuf\", root, source,\n                                        origin=self.caps[source].origin)\n\n    def instruction(self, ins):\n        op, args, out, attrs = ins[\"op\"], ins[\"args\"], ins[\"out\"], ins[\"attrs\"]\n        actual = [self.value(a) for a in args]\n        names, types = [o[\"name\"] for o in out], [o[\"type\"] for o in out]\n        try:\n            spec = None\n            if self.profile is not None:\n                if type(self.profile) is str and self.profile == \"hepta.hia.linux-file-render.v3\":\n                    from .hia_linux_file_render import profile_opcode\n                elif type(self.profile) is str and self.profile == \"hepta.hia.linux-file.v1\":\n                    from .hia_linux_file import profile_opcode\n                elif type(self.profile) is str and self.profile == \"hepta.hia.linux-cli-process.v1\":\n                    from .hia_linux_cli_process import profile_opcode\n                elif type(self.profile) is str and self.profile == \"hepta.hia.linux-process.v1\":\n                    from .hia_linux_process import profile_opcode\n                else:\n                    from .hia_linux_stdio import profile_opcode\n                spec = profile_opcode(self.profile, op, self.schema)\n            if spec is not None:\n                self.required.update(check_instruction(spec, actual, types, attrs))\n            else:\n                from .hia_instruction_policy_native import selected_instruction_policy\n                native_effects = selected_instruction_policy(op, self.schema, actual, types, attrs)\n                if native_effects is None:\n                    spec = opcode_spec(op, self.schema)\n                    self.required.update(check_instruction(spec, actual, types, attrs))\n                else:\n                    # Read already-admitted resource guard/transition metadata;\n                    # no old opcode/version/signature/attribute/effect decision.\n                    from .hia_opcodes import OPCODES\n                    spec = OPCODES[op]\n                    self.required.update(native_effects)\n        except OpcodeRejected as exc:\n            _reject(str(exc), exc.code)\n\n        # The catalog selects the guards. These small context-dependent checks\n        # still inspect actual capabilities, never declarations or receipts.\n        for guard in spec.guards:\n            parts = guard.split(\":\")\n            rule = parts[0]\n            if rule == \"callee_interface\":\n                continue\n            name = args[int(parts[1])]\n            if rule == \"free\":\n                self.owner_free(name)\n            elif rule in {\"read\", \"write\"}:\n                self.access(name, rule == \"write\")\n            elif rule == \"distinct\":\n                if self.caps[name].root == self.caps[args[int(parts[2])]].root:\n                    _reject(op + \" may not alias one owner\", \"E_HIA_LOAN\")\n            elif rule == \"end_local_loan\":\n                if self.caps[name].external:\n                    _reject(\"callee cannot end its caller's loan\", \"E_HIA_LOAN\")\n                if self.children(name):\n                    _reject(\"end child loans before their parent\", \"E_HIA_LOAN\")\n            else:\n                _reject(\"unsupported catalog resource guard\", \"E_HIA_OPCODE\")\n        if spec.resource_transition == \"call\":\n            callee_name = _ident(attrs[\"function\"], \"callee\")\n            if callee_name not in self.functions:\n                _reject(\"unknown callee\", \"E_HIA_CALL\")\n            callee = self.functions[callee_name]\n            if len(args) != len(callee.params):\n                _reject(\"call arity mismatch\", \"E_HIA_CALL\")\n            used_owners, views = set(), []\n            for name, typ, formal in zip(args, actual, callee.params):\n                if typ != formal and not (formal == \"readbuf\" and typ == \"mutbuf\"):\n                    _reject(\"call argument type mismatch\", \"E_HIA_CALL\")\n                if typ in OWNERS:\n                    self.owner_free(name)\n                    if name in used_owners:\n                        _reject(\"owner supplied twice to call\", \"E_HIA_RESOURCE\")\n                    used_owners.add(name)\n                elif typ in {\"readbuf\", \"mutbuf\"}:\n                    self.access(name, formal == \"mutbuf\")\n                    root = self.caps[name].root\n                    if any(r == root and (m or formal == \"mutbuf\") for r, m in views):\n                        _reject(\"aliased exclusive call arguments\", \"E_HIA_LOAN\")\n                    views.append((root, formal == \"mutbuf\"))\n            if types != list(callee.returns):\n                _reject(f\"{op}: output types must be {list(callee.returns)}\", \"E_HIA_TYPE\")\n            self.required.update(callee.effects)\n\n        # Resource transitions happen only after all operand/output checks.\n        transition = spec.resource_transition\n        if transition == \"allocate\":\n            self.caps[names[0]] = _Capability(\"buffer\", names[0])\n        elif transition == \"empty_chain\":\n            self.caps[names[0]] = _Capability(\"chain\", names[0])\n        elif transition == \"chain_transfer\":\n            for name in args:\n                del self.caps[name]\n            for name, typ in zip(names, types):\n                if typ in OWNERS:\n                    self.caps[name] = _Capability(typ, name)\n        elif transition == \"chain_borrow\":\n            self.borrow(args[0], names[0], op == \"chain.head_mut\", chain_head=True)\n        elif transition == \"borrow\":\n            self.borrow(args[0], names[0], op == \"borrow.mut\")\n        elif transition in {\"end_loan\", \"drop_owner\"}:\n            del self.caps[args[0]]\n        elif transition == \"move_owner\":\n            del self.caps[args[0]]\n            self.caps[names[0]] = _Capability(actual[0], names[0])\n        elif transition == \"call\":\n            for name, typ in zip(args, actual):\n                if typ in OWNERS:\n                    del self.caps[name]\n            bindings = dict(zip(callee.param_names, args))\n            for name, typ, origin in zip(names, types, callee.return_loans):\n                if typ in OWNERS:\n                    self.caps[name] = _Capability(typ, name)\n                elif typ in {\"readbuf\", \"mutbuf\"}:\n                    self.borrow(bindings[origin], name, typ == \"mutbuf\")\n        elif transition != \"none\":\n            _reject(\"unsupported catalog resource transition\", \"E_HIA_OPCODE\")\n        self.env.update(zip(names, types))\n\n    def transfer(self, edge, target):\n        arguments = edge[\"args\"]\n        actual = [self.value(a) for a in arguments]\n        if actual != [p[\"type\"] for p in target[\"params\"]]:\n            _reject(\"edge values do not match block parameter types\", \"E_HIA_CFG\")\n        resources = [a for a, t in zip(arguments, actual) if t in RESOURCES]\n        if len(resources) != len(set(resources)):\n            _reject(\"linear capability duplicated across an edge\", \"E_HIA_RESOURCE\")\n        required = {name for name, cap in self.caps.items() if not cap.external}\n        if not required.issubset(resources):\n            _reject(\"edge drops a live owner or local loan\", \"E_HIA_RESOURCE\")\n        remap = {a: p[\"name\"] for a, p in zip(arguments, target[\"params\"])\n                 if p[\"type\"] in RESOURCES}\n        try:\n            return rename_capabilities(self.caps, remap)\n        except CapabilityFlowRejected as error:\n            _reject(str(error), error.code)\n\n    def finish(self):\n        term = self.block[\"term\"]\n        if term[\"op\"] == \"branch\" and self.value(term[\"cond\"]) != \"bool\":\n            _reject(\"branch condition is not bool\", \"E_HIA_CFG\")\n        if term[\"op\"] == \"ret\":\n            names = term[\"values\"]\n            types = [self.value(n) for n in names]\n            if types != self.fn[\"returns\"]:\n                _reject(\"return type/arity mismatch\", \"E_HIA_TYPE\")\n            loans = [n for n, t in zip(names, types) if t in {\"readbuf\", \"mutbuf\"}]\n            if len(loans) != len(set(loans)):\n                _reject(\"same loan capability returned twice\", \"E_HIA_LOAN\")\n            for name, typ, origin in zip(names, types, self.fn.get(\"return_loans\", [None] * len(types))):\n                if typ not in {\"readbuf\", \"mutbuf\"}:\n                    continue\n                cap = self.caps[name]\n                parent = self.caps.get(cap.parent)\n                if (cap.origin != origin or self.children(name)\n                        or not (cap.external or parent is not None and parent.external)):\n                    _reject(\"returned loan must be its declared parameter or a direct child\", \"E_HIA_LOAN\")\n            for name in loans:\n                del self.caps[name]\n            owners = [n for n, t in zip(names, types) if t in OWNERS]\n            if len(owners) != len(set(owners)):\n                _reject(\"same owner returned twice\", \"E_HIA_RESOURCE\")\n            for name in owners:\n                self.owner_free(name)\n                del self.caps[name]\n            if any(not cap.external for cap in self.caps.values()):\n                _reject(\"return leaves live owner/local loan\", \"E_HIA_RESOURCE\")\n        elif term[\"op\"] == \"trap\":\n            self.required.add(\"trap\")\n        if not self.required.issubset(self.fn[\"effects\"]):\n            _reject(f\"missing effects {sorted(self.required - set(self.fn['effects']))}\", \"E_HIA_EFFECT\")\n\n\ndef _primitive_structure(data):\n    from .hia_program_shape_native import selected_program_shape\n    selected=selected_program_shape(data)\n    if selected is not None:\n        return selected\n    return _reference_primitive_structure(data)\n\n\ndef _reference_primitive_structure(data, *, profile=None):\n    \"\"\"Check every declaration, shape, SSA identity, CFG edge and export.\n\n    Incremental admission never caches this pass. It establishes every\n    function interface before any function body can be reused or checked.\n    \"\"\"\n    fields = {\"schema\", \"module\", \"functions\"}\n    if type(data) is dict and \"exports\" in data:\n        fields.add(\"exports\")\n    _keys(data, fields, \"program\")\n    if type(data[\"schema\"]) is not str or data[\"schema\"] not in PRIMITIVE_SCHEMAS:\n        _reject(\"unsupported program schema\", \"E_HIA_SCHEMA\")\n    _ident(data[\"module\"], \"module\")\n    if type(data[\"functions\"]) is not list or not 1 <= len(data[\"functions\"]) <= MAX_FUNCTIONS:\n        _reject(\"invalid function inventory\", \"E_HIA_FORMAT\")\n    functions, block_maps = {}, {}\n    for fn in data[\"functions\"]:\n        if profile is None:\n            blocks = _function_shape(fn, recursive_chain=supports_feature(data[\"schema\"], \"recursive_chain\"),\n                                     parameter_loan_returns=supports_feature(data[\"schema\"], \"parameter_loan_returns\"))\n        else:\n            blocks = _reference_function_shape(fn,\n                recursive_chain=supports_feature(data[\"schema\"], \"recursive_chain\"),\n                parameter_loan_returns=supports_feature(data[\"schema\"], \"parameter_loan_returns\"),\n                profile=profile)\n        if fn[\"name\"] in functions:\n            _reject(\"duplicate function\", \"E_HIA_NAME\")\n        functions[fn[\"name\"]], block_maps[fn[\"name\"]] = fn, blocks\n    if \"exports\" in data:\n        _names(data[\"exports\"], \"explicit scalar exports\")\n        if len(data[\"exports\"]) != len(set(data[\"exports\"])):\n            _reject(\"duplicate explicit scalar export\", \"E_HIA_NAME\")\n        for name in data[\"exports\"]:\n            if name not in functions:\n                _reject(\"explicit export names a missing function\", \"E_HIA_CALL\")\n            fn = functions[name]\n            if any(p[\"type\"] not in SCALARS for p in fn[\"params\"]) or any(t not in SCALARS for t in fn[\"returns\"]):\n                _reject(\"public exports cannot carry resource descriptors\", \"E_HIA_TYPE\")\n    return functions, block_maps\n\n\ndef _function_interfaces(functions):\n    \"\"\"Detached immutable facts visible across a body-checking boundary.\"\"\"\n    return {name: _FunctionInterface(\n                tuple(p[\"type\"] for p in fn[\"params\"]),\n                tuple(p[\"name\"] for p in fn[\"params\"]),\n                tuple(fn[\"returns\"]),\n                tuple(fn.get(\"return_loans\", [None] * len(fn[\"returns\"]))),\n                frozenset(fn[\"effects\"]))\n            for name, fn in functions.items()}\n\n\ndef _verify_function(schema, fn, blocks, interfaces, *, profile=None):\n    \"\"\"Verify a closed body using its bytes and immutable callee interfaces.\n\n    V8 formal identities and returned-loan declarations are dependencies.\n    Callee bodies, caller receipts and hidden global summaries are not inputs.\n    Any future cross-function obligation must extend the cache contract first.\n    \"\"\"\n    track_origins = supports_feature(schema, \"parameter_loan_returns\") and any(\n        typ in {\"readbuf\", \"mutbuf\"} for typ in fn[\"returns\"])\n    initial = {p[\"name\"]: _Capability(p[\"type\"], p[\"name\"], external=p[\"type\"] not in OWNERS,\n                                     origin=p[\"name\"] if track_origins and p[\"type\"] not in OWNERS else None)\n               for p in fn[\"params\"] if p[\"type\"] in RESOURCES}\n    incoming = {fn[\"entry\"]: initial}\n    pending = deque([fn[\"entry\"]])\n    processed = set()\n    while pending:\n        ident = pending.popleft()\n        if ident in processed:\n            continue\n        processed.add(ident)\n        block = blocks[ident]\n        if profile is None:\n            check = _BlockCheck(fn, block, incoming[ident], interfaces, schema=schema)\n        else:\n            check = _BlockCheck(fn, block, incoming[ident], interfaces, schema=schema, profile=profile)\n        for ins in block[\"ops\"]:\n            check.instruction(ins)\n        check.finish()\n        for edge in _edges(block[\"term\"]):\n            target = edge[\"target\"]\n            state = check.transfer(edge, blocks[target])\n            if target in incoming and incoming[target] != state:\n                _reject(\"predecessors disagree on loan origins/permissions\", \"E_HIA_LOAN\")\n            if target not in incoming:\n                incoming[target] = state\n                pending.append(target)\n    if processed != set(blocks):\n        _reject(\"not all blocks were checked\", \"E_HIA_CFG\")\n\n\ndef verify_program(program) -> VerifiedProgram:\n    \"\"\"Check standalone operations and every CFG edge; no source/hash authority.\n\n    Even a manually constructed VerifiedProgram is parsed and fully rechecked.\n    Caller-owned dictionaries and decoded dictionaries never back execution.\n    \"\"\"\n    if isinstance(program, VerifiedProgram) and program.structured_bytes is not None:\n        if type(program.structured_bytes) is not bytes:\n            _reject(\"structured input must be immutable canonical bytes\", \"E_HIA_FORMAT\")\n        checked = verify_program(program.structured_bytes)\n        if (checked.structured_bytes != program.structured_bytes\n                or checked.canonical_bytes != program.canonical_bytes):\n            _reject(\"structured input and executable core differ\", \"E_HIA_CORE\")\n        return checked\n    data, raw = _decode(program)\n    if (type(data) is dict and type(data.get(\"schema\")) is str\n            and data[\"schema\"] in COMPOSITE_SCHEMAS):\n        from .hia_program_composite import elaborate_program\n        # The entire input was bounded/strictly decoded above.  The whole\n        # generated program is independently checked, with no receipt bypass.\n        core = verify_program(elaborate_program(data))\n        return VerifiedProgram(core.canonical_bytes, raw)\n    if type(data) is dict and data.get(\"schema\") == SCHEMA_V2 and \"types\" in data:\n        _reject(\"historical nominal v2 requires import_legacy_composite_v2; \"\n                \"the primitive v2 namespace cannot infer a producer profile\",\n                \"E_HIA_VERSION_COLLISION\")\n    from .hia_core_admission_native import selected_core_structure\n    selected = selected_core_structure(data, raw)\n    if selected is not None:\n        return VerifiedProgram(raw)\n    functions, block_maps = _primitive_structure(data)\n    interfaces = _function_interfaces(functions)\n    for fn in functions.values():\n        _verify_function(data[\"schema\"], fn, block_maps[fn[\"name\"]], interfaces)\n    return VerifiedProgram(raw)\n\n\ndef execute_program(program, function, arguments, **kwargs):\n    \"\"\"Convenience entry point; implementation is an independent core consumer.\"\"\"\n    from .hia_program_runtime import execute_program as execute\n    return execute(program, function, arguments, **kwargs)\n\n\n# Public language-level spelling: verification of a program, not source replay.\nverify_core = verify_program\n\n# Explicit HIA selection; original function bodies remain the default.\nfrom .hia_core_verification_selection import native_core_verification_scope as _native_core_verification_scope\n\n_core_verification_reference_reject = _reject\n\ndef _reject(message, code='E_HIA_PROGRAM'):\n    with _native_core_verification_scope() as owner:\n        if owner is None:\n            carrier = {'callee': _core_verification_reference_reject, 'message': message, 'code': code}\n            del message, code, owner\n            return carrier.pop('callee')(carrier.pop('message'), carrier.pop('code'))\n        frame = owner.prepare('_reject', (message, code))\n        del message, code\n        return owner.finish(frame)\n\n_core_verification_referenceverify_program = verify_program\n\ndef verify_program(program, *, profile=None):\n    if profile is not None:\n        if type(profile) is str and profile == \"hepta.hia.linux-file-render.v3\":\n            from .hia_linux_file_render import verify_linux_file_render_program\n            return verify_linux_file_render_program(program)\n        if type(profile) is str and profile == \"hepta.hia.linux-file.v1\":\n            from .hia_linux_file import verify_linux_file_program\n            return verify_linux_file_program(program)\n        elif type(profile) is str and profile == \"hepta.hia.linux-cli-process.v1\":\n            from .hia_linux_cli_process import verify_linux_cli_process_program\n            return verify_linux_cli_process_program(program)\n        elif type(profile) is str and profile == \"hepta.hia.linux-process.v1\":\n            from .hia_linux_process import verify_linux_process_program\n            return verify_linux_process_program(program)\n        from .hia_linux_stdio import require_profile, verify_linux_stdio_program\n        require_profile(profile)\n        return verify_linux_stdio_program(program)\n    with _native_core_verification_scope() as owner:\n        if owner is None:\n            carrier = {'callee': _core_verification_referenceverify_program, 'program': program}\n            del program, owner\n            return carrier.pop('callee')(carrier.pop('program'))\n        frame = owner.prepare('verify_program', (program,))\n        del program\n        return owner.finish(frame)\n\nverify_core = verify_program\n\n# Definition anchors never follow late global replacement or deletion.\n_NATIVE_CORE_VERIFICATION_ENTRIES = {\n    '_reject': _reject,\n    'verify_program': verify_program,\n}\n"
      },
      "before": {
        "bytes": 50055,
        "git_blob": "b5f9a8c4cabaa32df8207640d3f838d3c7c588fd",
        "mode": "100644",
        "sha256": "bda3f9df9d86a4c4aa13b9777403e904a07731457aa7bcdd510961bae7a6d81a"
      },
      "path": "hepta/hia_program.py"
    },
    {
      "after": {
        "bytes": 35528,
        "git_blob": "a7a87ffe09e8a3756422e3c1863f6f9bb3107d50",
        "mode": "100644",
        "sha256": "f7aba1259bf766809545bc00ad245156a299042b94775cea900bd850fc41cb9b",
        "text": "\"\"\"Finite direct interpreter for standalone typed HIA operations.\n\nNo source AST, source compiler, LLVM, or producer receipt participates.  Defined\nprogram traps and analysis budgets are different outcomes.  Resource counters\ndescribe the stopped program state; traps/budget stops do not pretend that an\naborting native process performed normal-path destructor cleanup.\n\"\"\"\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\n\nfrom .hia_program import (HIAProgramRejected, OWNERS, RESOURCES, SCALARS, WIDTHS,\n                          integer_range, scalar_value_valid, verify_program)\nfrom .hia_bounded_memory import fill_bytes, move_bytes\nfrom .hia_schema import supports_feature\nfrom .hia_opcodes import ExecutionObservationRejected, validate_execution_observation\n\n\nclass HIAProgramTrap(ArithmeticError):\n    \"\"\"A specified aborting program operation, not an interpreter budget.\"\"\"\n\n    def __init__(self, code, message):\n        self.code, self.report = code, None\n        super().__init__(f\"E_HIA_TRAP_{code.upper()}: {message}\")\n\n\nclass HIAProgramBudgetExceeded(RuntimeError):\n    \"\"\"A finite evaluator resource limit; says nothing about termination.\"\"\"\n\n    def __init__(self, code, message):\n        self.code, self.report = code, None\n        super().__init__(f\"E_HIA_BUDGET_{code.upper()}: {message}\")\n\n\n@dataclass(eq=False)\nclass _Owner:\n    ident: int\n    data: bytearray\n    active: bool = True\n\n\n@dataclass(eq=False)\nclass _View:\n    parent: _Owner | _View\n    mutable: bool\n    active: bool = True\n\n\n@dataclass(eq=False)\nclass _ChainNode:\n    storage: _Owner\n    payload: _Owner\n    tail: _ChainNode | None\n\n\n@dataclass(eq=False)\nclass _Chain:\n    ident: int\n    head: _ChainNode | None\n    active: bool = True\n\n\n# The native v7 object model has a 16-byte buffer descriptor and one 8-byte\n# successor pointer. Node storage is charged to the same live-byte budget as\n# user buffers, and consumes the same allocation-failure sequence.\nCHAIN_NODE_BYTES = 24\n\n\ndef _underlying(value):\n    seen = set()\n    while isinstance(value, _View):\n        if not value.active or id(value) in seen:\n            raise HIAProgramRejected(\"expired/cyclic runtime view\", \"E_HIA_RUNTIME_INVARIANT\")\n        seen.add(id(value))\n        value = value.parent\n    if not isinstance(value, _Owner) or not value.active:\n        raise HIAProgramRejected(\"expired runtime owner\", \"E_HIA_RUNTIME_INVARIANT\")\n    return value\n\n\ndef _wrap(value, typ):\n    width = WIDTHS[typ]\n    value &= (1 << width) - 1\n    if typ.startswith(\"i\") and value >= (1 << (width - 1)):\n        value -= 1 << width\n    return value\n\n\ndef _checked(value, typ):\n    lo, hi = integer_range(typ)\n    if not lo <= value <= hi:\n        raise HIAProgramTrap(\"overflow\", f\"result is outside {typ}\")\n    return value\n\n\nclass _Machine:\n    def __init__(self, program, max_steps, max_heap_bytes, allocation_fail_at, max_call_depth):\n        self.program = program\n        document = program.as_dict()\n        self.functions = {f[\"name\"]: f for f in document[\"functions\"]}\n        self.recursive_chain = supports_feature(document[\"schema\"], \"recursive_chain\")\n        self.max_steps, self.max_heap_bytes = max_steps, max_heap_bytes\n        self.allocation_fail_at, self.max_call_depth = allocation_fail_at, max_call_depth\n        self.steps = self.allocations = self.frees = self.allocation_attempts = 0\n        self.live_bytes = self.peak_bytes = self.owner_count = self.drops = 0\n        self.loans_started = self.loans_ended = 0\n        self.owners = {}\n        self.chains = {}\n        self.chains_created = self.chains_consumed = 0\n        self.chain_nodes_created = self.chain_nodes_dropped = 0\n\n    def tick(self):\n        self.steps += 1\n        if self.steps > self.max_steps:\n            raise HIAProgramBudgetExceeded(\"steps\", \"finite step limit reached\")\n\n    def resources(self):\n        result = {\"allocations\": self.allocations, \"frees\": self.frees,\n                \"allocation_attempts\": self.allocation_attempts,\n                \"owners_created\": self.owner_count, \"owners_dropped\": self.drops,\n                \"live_owners\": len(self.owners), \"live_bytes\": self.live_bytes,\n                \"peak_bytes\": self.peak_bytes,\n                \"loans_started\": self.loans_started, \"loans_ended\": self.loans_ended,\n                \"live_local_loans\": self.loans_started - self.loans_ended}\n        # Existing profiles retain the original report shape. New counters\n        # describe the recursive data structure independently of byte owners.\n        if self.recursive_chain:\n            result.update({\"chains_created\": self.chains_created,\n                           \"chains_consumed\": self.chains_consumed,\n                           \"live_chains\": len(self.chains),\n                           \"chain_nodes_created\": self.chain_nodes_created,\n                           \"chain_nodes_dropped\": self.chain_nodes_dropped,\n                           \"live_chain_nodes\": self.chain_nodes_created - self.chain_nodes_dropped})\n        return result\n\n    def new_chain(self, head=None):\n        self.chains_created += 1\n        chain = _Chain(self.chains_created, head)\n        self.chains[chain.ident] = chain\n        return chain\n\n    def chain_head(self, chain):\n        if not isinstance(chain, _Chain) or not chain.active or self.chains.get(chain.ident) is not chain:\n            raise HIAProgramRejected(\"expired runtime chain\", \"E_HIA_RUNTIME_INVARIANT\")\n        return chain.head\n\n    def consume_chain(self, chain):\n        head = self.chain_head(chain)\n        del self.chains[chain.ident]\n        chain.active, chain.head = False, None\n        self.chains_consumed += 1\n        return head\n\n    def drop_chain(self, chain):\n        head = self.consume_chain(chain)\n        # Destruction is iterative. A runtime-sized list does not consume one\n        # Python/native stack frame per node. Charge work to the step budget;\n        # an interrupted destruction is a budget stop, not claimed cleanup.\n        while head is not None:\n            self.tick()\n            tail = head.tail\n            self.drop(head.payload)\n            self.drop(head.storage)\n            self.chain_nodes_dropped += 1\n            head.tail = None\n            head = tail\n\n    def new_owner(self, data):\n        self.owner_count += 1\n        owner = _Owner(self.owner_count, data)\n        self.owners[owner.ident] = owner\n        if data:\n            self.allocations += 1\n        self.live_bytes += len(data)\n        self.peak_bytes = max(self.peak_bytes, self.live_bytes)\n        return owner\n\n    def allocate(self, size, optional):\n        # Zero-size owners are real capabilities but require no allocator call,\n        # cannot fail, and do not consume the deterministic failure injection.\n        if size == 0:\n            return self.new_owner(bytearray()), True\n        if size > (1 << 63) - 1:\n            if optional:\n                return self.new_owner(bytearray()), False\n            raise HIAProgramTrap(\"allocation\", \"allocation exceeds the 64-bit object-size model\")\n        # A host evaluator budget is not reported as a program malloc failure.\n        if size > self.max_heap_bytes - self.live_bytes:\n            raise HIAProgramBudgetExceeded(\"heap\", \"finite live-byte limit reached\")\n        self.allocation_attempts += 1\n        failed = self.allocation_fail_at == self.allocation_attempts\n        if not failed:\n            try:\n                return self.new_owner(bytearray(size)), True\n            except (MemoryError, OverflowError):\n                failed = True\n        if failed and optional:\n            return self.new_owner(bytearray()), False\n        raise HIAProgramTrap(\"allocation\", \"allocator returned failure\")\n\n    def drop(self, owner):\n        owner = _underlying(owner)\n        if owner.ident not in self.owners:\n            raise HIAProgramRejected(\"duplicate runtime drop\", \"E_HIA_RUNTIME_INVARIANT\")\n        del self.owners[owner.ident]\n        self.drops += 1\n        if owner.data:\n            self.frees += 1\n        self.live_bytes -= len(owner.data)\n        owner.active = False\n        owner.data = bytearray()\n\n    def operation(self, ins, env, depth):\n        op, attrs = ins[\"op\"], ins[\"attrs\"]\n        names = ins[\"args\"]\n        args = [env[name] for name in names]\n        outputs = ins[\"out\"]\n        typ = outputs[0][\"type\"] if outputs else None\n        result = []\n        if op == \"const\":\n            result = [attrs[\"value\"]]\n        elif op in {f\"int.{a}.{m}\" for a in (\"add\", \"sub\", \"mul\") for m in (\"checked\", \"wrap\")}:\n            a, b = args\n            kind = op.split(\".\")[1]\n            value = a + b if kind == \"add\" else a - b if kind == \"sub\" else a * b\n            result = [(_checked if op.endswith(\"checked\") else _wrap)(value, typ)]\n        elif op in {\"int.div.checked\", \"int.rem.checked\"}:\n            a, b = args\n            if b == 0:\n                raise HIAProgramTrap(\"division_by_zero\", \"integer divisor is zero\")\n            lo, _ = integer_range(typ)\n            if typ.startswith(\"i\") and a == lo and b == -1:\n                raise HIAProgramTrap(\"overflow\", \"signed minimum divided by minus one\")\n            quotient = abs(a) // abs(b)\n            if (a < 0) != (b < 0):\n                quotient = -quotient\n            result = [quotient if op == \"int.div.checked\" else a - quotient * b]\n        elif op in {\"int.shl.checked\", \"int.shr.checked\"}:\n            a, b = args\n            if not 0 <= b < WIDTHS[typ]:\n                raise HIAProgramTrap(\"overflow\", \"shift count is outside the word width\")\n            result = [_wrap(a << b, typ) if op == \"int.shl.checked\" else a >> b]\n        elif op == \"int.neg.checked\":\n            result = [_checked(-args[0], typ)]\n        elif op in {\"bit.and\", \"bit.or\", \"bit.xor\"}:\n            a, b = args\n            value = a & b if op == \"bit.and\" else a | b if op == \"bit.or\" else a ^ b\n            result = [_wrap(value, typ)]\n        elif op == \"bit.not\":\n            result = [_wrap(~args[0], typ)]\n        elif op.startswith(\"compare.\"):\n            a, b = args\n            result = [{\"compare.eq\": a == b, \"compare.ne\": a != b,\n                       \"compare.lt\": a < b, \"compare.le\": a <= b,\n                       \"compare.gt\": a > b, \"compare.ge\": a >= b}[op]]\n        elif op == \"bool.not\":\n            result = [not args[0]]\n        elif op == \"bool.and\":\n            result = [args[0] and args[1]]\n        elif op == \"bool.or\":\n            result = [args[0] or args[1]]\n        elif op == \"int.cast\":\n            result = [(_checked if attrs[\"mode\"] == \"checked\" else _wrap)(args[0], typ)]\n        elif op == \"select\":\n            result = [args[1] if args[0] else args[2]]\n        elif op in {\"buffer.new\", \"buffer.try_new\"}:\n            owner, ok = self.allocate(args[0], op == \"buffer.try_new\")\n            result = [owner] + ([ok] if op == \"buffer.try_new\" else [])\n        elif op == \"buffer.len\":\n            result = [len(_underlying(args[0]).data)]\n        elif op == \"chain.empty\":\n            result = [self.new_chain()]\n        elif op == \"chain.try_push\":\n            chain, payload = args\n            head = self.chain_head(chain)\n            _underlying(payload)\n            storage, ok = self.allocate(CHAIN_NODE_BYTES, True)\n            if ok:\n                node = _ChainNode(storage, payload, head)\n                self.chain_nodes_created += 1\n                fallback = self.new_owner(bytearray())\n                self.consume_chain(chain)\n                result = [self.new_chain(node), fallback, True]\n            else:\n                # The failed allocation's logical empty owner is internal.\n                # Both caller-owned inputs survive in fresh output names.\n                self.drop(storage)\n                self.consume_chain(chain)\n                result = [self.new_chain(head), payload, False]\n            for name in names:\n                del env[name]\n        elif op == \"chain.pop\":\n            head = self.consume_chain(args[0])\n            if head is None:\n                result = [self.new_chain(), self.new_owner(bytearray()), False]\n            else:\n                tail, payload = head.tail, head.payload\n                self.drop(head.storage)\n                self.chain_nodes_dropped += 1\n                head.tail = None\n                result = [self.new_chain(tail), payload, True]\n            del env[names[0]]\n        elif op == \"chain.is_empty\":\n            result = [self.chain_head(args[0]) is None]\n        elif op in {\"chain.head_read\", \"chain.head_mut\"}:\n            head = self.chain_head(args[0])\n            if head is None:\n                raise HIAProgramTrap(\"bounds\", \"head borrow of an empty chain\")\n            _underlying(head.payload)\n            result = [_View(head.payload, op == \"chain.head_mut\")]\n            self.loans_started += 1\n        elif op in {\"borrow.read\", \"borrow.mut\"}:\n            _underlying(args[0])\n            result = [_View(args[0], op == \"borrow.mut\")]\n            self.loans_started += 1\n        elif op == \"loan.end\":\n            view = args[0]\n            _underlying(view)\n            if not isinstance(view, _View):\n                raise HIAProgramRejected(\"end of non-view\", \"E_HIA_RUNTIME_INVARIANT\")\n            view.active = False\n            self.loans_ended += 1\n            del env[names[0]]\n        elif op == \"owner.move\":\n            if isinstance(args[0], _Chain):\n                self.chain_head(args[0])\n            else:\n                _underlying(args[0])\n            result = [env.pop(names[0])]\n        elif op == \"owner.drop\":\n            if isinstance(args[0], _Chain):\n                self.drop_chain(args[0])\n            else:\n                self.drop(args[0])\n            del env[names[0]]\n        elif op == \"buffer.load\":\n            owner, index = _underlying(args[0]), args[1]\n            if index >= len(owner.data):\n                raise HIAProgramTrap(\"bounds\", \"byte load outside the borrowed buffer\")\n            result = [owner.data[index]]\n        elif op == \"buffer.store\":\n            owner, index, value = _underlying(args[0]), args[1], args[2]\n            if not isinstance(args[0], _View) or not args[0].mutable:\n                raise HIAProgramRejected(\"write through non-mutable view\", \"E_HIA_RUNTIME_INVARIANT\")\n            if index >= len(owner.data):\n                raise HIAProgramTrap(\"bounds\", \"byte store outside the borrowed buffer\")\n            owner.data[index] = value\n        elif op == \"buffer.fill\":\n            owner, value = _underlying(args[0]), args[1]\n            if not isinstance(args[0], _View) or not args[0].mutable:\n                raise HIAProgramRejected(\"fill without a mutable view\", \"E_HIA_RUNTIME_INVARIANT\")\n            # Bounded host scratch, not an O(owner_length) temporary.\n            # The HIA Owner allocation and its declared effects are unchanged.\n            try:\n                fill_bytes(owner.data, 0, len(owner.data), value)\n            except MemoryError as exc:\n                raise HIAProgramBudgetExceeded(\"host_memory\", \"bulk fill exceeds host memory\") from exc\n        elif op == \"buffer.copy\":\n            destination, source, size = _underlying(args[0]), _underlying(args[1]), args[2]\n            if not isinstance(args[0], _View) or not args[0].mutable or not isinstance(args[1], _View):\n                raise HIAProgramRejected(\"copy requires checked mutable and shared loans\", \"E_HIA_RUNTIME_INVARIANT\")\n            if destination is source:\n                raise HIAProgramRejected(\"copy alias escaped static owner verification\", \"E_HIA_RUNTIME_INVARIANT\")\n            if size > len(destination.data) or size > len(source.data):\n                raise HIAProgramTrap(\"bounds\", \"bulk copy exceeds an owner extent\")\n            # Distinct live allocations are guaranteed by the verified roots.\n            memoryview(destination.data)[:size] = memoryview(source.data)[:size]\n        elif op == \"buffer.move_within\":\n            # Exact memmove semantics, including overlapping byte ranges.\n            # All offsets are already verified usize; prove each subrange\n            # fits before any write (subtraction cannot underflow here).\n            owner = _underlying(args[0])\n            destination, source, size = args[1:]\n            if not isinstance(args[0], _View) or not args[0].mutable:\n                raise HIAProgramRejected(\"in-place move needs a unique mutable loan\",\n                                         \"E_HIA_RUNTIME_INVARIANT\")\n            extent = len(owner.data)\n            if (destination > extent or source > extent\n                    or size > extent - destination or size > extent - source):\n                raise HIAProgramTrap(\"bounds\", \"in-place byte range exceeds owned extent\")\n            if size:\n                # Match memmove overlap semantics without O(size) host scratch.\n                try:\n                    move_bytes(owner.data, destination, source, size)\n                except MemoryError as exc:\n                    raise HIAProgramBudgetExceeded(\n                        \"host_memory\", \"in-place copy exceeds host memory\") from exc\n        elif op == \"buffer.fill_range\":\n            view, offset, size, value = args\n            owner = _underlying(view)\n            if not isinstance(view, _View) or not view.mutable:\n                raise HIAProgramRejected(\"range fill requires unique mutable loan\",\n                                         \"E_HIA_RUNTIME_INVARIANT\")\n            extent = len(owner.data)\n            if offset > extent or size > extent - offset:\n                raise HIAProgramTrap(\"bounds\", \"fill range exceeds owned extent\")\n            if size:\n                try:\n                    fill_bytes(owner.data, offset, size, value)\n                except MemoryError as exc:\n                    raise HIAProgramBudgetExceeded(\n                        \"host_memory\", \"range fill exceeds host memory\") from exc\n        elif op == \"buffer.copy_range\":\n            dest_view, src_view = args[:2]\n            destination, source = _underlying(dest_view), _underlying(src_view)\n            dst_offset, src_offset, size = args[2:]\n            if (not isinstance(dest_view, _View) or not dest_view.mutable\n                    or not isinstance(src_view, _View) or destination is source):\n                raise HIAProgramRejected(\"range copy violates checked distinct-owner loans\",\n                                         \"E_HIA_RUNTIME_INVARIANT\")\n            dst_size, src_size = len(destination.data), len(source.data)\n            if (dst_offset > dst_size or src_offset > src_size\n                    or size > dst_size - dst_offset or size > src_size - src_offset):\n                raise HIAProgramTrap(\"bounds\", \"cross-owner range copy exceeds byte extent\")\n            if size:\n                memoryview(destination.data)[dst_offset:dst_offset + size] = (\n                    memoryview(source.data)[src_offset:src_offset + size])\n        elif op == \"buffer.swap\":\n            owner = _underlying(args[0])\n            left, right = args[1:]\n            if not isinstance(args[0], _View) or not args[0].mutable:\n                raise HIAProgramRejected(\"swap needs one live mutable borrow\",\n                                         \"E_HIA_RUNTIME_INVARIANT\")\n            # Snapshot both source bytes before modifying either position.\n            if left >= len(owner.data) or right >= len(owner.data):\n                raise HIAProgramTrap(\"bounds\", \"swap byte offset outside owner extent\")\n            a, b = owner.data[left], owner.data[right]\n            owner.data[left], owner.data[right] = b, a\n        elif op == \"call\":\n            callee = self.functions[attrs[\"function\"]]\n            for name, param in zip(names, callee[\"params\"]):\n                if param[\"type\"] in OWNERS:\n                    del env[name]\n            result = self.invoke(callee, args, depth + 1)\n        else:\n            raise HIAProgramRejected(\"unhandled verified opcode\", \"E_HIA_RUNTIME_INVARIANT\")\n        if len(result) != len(outputs):\n            raise HIAProgramRejected(\"runtime result arity mismatch\", \"E_HIA_RUNTIME_INVARIANT\")\n        for output, value in zip(outputs, result):\n            if output[\"type\"] in SCALARS and not scalar_value_valid(value, output[\"type\"]):\n                raise HIAProgramRejected(\"runtime produced an invalid scalar\", \"E_HIA_RUNTIME_INVARIANT\")\n            env[output[\"name\"]] = value\n\n    def invoke(self, fn, arguments, depth=0):\n        # Root invocation occupies frame 1 (depth=0), matching the static\n        # max_call_depth budget. A limit of N admits exactly N live frames.\n        # Refuse the (N+1)th BEFORE its call-entry tick or any side effect.\n        if depth >= self.max_call_depth:\n            raise HIAProgramBudgetExceeded(\"calls\", \"finite call-depth limit reached\")\n        self.tick()\n        blocks = {b[\"id\"]: b for b in fn[\"blocks\"]}\n        current = fn[\"entry\"]\n        env = {p[\"name\"]: a for p, a in zip(fn[\"params\"], arguments)}\n        while True:\n            block = blocks[current]\n            for ins in block[\"ops\"]:\n                self.tick()\n                self.operation(ins, env, depth)\n            self.tick()\n            term = block[\"term\"]\n            if term[\"op\"] == \"ret\":\n                values = [env[name] for name in term[\"values\"]]\n                bindings = {p[\"name\"]: a for p, a in zip(fn[\"params\"], arguments)}\n                for index, (typ, origin) in enumerate(zip(fn[\"returns\"], fn.get(\"return_loans\", [None] * len(values)))):\n                    if typ not in {\"readbuf\", \"mutbuf\"}:\n                        continue\n                    value, parent = values[index], bindings[origin]\n                    _underlying(value)\n                    _underlying(parent)\n                    if (not isinstance(value, _View) or not isinstance(parent, _View)\n                            or typ == \"mutbuf\" and (not value.mutable or not parent.mutable)):\n                        raise HIAProgramRejected(\"returned view permission invariant\", \"E_HIA_RUNTIME_INVARIANT\")\n                    if value is parent:\n                        # Forwarding must not expose one consumable runtime view\n                        # as both the caller's parent and its returned child.\n                        values[index] = _View(parent, typ == \"mutbuf\")\n                        self.loans_started += 1\n                    elif value.parent is not parent:\n                        raise HIAProgramRejected(\"returned view origin invariant\", \"E_HIA_RUNTIME_INVARIANT\")\n                return values\n            if term[\"op\"] == \"trap\":\n                raise HIAProgramTrap(term[\"code\"], \"explicit core trap\")\n            edge = term if term[\"op\"] == \"jump\" else term[\"then\"] if env[term[\"cond\"]] else term[\"else\"]\n            target = blocks[edge[\"target\"]]\n            values = [env[name] for name in edge[\"args\"]]\n            # All block inputs are evaluated simultaneously. Loop iterations\n            # create new dynamic instances of the same static SSA names.\n            env = {p[\"name\"]: a for p, a in zip(target[\"params\"], values)}\n            current = target[\"id\"]\n\n    def report(self, function, status, values=None, error=None, *, external_roots=()):\n        # Borrowed entry storage belongs to its caller, not this VM's heap.\n        # Accept actual live roots from the reference adapter, not a producer's\n        # reported count. This preserves the aggregate loan-backing invariant;\n        # it is not a new proof of the complete dynamic view graph.\n        if (type(external_roots) is not tuple\n                or any(type(root) is not _Owner or type(root.ident) is not int\n                       or root.ident >= 0 or root.active is not True\n                       or type(root.data) is not bytearray for root in external_roots)\n                or len({id(root) for root in external_roots}) != len(external_roots)\n                or len({root.ident for root in external_roots}) != len(external_roots)\n                or len({id(root.data) for root in external_roots}) != len(external_roots)\n                or any(root.ident in self.owners\n                       or any(root is owner for owner in self.owners.values())\n                       for root in external_roots)):\n            raise HIAProgramRejected(\"invalid external runtime roots\", \"E_HIA_RUNTIME_INVARIANT\")\n        resources = self.resources()\n        try:\n            validate_execution_observation(status, resources, steps=self.steps,\n                max_steps=self.max_steps, max_heap_bytes=self.max_heap_bytes,\n                error_code=error.code if error is not None else None,\n                with_chains=self.recursive_chain, allow_host_memory=True,\n                live_external_roots=len(external_roots))\n        except ExecutionObservationRejected as exc:\n            raise HIAProgramRejected(str(exc), \"E_HIA_RUNTIME_INVARIANT\") from exc\n        result = {\"schema\": \"hepta.hia.program-execution.v1\", \"status\": status,\n                  \"program_sha256\": self.program.sha256, \"function\": function,\n                  \"input_sha256\": self.program.input_sha256,\n                  \"steps\": self.steps, \"resources\": resources,\n                  \"word_bits\": 64, \"source_used\": False,\n                  \"claims\": {\"finite_core_execution\": True,\n                             \"whole_language_soundness_proved\": False,\n                             \"backend_refinement_proved\": False}}\n        if values is not None:\n            result[\"values\"] = values\n            result[\"result\"] = values[0] if len(values) == 1 else values\n        if error is not None:\n            result[\"error\"] = {\"code\": error.code, \"message\": str(error)}\n        return result\n\n\ndef execute_program(program, function, arguments, *, max_steps=1_000_000,\n                    max_heap_bytes=16 * 1024 * 1024, allocation_fail_at=None,\n                    max_call_depth=256, bounded_resource_limits=None,\n                    profile=None, linux_stdio_provider=None,\n                    linux_process_startup=None, linux_process_provider=None, linux_cli_components=None, linux_file_provider=None,\n                    linux_file_render_components=None):\n    \"\"\"Verify immutable bytes, then execute a scalar public entry point.\n\n    Owners and views can be created, moved and called internally. Python callers\n    cannot fabricate them: public interpreter inputs/outputs are scalar values.\n    Resource-returning functions remain available as internal core functions.\n    \"\"\"\n    if profile is not None:\n        if type(profile) is str and profile == \"hepta.hia.linux-file-render.v3\":\n            from .hia_linux_file_render import execute_linux_file_render\n            if (bounded_resource_limits is not None or linux_stdio_provider is not None\n                    or linux_process_provider is not None or linux_cli_components is not None):\n                raise HIAProgramRejected(\"separate file-render authority required\", \"E_HIA_LINUX_FILE_RENDER_PROFILE\")\n            return execute_linux_file_render(program, function, arguments,\n                provider=linux_file_provider, startup=linux_process_startup,\n                components=linux_file_render_components,\n                max_steps=max_steps, max_heap_bytes=max_heap_bytes,\n                allocation_fail_at=allocation_fail_at, max_call_depth=max_call_depth)\n        if linux_file_render_components is not None:\n            raise HIAProgramRejected(\"file-render components require their exact profile\", \"E_HIA_LINUX_FILE_RENDER_PROFILE\")\n        if type(profile) is str and profile == \"hepta.hia.linux-file.v1\":\n            from .hia_linux_file import execute_linux_file\n            if (bounded_resource_limits is not None or linux_stdio_provider is not None\n                    or linux_process_provider is not None or linux_cli_components is not None):\n                raise HIAProgramRejected(\"separate file-profile authority required\", \"E_HIA_LINUX_FILE_PROFILE\")\n            return execute_linux_file(program, function, arguments,\n                provider=linux_file_provider, startup=linux_process_startup,\n                max_steps=max_steps, max_heap_bytes=max_heap_bytes,\n                allocation_fail_at=allocation_fail_at, max_call_depth=max_call_depth)\n        if linux_file_provider is not None:\n            raise HIAProgramRejected(\"file provider requires exact file profile\", \"E_HIA_LINUX_FILE_PROFILE\")\n        if type(profile) is str and profile == \"hepta.hia.linux-cli-process.v1\":\n            from .hia_linux_cli_process import execute_linux_cli_process\n            if bounded_resource_limits is not None or linux_stdio_provider is not None:\n                raise HIAProgramRejected(\"separate CLI-process authority required\", \"E_HIA_LINUX_CLI_PROCESS_PROFILE\")\n            return execute_linux_cli_process(program, function, arguments,\n                provider=linux_process_provider, startup=linux_process_startup, components=linux_cli_components,\n                max_steps=max_steps, max_heap_bytes=max_heap_bytes,\n                allocation_fail_at=allocation_fail_at, max_call_depth=max_call_depth)\n        if linux_cli_components is not None:\n            raise HIAProgramRejected(\"CLI components require exact CLI profile\", \"E_HIA_LINUX_CLI_PROCESS_PROFILE\")\n        if type(profile) is str and profile == \"hepta.hia.linux-process.v1\":\n            from .hia_linux_process import execute_linux_process\n            if bounded_resource_limits is not None or linux_stdio_provider is not None:\n                raise HIAProgramRejected(\"separate process-profile authority and provider required\",\n                                         \"E_HIA_LINUX_PROCESS_PROFILE\")\n            return execute_linux_process(program, function, arguments,\n                provider=linux_process_provider, startup=linux_process_startup,\n                max_steps=max_steps, max_heap_bytes=max_heap_bytes,\n                allocation_fail_at=allocation_fail_at, max_call_depth=max_call_depth)\n        if linux_process_startup is not None or linux_process_provider is not None:\n            raise HIAProgramRejected(\"startup authority requires the exact process profile\",\n                                     \"E_HIA_LINUX_PROCESS_PROFILE\")\n        from .hia_linux_stdio import require_profile, execute_linux_stdio\n        require_profile(profile)\n        if bounded_resource_limits is not None:\n            raise HIAProgramRejected(\"ordinary Core budget receipts do not admit Linux I/O\",\n                                     \"E_HIA_LINUX_STDIO_PROFILE\")\n        return execute_linux_stdio(program, function, arguments, provider=linux_stdio_provider,\n            max_steps=max_steps, max_heap_bytes=max_heap_bytes,\n            allocation_fail_at=allocation_fail_at, max_call_depth=max_call_depth)\n    if linux_stdio_provider is not None or linux_process_startup is not None or linux_process_provider is not None or linux_cli_components is not None or linux_file_provider is not None or linux_file_render_components is not None:\n        raise HIAProgramRejected(\"physical-effect provider requires an explicit profile\",\n                                 \"E_HIA_LINUX_STDIO_PROFILE\")\n    checked = verify_program(program)\n    if (type(function) is not str or type(arguments) not in (list, tuple)\n            or type(max_steps) is not int or not 1 <= max_steps <= 10_000_000\n            or type(max_heap_bytes) is not int or not 0 <= max_heap_bytes <= 1024 * 1024 * 1024\n            or type(max_call_depth) is not int or not 1 <= max_call_depth <= 256\n            or allocation_fail_at is not None and\n               (type(allocation_fail_at) is not int or allocation_fail_at < 1)):\n        raise HIAProgramRejected(\"invalid entry arguments/evaluator limits\", \"E_HIA_INPUT\")\n    # Validate and execute one immutable invocation. The caller may mutate an\n    # exact list while scalar validation runs; rereading it after validation\n    # could substitute an untyped value, change arity or alter an allocation\n    # extent. Admitted scalar values themselves are immutable built-ins.\n    arguments = tuple(arguments)\n    if function not in checked.scalar_entrypoints:\n        raise HIAProgramRejected(\"nominal/internal signatures are not public scalar entries\", \"E_HIA_INPUT\")\n    budget = None\n    if bounded_resource_limits is not None:\n        from .hia_static_budget import HIAStaticBudgetRejected, qualify_bounded_resources\n        budget = qualify_bounded_resources(checked, limits=bounded_resource_limits)\n        row = next(row for row in budget[\"exports\"] if row[\"function\"] == function)\n        # Smaller evaluator limits remain meaningful, but cannot silently\n        # invalidate the finite profile promised for this invocation.\n        if (max_steps < row[\"max_vm_ticks\"] or max_heap_bytes < row[\"max_live_heap_bytes\"]\n                or max_call_depth < row[\"max_call_depth\"]):\n            raise HIAStaticBudgetRejected(\"E_HIA_BUDGET_POLICY\",\n                \"evaluator limits are below the selected entry's qualified resource bounds\")\n        max_steps = min(max_steps, budget[\"limits\"][\"max_vm_ticks\"])\n        max_heap_bytes = min(max_heap_bytes, budget[\"limits\"][\"max_live_heap_bytes\"])\n        max_call_depth = min(max_call_depth, budget[\"limits\"][\"max_call_depth\"])\n    from .hia_program_execution_native import selected_program_execution\n    native = selected_program_execution()\n    if native is not None:\n        try:\n            observed = native.execute(checked, function, arguments, max_steps=max_steps,\n                max_heap_bytes=max_heap_bytes, allocation_fail_at=allocation_fail_at,\n                max_call_depth=max_call_depth)\n        except (HIAProgramTrap, HIAProgramBudgetExceeded) as exc:\n            if budget is not None:\n                exc.report['bounded_resources'] = budget\n            raise\n        if budget is not None:\n            observed['bounded_resources'] = budget\n        return observed\n    machine = _Machine(checked, max_steps, max_heap_bytes, allocation_fail_at, max_call_depth)\n\n    def report(status, values=None, error=None):\n        observed = machine.report(function, status, values, error)\n        if budget is not None:\n            observed[\"bounded_resources\"] = budget\n        return observed\n    fn = machine.functions.get(function)\n    if fn is None or len(fn[\"params\"]) != len(arguments):\n        raise HIAProgramRejected(\"unknown entry/wrong argument count\", \"E_HIA_INPUT\")\n    if any(p[\"type\"] in RESOURCES for p in fn[\"params\"]) or any(t in RESOURCES for t in fn[\"returns\"]):\n        raise HIAProgramRejected(\"public evaluator boundary cannot carry capabilities\", \"E_HIA_INPUT\")\n    if any(not scalar_value_valid(a, p[\"type\"]) for p, a in zip(fn[\"params\"], arguments)):\n        raise HIAProgramRejected(\"entry arguments are not exactly typed machine values\", \"E_HIA_INPUT\")\n    try:\n        values = machine.invoke(fn, arguments)\n    except HIAProgramTrap as exc:\n        exc.report = report(\"trapped\", error=exc)\n        raise\n    except HIAProgramBudgetExceeded as exc:\n        exc.report = report(\"budget_exceeded\", error=exc)\n        raise\n    except RecursionError as exc:\n        limit = HIAProgramBudgetExceeded(\"calls\", \"host recursion limit reached\")\n        limit.report = report(\"budget_exceeded\", error=limit)\n        raise limit from exc\n    if machine.owners or machine.chains or machine.loans_started != machine.loans_ended:\n        raise HIAProgramRejected(\"successful scalar entry leaked a verified resource\", \"E_HIA_RUNTIME_INVARIANT\")\n    return report(\"returned\", values)\n"
      },
      "before": {
        "bytes": 35528,
