        "text": "\"\"\"Author the optional discovery expression's claim/ACK HIA controller.\"\"\"\nfrom __future__ import annotations\nimport ast\nimport hashlib\nimport json\nfrom pathlib import Path\nimport struct\nimport sys\n\nROOT=Path(__file__).resolve().parents[1]\nif __package__ in {None,''}:sys.path.insert(0,str(ROOT))\nfrom hepta import cli, hia_opcodes\nfrom hepta.hia_agent_assembly import render_assembly\nfrom hepta.hia_cli_discovery_facts import observation\nfrom tools.generate_hia_selfhost import Builder,compact_authoring_cfg,total_scalar_functions\n\nSOURCE_NAME='examples/hia_bootstrap/cli_discovery_routing.hepta'\nMAGIC=int.from_bytes(b'HCLROUT1','little')\nSTATE=int.from_bytes(b'HCLSTAT1','little')\nCOMMAND=int.from_bytes(b'HCLCMD01','little')\n\nSOURCE=r'''\ndef route(s:readbuf, o:mutbuf, w:mutbuf) -> u32:\n    if length(w) < 2048 or length(o) < 128 or length(s) < 128:\n        return 199\n    if read64(s, 0) != MAGIC:\n        return refuse(w)\n    command = read64(s, 8)\n    nonce = read64(s, 16)\n    if nonce == 0 or command > 5:\n        return refuse(w)\n    if command == 0:\n        if get(w, 0) != 0 or length(s) != 128:\n            return refuse(w)\n        i = 0\n        while i < 2048:\n            store(w, i, 0)\n            i = i + 1\n        put(w, 0, STATE)\n        put(w, 48, read64(s, 48))\n        put(w, 56, nonce)\n        profile = read64(s, 56)\n        if profile != 312 and profile != 314 and profile != 31410:\n            return refuse(w)\n        put(w, 184, profile)\n        action = get(w, 48)\n        if action < 1 or action > 15:\n            return refuse(w)\n        if action != 1 and action != 2:\n            return done(o, w, 3)\n        if action == 2:\n            return ask(o, w, 1, 2, 0, 0, 0, 0)\n        return ask(o, w, 3, 10, 0, 0, 0, 0)\n    if get(w, 0) != STATE or nonce != get(w, 56):\n        return refuse(w)\n    if command == 5:\n        if length(s) != 128 or get(w, 8) < 100 or get(w, 8) > 114:\n            return refuse(w)\n        error = get(w, 120)\n        put(w, 120, 0)\n        emit_command(o, w)\n        put(o, 64, error)\n        return 4\n    if command == 4:\n        if length(s) != 128 or get(w, 40) != 2:\n            return refuse(w)\n        put(w, 40, 0)\n        put(w, 200, 0)\n        return retire_next(o, w)\n    if get(w, 40) != 0:\n        return refuse(w)\n    if read64(s, 24) != get(w, 16) or read64(s, 32) != get(w, 24) or get(w, 24) == 0:\n        return refuse(w)\n    if command == 3:\n        if length(s) != 128 or get(w, 32) != 1:\n            return refuse(w)\n        put(w, 40, 2)\n        put(w, 176, 4)\n        emit_command(o, w)\n        return 5\n    if command == 2:\n        if get(w, 32) != 0 or length(s) != 128:\n            return refuse(w)\n        put(w, 32, 1)\n        emit_command(o, w)\n        return 3\n    if get(w, 32) != 1 or read64(s, 40) > 1:\n        return refuse(w)\n    phase = get(w, 8)\n    operation = get(w, 24)\n    put(w, 24, 0)\n    put(w, 32, 0)\n    if read64(s, 40) == 1:\n        if phase >= 100 or read64(s, 48) == 0:\n            return refuse(w)\n        put(w, 120, read64(s, 48))\n        return ask(o, w, 3, 101, 0, 0, 0, 0)\n    a = read64(s, 48)\n    b = read64(s, 56)\n    if phase == 2:\n        put(w, 168, 1)\n        return ask(o, w, 2, 3, 0, 0, 0, 0)\n    if phase == 3:\n        if a == 0:\n            return refuse(w)\n        put(w, 88, a)\n        put(w, 160, a)\n        return ask(o, w, 3, 10, 0, 0, 0, 0)\n    if phase == 10:\n        if a == 0:\n            return refuse(w)\n        put(w, 80, a)\n        if get(w, 48) == 1:\n            return ask(o, w, 4, 11, a, 0, 0, 0)\n        return ask(o, w, 5, 12, a, 0, 0, 0)\n    if phase == 11 or phase == 12:\n        if a == 0 or b == 0:\n            return refuse(w)\n        put(w, 80, a)\n        if phase == 11:\n            put(w, 88, b)\n        else:\n            put(w, 96, b)\n        return ask(o, w, 6, 13, get(w, 80), get(w, 88), get(w, 96),