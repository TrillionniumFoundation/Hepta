native CLI continuation is closed or awaiting its effect\\\")\\n        try:\\n            _ACTIVE_SESSIONS[self.nonce] = self\\n            raw = self.packet if packet is None else packet\\n            source = ctypes.create_string_buffer(raw, max(1, len(raw)))\\n            code = self.owner.control._entry(source, len(raw), self.output, len(self.output),\\n                                             self.workspace, len(self.workspace))\\n            command = struct.unpack_from(\\\"<16Q\\\", self.output)\\n            if command[0] != COMMAND_MAGIC or any(command[10:]):\\n                raise RuntimeError(\\\"invalid native CLI command envelope\\\")\\n            if code == 1:\\n                operation, sequence, catching, a, b, c, d = command[1:8]\\n                if (not 1 <= operation <= 44 or sequence == 0 or catching not in (0, 1)\\n                        or command[8] > 15 or command[9] != 0):\\n                    raise RuntimeError(\\\"invalid native CLI effect instruction\\\")\\n                self.command = (operation, sequence, catching, a, b, c, d)\\n                self.consume_mask = command[8]\\n                self.pending = True\\n            elif code == 2:\\n                if command[1] or command[3] or command[4] not in (0, 1, 2) or any(command[5:8]):\\n                    raise RuntimeError(\\\"invalid native CLI terminal instruction\\\")\\n                count, location = command[8:10]\\n                if count > 9 or location != 2816:\\n                    raise RuntimeError(\\\"invalid native CLI terminal owner plan\\\")\\n                handles = struct.unpack_from(\\\"<\\\" + \\\"Q\\\" * count, self.workspace, location)\\n                if (len(set(handles)) != len(handles)\\n                        or any(not 1 < handle < len(self.handles)\\n                               or self.handles[handle] is _RELEASED for handle in handles)):\\n                    raise RuntimeError(\\\"invalid native CLI terminal owner\\\")\\n                self.terminal_handles = handles\\n                self.finished = True\\n                self.exit_code = command[4]\\n            else:\\n                raise RuntimeError(\\\"native CLI continuation protocol or profile refused\\\")\\n            return code\\n        except BaseException:\\n            self.finished = True\\n            self.pending = False\\n            raise\\n\\n    def _read_stack(self, pending, raw):\\n        \\\"\\\"\\\"Return a still-live CALL argument and its subsequent read observation.\\\"\\\"\\\"\\n        return self.register(pending), self.register(raw), 0\\n\\n    def _effect(self, operation, a, b, c, d):\\n        value, register, field, argument = self.value, self.register, self.field, self.argument\\n        zero = (0, 0, 0)\\n        if operation == 1:\\n            result = self.cli.agent_capabilities()\\n        elif operation == 2:\\n            from .hia_opcodes import opcode_catalog\\n            result = opcode_catalog(field(a, b))\\n        elif operation == 3:\\n            result = self.common[\\\"read_bounded\\\"](field(a, b), limit=c)\\n        elif operation == 4:\\n            result = self.common[\\\"verify_program\\\"](argument(a, 0))\\n        elif operation == 5:\\n            result = self.common[\\\"assemble_program\\\"](value(a))\\n        elif operation == 6:\\n            result = self.common[\\\"diagnose_assembly\\\"](value(a))\\n        elif operation == 7:\\n            result = self.common[\\\"render_assembly\\\"](value(a))\\n        elif operation == 8:\\n            result = value(a).as_dict()\\n        elif operation == 9:\\n            result = value(a).report()\\n        elif operation == 10:\\n            result = self.common[\\\"inspect_program\\\"](value(a))\\n        elif operation == 11:\\n            from .hia_program_native import build_program_machine\\n            result = build_program_machine(value(a), field(b, c), kind=\\\"object\\\", linker=\\\"cc\\\")\\n        elif operation == 12:\\n            result = self.common[\\\"decode_json\\\"](argument(a, 0))\\n        elif operation == 13:\\n            revised, receipt = self.common[\\\"apply_program_patch\\\"](value(a), argument(b, 1))\\n            return register(revised), register(receipt), 0\\n        elif operation == 14:\\n            revised, receipt, impact = self.common[\\\"analyze_patch_impact\\\"](value(a), argument(b, 1))\\n            return register(revised), register(receipt), register(impact)\\n        elif operation == 15:\\n            result = self.common[\\\"prepare_edit\\\"](\\n                value(a), function=field(b, 8), block=field(b, 9),\\n                output=field(b, 10), fields=argument(c, 2))\\n        elif operation == 16:\\n            revised, receipt = self.common[\\\"apply_edit\\\"](value(a), argument(b, 1), argument(c, 2))\\n            return register(revised), register(receipt), 0\\n        elif operation == 17:\\n            result = self.common[\\\"prepare_batch\\\"](value(a), argument(b, 1))\\n        elif operation == 18:\\n            revised, receipt = self.common[\\\"apply_batch\\\"](value(a), argument(b, 1), argument(c, 2))\\n            return register(revised), register(receipt), 0\\n        elif operation == 19:\\n            result = self.common[\\\"publish_program\\\"](value(a), field(b, c))\\n        elif operation == 20:\\n            result = self.cli.publish_json_view(value(a), field(b, c))\\n        elif operation == 21:\\n            result = _publish_assembly(value(a), value(b), field(c, d))\\n        elif operation == 22:\\n            self.cli.output_json(argument(a, 0))\\n            return zero\\n        elif operation == 23:\\n            print(value(a), end=\\\"\\\")\\n            return zero\\n        elif operation == 24:\\n            result = {**argument(a, 0)}\\n        elif operation == 25:\\n            value(a)[value(b)] = argument(c, 2)\\n            return zero\\n        elif operation == 26:\\n            result = {}\\n        elif operation == 27:\\n            result = []\\n        elif operation == 28:\\n            value(a).append(argument(b, 1))\\n            return zero\\n        elif operation == 29:\\n            result = field(a, b)[c:c + d]\\n        elif operation == 30:\\n            return int(bool(value(a)[\\\"accepted\\\"])), 0, 0\\n        elif operation == 31:\\n            return int(value(a).get(\\\"ok\\\") is True), 0, 0\\n        elif operation == 32:\\n            result = str(value(a))\\n        elif operation == 33:\\n            result = self.owner.driver_error(value(a))\\n        elif operation == 34:\\n            print(argument(a, 0))\\n            return zero\\n        elif operation == 35:\\n            from .hia_program import verify_program\\n            from .hia_program_tools import (\\n                read_bounded, decode_json, inspect_program, apply_program_patch, publish_program,\\n            )\\n            self.common.update(verify_program=verify_program, read_bounded=read_bounded,\\n                               decode_json=decode_json, inspect_program=inspect_program,\\n                               apply_program_patch=apply_program_patch, publish_program=publish_program)\\n            return zero\\n        elif operation == 36:\\n            from .hia_agent_assembly import assemble_program, render_assembly, diagnose_assembly\\n            self.common.update(assemble_program=assemble_program, render_assembly=render_assembly,\\n                               diagnose_assembly=diagnose_assembly)\\n            return zero\\n        elif operation == 37:\\n            from .hia_edit_query import prepare_edit\\n            self.common[\\\"prepare_edit\\\"] = prepare_edit\\n            return zero\\n        elif operation == 38:\\n            from .hia_edit_query import apply_edit, MAX_RESPONSE_BYTES\\n            self.common[\\\"apply_edit\\\"] = apply_edit\\n            return zero\\n        elif operation == 39:\\n            from .hia_edit_batch import prepare_batch\\n            self.common[\\\"prepare_batch\\\"] = prepare_batch\\n            return zero\\n        elif operation == 40:\\n            from .hia_edit_batch import apply_batch, MAX_QUERY_BYTES, MAX_RESPONSE_BYTES\\n            self.common[\\\"apply_batch\\\"] = apply_batch\\n            return zero\\n        elif operation == 41:\\n            from .hia_patch_impact import analyze_patch_impact\\n            self.common[\\\"analyze_patch_impact\\\"] = analyze_patch_impact\\n            return zero\\n        elif operation == 42:\\n            from .hia_program_selfhost import build_program_selfhost\\n            result = build_program_selfhost(value(a), field(b, c),\\n                manifest=field(b, 17), manifest_sha256=field(b, 18),\\n                kind=field(b, 5), target=field(b, 6))\\n        elif operation == 43:\\n            argument(a, 0)\\n            argument(b, 1)\\n            return zero\\n        elif operation == 44:\\n            # pending is evaluated onto the real CALL stack before the read.\\n            # A read exception releases it during stack unwind, before entering\\n            # the CLI except handler, exactly like the original nested call.\\n            return self._read_stack(argument(a, 0),\\n                self.common[\\\"read_bounded\\\"](field(b, c), limit=d))\\n        else:\\n            raise RuntimeError(\\\"unknown native CLI effect\\\")\\n        return register(result), 0, 0\\n\\n    def _claim_effect(self):\\n        operation, sequence, catching, a, b, c, d = self.command\\n        raw = struct.pack(\\\"<12Q\\\", CLAIM_MAGIC, 4, sequence, operation,\\n                          self.nonce, 0, 0, 0, 0, 0, 0, 0)\\n        source = ctypes.create_string_buffer(raw, len(raw))\\n        code = self.owner.control._entry(source, len(raw), self.output, len(self.output),\\n                                         self.workspace, len(self.workspace))\\n        expected = (COMMAND_MAGIC, operation, sequence, catching, a, b, c, d,\\n                    self.consume_mask, 0, 0, 0, 0, 0, 0, 0)\\n        if code != 3 or struct.unpack_from(\\\"<16Q\\\", self.output) != expected:\\n            raise RuntimeError(\\\"native CLI effect claim refused or lost\\\")\\n\\n    def observe(self):\\n        if self.finished or not self.pending or self.in_effect:\\n            self.finished = True\\n            self.pending = False\\n            raise RuntimeError(\\\"native CLI effect permission already consumed or closed\\\")\\n        operation, sequence, catching, a, b, c, d = self.command\\n        self.pending = False\\n        self.domain_failure = False\\n        self.in_effect = True\\n        try:\\n            self._claim_effect()\\n            try:\\n                result = self._effect(operation, a, b, c, d)\\n            except DOMAIN_ERRORS:\\n                if catching:\\n                    self.domain_failure = True\\n                else:\\n                    self.finished = True\\n                raise\\n            if self.finished:\\n                raise RuntimeError(\\\"native CLI effect reentered a fenced continuation\\\")\\n            self.packet = self._packet(sequence, operation, 0, *result)\\n            self.in_effect = False\\n            return self.packet\\n        except BaseException:\\n            self.in_effect = False\\n            if not self.domain_failure:\\n                self.finished = True\\n                self.pending = False\\n            raise\\n\\n    def _drive(self):\\n        while self.step() == 1:\\n            try:\\n                self.observe()\\n            except DOMAIN_ERRORS as error:\\n                if not self.domain_failure or self.finished:\\n                    raise\\n                self.domain_failure = False\\n                operation, sequence, catching, a, b, c, d = self.command\\n                self.packet = self._packet(sequence, operation, 1, self.register(error), 0, 0)\\n                # The entire native-requested handler runs inside this except.\\n                # str(error) and stdout effects retain the real active exception;\\n                # no synthetic raise alters its traceback or context.\\n                return self._drive()\\n        return self.exit_code\\n\\n    def run(self):\\n        try:\\n            result = self._drive()\\n            # _drive's real except has unwound before local owners are released.\\n            self._release_terminal()\\n            return result\\n        except BaseException:\\n            self._fence()\\n            raise\\n\\n\\ndef _relative_path(value):\\n    return (type(value) is str and bool(value) and \\\"\\\\0\\\" not in value and \\\"\\\\\\\\\\\" not in value\\n            and not value.startswith(\\\"/\\\") and str(PurePosixPath(value)) == value\\n            and all(part not in (\\\"\\\", \\\".\\\", \\\"..\\\") for part in value.split(\\\"/\\\")))\\n\\n\\ndef installed_cli(manifest_path):\\n    \\\"\\\"\\\"Bind both sources and exact child manifests; selected failures never fall back.\\n\\n    Warm cache entries retain their original immutable image mapping. They\\n    do not reread a previously admitted disk image on every command. Source\\n    and manifest bytes are rebound on every explicit selection.\\n    \\\"\\\"\\\"\\n    path = Path(manifest_path).resolve(strict=True)\\n    with path.open(\\\"rb\\\") as stream:\\n        raw = stream.read(8193)\\n    if len(raw) > 8192:\\n        raise ValueError(\\\"native CLI bundle exceeds manifest extent\\\")\\n    bundle = json.JSONDecoder(object_pairs_hook=_unique_manifest_pairs).decode(raw.decode(\\\"utf-8\\\"))\\n    keys = {\\\"schema\\\", \\\"control_manifest\\\", \\\"control_manifest_sha256\\\",\\n            \\\"format_manifest\\\", \\\"format_manifest_sha256\\\"}\\n    if type(bundle) is not dict or set(bundle) != keys or bundle[\\\"schema\\\"] != SCHEMA:\\n        raise ValueError(\\\"invalid native CLI bundle\\\")\\n    children = {}\\n    compilers = []\\n    for name in (\\\"control\\\", \\\"format\\\"):\\n        relative, expected = bundle[name + \\\"_manifest\\\"], bundle[name + \\\"_manifest_sha256\\\"]\\n        if (not _relative_path(relative) or type(expected) is not str or len(expected) != 64\\n                or any(char not in \\\"0123456789abcdef\\\" for char in expected)):\\n            raise ValueError(\\\"invalid native CLI child identity\\\")\\n        child = (path.parent / relative).resolve(strict=True)\\n        if not child.is_relative_to(path.parent):\\n            raise ValueError(\\\"native CLI child leaves its bundle\\\")\\n        with child.open(\\\"rb\\\") as stream:\\n            child_raw = stream.read(16385)\\n        if len(child_raw) > 16384 or sha256(child_raw).hexdigest() != expected:\\n            raise ValueError(\\\"native CLI child manifest identity mismatch\\\")\\n        metadata = json.JSONDecoder(object_pairs_hook=_unique_manifest_pairs).decode(child_raw.decode(\\\"utf-8\\\"))\\n        if type(metadata) is not dict or not _relative_path(metadata.get(\\\"image_path\\\")):\\n            raise ValueError(\\\"invalid native CLI child image path\\\")\\n        compilers.append(metadata.get(\\\"compiler_sha256\\\"))\\n        children[name] = (child, child_raw)\\n    if compilers[0] != compilers[1]:\\n        raise ValueError(\\\"native CLI companion compilers differ\\\")\\n    source_hashes = {name: sha256(source.read_bytes()).hexdigest() for name, source in SOURCES.items()}\\n    control = _load_manifest(str(children[\\\"control\\\"][0]), children[\\\"control\\\"][1],\\n                             source_hashes[\\\"control\\\"], CONTROL_SCHEMA, NativeHiaJsonImage)\\n    formatter = _load_manifest(str(children[\\\"format\\\"][0]), children[\\\"format\\\"][1],\\n                               source_hashes[\\\"format\\\"], FORMAT_SCHEMA, NativeHiaJsonImage)\\n    if (path.read_bytes() != raw\\n            or any(child.read_bytes() != child_raw for child, child_raw in children.values())\\n            or any(sha256(source.read_bytes()).hexdigest() != source_hashes[name]\\n                   for name, source in SOURCES.items())):\\n        raise ValueError(\\\"native CLI selection changed while loading\\\")\\n    return NativeCli(control, formatter)\\n\\n\\ndef installed_cli_strict(manifest_path):\\n    \\\"\\\"\\\"Bind both sources and exact child manifests; selected failures never fall back.\\n\\n    Warm cache entries retain immutable mappings. Both image files, source\\n    resources and manifests are freshly read and rebound on each selection;\\n    changing a selected disk input never silently substitutes cached bytes.\\n    \\\"\\\"\\\"\\n    path = Path(manifest_path).resolve(strict=True)\\n    with path.open(\\\"rb\\\") as stream:\\n        raw = stream.read(8193)\\n    if len(raw) > 8192:\\n        raise ValueError(\\\"native CLI bundle exceeds manifest extent\\\")\\n    bundle = json.JSONDecoder(object_pairs_hook=_unique_manifest_pairs).decode(raw.decode(\\\"utf-8\\\"))\\n    keys = {\\\"schema\\\", \\\"control_manifest\\\", \\\"control_manifest_sha256\\\",\\n            \\\"format_manifest\\\", \\\"format_manifest_sha256\\\"}\\n    if type(bundle) is not dict or set(bundle) != keys or bundle[\\\"schema\\\"] != SCHEMA:\\n        raise ValueError(\\\"invalid native CLI bundle\\\")\\n    children = {}\\n    images = {}\\n    compilers = []\\n    for name in (\\\"control\\\", \\\"format\\\"):\\n        relative, expected = bundle[name + \\\"_manifest\\\"], bundle[name + \\\"_manifest_sha256\\\"]\\n        if (not _relative_path(relative) or type(expected) is not str or len(expected) != 64\\n                or any(char not in \\\"0123456789abcdef\\\" for char in expected)):\\n            raise ValueError(\\\"invalid native CLI child identity\\\")\\n        child = (path.parent / relative).resolve(strict=True)\\n        if not child.is_relative_to(path.parent):\\n            raise ValueError(\\\"native CLI child leaves its bundle\\\")\\n        with child.open(\\\"rb\\\") as stream:\\n            child_raw = stream.read(16385)\\n        if len(child_raw) > 16384 or sha256(child_raw).hexdigest() != expected:\\n            raise ValueError(\\\"native CLI child manifest identity mismatch\\\")\\n        metadata = json.JSONDecoder(object_pairs_hook=_unique_manifest_pairs).decode(child_raw.decode(\\\"utf-8\\\"))\\n        if type(metadata) is not dict or not _relative_path(metadata.get(\\\"image_path\\\")):\\n            raise ValueError(\\\"invalid native CLI child image path\\\")\\n        image_path = (child.parent / metadata[\\\"image_path\\\"]).resolve(strict=True)\\n        if not image_path.is_relative_to(child.parent):\\n            raise ValueError(\\\"native CLI child image leaves its component\\\")\\n        with image_path.open(\\\"rb\\\") as stream:\\n            image_raw = stream.read((1 << 20) + 1)\\n        if (not 0 < len(image_raw) <= 1 << 20\\n                or sha256(image_raw).hexdigest() != metadata.get(\\\"image_sha256\\\")):\\n            raise ValueError(\\\"native CLI child image identity mismatch\\\")\\n        images[name] = (image_path, image_raw)\\n        compilers.append(metadata.get(\\\"compiler_sha256\\\"))\\n        children[name] = (child, child_raw)\\n    if compilers[0] != compilers[1]:\\n        raise ValueError(\\\"native CLI companion compilers differ\\\")\\n    source_hashes = {name: sha256(source.read_bytes()).hexdigest() for name, source in SOURCES.items()}\\n    control = _load_manifest(str(children[\\\"control\\\"][0]), children[\\\"control\\\"][1],\\n                             source_hashes[\\\"control\\\"], CONTROL_SCHEMA, NativeHiaJsonImage)\\n    formatter = _load_manifest(str(children[\\\"format\\\"][0]), children[\\\"format\\\"][1],\\n                               source_hashes[\\\"format\\\"], FORMAT_SCHEMA, NativeHiaJsonImage)\\n    if (path.read_bytes() != raw\\n            or any(child.read_bytes() != child_raw for child, child_raw in children.values())\\n            or any(image.read_bytes() != raw_image for image, raw_image in images.values())\\n            or any(sha256(source.read_bytes()).hexdigest() != source_hashes[name]\\n                   for name, source in SOURCES.items())):\\n        raise ValueError(\\\"native CLI selection changed while loading\\\")\\n    return NativeCli(control, formatter)\\n\"\n      },\n      \"explicit_changed_definitions\": [\n        \"CliSession\",\n        \"installed_cli\",\n        \"installed_cli_strict\"\n      ],\n      \"patch\": \"--- before/hepta/hia_cli_native.py\\n+++ after/hepta/hia_cli_native.py\\n@@ -272,6 +272,7 @@\\n         self.in_effect = False\\n         self.cleanup_started = False\\n         self.terminal_handles = None\\n+        self.discovery_permission = None\\n         self.handles = [_RELEASED]\\n         self.common = {}\\n         try:\\n@@ -450,6 +451,8 @@\\n         return self.register(pending), self.register(raw), 0\\n \\n     def _effect(self, operation, a, b, c, d):\\n+        if self.discovery_permission is not None:\\n+            return self.discovery_permission.consume_legacy_port(self, operation, a, b, c, d)\\n         value, register, field, argument = self.value, self.register, self.field, self.argument\\n         zero = (0, 0, 0)\\n         if operation == 1:\\n@@ -675,6 +678,9 @@\\n     if len(raw) > 8192:\\n         raise ValueError(\\\"native CLI bundle exceeds manifest extent\\\")\\n     bundle = json.JSONDecoder(object_pairs_hook=_unique_manifest_pairs).decode(raw.decode(\\\"utf-8\\\"))\\n+    if type(bundle) is dict and bundle.get(\\\"schema\\\") in (\\\"hepta.hia.cli-discovery-bundle.v2\\\", \\\"hepta.hia.cli-discovery-bundle.v3\\\"):\\n+        from .hia_cli_discovery_routing_native import installed_bundle\\n+        return installed_bundle(path, raw, bundle)\\n     keys = {\\\"schema\\\", \\\"control_manifest\\\", \\\"control_manifest_sha256\\\",\\n             \\\"format_manifest\\\", \\\"format_manifest_sha256\\\"}\\n     if type(bundle) is not dict or set(bundle) != keys or bundle[\\\"schema\\\"] != SCHEMA:\\n@@ -726,6 +732,9 @@\\n     if len(raw) > 8192:\\n         raise ValueError(\\\"native CLI bundle exceeds manifest extent\\\")\\n     bundle = json.JSONDecoder(object_pairs_hook=_unique_manifest_pairs).decode(raw.decode(\\\"utf-8\\\"))\\n+    if type(bundle) is dict and bundle.get(\\\"schema\\\") in (\\\"hepta.hia.cli-discovery-bundle.v2\\\", \\\"hepta.hia.cli-discovery-bundle.v3\\\"):\\n+        from .hia_cli_discovery_routing_native import installed_bundle\\n+        return installed_bundle(path, raw, bundle, strict=True)\\n     keys = {\\\"schema\\\", \\\"control_manifest\\\", \\\"control_manifest_sha256\\\",\\n             \\\"format_manifest\\\", \\\"format_manifest_sha256\\\"}\\n     if type(bundle) is not dict or set(bundle) != keys or bundle[\\\"schema\\\"] != SCHEMA:\\n\",\n      \"unchanged_definitions\": [\n        \"_session_nonce\",\n        \"_utf32\",\n        \"_text\",\n        \"_q\",\n        \"_frame\",\n        \"_runtime_profile\",\n        \"_terminal_columns\",\n        \"_color_terminal\",\n        \"_print_parser_message\",\n        \"_publish_assembly\",\n        \"NativeCli\",\n        \"_relative_path\"\n      ]\n    },\n    \"hepta/hia_opcodes.py\": {\n      \"after\": {\n        \"bytes\": 20972,\n        \"sha256\": \"c95b050174d8b08a5af61b50bf21e5af87d6dbd154d0a242c4c01c170b56d217\",\n        \"text\": \"\\\"\\\"\\\"One closed instruction contract for primitive HIA checkers and agent tools.\\n\\nThe table generates local operand/result, attribute, effect and version checks.\\nOwnership/CFG checks, execution, and lowering remain separate implementations;\\npublishing this catalog is not a soundness or native-refinement certificate.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nfrom dataclasses import asdict, dataclass\\nfrom hashlib import sha256\\nimport json\\nfrom types import MappingProxyType\\n\\nfrom .hia_schema import LATEST_CORE_SCHEMA, PRIMITIVE_PROFILES\\n\\nWIDTHS = MappingProxyType({**{f\\\"{s}{n}\\\": n for s in (\\\"i\\\", \\\"u\\\") for n in (8, 16, 32, 64)},\\n                          \\\"isize\\\": 64, \\\"usize\\\": 64})\\nSCALARS = frozenset(WIDTHS) | {\\\"bool\\\", \\\"unit\\\"}\\nOWNERS = frozenset({\\\"buffer\\\", \\\"chain\\\"})\\nBYTE_RESOURCES = frozenset({\\\"buffer\\\", \\\"readbuf\\\", \\\"mutbuf\\\"})\\nRESOURCES = BYTE_RESOURCES | OWNERS\\nTYPES = SCALARS | RESOURCES\\nEFFECTS = frozenset({\\\"alloc\\\", \\\"read\\\", \\\"write\\\", \\\"trap\\\"})\\nTRAP_CODES = frozenset({\\\"user\\\", \\\"overflow\\\", \\\"division_by_zero\\\", \\\"bounds\\\", \\\"allocation\\\"})\\nEXECUTION_RESOURCE_FIELDS = frozenset({\\n    \\\"allocations\\\", \\\"frees\\\", \\\"allocation_attempts\\\", \\\"owners_created\\\", \\\"owners_dropped\\\",\\n    \\\"live_owners\\\", \\\"live_bytes\\\", \\\"peak_bytes\\\", \\\"loans_started\\\", \\\"loans_ended\\\", \\\"live_local_loans\\\",\\n})\\nEXECUTION_CHAIN_FIELDS = frozenset({\\n    \\\"chains_created\\\", \\\"chains_consumed\\\", \\\"live_chains\\\", \\\"chain_nodes_created\\\",\\n    \\\"chain_nodes_dropped\\\", \\\"live_chain_nodes\\\",\\n})\\n_GROUPS = MappingProxyType({\\\"integer\\\": frozenset(WIDTHS), \\\"scalar\\\": SCALARS,\\n    \\\"equality\\\": frozenset(WIDTHS) | {\\\"bool\\\"}, \\\"owner\\\": OWNERS, \\\"bytes\\\": BYTE_RESOURCES,\\n    \\\"view\\\": frozenset({\\\"readbuf\\\", \\\"mutbuf\\\"}), \\\"mutable_source\\\": frozenset({\\\"buffer\\\", \\\"mutbuf\\\"})})\\n\\n\\nclass OpcodeRejected(ValueError):\\n    def __init__(self, message, code=\\\"E_HIA_OPCODE\\\"):\\n        self.code = code\\n        super().__init__(message)\\n\\n\\nclass ExecutionObservationRejected(ValueError):\\n    \\\"\\\"\\\"An execution summary contradicts the shared outcome/ledger contract.\\\"\\\"\\\"\\n\\n\\ndef validate_execution_observation(status, ledger, *, steps, max_steps, max_heap_bytes,\\n                                   error_code=None, with_chains=False, allow_host_memory=False,\\n                                   live_external_roots=0):\\n    from .hia_execution_observation_selection import selected_execution_observation\\n    owner = selected_execution_observation(globals())\\n    if owner is not None:\\n        return owner.invoke('validate_execution_observation', (status, ledger,\\n            (steps, max_steps, max_heap_bytes, error_code, with_chains,\\n             allow_host_memory, live_external_roots)))\\n    return _reference_validate_execution_observation(status, ledger, steps=steps,\\n        max_steps=max_steps, max_heap_bytes=max_heap_bytes, error_code=error_code,\\n        with_chains=with_chains, allow_host_memory=allow_host_memory,\\n        live_external_roots=live_external_roots)\\n\\n\\ndef _reference_validate_execution_observation(status, ledger, *, steps, max_steps, max_heap_bytes,\\n                                   error_code=None, with_chains=False, allow_host_memory=False,\\n                                   live_external_roots=0):\\n    \\\"\\\"\\\"Check finite wire/accounting invariants, without running or admitting Core.\\n\\n    Return, program trap and evaluator stop remain distinct. In particular a\\n    stopped invocation may retain resources; its observation must not erase\\n    those resources by contradicting the allocation/owner/loan counters. This\\n    validates a summary, not the truth of a producer or any program semantics.\\n    Normal errors and cooperative cancellation represented as values obey the\\n    ordinary-return rule. Host termination and arbitrary unwinding are absent.\\n    A reference adapter may supply separately checked live external roots as\\n    context, never as Core heap allocations or wire-ledger fields. The default\\n    remains the closed, VM-owned-root contract used by raw/native observers.\\n    \\\"\\\"\\\"\\n    def need(condition, message):\\n        if not condition:\\n            raise ExecutionObservationRejected(\\\"E_HIA_EXECUTION_CONTRACT: \\\" + message)\\n\\n    need(type(status) is str and status in {\\\"returned\\\", \\\"trapped\\\", \\\"budget_exceeded\\\"},\\n         \\\"unknown execution outcome\\\")\\n    need(type(with_chains) is bool and type(allow_host_memory) is bool, \\\"exact profile flags required\\\")\\n    need(type(live_external_roots) is int and 0 <= live_external_roots < 1 << 64,\\n         \\\"external root count must be an exact unsigned u64 integer\\\")\\n    fields = EXECUTION_RESOURCE_FIELDS | (EXECUTION_CHAIN_FIELDS if with_chains else frozenset())\\n    need(type(ledger) is dict and set(ledger) == fields, \\\"resource field inventory differs\\\")\\n    need(all(type(value) is int and 0 <= value < 1 << 64 for value in ledger.values()),\\n         \\\"resource counters must be exact unsigned u64 integers\\\")\\n    need(type(steps) is int and type(max_steps) is int and 1 <= max_steps <= 10_000_000\\n         and type(max_heap_bytes) is int and 0 <= max_heap_bytes <= 1024 * 1024 * 1024,\\n         \\\"invalid explicit evaluator limits\\\")\\n    allocated, freed = ledger[\\\"allocations\\\"], ledger[\\\"frees\\\"]\\n    created, dropped, live = ledger[\\\"owners_created\\\"], ledger[\\\"owners_dropped\\\"], ledger[\\\"live_owners\\\"]\\n    nonempty = allocated - freed\\n    need(freed <= allocated <= ledger[\\\"allocation_attempts\\\"] and allocated <= created\\n         and freed <= dropped <= created and live == created - dropped,\\n         \\\"allocation and owner conservation differ\\\")\\n    need(0 <= nonempty <= live and nonempty <= ledger[\\\"live_bytes\\\"]\\n         and (nonempty == 0) == (ledger[\\\"live_bytes\\\"] == 0),\\n         \\\"live payload is inconsistent with live allocation/owner counts\\\")\\n    need(ledger[\\\"loans_ended\\\"] <= ledger[\\\"loans_started\\\"]\\n         and ledger[\\\"live_local_loans\\\"] == ledger[\\\"loans_started\\\"] - ledger[\\\"loans_ended\\\"],\\n         \\\"local loan conservation differs\\\")\\n    need(live > 0 or live_external_roots > 0 or ledger[\\\"live_local_loans\\\"] == 0,\\n         \\\"a live loan has no live byte owner\\\")\\n    need(ledger[\\\"live_bytes\\\"] <= ledger[\\\"peak_bytes\\\"] <= max_heap_bytes,\\n         \\\"live/peak payload exceeds the explicit heap policy\\\")\\n    if with_chains:\\n        need(ledger[\\\"chains_consumed\\\"] <= ledger[\\\"chains_created\\\"]\\n             and ledger[\\\"live_chains\\\"] == ledger[\\\"chains_created\\\"] - ledger[\\\"chains_consumed\\\"]\\n             and ledger[\\\"chain_nodes_dropped\\\"] <= ledger[\\\"chain_nodes_created\\\"]\\n             and ledger[\\\"live_chain_nodes\\\"] == ledger[\\\"chain_nodes_created\\\"] - ledger[\\\"chain_nodes_dropped\\\"],\\n             \\\"recursive chain conservation differs\\\")\\n        # Each still-live chain node owns its distinct payload and node-storage\\n        # byte owners, even after a quota interrupts iterative destruction.\\n        need(2 * ledger[\\\"live_chain_nodes\\\"] <= live, \\\"chain nodes have missing byte owners\\\")\\n    if status == \\\"returned\\\":\\n        need(error_code is None, \\\"ordinary return cannot carry an error outcome\\\")\\n        need(live == ledger[\\\"live_local_loans\\\"] == 0\\n             and (not with_chains or ledger[\\\"live_chains\\\"] == ledger[\\\"live_chain_nodes\\\"] == 0),\\n             \\\"ordinary scalar return retains resources\\\")\\n    else:\\n        permitted = TRAP_CODES if status == \\\"trapped\\\" else frozenset({\\\"steps\\\", \\\"heap\\\", \\\"calls\\\"})\\n        if status == \\\"budget_exceeded\\\" and allow_host_memory:\\n            permitted |= {\\\"host_memory\\\"}\\n        need(type(error_code) is str and error_code in permitted, \\\"unknown or misclassified stop code\\\")\\n    tick_stop = status == \\\"budget_exceeded\\\" and error_code == \\\"steps\\\"\\n    need(steps == max_steps + 1 if tick_stop else 1 <= steps <= max_steps,\\n         \\\"tick count contradicts the execution outcome\\\")\\n\\n\\n@dataclass(frozen=True, slots=True)\\nclass OpcodeSpec:\\n    name: str\\n    operands: tuple[str, ...] | None\\n    results: tuple[str, ...] | None\\n    attributes: tuple[str, ...] = ()\\n    effects: tuple[str, ...] = ()\\n    traps: tuple[str, ...] = ()\\n    since: int = 1\\n    guards: tuple[str, ...] = ()\\n    resource_transition: str = \\\"none\\\"\\n    semantic_rule: str = \\\"\\\"\\n\\n\\ndef _table():\\n    rows = [OpcodeSpec(\\\"const\\\", (), (\\\"declared:scalar\\\",), (\\\"value\\\",), semantic_rule=\\\"exact_scalar_literal\\\")]\\n    for operator in (\\\"add\\\", \\\"sub\\\", \\\"mul\\\"):\\n        for mode in (\\\"checked\\\", \\\"wrap\\\"):\\n            rows.append(OpcodeSpec(f\\\"int.{operator}.{mode}\\\", (\\\"integer\\\", \\\"=0\\\"), (\\\"=0\\\",),\\n                effects=(\\\"trap\\\",) if mode == \\\"checked\\\" else (),\\n                traps=(\\\"overflow\\\",) if mode == \\\"checked\\\" else (), semantic_rule=f\\\"integer_{operator}_{mode}\\\"))\\n    for operator in (\\\"div\\\", \\\"rem\\\", \\\"shl\\\", \\\"shr\\\"):\\n        rows.append(OpcodeSpec(f\\\"int.{operator}.checked\\\", (\\\"integer\\\", \\\"=0\\\"), (\\\"=0\\\",),\\n            effects=(\\\"trap\\\",), traps=(\\\"division_by_zero\\\", \\\"overflow\\\") if operator in {\\\"div\\\", \\\"rem\\\"} else (\\\"overflow\\\",),\\n            semantic_rule=f\\\"integer_{operator}_checked\\\"))\\n    for operator in (\\\"and\\\", \\\"or\\\", \\\"xor\\\"):\\n        rows.append(OpcodeSpec(\\\"bit.\\\" + operator, (\\\"integer\\\", \\\"=0\\\"), (\\\"=0\\\",), semantic_rule=\\\"bit_\\\" + operator))\\n    rows += [OpcodeSpec(\\\"bit.not\\\", (\\\"integer\\\",), (\\\"=0\\\",), semantic_rule=\\\"bit_not\\\"),\\n             OpcodeSpec(\\\"int.neg.checked\\\", (\\\"integer\\\",), (\\\"=0\\\",), effects=(\\\"trap\\\",), traps=(\\\"overflow\\\",), semantic_rule=\\\"integer_neg_checked\\\")]\\n    for operator in (\\\"eq\\\", \\\"ne\\\", \\\"lt\\\", \\\"le\\\", \\\"gt\\\", \\\"ge\\\"):\\n        rows.append(OpcodeSpec(\\\"compare.\\\" + operator, (\\\"equality\\\" if operator in {\\\"eq\\\", \\\"ne\\\"} else \\\"integer\\\", \\\"=0\\\"),\\n                               (\\\"bool\\\",), semantic_rule=\\\"compare_\\\" + operator))\\n    for operator in (\\\"not\\\", \\\"and\\\", \\\"or\\\"):\\n        rows.append(OpcodeSpec(\\\"bool.\\\" + operator, (\\\"bool\\\",) if operator == \\\"not\\\" else (\\\"bool\\\", \\\"bool\\\"),\\n                               (\\\"bool\\\",), semantic_rule=\\\"bool_\\\" + operator))\\n    rows += [\\n        OpcodeSpec(\\\"int.cast\\\", (\\\"integer\\\",), (\\\"declared:integer\\\",), (\\\"mode\\\",), traps=(\\\"overflow_when_checked\\\",), semantic_rule=\\\"integer_cast_mode\\\"),\\n        OpcodeSpec(\\\"select\\\", (\\\"bool\\\", \\\"scalar\\\", \\\"=1\\\"), (\\\"=1\\\",), semantic_rule=\\\"scalar_select\\\"),\\n        OpcodeSpec(\\\"buffer.new\\\", (\\\"usize\\\",), (\\\"buffer\\\",), effects=(\\\"alloc\\\", \\\"trap\\\"), traps=(\\\"allocation\\\",), resource_transition=\\\"allocate\\\", semantic_rule=\\\"zeroed_byte_allocation\\\"),\\n        OpcodeSpec(\\\"buffer.try_new\\\", (\\\"usize\\\",), (\\\"buffer\\\", \\\"bool\\\"), effects=(\\\"alloc\\\",), resource_transition=\\\"allocate\\\", semantic_rule=\\\"zeroed_byte_allocation_or_empty_owner_false\\\"),\\n        OpcodeSpec(\\\"buffer.len\\\", (\\\"bytes\\\",), (\\\"usize\\\",), semantic_rule=\\\"byte_extent\\\"),\\n        OpcodeSpec(\\\"chain.empty\\\", (), (\\\"chain\\\",), since=7, resource_transition=\\\"empty_chain\\\", semantic_rule=\\\"empty_chain\\\"),\\n        OpcodeSpec(\\\"chain.try_push\\\", (\\\"chain\\\", \\\"buffer\\\"), (\\\"chain\\\", \\\"buffer\\\", \\\"bool\\\"), effects=(\\\"alloc\\\",), since=7, guards=(\\\"free:0\\\", \\\"free:1\\\"), resource_transition=\\\"chain_transfer\\\", semantic_rule=\\\"push_or_return_owned_inputs\\\"),\\n        OpcodeSpec(\\\"chain.pop\\\", (\\\"chain\\\",), (\\\"chain\\\", \\\"buffer\\\", \\\"bool\\\"), effects=(\\\"alloc\\\",), since=7, guards=(\\\"free:0\\\",), resource_transition=\\\"chain_transfer\\\", semantic_rule=\\\"pop_or_empty_payload_false\\\"),\\n        OpcodeSpec(\\\"chain.is_empty\\\", (\\\"chain\\\",), (\\\"bool\\\",), since=7, semantic_rule=\\\"chain_empty_test\\\"),\\n        OpcodeSpec(\\\"chain.head_read\\\", (\\\"chain\\\",), (\\\"readbuf\\\",), effects=(\\\"read\\\", \\\"trap\\\"), traps=(\\\"bounds\\\",), since=7, resource_transition=\\\"chain_borrow\\\", semantic_rule=\\\"shared_head_loan\\\"),\\n        OpcodeSpec(\\\"chain.head_mut\\\", (\\\"chain\\\",), (\\\"mutbuf\\\",), effects=(\\\"read\\\", \\\"trap\\\"), traps=(\\\"bounds\\\",), since=7, resource_transition=\\\"chain_borrow\\\", semantic_rule=\\\"exclusive_head_loan\\\"),\\n        OpcodeSpec(\\\"borrow.read\\\", (\\\"bytes\\\",), (\\\"readbuf\\\",), resource_transition=\\\"borrow\\\", semantic_rule=\\\"shared_loan\\\"),\\n        OpcodeSpec(\\\"borrow.mut\\\", (\\\"mutable_source\\\",), (\\\"mutbuf\\\",), resource_transition=\\\"borrow\\\", semantic_rule=\\\"exclusive_loan\\\"),\\n        OpcodeSpec(\\\"loan.end\\\", (\\\"view\\\",), (), guards=(\\\"end_local_loan:0\\\",), resource_transition=\\\"end_loan\\\", semantic_rule=\\\"end_local_childless_loan\\\"),\\n        OpcodeSpec(\\\"owner.move\\\", (\\\"owner\\\",), (\\\"=0\\\",), guards=(\\\"free:0\\\",), resource_transition=\\\"move_owner\\\", semantic_rule=\\\"move_unborrowed_owner\\\"),\\n        OpcodeSpec(\\\"owner.drop\\\", (\\\"owner\\\",), (), effects=(\\\"alloc\\\",), guards=(\\\"free:0\\\",), resource_transition=\\\"drop_owner\\\", semantic_rule=\\\"release_unborrowed_owner\\\"),\\n        OpcodeSpec(\\\"buffer.load\\\", (\\\"view\\\", \\\"usize\\\"), (\\\"u8\\\",), effects=(\\\"read\\\", \\\"trap\\\"), traps=(\\\"bounds\\\",), guards=(\\\"read:0\\\",), semantic_rule=\\\"checked_byte_load\\\"),\\n        OpcodeSpec(\\\"buffer.store\\\", (\\\"mutbuf\\\", \\\"usize\\\", \\\"u8\\\"), (), effects=(\\\"write\\\", \\\"trap\\\"), traps=(\\\"bounds\\\",), guards=(\\\"write:0\\\",), semantic_rule=\\\"checked_byte_store\\\"),\\n        OpcodeSpec(\\\"buffer.fill\\\", (\\\"mutbuf\\\", \\\"u8\\\"), (), effects=(\\\"write\\\",), since=2, guards=(\\\"write:0\\\",), semantic_rule=\\\"fill_entire_view\\\"),\\n        OpcodeSpec(\\\"buffer.copy\\\", (\\\"mutbuf\\\", \\\"readbuf\\\", \\\"usize\\\"), (), effects=(\\\"read\\\", \\\"write\\\", \\\"trap\\\"), traps=(\\\"bounds\\\",), since=2, guards=(\\\"write:0\\\", \\\"read:1\\\", \\\"distinct:0:1\\\"), semantic_rule=\\\"checked_disjoint_copy\\\"),\\n        OpcodeSpec(\\\"buffer.move_within\\\", (\\\"mutbuf\\\", \\\"usize\\\", \\\"usize\\\", \\\"usize\\\"), (), effects=(\\\"read\\\", \\\"write\\\", \\\"trap\\\"), traps=(\\\"bounds\\\",), since=3, guards=(\\\"write:0\\\",), semantic_rule=\\\"checked_overlap_memmove\\\"),\\n        OpcodeSpec(\\\"buffer.swap\\\", (\\\"mutbuf\\\", \\\"usize\\\", \\\"usize\\\"), (), effects=(\\\"read\\\", \\\"write\\\", \\\"trap\\\"), traps=(\\\"bounds\\\",), since=4, guards=(\\\"write:0\\\",), semantic_rule=\\\"check_both_indices_before_swap\\\"),\\n        OpcodeSpec(\\\"buffer.copy_range\\\", (\\\"mutbuf\\\", \\\"readbuf\\\", \\\"usize\\\", \\\"usize\\\", \\\"usize\\\"), (), effects=(\\\"read\\\", \\\"write\\\", \\\"trap\\\"), traps=(\\\"bounds\\\",), since=5, guards=(\\\"write:0\\\", \\\"read:1\\\", \\\"distinct:0:1\\\"), semantic_rule=\\\"checked_disjoint_offset_copy\\\"),\\n        OpcodeSpec(\\\"buffer.fill_range\\\", (\\\"mutbuf\\\", \\\"usize\\\", \\\"usize\\\", \\\"u8\\\"), (), effects=(\\\"write\\\", \\\"trap\\\"), traps=(\\\"bounds\\\",), since=6, guards=(\\\"write:0\\\",), semantic_rule=\\\"check_complete_range_before_fill\\\"),\\n        OpcodeSpec(\\\"call\\\", None, None, (\\\"function\\\",), guards=(\\\"callee_interface\\\",), resource_transition=\\\"call\\\", semantic_rule=\\\"checked_callee_and_parameter_loan_contract\\\"),\\n    ]\\n    assert len({row.name for row in rows}) == len(rows)\\n    return MappingProxyType({row.name: row for row in rows})\\n\\n\\nOPCODES = _table()\\n# Terminator structure is consumed by the same parser as instruction attributes.\\nTERMINATORS = MappingProxyType({\\\"ret\\\": (\\\"op\\\", \\\"values\\\"), \\\"jump\\\": (\\\"op\\\", \\\"target\\\", \\\"args\\\"),\\n                               \\\"branch\\\": (\\\"op\\\", \\\"cond\\\", \\\"then\\\", \\\"else\\\"), \\\"trap\\\": (\\\"op\\\", \\\"code\\\")})\\n\\n\\ndef opcode_spec(name: str, schema: str = LATEST_CORE_SCHEMA) -> OpcodeSpec:\\n    if schema not in PRIMITIVE_PROFILES:\\n        raise OpcodeRejected(\\\"unknown primitive schema; legacy/composite input requires an explicit adapter\\\")\\n    spec = OPCODES.get(name)\\n    if spec is None:\\n        raise OpcodeRejected(f\\\"unsupported opcode {name}\\\")\\n    if list(PRIMITIVE_PROFILES).index(schema) + 1 < spec.since:\\n        raise OpcodeRejected(f\\\"{name} requires HIA program v{spec.since}\\\")\\n    return spec\\n\\n\\ndef scalar_value_valid(value, typ):\\n    if typ in WIDTHS:\\n        bits = WIDTHS[typ]\\n        low, high = (-(1 << (bits - 1)), (1 << (bits - 1)) - 1) if typ.startswith(\\\"i\\\") else (0, (1 << bits) - 1)\\n        return type(value) is int and low <= value <= high\\n    return type(value) is bool if typ == \\\"bool\\\" else value is None if typ == \\\"unit\\\" else False\\n\\n\\ndef _matches(rule, typ, operands):\\n    if rule.startswith(\\\"=\\\"):\\n        return typ == operands[int(rule[1:])]\\n    rule = rule.removeprefix(\\\"declared:\\\")\\n    return typ in _GROUPS[rule] if rule in _GROUPS else typ == rule\\n\\n\\ndef check_instruction(spec: OpcodeSpec, operands, results, attributes) -> frozenset[str]:\\n    \\\"\\\"\\\"Generated local checker; caller still checks liveness, CFG and calls.\\\"\\\"\\\"\\n    if type(attributes) is not dict or set(attributes) != set(spec.attributes):\\n        raise OpcodeRejected(f\\\"{spec.name}: expected exactly {', '.join(spec.attributes)} attributes\\\", \\\"E_HIA_FORMAT\\\")\\n    for actual, rules, label in ((operands, spec.operands, \\\"operand\\\"), (results, spec.results, \\\"output\\\")):\\n        if rules is not None:\\n            if len(actual) != len(rules):\\n                raise OpcodeRejected(f\\\"{spec.name}: wrong {label} count\\\", \\\"E_HIA_TYPE\\\")\\n            if any(not _matches(rule, typ, operands) for rule, typ in zip(rules, actual)):\\n                code = \\\"E_HIA_LOAN\\\" if label == \\\"operand\\\" and spec.name in {\\\"borrow.read\\\", \\\"borrow.mut\\\"} else \\\"E_HIA_TYPE\\\"\\n                raise OpcodeRejected(f\\\"{spec.name}: {label} types must match {rules}\\\", code)\\n    effects = set(spec.effects)\\n    if spec.name == \\\"const\\\" and not scalar_value_valid(attributes[\\\"value\\\"], results[0]):\\n        raise OpcodeRejected(\\\"constant must be an exactly typed scalar\\\", \\\"E_HIA_TYPE\\\")\\n    if spec.name == \\\"int.cast\\\":\\n        if type(attributes[\\\"mode\\\"]) is not str or attributes[\\\"mode\\\"] not in {\\\"checked\\\", \\\"wrap\\\"}:\\n            raise OpcodeRejected(\\\"unsupported integer cast\\\", \\\"E_HIA_TYPE\\\")\\n        if attributes[\\\"mode\\\"] == \\\"checked\\\":\\n            effects.add(\\\"trap\\\")\\n    return frozenset(effects)\\n\\n\\ndef opcode_catalog(schema: str | None = None) -> dict:\\n    \\\"\\\"\\\"Detached complete catalog; hashes bind metadata, never grant admission.\\\"\\\"\\\"\\n    schema = LATEST_CORE_SCHEMA if schema is None else schema\\n    if schema not in PRIMITIVE_PROFILES:\\n        raise OpcodeRejected(\\\"catalog requires an exact primitive schema\\\")\\n    version = list(PRIMITIVE_PROFILES).index(schema) + 1\\n    rows = [asdict(spec) for spec in OPCODES.values() if spec.since <= version]\\n    visible_types = TYPES - ({\\\"chain\\\"} if version < 7 else set())\\n    result = {\\\"schema\\\": \\\"hepta.hia.opcode-catalog.v1\\\", \\\"core_schema\\\": schema,\\n        \\\"profile\\\": PRIMITIVE_PROFILES[schema], \\\"word_bits\\\": 64,\\n        \\\"types\\\": sorted(visible_types),\\n        \\\"type_groups\\\": {k: sorted(v & visible_types) for k, v in _GROUPS.items()},\\n        \\\"signature_rules\\\": {\\\"=N\\\": \\\"same type as zero-based operand N\\\", \\\"declared:T\\\": \\\"explicit result type in group T\\\",\\n                            \\\"null\\\": \\\"arity/types/effects determined by verified callee interface\\\"},\\n        \\\"instructions\\\": rows,\\n        \\\"terminators\\\": [{\\\"name\\\": name, \\\"fields\\\": list(fields)} for name, fields in TERMINATORS.items()],\\n        \\\"function_contract\\\": {\\\"return_loans\\\": \\\"explicit formal-name/null per return; parameter origin checked\\\" if version >= 8 else \\\"loan returns forbidden\\\"},\\n        \\\"conditional_effects\\\": {\\\"int.cast\\\": \\\"checked mode requires trap\\\", \\\"call\\\": \\\"all callee effects\\\"},\\n        \\\"resource_checks\\\": \\\"all guards, transitions, exact CFG joins and return cleanup remain mandatory\\\",\\n        \\\"backend_scope\\\": \\\"VM, direct LLVM and direct x86-64 machine backends have separate supported-target/entry-ABI checks; catalog inclusion grants no native entry ABI\\\",\\n        \\\"admission_authority\\\": \\\"hepta.hia_program.verify_program\\\", \\\"safety_certificate\\\": False,\\n        \\\"generated_checker_scope\\\": \\\"opcode/version, operand/result signatures, attributes, effects, named resource guards\\\",\\n        \\\"not_generated_or_proved\\\": [\\\"CFG ownership algorithm\\\", \\\"interpreter\\\", \\\"LLVM lowering\\\", \\\"machine code\\\"]}\\n    result[\\\"catalog_sha256\\\"] = sha256(json.dumps(result, sort_keys=True, separators=(\\\",\\\", \\\":\\\")).encode()).hexdigest()\\n    return result\\n\\n\\ndef render_opcode_reference() -> str:\\n    rows = [\\\"# HIA primitive instruction reference\\\", \\\"\\\", \\\"Generated by `python tools/generate_hia_catalog.py`; edit `hepta/hia_opcodes.py`.\\\", \\\"\\\",\\n        \\\"This catalog generates local checking and agent discovery. The ownership/CFG checker, VM and native backend remain separate implementations and require independent validation.\\\", \\\"\\\",\\n        \\\"`=N` refers to the type of operand N (zero based); `declared:T` requires an explicit result type in group T. `call` uses its checked callee interface. All attributes are exact required sets.\\\", \\\"\\\",\\n        \\\"| Instruction | Since | Operands | Results | Attributes | Effects | Resource guards |\\\", \\\"| --- | --- | --- | --- | --- | --- | --- |\\\"]\\n    for spec in OPCODES.values():\\n        fmt = lambda values: \\\"callee interface\\\" if values is None else \\\", \\\".join(values) or \\\"\\u2014\\\"\\n        rows.append(f\\\"| `{spec.name}` | v{spec.since} | {fmt(spec.operands)} | {fmt(spec.results)} | {fmt(spec.attributes)} | {fmt(spec.effects)} | {fmt(spec.guards)} |\\\")\\n    rows += [\\\"\\\", \\\"`int.cast` additionally requires `trap` in checked mode. `call` propagates all callee effects. Traps abort; normal/error-as-value returns must balance ownership. VM fuel, call depth, native stack, payload and allocator overhead are separate budgets.\\\", \\\"\\\",\\n        \\\"Core v8 adds explicit `return_loans` contracts; it does not invent new opcodes. Assembly v1 accepts explicit primitive v6/v7/v8 and preserves this field. Historical schemas are accepted only through their named adapters; no profile is guessed.\\\", \\\"\\\",\\n        \\\"Query the complete version-specific JSON with `hia catalog --schema hepta.hia.program.v8`. The catalog includes terminators, conditional effects, resource transitions, trap descriptions and exact scope limitations.\\\", \\\"\\\"]\\n    return \\\"\\\\n\\\".join(rows)\\n\\n# Definition and intrinsic metadata anchors; no admission is performed here.\\n_HIA_DISCOVERY_DEFINITIONS = (opcode_catalog, OpcodeSpec, OPCODES, PRIMITIVE_PROFILES, TYPES, _GROUPS, TERMINATORS,\\n                              opcode_catalog.__code__)\\n\"\n      },\n      \"before\": {\n        \"bytes\": 20723,\n        \"sha256\": \"05d09dad1057b9a929389ac80de1fddf533652e63160434ace41818c22f0289b\",\n        \"text\": \"\\\"\\\"\\\"One closed instruction contract for primitive HIA checkers and agent tools.\\n\\nThe table generates local operand/result, attribute, effect and version checks.\\nOwnership/CFG checks, execution, and lowering remain separate implementations;\\npublishing this catalog is not a soundness or native-refinement certificate.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nfrom dataclasses import asdict, dataclass\\nfrom hashlib import sha256\\nimport json\\nfrom types import MappingProxyType\\n\\nfrom .hia_schema import LATEST_CORE_SCHEMA, PRIMITIVE_PROFILES\\n\\nWIDTHS = MappingProxyType({**{f\\\"{s}{n}\\\": n for s in (\\\"i\\\", \\\"u\\\") for n in (8, 16, 32, 64)},\\n                          \\\"isize\\\": 64, \\\"usize\\\": 64})\\nSCALARS = frozenset(WIDTHS) | {\\\"bool\\\", \\\"unit\\\"}\\nOWNERS = frozenset({\\\"buffer\\\", \\\"chain\\\"})\\nBYTE_RESOURCES = frozenset({\\\"buffer\\\", \\\"readbuf\\\", \\\"mutbuf\\\"})\\nRESOURCES = BYTE_RESOURCES | OWNERS\\nTYPES = SCALARS | RESOURCES\\nEFFECTS = frozenset({\\\"alloc\\\", \\\"read\\\", \\\"write\\\", \\\"trap\\\"})\\nTRAP_CODES = frozenset({\\\"user\\\", \\\"overflow\\\", \\\"division_by_zero\\\", \\\"bounds\\\", \\\"allocation\\\"})\\nEXECUTION_RESOURCE_FIELDS = frozenset({\\n    \\\"allocations\\\", \\\"frees\\\", \\\"allocation_attempts\\\", \\\"owners_created\\\", \\\"owners_dropped\\\",\\n    \\\"live_owners\\\", \\\"live_bytes\\\", \\\"peak_bytes\\\", \\\"loans_started\\\", \\\"loans_ended\\\", \\\"live_local_loans\\\",\\n})\\nEXECUTION_CHAIN_FIELDS = frozenset({\\n    \\\"chains_created\\\", \\\"chains_consumed\\\", \\\"live_chains\\\", \\\"chain_nodes_created\\\",\\n    \\\"chain_nodes_dropped\\\", \\\"live_chain_nodes\\\",\\n})\\n_GROUPS = MappingProxyType({\\\"integer\\\": frozenset(WIDTHS), \\\"scalar\\\": SCALARS,\\n    \\\"equality\\\": frozenset(WIDTHS) | {\\\"bool\\\"}, \\\"owner\\\": OWNERS, \\\"bytes\\\": BYTE_RESOURCES,\\n    \\\"view\\\": frozenset({\\\"readbuf\\\", \\\"mutbuf\\\"}), \\\"mutable_source\\\": frozenset({\\\"buffer\\\", \\\"mutbuf\\\"})})\\n\\n\\nclass OpcodeRejected(ValueError):\\n    def __init__(self, message, code=\\\"E_HIA_OPCODE\\\"):\\n        self.code = code\\n        super().__init__(message)\\n\\n\\nclass ExecutionObservationRejected(ValueError):\\n    \\\"\\\"\\\"An execution summary contradicts the shared outcome/ledger contract.\\\"\\\"\\\"\\n\\n\\ndef validate_execution_observation(status, ledger, *, steps, max_steps, max_heap_bytes,\\n                                   error_code=None, with_chains=False, allow_host_memory=False,\\n                                   live_external_roots=0):\\n    from .hia_execution_observation_selection import selected_execution_observation\\n    owner = selected_execution_observation(globals())\\n    if owner is not None:\\n        return owner.invoke('validate_execution_observation', (status, ledger,\\n            (steps, max_steps, max_heap_bytes, error_code, with_chains,\\n             allow_host_memory, live_external_roots)))\\n    return _reference_validate_execution_observation(status, ledger, steps=steps,\\n        max_steps=max_steps, max_heap_bytes=max_heap_bytes, error_code=error_code,\\n        with_chains=with_chains, allow_host_memory=allow_host_memory,\\n        live_external_roots=live_external_roots)\\n\\n\\ndef _reference_validate_execution_observation(status, ledger, *, steps, max_steps, max_heap_bytes,\\n                                   error_code=None, with_chains=False, allow_host_memory=False,\\n                                   live_external_roots=0):\\n    \\\"\\\"\\\"Check finite wire/accounting invariants, without running or admitting Core.\\n\\n    Return, program trap and evaluator stop remain distinct. In particular a\\n    stopped invocation may retain resources; its observation must not erase\\n    those resources by contradicting the allocation/owner/loan counters. This\\n    validates a summary, not the truth of a producer or any program semantics.\\n    Normal errors and cooperative cancellation represented as values obey the\\n    ordinary-return rule. Host termination and arbitrary unwinding are absent.\\n    A reference adapter may supply separately checked live external roots as\\n    context, never as Core heap allocations or wire-ledger fields. The default\\n    remains the closed, VM-owned-root contract used by raw/native observers.\\n    \\\"\\\"\\\"\\n    def need(condition, message):\\n        if not condition:\\n            raise ExecutionObservationRejected(\\\"E_HIA_EXECUTION_CONTRACT: \\\" + message)\\n\\n    need(type(status) is str and status in {\\\"returned\\\", \\\"trapped\\\", \\\"budget_exceeded\\\"},\\n         \\\"unknown execution outcome\\\")\\n    need(type(with_chains) is bool and type(allow_host_memory) is bool, \\\"exact profile flags required\\\")\\n    need(type(live_external_roots) is int and 0 <= live_external_roots < 1 << 64,\\n         \\\"external root count must be an exact unsigned u64 integer\\\")\\n    fields = EXECUTION_RESOURCE_FIELDS | (EXECUTION_CHAIN_FIELDS if with_chains else frozenset())\\n    need(type(ledger) is dict and set(ledger) == fields, \\\"resource field inventory differs\\\")\\n    need(all(type(value) is int and 0 <= value < 1 << 64 for value in ledger.values()),\\n         \\\"resource counters must be exact unsigned u64 integers\\\")\\n    need(type(steps) is int and type(max_steps) is int and 1 <= max_steps <= 10_000_000\\n         and type(max_heap_bytes) is int and 0 <= max_heap_bytes <= 1024 * 1024 * 1024,\\n         \\\"invalid explicit evaluator limits\\\")\\n    allocated, freed = ledger[\\\"allocations\\\"], ledger[\\\"frees\\\"]\\n    created, dropped, live = ledger[\\\"owners_created\\\"], ledger[\\\"owners_dropped\\\"], ledger[\\\"live_owners\\\"]\\n    nonempty = allocated - freed\\n    need(freed <= allocated <= ledger[\\\"allocation_attempts\\\"] and allocated <= created\\n         and freed <= dropped <= created and live == created - dropped,\\n         \\\"allocation and owner conservation differ\\\")\\n    need(0 <= nonempty <= live and nonempty <= ledger[\\\"live_bytes\\\"]\\n         and (nonempty == 0) == (ledger[\\\"live_bytes\\\"] == 0),\\n         \\\"live payload is inconsistent with live allocation/owner counts\\\")\\n    need(ledger[\\\"loans_ended\\\"] <= ledger[\\\"loans_started\\\"]\\n         and ledger[\\\"live_local_loans\\\"] == ledger[\\\"loans_started\\\"] - ledger[\\\"loans_ended\\\"],\\n         \\\"local loan conservation differs\\\")\\n    need(live > 0 or live_external_roots > 0 or ledger[\\\"live_local_loans\\\"] == 0,\\n         \\\"a live loan has no live byte owner\\\")\\n    need(ledger[\\\"live_bytes\\\"] <= ledger[\\\"peak_bytes\\\"] <= max_heap_bytes,\\n         \\\"live/peak payload exceeds the explicit heap policy\\\")\\n    if with_chains:\\n        need(ledger[\\\"chains_consumed\\\"] <= ledger[\\\"chains_created\\\"]\\n             and ledger[\\\"live_chains\\\"] == ledger[\\\"chains_created\\\"] - ledger[\\\"chains_consumed\\\"]\\n             and ledger[\\\"chain_nodes_dropped\\\"] <= ledger[\\\"chain_nodes_created\\\"]\\n             and ledger[\\\"live_chain_nodes\\\"] == ledger[\\\"chain_nodes_created\\\"] - ledger[\\\"chain_nodes_dropped\\\"],\\n             \\\"recursive chain conservation differs\\\")\\n        # Each still-live chain node owns its distinct payload and node-storage\\n        # byte owners, even after a quota interrupts iterative destruction.\\n        need(2 * ledger[\\\"live_chain_nodes\\\"] <= live, \\\"chain nodes have missing byte owners\\\")\\n    if status == \\\"returned\\\":\\n        need(error_code is None, \\\"ordinary return cannot carry an error outcome\\\")\\n        need(live == ledger[\\\"live_local_loans\\\"] == 0\\n             and (not with_chains or ledger[\\\"live_chains\\\"] == ledger[\\\"live_chain_nodes\\\"] == 0),\\n             \\\"ordinary scalar return retains resources\\\")\\n    else:\\n        permitted = TRAP_CODES if status == \\\"trapped\\\" else frozenset({\\\"steps\\\", \\\"heap\\\", \\\"calls\\\"})\\n        if status == \\\"budget_exceeded\\\" and allow_host_memory:\\n            permitted |= {\\\"host_memory\\\"}\\n        need(type(error_code) is str and error_code in permitted, \\\"unknown or misclassified stop code\\\")\\n    tick_stop = status == \\\"budget_exceeded\\\" and error_code == \\\"steps\\\"\\n    need(steps == max_steps + 1 if tick_stop else 1 <= steps <= max_steps,\\n         \\\"tick count contradicts the execution outcome\\\")\\n\\n\\n@dataclass(frozen=True, slots=True)\\nclass OpcodeSpec:\\n    name: str\\n    operands: tuple[str, ...] | None\\n    results: tuple[str, ...] | None\\n    attributes: tuple[str, ...] = ()\\n    effects: tuple[str, ...] = ()\\n    traps: tuple[str, ...] = ()\\n    since: int = 1\\n    guards: tuple[str, ...] = ()\\n    resource_transition: str = \\\"none\\\"\\n    semantic_rule: str = \\\"\\\"\\n\\n\\ndef _table():\\n    rows = [OpcodeSpec(\\\"const\\\", (), (\\\"declared:scalar\\\",), (\\\"value\\\",), semantic_rule=\\\"exact_scalar_literal\\\")]\\n    for operator in (\\\"add\\\", \\\"sub\\\", \\\"mul\\\"):\\n        for mode in (\\\"checked\\\", \\\"wrap\\\"):\\n            rows.append(OpcodeSpec(f\\\"int.{operator}.{mode}\\\", (\\\"integer\\\", \\\"=0\\\"), (\\\"=0\\\",),\\n                effects=(\\\"trap\\\",) if mode == \\\"checked\\\" else (),\\n                traps=(\\\"overflow\\\",) if mode == \\\"checked\\\" else (), semantic_rule=f\\\"integer_{operator}_{mode}\\\"))\\n    for operator in (\\\"div\\\", \\\"rem\\\", \\\"shl\\\", \\\"shr\\\"):\\n        rows.append(OpcodeSpec(f\\\"int.{operator}.checked\\\", (\\\"integer\\\", \\\"=0\\\"), (\\\"=0\\\",),\\n            effects=(\\\"trap\\\",), traps=(\\\"division_by_zero\\\", \\\"overflow\\\") if operator in {\\\"div\\\", \\\"rem\\\"} else (\\\"overflow\\\",),\\n            semantic_rule=f\\\"integer_{operator}_checked\\\"))\\n    for operator in (\\\"and\\\", \\\"or\\\", \\\"xor\\\"):\\n        rows.append(OpcodeSpec(\\\"bit.\\\" + operator, (\\\"integer\\\", \\\"=0\\\"), (\\\"=0\\\",), semantic_rule=\\\"bit_\\\" + operator))\\n    rows += [OpcodeSpec(\\\"bit.not\\\", (\\\"integer\\\",), (\\\"=0\\\",), semantic_rule=\\\"bit_not\\\"),\\n             OpcodeSpec(\\\"int.neg.checked\\\", (\\\"integer\\\",), (\\\"=0\\\",), effects=(\\\"trap\\\",), traps=(\\\"overflow\\\",), semantic_rule=\\\"integer_neg_checked\\\")]\\n    for operator in (\\\"eq\\\", \\\"ne\\\", \\\"lt\\\", \\\"le\\\", \\\"gt\\\", \\\"ge\\\"):\\n        rows.append(OpcodeSpec(\\\"compare.\\\" + operator, (\\\"equality\\\" if operator in {\\\"eq\\\", \\\"ne\\\"} else \\\"integer\\\", \\\"=0\\\"),\\n                               (\\\"bool\\\",), semantic_rule=\\\"compare_\\\" + operator))\\n    for operator in (\\\"not\\\", \\\"and\\\", \\\"or\\\"):\\n        rows.append(OpcodeSpec(\\\"bool.\\\" + operator, (\\\"bool\\\",) if operator == \\\"not\\\" else (\\\"bool\\\", \\\"bool\\\"),\\n                               (\\\"bool\\\",), semantic_rule=\\\"bool_\\\" + operator))\\n    rows += [\\n        OpcodeSpec(\\\"int.cast\\\", (\\\"integer\\\",), (\\\"declared:integer\\\",), (\\\"mode\\\",), traps=(\\\"overflow_when_checked\\\",), semantic_rule=\\\"integer_cast_mode\\\"),\\n        OpcodeSpec(\\\"select\\\", (\\\"bool\\\", \\\"scalar\\\", \\\"=1\\\"), (\\\"=1\\\",), semantic_rule=\\\"scalar_select\\\"),\\n        OpcodeSpec(\\\"buffer.new\\\", (\\\"usize\\\",), (\\\"buffer\\\",), effects=(\\\"alloc\\\", \\\"trap\\\"), traps=(\\\"allocation\\\",), resource_transition=\\\"allocate\\\", semantic_rule=\\\"zeroed_byte_allocation\\\"),\\n        OpcodeSpec(\\\"buffer.try_new\\\", (\\\"usize\\\",), (\\\"buffer\\\", \\\"bool\\\"), effects=(\\\"alloc\\\",), resource_transition=\\\"allocate\\\", semantic_rule=\\\"zeroed_byte_allocation_or_empty_owner_false\\\"),\\n        OpcodeSpec(\\\"buffer.len\\\", (\\\"bytes\\\",), (\\\"usize\\\",), semantic_rule=\\\"byte_extent\\\"),\\n        OpcodeSpec(\\\"chain.empty\\\", (), (\\\"chain\\\",), since=7, resource_transition=\\\"empty_chain\\\", semantic_rule=\\\"empty_chain\\\"),\\n        OpcodeSpec(\\\"chain.try_push\\\", (\\\"chain\\\", \\\"buffer\\\"), (\\\"chain\\\", \\\"buffer\\\", \\\"bool\\\"), effects=(\\\"alloc\\\",), since=7, guards=(\\\"free:0\\\", \\\"free:1\\\"), resource_transition=\\\"chain_transfer\\\", semantic_rule=\\\"push_or_return_owned_inputs\\\"),\\n        OpcodeSpec(\\\"chain.pop\\\", (\\\"chain\\\",), (\\\"chain\\\", \\\"buffer\\\", \\\"bool\\\"), effects=(\\\"alloc\\\",), since=7, guards=(\\\"free:0\\\",), resource_transition=\\\"chain_transfer\\\", semantic_rule=\\\"pop_or_empty_payload_false\\\"),\\n        OpcodeSpec(\\\"chain.is_empty\\\", (\\\"chain\\\",), (\\\"bool\\\",), since=7, semantic_rule=\\\"chain_empty_test\\\"),\\n        OpcodeSpec(\\\"chain.head_read\\\", (\\\"chain\\\",), (\\\"readbuf\\\",), effects=(\\\"read\\\", \\\"trap\\\"), traps=(\\\"bounds\\\",), since=7, resource_transition=\\\"chain_borrow\\\", semantic_rule=\\\"shared_head_loan\\\"),\\n        OpcodeSpec(\\\"chain.head_mut\\\", (\\\"chain\\\",), (\\\"mutbuf\\\",), effects=(\\\"read\\\", \\\"trap\\\"), traps=(\\\"bounds\\\",), since=7, resource_transition=\\\"chain_borrow\\\", semantic_rule=\\\"exclusive_head_loan\\\"),\\n        OpcodeSpec(\\\"borrow.read\\\", (\\\"bytes\\\",), (\\\"readbuf\\\",), resource_transition=\\\"borrow\\\", semantic_rule=\\\"shared_loan\\\"),\\n        OpcodeSpec(\\\"borrow.mut\\\", (\\\"mutable_source\\\",), (\\\"mutbuf\\\",), resource_transition=\\\"borrow\\\", semantic_rule=\\\"exclusive_loan\\\"),\\n        OpcodeSpec(\\\"loan.end\\\", (\\\"view\\\",), (), guards=(\\\"end_local_loan:0\\\",), resource_transition=\\\"end_loan\\\", semantic_rule=\\\"end_local_childless_loan\\\"),\\n        OpcodeSpec(\\\"owner.move\\\", (\\\"owner\\\",), (\\\"=0\\\",), guards=(\\\"free:0\\\",), resource_transition=\\\"move_owner\\\", semantic_rule=\\\"move_unborrowed_owner\\\"),\\n        OpcodeSpec(\\\"owner.drop\\\", (\\\"owner\\\",), (), effects=(\\\"alloc\\\",), guards=(\\\"free:0\\\",), resource_transition=\\\"drop_owner\\\", semantic_rule=\\\"release_unborrowed_owner\\\"),\\n        OpcodeSpec(\\\"buffer.load\\\", (\\\"view\\\", \\\"usize\\\"), (\\\"u8\\\",), effects=(\\\"read\\\", \\\"trap\\\"), traps=(\\\"bounds\\\",), guards=(\\\"read:0\\\",), semantic_rule=\\\"checked_byte_load\\\"),\\n        OpcodeSpec(\\\"buffer.store\\\", (\\\"mutbuf\\\", \\\"usize\\\", \\\"u8\\\"), (), effects=(\\\"write\\\", \\\"trap\\\"), traps=(\\\"bounds\\\",), guards=(\\\"write:0\\\",), semantic_rule=\\\"checked_byte_store\\\"),\\n        OpcodeSpec(\\\"buffer.fill\\\", (\\\"mutbuf\\\", \\\"u8\\\"), (), effects=(\\\"write\\\",), since=2, guards=(\\\"write:0\\\",), semantic_rule=\\\"fill_entire_view\\\"),\\n        OpcodeSpec(\\\"buffer.copy\\\", (\\\"mutbuf\\\", \\\"readbuf\\\", \\\"usize\\\"), (), effects=(\\\"read\\\", \\\"write\\\", \\\"trap\\\"), traps=(\\\"bounds\\\",), since=2, guards=(\\\"write:0\\\", \\\"read:1\\\", \\\"distinct:0:1\\\"), semantic_rule=\\\"checked_disjoint_copy\\\"),\\n        OpcodeSpec(\\\"buffer.move_within\\\", (\\\"mutbuf\\\", \\\"usize\\\", \\\"usize\\\", \\\"usize\\\"), (), effects=(\\\"read\\\", \\\"write\\\", \\\"trap\\\"), traps=(\\\"bounds\\\",), since=3, guards=(\\\"write:0\\\",), semantic_rule=\\\"checked_overlap_memmove\\\"),\\n        OpcodeSpec(\\\"buffer.swap\\\", (\\\"mutbuf\\\", \\\"usize\\\", \\\"usize\\\"), (), effects=(\\\"read\\\", \\\"write\\\", \\\"trap\\\"), traps=(\\\"bounds\\\",), since=4, guards=(\\\"write:0\\\",), semantic_rule=\\\"check_both_indices_before_swap\\\"),\\n        OpcodeSpec(\\\"buffer.copy_range\\\", (\\\"mutbuf\\\", \\\"readbuf\\\", \\\"usize\\\", \\\"usize\\\", \\\"usize\\\"), (), effects=(\\\"read\\\", \\\"write\\\", \\\"trap\\\"), traps=(\\\"bounds\\\",), since=5, guards=(\\\"write:0\\\", \\\"read:1\\\", \\\"distinct:0:1\\\"), semantic_rule=\\\"checked_disjoint_offset_copy\\\"),\\n        OpcodeSpec(\\\"buffer.fill_range\\\", (\\\"mutbuf\\\", \\\"usize\\\", \\\"usize\\\", \\\"u8\\\"), (), effects=(\\\"write\\\", \\\"trap\\\"), traps=(\\\"bounds\\\",), since=6, guards=(\\\"write:0\\\",), semantic_rule=\\\"check_complete_range_before_fill\\\"),\\n        OpcodeSpec(\\\"call\\\", None, None, (\\\"function\\\",), guards=(\\\"callee_interface\\\",), resource_transition=\\\"call\\\", semantic_rule=\\\"checked_callee_and_parameter_loan_contract\\\"),\\n    ]\\n    assert len({row.name for row in rows}) == len(rows)\\n    return MappingProxyType({row.name: row for row in rows})\\n\\n\\nOPCODES = _table()\\n# Terminator structure is consumed by the same parser as instruction attributes.\\nTERMINATORS = MappingProxyType({\\\"ret\\\": (\\\"op\\\", \\\"values\\\"), \\\"jump\\\": (\\\"op\\\", \\\"target\\\", \\\"args\\\"),\\n                               \\\"branch\\\": (\\\"op\\\", \\\"cond\\\", \\\"then\\\", \\\"else\\\"), \\\"trap\\\": (\\\"op\\\", \\\"code\\\")})\\n\\n\\ndef opcode_spec(name: str, schema: str = LATEST_CORE_SCHEMA) -> OpcodeSpec:\\n    if schema not in PRIMITIVE_PROFILES:\\n        raise OpcodeRejected(\\\"unknown primitive schema; legacy/composite input requires an explicit adapter\\\")\\n    spec = OPCODES.get(name)\\n    if spec is None:\\n        raise OpcodeRejected(f\\\"unsupported opcode {name}\\\")\\n    if list(PRIMITIVE_PROFILES).index(schema) + 1 < spec.since:\\n        raise OpcodeRejected(f\\\"{name} requires HIA program v{spec.since}\\\")\\n    return spec\\n\\n\\ndef scalar_value_valid(value, typ):\\n    if typ in WIDTHS:\\n        bits = WIDTHS[typ]\\n        low, high = (-(1 << (bits - 1)), (1 << (bits - 1)) - 1) if typ.startswith(\\\"i\\\") else (0, (1 << bits) - 1)\\n        return type(value) is int and low <= value <= high\\n    return type(value) is bool if typ == \\\"bool\\\" else value is None if typ == \\\"unit\\\" else False\\n\\n\\ndef _matches(rule, typ, operands):\\n    if rule.startswith(\\\"=\\\"):\\n        return typ == operands[int(rule[1:])]\\n    rule = rule.removeprefix(\\\"declared:\\\")\\n    return typ in _GROUPS[rule] if rule in _GROUPS else typ == rule\\n\\n\\ndef check_instruction(spec: OpcodeSpec, operands, results, attributes) -> frozenset[str]:\\n    \\\"\\\"\\\"Generated local checker; caller still checks liveness, CFG and calls.\\\"\\\"\\\"\\n    if type(attributes) is not dict or set(attributes) != set(spec.attributes):\\n        raise OpcodeRejected(f\\\"{spec.name}: expected exactly {', '.join(spec.attributes)} attributes\\\", \\\"E_HIA_FORMAT\\\")\\n    for actual, rules, label in ((operands, spec.operands, \\\"operand\\\"), (results, spec.results, \\\"output\\\")):\\n        if rules is not None:\\n            if len(actual) != len(rules):\\n                raise OpcodeRejected(f\\\"{spec.name}: wrong {label} count\\\", \\\"E_HIA_TYPE\\\")\\n            if any(not _matches(rule, typ, operands) for rule, typ in zip(rules, actual)):\\n                code = \\\"E_HIA_LOAN\\\" if label == \\\"operand\\\" and spec.name in {\\\"borrow.read\\\", \\\"borrow.mut\\\"} else \\\"E_HIA_TYPE\\\"\\n                raise OpcodeRejected(f\\\"{spec.name}: {label} types must match {rules}\\\", code)\\n    effects = set(spec.effects)\\n    if spec.name == \\\"const\\\" and not scalar_value_valid(attributes[\\\"value\\\"], results[0]):\\n        raise OpcodeRejected(\\\"constant must be an exactly typed scalar\\\", \\\"E_HIA_TYPE\\\")\\n    if spec.name == \\\"int.cast\\\":\\n        if type(attributes[\\\"mode\\\"]) is not str or attributes[\\\"mode\\\"] not in {\\\"checked\\\", \\\"wrap\\\"}:\\n            raise OpcodeRejected(\\\"unsupported integer cast\\\", \\\"E_HIA_TYPE\\\")\\n        if attributes[\\\"mode\\\"] == \\\"checked\\\":\\n            effects.add(\\\"trap\\\")\\n    return frozenset(effects)\\n\\n\\ndef opcode_catalog(schema: str | None = None) -> dict:\\n    \\\"\\\"\\\"Detached complete catalog; hashes bind metadata, never grant admission.\\\"\\\"\\\"\\n    schema = LATEST_CORE_SCHEMA if schema is None else schema\\n    if schema not in PRIMITIVE_PROFILES:\\n        raise OpcodeRejected(\\\"catalog requires an exact primitive schema\\\")\\n    version = list(PRIMITIVE_PROFILES).index(schema) + 1\\n    rows = [asdict(spec) for spec in OPCODES.values() if spec.since <= version]\\n    visible_types = TYPES - ({\\\"chain\\\"} if version < 7 else set())\\n    result = {\\\"schema\\\": \\\"hepta.hia.opcode-catalog.v1\\\", \\\"core_schema\\\": schema,\\n        \\\"profile\\\": PRIMITIVE_PROFILES[schema], \\\"word_bits\\\": 64,\\n        \\\"types\\\": sorted(visible_types),\\n        \\\"type_groups\\\": {k: sorted(v & visible_types) for k, v in _GROUPS.items()},\\n        \\\"signature_rules\\\": {\\\"=N\\\": \\\"same type as zero-based operand N\\\", \\\"declared:T\\\": \\\"explicit result type in group T\\\",\\n                            \\\"null\\\": \\\"arity/types/effects determined by verified callee interface\\\"},\\n        \\\"instructions\\\": rows,\\n        \\\"terminators\\\": [{\\\"name\\\": name, \\\"fields\\\": list(fields)} for name, fields in TERMINATORS.items()],\\n        \\\"function_contract\\\": {\\\"return_loans\\\": \\\"explicit formal-name/null per return; parameter origin checked\\\" if version >= 8 else \\\"loan returns forbidden\\\"},\\n        \\\"conditional_effects\\\": {\\\"int.cast\\\": \\\"checked mode requires trap\\\", \\\"call\\\": \\\"all callee effects\\\"},\\n        \\\"resource_checks\\\": \\\"all guards, transitions, exact CFG joins and return cleanup remain mandatory\\\",\\n        \\\"backend_scope\\\": \\\"VM, direct LLVM and direct x86-64 machine backends have separate supported-target/entry-ABI checks; catalog inclusion grants no native entry ABI\\\",\\n        \\\"admission_authority\\\": \\\"hepta.hia_program.verify_program\\\", \\\"safety_certificate\\\": False,\\n        \\\"generated_checker_scope\\\": \\\"opcode/version, operand/result signatures, attributes, effects, named resource guards\\\",\\n        \\\"not_generated_or_proved\\\": [\\\"CFG ownership algorithm\\\", \\\"interpreter\\\", \\\"LLVM lowering\\\", \\\"machine code\\\"]}\\n    result[\\\"catalog_sha256\\\"] = sha256(json.dumps(result, sort_keys=True, separators=(\\\",\\\", \\\":\\\")).encode()).hexdigest()\\n    return result\\n\\n\\ndef render_opcode_reference() -> str:\\n    rows = [\\\"# HIA primitive instruction reference\\\", \\\"\\\", \\\"Generated by `python tools/generate_hia_catalog.py`; edit `hepta/hia_opcodes.py`.\\\", \\\"\\\",\\n        \\\"This catalog generates local checking and agent discovery. The ownership/CFG checker, VM and native backend remain separate implementations and require independent validation.\\\", \\\"\\\",\\n        \\\"`=N` refers to the type of operand N (zero based); `declared:T` requires an explicit result type in group T. `call` uses its checked callee interface. All attributes are exact required sets.\\\", \\\"\\\",\\n        \\\"| Instruction | Since | Operands | Results | Attributes | Effects | Resource guards |\\\", \\\"| --- | --- | --- | --- | --- | --- | --- |\\\"]\\n    for spec in OPCODES.values():\\n        fmt = lambda values: \\\"callee interface\\\" if values is None else \\\", \\\".join(values) or \\\"\\u2014\\\"\\n        rows.append(f\\\"| `{spec.name}` | v{spec.since} | {fmt(spec.operands)} | {fmt(spec.results)} | {fmt(spec.attributes)} | {fmt(spec.effects)} | {fmt(spec.guards)} |\\\")\\n    rows += [\\\"\\\", \\\"`int.cast` additionally requires `trap` in checked mode. `call` propagates all callee effects. Traps abort; normal/error-as-value returns must balance ownership. VM fuel, call depth, native stack, payload and allocator overhead are separate budgets.\\\", \\\"\\\",\\n        \\\"Core v8 adds explicit `return_loans` contracts; it does not invent new opcodes. Assembly v1 accepts explicit primitive v6/v7/v8 and preserves this field. Historical schemas are accepted only through their named adapters; no profile is guessed.\\\", \\\"\\\",\\n        \\\"Query the complete version-specific JSON with `hia catalog --schema hepta.hia.program.v8`. The catalog includes terminators, conditional effects, resource transitions, trap descriptions and exact scope limitations.\\\", \\\"\\\"]\\n    return \\\"\\\\n\\\".join(rows)\\n\"\n      },\n      \"explicit_changed_definitions\": [],\n      \"patch\": \"--- before/hepta/hia_opcodes.py\\n+++ after/hepta/hia_opcodes.py\\n@@ -290,3 +290,7 @@\\n         \\\"Core v8 adds explicit `return_loans` contracts; it does not invent new opcodes. Assembly v1 accepts explicit primitive v6/v7/v8 and preserves this field. Historical schemas are accepted only through their named adapters; no profile is guessed.\\\", \\\"\\\",\\n         \\\"Query the complete version-specific JSON with `hia catalog --schema hepta.hia.program.v8`. The catalog includes terminators, conditional effects, resource transitions, trap descriptions and exact scope limitations.\\\", \\\"\\\"]\\n     return \\\"\\\\n\\\".join(rows)\\n+\\n+# Definition and intrinsic metadata anchors; no admission is performed here.\\n+_HIA_DISCOVERY_DEFINITIONS = (opcode_catalog, OpcodeSpec, OPCODES, PRIMITIVE_PROFILES, TYPES, _GROUPS, TERMINATORS,\\n+                              opcode_catalog.__code__)\\n\",\n      \"unchanged_definitions\": [\n        \"OpcodeRejected\",\n        \"ExecutionObservationRejected\",\n        \"validate_execution_observation\",\n        \"_reference_validate_execution_observation\",\n        \"OpcodeSpec\",\n        \"_table\",\n        \"opcode_spec\",\n        \"scalar_value_valid\",\n        \"_matches\",\n        \"check_instruction\",\n        \"opcode_catalog\",\n        \"render_opcode_reference\"\n      ]\n    }\n  },\n  \"original_ids\": [\n    \"tests.test_hia_cli_native.CliNativeTests.test_actual_installed_wheel_without_retained_cli_or_checkout_resources\",\n    \"tests.test_hia_cli_native.CliNativeTests.test_all_fifteen_real_actions_and_publication_branches\",\n    \"tests.test_hia_cli_native.CliNativeTests.test_argparse_order_abbreviation_clusters_repetition_and_sentinel\",\n    \"tests.test_hia_cli_native.CliNativeTests.test_error_json_is_native_and_keeps_active_exception_context\",\n    \"tests.test_hia_cli_native.CliNativeTests.test_error_str_baseexception_preserves_object_context_and_closes\",\n    \"tests.test_hia_cli_native.CliNativeTests.test_existing_read_ceilings_and_unicode_error_publication\",\n    \"tests.test_hia_cli_native.CliNativeTests.test_external_baseexception_after_native_return_closes_permission\",\n    \"tests.test_hia_cli_native.CliNativeTests.test_help_wrapping_columns_and_exact_unicode_repr\",\n    \"tests.test_hia_cli_native.CliNativeTests.test_hia_continuation_routes_selfhost_without_entering_direct_emitter\",\n    \"tests.test_hia_cli_native.CliNativeTests.test_hyphenated_build_help_matches_reference_at_every_ordinary_width\",\n    \"tests.test_hia_cli_native.CliNativeTests.test_native_ack_refusal_and_no_replay_after_consumed_effect\",\n    \"tests.test_hia_cli_native.CliNativeTests.test_output_precedes_result_truth_and_query_read_errors\",\n    \"tests.test_hia_cli_native.CliNativeTests.test_parser_stream_write_failures_and_missing_stdout_match\",\n    \"tests.test_hia_cli_native.CliNativeTests.test_python_color_environment_precedence_and_colored_wrapping\",\n    \"tests.test_hia_cli_native.CliNativeTests.test_selfhost_options_errors_and_complete_argv_preserve_current_entry\",\n    \"tests.test_hia_cli_native.CliNativeTests.test_source_bundle_binding_and_selected_fail_closed\",\n    \"tests.test_hia_cli_native.CliNativeTests.test_unchanged_original_agent_entry_suite_with_native_selected\",\n    \"tests.test_hia_cli_native.CliSourceTests.test_complete_regeneration_and_unchanged_native_profile\",\n    \"tests.test_hia_cli_native.CliSourceTests.test_independent_core_vm_argument_and_error_formatter\",\n    \"tests.test_hia_cli_native.CliSourceTests.test_matching_cold_build_rejects_before_output_creation\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_all_profiles_keep_complete_native_vm_frames_and_local_retirement_order\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_apply_edit_stack_argument_and_named_local_destruction_order\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_as_dict_temporary_releases_after_output_before_program\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_assembly_named_raw_program_text_are_retained_in_original_order\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_closed_instance_nonces_never_reuse_and_old_claim_cannot_move\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_cross_session_claim_and_repeated_claim_are_native_refusals\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_foreign_result_ack_loss_keeps_owner_and_forbids_replay\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_independent_vm_matches_complete_claim_and_selfhost_continuation_bytes\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_native_temporary_read_releases_before_program_report\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_nonce_exhaustion_refuses_before_control_entry_without_wrap\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_normal_terminal_releases_owned_locals_without_gc_or_retained_pool\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_pending_query_releases_during_read_unwind_before_handler_context\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_preclaim_ack_loss_never_launches_a_foreign_effect\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_published_warm_loader_keeps_actual_immutable_mappings\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_query_argument_release_can_modify_returned_query_before_output\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_report_unpack_temporary_releases_before_output_mutation\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_same_session_reentry_fences_but_independent_nested_call_is_allowed\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_selfhost_and_native_dispatch_preserve_input_output_pin_objects\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_selfhost_parser_pair_errors_precede_all_file_or_build_effects\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationNativeTests.test_warm_disk_image_drift_or_missing_is_rejected_before_entry\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationSourceTests.test_default_keeps_arbitrary_argv_object_reference_route\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationSourceTests.test_hia_owns_new_backend_and_one_use_claim_protocol\",\n    \"tests.test_hia_cli_continuation_native.CliContinuationSourceTests.test_v74_original_reference_body_is_byte_exact\"\n  ],\n  \"original_tests\": {\n    \"tests/test_hia_cli_continuation_native.py\": {\n      \"bytes\": 37203,\n      \"sha256\": \"40886aeb41388b6ac61e0eff653c2060aeeddc19c5bca0845d11c1b92e5b7bea\",\n      \"text\": \"\\\"\\\"\\\"CLI v75 continuation differentials; original callers and limits stay separate.\\n\\nSource tests require no image. Native tests use the same explicit cold/development\\nfixture as the retained CLI-native module; no compiler or parser fallback exists.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nfrom contextlib import ExitStack, redirect_stderr, redirect_stdout\\nimport ctypes\\nimport gc\\nfrom hashlib import sha256\\nimport inspect\\nimport io\\nimport json\\nimport os\\nfrom pathlib import Path\\nimport shutil\\nimport struct\\nimport sys\\nimport unittest\\nimport weakref\\nfrom unittest.mock import patch\\n\\nfrom hepta import cli\\nfrom hepta import hia_cli_native as bridge\\nfrom tests import test_hia_cli_native as native_fixture\\nfrom tests.test_hia_cli_native import (\\n    environment, entry_outcome, ROOT, SELECTOR,\\n)\\n\\n\\nclass CliContinuationSourceTests(unittest.TestCase):\\n    def test_v74_original_reference_body_is_byte_exact(self):\\n        self.assertEqual(sha256(inspect.getsource(cli._reference_hia_main).encode()).hexdigest(),\\n                         \\\"2502a29f616377c969fbad19c2340e479167ab1b10dc5e0c6f6082eb5755f1a0\\\")\\n\\n    def test_hia_owns_new_backend_and_one_use_claim_protocol(self):\\n        from tools import generate_hia_cli_control as grammar\\n        from tools import hia_cli_control_phases as phases\\n        self.assertEqual(grammar.FIELDS[17:], (\\\"selfhost_manifest\\\", \\\"selfhost_manifest_sha256\\\"))\\n        self.assertEqual(phases.COMMANDS[42], \\\"build_selfhost\\\")\\n        self.assertEqual(phases.COMMANDS[43], \\\"release_handler_temporaries\\\")\\n        self.assertIn(\\\"return control_claim(s, o, w)\\\", grammar.SOURCE)\\n        self.assertIn(\\\"put(w, C_CLAIMED, 1)\\\", phases.SOURCE)\\n        self.assertIn(\\\"get(w, C_CLAIMED) != 1\\\", phases.SOURCE)\\n        self.assertIn(\\\"control_consumes(w, operation, c)\\\", phases.SOURCE)\\n        self.assertIn(\\\"if get(w, C_SELFHOST) != 0:\\\", phases.SOURCE)\\n        self.assertNotIn(\\\"args.backend\\\", inspect.getsource(bridge.CliSession._effect))\\n        self.assertNotIn(\\\"argparse\\\", inspect.getsource(bridge.CliSession._effect))\\n\\n    def test_default_keeps_arbitrary_argv_object_reference_route(self):\\n        marker = object()\\n        observed = []\\n        with (patch.dict(os.environ, environment(), clear=True),\\n              patch.object(cli, \\\"_reference_hia_main\\\",\\n                           new=lambda value: observed.append(value) or 71)):\\n            self.assertEqual(cli.hia_main(marker), 71)\\n        self.assertEqual(len(observed), 1)\\n        self.assertIs(observed[0], marker)\\n\\n\\nclass CliContinuationNativeTests(unittest.TestCase):\\n    @classmethod\\n    def setUpClass(cls):\\n        native_fixture.CliNativeTests.setUpClass.__func__(cls)\\n\\n    @classmethod\\n    def tearDownClass(cls):\\n        native_fixture.CliNativeTests.tearDownClass.__func__(cls)\\n\\n    def prepare(self, argv):\\n        with patch.dict(os.environ, environment(), clear=True):\\n            return self.owner.prepare(argv, cli)\\n\\n    def compare(self, argv, install):\\n        rows = []\\n        for selected in (False, True):\\n            events = []\\n            with ExitStack() as stack:\\n                stack.enter_context(patch.dict(os.environ, environment(), clear=True))\\n                install(stack, events)\\n                if selected:\\n                    actual = entry_outcome(argv, self.manifest)\\n                else:\\n                    actual = entry_outcome(argv)\\n            rows.append((actual, events))\\n        self.observations.append({\\\"test\\\": self.id(), \\\"argv\\\": argv,\\n                                  \\\"reference\\\": rows[0], \\\"native\\\": rows[1]})\\n        self.assertEqual(rows[1], rows[0])\\n        return rows\\n\\n    def test_selfhost_parser_pair_errors_precede_all_file_or_build_effects(self):\\n        from hepta import hia_program_tools\\n        cases = [\\n            [\\\"build\\\", \\\"unused\\\", \\\"-o\\\", \\\"out\\\", \\\"--backend\\\", \\\"selfhost\\\"],\\n            [\\\"build\\\", \\\"unused\\\", \\\"-o\\\", \\\"out\\\", \\\"--backend\\\", \\\"selfhost\\\",\\n             \\\"--selfhost-manifest\\\", \\\"manifest\\\"],\\n            [\\\"build\\\", \\\"unused\\\", \\\"-o\\\", \\\"out\\\", \\\"--backend\\\", \\\"selfhost\\\",\\n             \\\"--selfhost-manifest-sha256\\\", \\\"pin\\\"],\\n            [\\\"build\\\", \\\"unused\\\", \\\"-o\\\", \\\"out\\\", \\\"--backend\\\", \\\"selfhost\\\",\\n             \\\"--selfhost-manifest=\\\", \\\"--selfhost-manifest-sha256=pin\\\"],\\n            [\\\"build\\\", \\\"unused\\\", \\\"-o\\\", \\\"out\\\", \\\"--backend\\\", \\\"selfhost\\\",\\n             \\\"--selfhost-manifest=manifest\\\", \\\"--selfhost-manifest-sha256=\\\"],\\n            [\\\"build\\\", \\\"unused\\\", \\\"-o\\\", \\\"out\\\", \\\"--selfhost-manifest=\\\"],\\n            [\\\"build\\\", \\\"unused\\\", \\\"-o\\\", \\\"out\\\", \\\"--selfhost-manifest-sha256=pin\\\"],\\n            [\\\"build\\\", \\\"--backend\\\", \\\"selfhost\\\"],\\n            [\\\"build\\\", \\\"unused\\\", \\\"-o\\\", \\\"out\\\", \\\"--backend\\\", \\\"bad\\\", \\\"--help\\\"],\\n            [\\\"build\\\", \\\"unused\\\", \\\"-o\\\", \\\"out\\\", \\\"--help\\\", \\\"--backend\\\", \\\"bad\\\"],\\n            [\\\"build\\\", \\\"unused\\\", \\\"-o\\\", \\\"out\\\", \\\"--selfhost-man\\\", \\\"ambiguous\\\"],\\n            [\\\"build\\\", \\\"unused\\\", \\\"-o\\\", \\\"out\\\", \\\"--backend\\\", \\\"selfhost\\\", \\\"--extra\\\"],\\n        ]\\n        def forbidden(*args, **kwargs):\\n            raise AssertionError(\\\"parse refusal launched a file or build effect\\\")\\n        for argv in cases:\\n            with self.subTest(argv=argv):\\n                rows = self.compare(argv, lambda stack, events:\\n                                    stack.enter_context(patch.object(hia_program_tools,\\n                                                                     \\\"read_bounded\\\", new=forbidden)))\\n                self.assertEqual(rows[0][0][0][0], \\\"exit\\\")\\n\\n    def test_selfhost_and_native_dispatch_preserve_input_output_pin_objects(self):\\n        from hepta import hia_program, hia_program_tools, hia_program_selfhost, hia_program_native\\n        input_path = \\\"\\\".join([\\\"input\\\", \\\"-\\\", \\\"original-object\\\"] * 3)\\n        output_path = \\\"\\\".join([\\\"output\\\", \\\"-\\\", \\\"original-object\\\"] * 3)\\n        manifest = \\\"\\\".join([\\\"manifest\\\", \\\"-\\\", \\\"original-object\\\"] * 3)\\n        pin = \\\"\\\".join([\\\"a\\\" * 32, \\\"b\\\" * 32])\\n        checked = object()\\n        for backend in (\\\"native\\\", \\\"selfhost\\\"):\\n            argv = [\\\"build\\\", input_path, \\\"-o\\\", output_path, \\\"--backend\\\", backend]\\n            if backend == \\\"selfhost\\\":\\n                argv += [\\\"--selfhost-manifest\\\", manifest, \\\"--selfhost-manifest-sha256\\\", pin]\\n            def install(stack, events):\\n                def read(path, *, limit=8 << 20):\\n                    events.append([\\\"read\\\", path is input_path, limit])\\n                    return b\\\"raw\\\"\\n                def verify(raw):\\n                    events.append([\\\"verify\\\", raw == b\\\"raw\\\"])\\n                    return checked\\n                def native(program, output, *, kind, linker):\\n                    events.append([\\\"native\\\", program is checked, output is output_path, kind, linker])\\n                    return {\\\"ok\\\": True, \\\"backend\\\": \\\"native\\\"}\\n                def selfhost(program, output, *, manifest, manifest_sha256, kind, target):\\n                    events.append([\\\"selfhost\\\", program is checked, output is output_path,\\n                                   manifest is argv[-3], manifest_sha256 is pin, kind, target])\\n                    return {\\\"ok\\\": True, \\\"backend\\\": \\\"selfhost\\\"}\\n                stack.enter_context(patch.object(hia_program_tools, \\\"read_bounded\\\", new=read))\\n                stack.enter_context(patch.object(hia_program, \\\"verify_program\\\", new=verify))\\n                stack.enter_context(patch.object(hia_program_native, \\\"build_program_machine\\\", new=native))\\n                stack.enter_context(patch.object(hia_program_selfhost, \\\"build_program_selfhost\\\", new=selfhost))\\n            rows = self.compare(argv, install)\\n            self.assertEqual(rows[0][0][0], (\\\"return\\\", 0))\\n            self.assertEqual(rows[0][1][0], [\\\"read\\\", True, 8 << 20])\\n            self.assertEqual(rows[0][1][-1][0], backend)\\n            self.assertTrue(all(value is True for value in rows[0][1][-1][1:3]))\\n\\n    def test_native_temporary_read_releases_before_program_report(self):\\n        from hepta import hia_program, hia_program_tools\\n        def install(stack, events):\\n            class Raw:\\n                def __del__(self):\\n                    events.append(\\\"raw-drop\\\")\\n            class Program:\\n                def report(self):\\n                    events.append(\\\"report\\\")\\n                    return {\\\"ok\\\": True}\\n                def __del__(self):\\n                    events.append(\\\"program-drop\\\")\\n            def read(*args, **kwargs):\\n                events.append(\\\"read\\\")\\n                return Raw()\\n            def verify(raw):\\n                events.append(\\\"verify\\\")\\n                return Program()\\n            def output(value):\\n                events.append(\\\"output\\\")\\n            stack.enter_context(patch.object(hia_program_tools, \\\"read_bounded\\\", new=read))\\n            stack.enter_context(patch.object(hia_program, \\\"verify_program\\\", new=verify))\\n            stack.enter_context(patch.object(cli, \\\"output_json\\\", new=output))\\n        rows = self.compare([\\\"verify\\\", \\\"unused\\\"], install)\\n        events = rows[0][1]\\n        self.assertLess(events.index(\\\"raw-drop\\\"), events.index(\\\"report\\\"))\\n        self.assertLess(events.index(\\\"output\\\"), events.index(\\\"program-drop\\\"))\\n\\n    def test_report_unpack_temporary_releases_before_output_mutation(self):\\n        from hepta import hia_program, hia_program_tools\\n        def install(stack, events):\\n            state = {\\\"released\\\": False}\\n            class Mapping(dict):\\n                def __del__(self):\\n                    state[\\\"released\\\"] = True\\n                    events.append(\\\"mapping-drop\\\")\\n            class Program:\\n                def report(self):\\n                    return Mapping(ok=True)\\n            def output(value):\\n                events.append([\\\"output\\\", state[\\\"released\\\"],\\n                               value[\\\"status\\\"], value[\\\"native_executed\\\"]])\\n            stack.enter_context(patch.object(hia_program_tools, \\\"read_bounded\\\", new=lambda *a, **k: b\\\"x\\\"))\\n            stack.enter_context(patch.object(hia_program, \\\"verify_program\\\", new=lambda value: Program()))\\n            stack.enter_context(patch.object(cli, \\\"output_json\\\", new=output))\\n        rows = self.compare([\\\"verify\\\", \\\"unused\\\"], install)\\n        self.assertEqual(rows[0][1][-1], [\\\"output\\\", True, \\\"standalone_core_checked\\\", False])\\n\\n    def test_as_dict_temporary_releases_after_output_before_program(self):\\n        from hepta import hia_program, hia_program_tools\\n        def install(stack, events):\\n            class Mapping(dict):\\n                def __del__(self):\\n                    events.append(\\\"mapping-drop\\\")\\n            class Program:\\n                def as_dict(self):\\n                    return Mapping(ok=True)\\n                def __del__(self):\\n                    events.append(\\\"program-drop\\\")\\n            stack.enter_context(patch.object(hia_program_tools, \\\"read_bounded\\\", new=lambda *a, **k: b\\\"x\\\"))\\n            stack.enter_context(patch.object(hia_program, \\\"verify_program\\\", new=lambda value: Program()))\\n            stack.enter_context(patch.object(cli, \\\"output_json\\\", new=lambda value: events.append(\\\"output\\\")))\\n        rows = self.compare([\\\"normalize\\\", \\\"unused\\\"], install)\\n        self.assertEqual(rows[0][1], [\\\"output\\\", \\\"mapping-drop\\\", \\\"program-drop\\\"])\\n\\n    def test_query_argument_release_can_modify_returned_query_before_output(self):\\n        from hepta import hia_program, hia_program_tools, hia_edit_batch\\n        def install(stack, events):\\n            returned = {}\\n            class Raw:\\n                def __del__(self):\\n                    events.append(\\\"raw-query-drop\\\")\\n            class Decoded:\\n                def __del__(self):\\n                    events.append(\\\"decoded-query-drop\\\")\\n                    returned[\\\"finalized\\\"] = True\\n            def read(path, **kwargs):\\n                return b\\\"program\\\" if path == \\\"program\\\" else Raw()\\n            def decode(raw):\\n                events.append(\\\"decode\\\")\\n                return Decoded()\\n            def prepare(program, decoded):\\n                events.append(\\\"prepare\\\")\\n                return returned\\n            def output(value):\\n                events.append([\\\"output\\\", value.get(\\\"finalized\\\") is True])\\n            stack.enter_context(patch.object(hia_program_tools, \\\"read_bounded\\\", new=read))\\n            stack.enter_context(patch.object(hia_program_tools, \\\"decode_json\\\", new=decode))\\n            stack.enter_context(patch.object(hia_program, \\\"verify_program\\\", new=lambda value: object()))\\n            stack.enter_context(patch.object(hia_edit_batch, \\\"prepare_batch\\\", new=prepare))\\n            stack.enter_context(patch.object(cli, \\\"output_json\\\", new=output))\\n        rows = self.compare([\\\"edit-batch-query\\\", \\\"program\\\", \\\"--selections\\\", \\\"query\\\"], install)\\n        self.assertEqual(rows[0][1][-1], [\\\"output\\\", True])\\n        self.assertLess(rows[0][1].index(\\\"raw-query-drop\\\"), rows[0][1].index(\\\"prepare\\\"))\\n\\n    def test_apply_edit_stack_argument_and_named_local_destruction_order(self):\\n        from hepta import hia_program, hia_program_tools, hia_edit_query\\n        def install(stack, events):\\n            class Raw:\\n                def __init__(self, tag): self.tag = tag\\n                def __del__(self): events.append(\\\"drop-\\\" + self.tag)\\n            class Query:\\n                def __del__(self): events.append(\\\"drop-decoded\\\")\\n            class Program:\\n                def __init__(self, tag): self.tag = tag\\n                def as_dict(self): return {\\\"ok\\\": True}\\n                def __del__(self): events.append(\\\"drop-\\\" + self.tag)\\n            class Receipt(dict):\\n                def __del__(self): events.append(\\\"drop-receipt\\\")\\n            def read(path, **kwargs):\\n                events.append(\\\"read-\\\" + path)\\n                return Raw(path)\\n            def verify(raw):\\n                events.append(\\\"verify\\\")\\n                return Program(\\\"program\\\")\\n            def decode(raw):\\n                events.append(\\\"decode\\\")\\n                return Query()\\n            def apply(program, query, response):\\n                events.append(\\\"apply\\\")\\n                return Program(\\\"revised\\\"), Receipt(ok=True)\\n            stack.enter_context(patch.object(hia_program_tools, \\\"read_bounded\\\", new=read))\\n            stack.enter_context(patch.object(hia_program_tools, \\\"decode_json\\\", new=decode))\\n            stack.enter_context(patch.object(hia_program, \\\"verify_program\\\", new=verify))\\n            stack.enter_context(patch.object(hia_edit_query, \\\"apply_edit\\\", new=apply))\\n            stack.enter_context(patch.object(cli, \\\"output_json\\\", new=lambda value: events.append(\\\"output\\\")))\\n        rows = self.compare([\\\"edit-apply\\\", \\\"program-input\\\", \\\"--query\\\", \\\"query-input\\\",\\n                             \\\"--response\\\", \\\"response-input\\\"], install)\\n        events = rows[0][1]\\n        self.assertLess(events.index(\\\"drop-query-input\\\"), events.index(\\\"read-response-input\\\"))\\n        self.assertLess(events.index(\\\"apply\\\"), events.index(\\\"drop-decoded\\\"))\\n\\n    def test_assembly_named_raw_program_text_are_retained_in_original_order(self):\\n        from hepta import hia_program, hia_program_tools, hia_agent_assembly\\n        def install(stack, events):\\n            class Raw:\\n                def __del__(self): events.append(\\\"raw-drop\\\")\\n            class Program:\\n                def __del__(self): events.append(\\\"program-drop\\\")\\n            class Text(str):\\n                def __del__(self): events.append(\\\"text-drop\\\")\\n            def render(program):\\n                events.append(\\\"render\\\")\\n                return Text(\\\"assembly\\\\n\\\")\\n            stack.enter_context(patch.object(hia_program_tools, \\\"read_bounded\\\", new=lambda *a, **k: Raw()))\\n            stack.enter_context(patch.object(hia_program, \\\"verify_program\\\", new=lambda value: Program()))\\n            stack.enter_context(patch.object(hia_agent_assembly, \\\"render_assembly\\\", new=render))\\n        rows = self.compare([\\\"render-assembly\\\", \\\"unused\\\"], install)\\n        expected = {\\n            312: [\\\"render\\\", \\\"raw-drop\\\", \\\"program-drop\\\", \\\"text-drop\\\"],\\n            314: [\\\"render\\\", \\\"text-drop\\\", \\\"program-drop\\\", \\\"raw-drop\\\"],\\n            31410: [\\\"render\\\", \\\"text-drop\\\", \\\"program-drop\\\", \\\"raw-drop\\\"],\\n        }[bridge._runtime_profile()]\\n        self.assertEqual(rows[0][1], expected)\\n\\n\\n    def test_pending_query_releases_during_read_unwind_before_handler_context(self):\\n        from hepta import hia_program, hia_program_tools\\n        def install(stack, events):\\n            class Query:\\n                def __del__(self):\\n                    active = sys.exception()\\n                    events.append([\\\"query-drop\\\", None if active is None else type(active).__name__])\\n            class ReadError(OSError):\\n                def __str__(self):\\n                    events.append([\\\"error-str\\\", sys.exception() is self])\\n                    return \\\"second read failed\\\"\\n            def read(path, **kwargs):\\n                if path == \\\"response\\\":\\n                    raise ReadError()\\n                return b\\\"program\\\" if path == \\\"program\\\" else b\\\"query\\\"\\n            stack.enter_context(patch.object(hia_program_tools, \\\"read_bounded\\\", new=read))\\n            stack.enter_context(patch.object(hia_program_tools, \\\"decode_json\\\", new=lambda raw: Query()))\\n            stack.enter_context(patch.object(hia_program, \\\"verify_program\\\", new=lambda raw: object()))\\n        rows = self.compare([\\\"edit-apply\\\", \\\"program\\\", \\\"--query\\\", \\\"query\\\", \\\"--response\\\", \\\"response\\\"], install)\\n        self.assertEqual(rows[0][0][0], (\\\"return\\\", 2))\\n        self.assertEqual(rows[0][1], [[\\\"query-drop\\\", None], [\\\"error-str\\\", True]])\\n\\n    def test_independent_vm_matches_complete_claim_and_selfhost_continuation_bytes(self):\\n        from hepta.hia_agent_assembly import assemble_program\\n        from hepta.hia_program_runtime import _Machine, _Owner, _View\\n        program = assemble_program(bridge.SOURCES[\\\"control\\\"].read_bytes())\\n        nonce = 913479\\n        cases = [\\n            ([\\\"capabilities\\\"], [(1, (2, 0, 0)), (22, (0, 0, 0))], []),\\n            ([\\\"build\\\", \\\"in\\\", \\\"-o\\\", \\\"out\\\", \\\"--backend\\\", \\\"selfhost\\\",\\n              \\\"--selfhost-manifest\\\", \\\"manifest\\\", \\\"--selfhost-manifest-sha256\\\", \\\"pin\\\"],\\n             [(35, (0, 0, 0)), (3, (2, 0, 0)), (4, (3, 0, 0)),\\n              (42, (4, 0, 0)), (22, (0, 0, 0)), (31, (1, 0, 0))], [4, 3]),\\n        ]\\n        for argv, replies, release in cases:\\n            raw = bytearray(bridge._frame(argv, \\\"hia \\\" + cli.__version__, environment(),\\n                bridge._runtime_profile(), 80, False, False, sys.get_int_max_str_digits()))\\n            struct.pack_into(\\\"<Q\\\", raw, 80, nonce)\\n            capacity = 65536 + len(argv) * 80 + len(raw)\\n            actual_workspace = ctypes.create_string_buffer(capacity)\\n            actual_output = ctypes.create_string_buffer(128)\\n            expected_workspace = bytearray(capacity)\\n            expected_output = bytearray(128)\\n            observations = []\\n            def invoke(packet):\\n                nonlocal expected_workspace, expected_output\\n                source = ctypes.create_string_buffer(bytes(packet), len(packet))\\n                actual = self.owner.control._entry(source, len(packet), actual_output,\\n                                                   128, actual_workspace, capacity)\\n                owners = [_Owner(-1, bytearray(packet)), _Owner(-2, expected_output),\\n                          _Owner(-3, expected_workspace)]\\n                machine = _Machine(program, 25000000, 64 << 20, None, 128)\\n                expected = machine.invoke(program.as_dict()[\\\"functions\\\"][0],\\n                    [_View(owners[0], False), _View(owners[1], True), _View(owners[2], True)])[0]\\n                self.assertEqual(actual, expected)\\n                self.assertEqual(ctypes.string_at(actual_output, 128), bytes(owners[1].data))\\n                self.assertEqual(ctypes.string_at(actual_workspace, capacity), bytes(owners[2].data))\\n                self.assertEqual(ctypes.string_at(source, len(packet)), bytes(packet))\\n                expected_output, expected_workspace = owners[1].data, owners[2].data\\n                observations.append({\\\"status\\\": int(actual),\\n                    \\\"output_sha256\\\": sha256(bytes(expected_output)).hexdigest(),\\n                    \\\"workspace_sha256\\\": sha256(bytes(expected_workspace)).hexdigest()})\\n                return actual\\n            self.assertEqual(invoke(raw), 0)\\n            self.assertEqual(invoke(struct.pack(\\\"<12Q\\\", bridge.STEP_MAGIC, 4, 0, 0, 0,\\n                                                1, 0, 0, 0, 0, 0, nonce)), 1)\\n            for index, (operation, values) in enumerate(replies, 1):\\n                self.assertEqual(struct.unpack_from(\\\"<Q\\\", actual_output, 8)[0], operation)\\n                claim = struct.pack(\\\"<12Q\\\", bridge.CLAIM_MAGIC, 4, index, operation,\\n                                    nonce, 0, 0, 0, 0, 0, 0, 0)\\n                self.assertEqual(invoke(claim), 3)\\n                reply = struct.pack(\\\"<12Q\\\", bridge.STEP_MAGIC, 4, index, operation,\\n                                    0, *values, 0, 0, 0, nonce)\\n                self.assertEqual(invoke(reply), 2 if index == len(replies) else 1)\\n            count = struct.unpack_from(\\\"<Q\\\", actual_output, 64)[0]\\n            # This ABI vector must follow the same admitted runtime as the\\n            # real reference differential, rather than hard-code 3.12 order.\\n            expected_release = (release if struct.unpack_from(\\\"<Q\\\", raw, 24)[0] == 312\\n                                else list(reversed(release)))\\n            self.assertEqual(list(struct.unpack_from(\\\"<\\\" + \\\"Q\\\" * count,\\n                                                    actual_workspace, 2816)), expected_release)\\n            self.observations.append({\\\"test\\\": self.id(), \\\"argv\\\": argv,\\n                                      \\\"independent_vm_full_buffers\\\": observations})\\n\\n\\n    def test_all_profiles_keep_complete_native_vm_frames_and_local_retirement_order(self):\\n        from hepta.hia_agent_assembly import assemble_program\\n        from hepta.hia_program_runtime import _Machine, _Owner, _View\\n        program = assemble_program(bridge.SOURCES[\\\"control\\\"].read_bytes())\\n        canary = b\\\"\\\\xa5\\\" * 32\\n        cases = [\\n            ([\\\"capabilities\\\"], [(1, (2, 0, 0)), (22, (0, 0, 0))], []),\\n            ([\\\"render-assembly\\\", \\\"input\\\"],\\n             [(35, (0, 0, 0)), (36, (0, 0, 0)), (3, (2, 0, 0)),\\n              (4, (3, 0, 0)), (7, (4, 0, 0)), (23, (0, 0, 0))], [2, 3, 4]),\\n            ([\\\"build\\\", \\\"in\\\", \\\"-o\\\", \\\"out\\\", \\\"--backend\\\", \\\"selfhost\\\",\\n              \\\"--selfhost-manifest\\\", \\\"manifest\\\", \\\"--selfhost-manifest-sha256\\\", \\\"pin\\\"],\\n             [(35, (0, 0, 0)), (3, (2, 0, 0)), (4, (3, 0, 0)),\\n              (42, (4, 0, 0)), (22, (0, 0, 0)), (31, (1, 0, 0))], [4, 3]),\\n        ]\\n        for profile in (312, 314, 31410):\\n            for case, (argv, replies, forward_release) in enumerate(cases):\\n                with self.subTest(profile=profile, action=argv[0]):\\n                    nonce = 913479 + 10 * profile + case\\n                    raw = bytearray(bridge._frame(argv, \\\"hia \\\" + cli.__version__,\\n                        environment(), profile, 80, False, False,\\n                        sys.get_int_max_str_digits()))\\n                    struct.pack_into(\\\"<Q\\\", raw, 80, nonce)\\n                    capacity = 65536 + len(argv) * 80 + len(raw)\\n                    actual_workspace = ctypes.create_string_buffer(capacity + 32)\\n                    actual_output = ctypes.create_string_buffer(160)\\n                    ctypes.memmove(ctypes.addressof(actual_workspace) + capacity, canary, 32)\\n                    ctypes.memmove(ctypes.addressof(actual_output) + 128, canary, 32)\\n                    expected_workspace = bytearray(capacity)\\n                    expected_output = bytearray(128)\\n                    observations = []\\n                    def invoke(packet):\\n                        nonlocal expected_workspace, expected_output\\n                        packet = bytes(packet)\\n                        source = ctypes.create_string_buffer(packet + canary, len(packet) + 32)\\n                        actual = self.owner.control._entry(source, len(packet), actual_output,\\n                                                           128, actual_workspace, capacity)\\n                        owners = [_Owner(-1, bytearray(packet)), _Owner(-2, expected_output),\\n                                  _Owner(-3, expected_workspace)]\\n                        machine = _Machine(program, 25000000, 64 << 20, None, 128)\\n                        expected = machine.invoke(program.as_dict()[\\\"functions\\\"][0],\\n                            [_View(owners[0], False), _View(owners[1], True),\\n                             _View(owners[2], True)])[0]\\n                        self.assertEqual(actual, expected)\\n                        self.assertEqual(ctypes.string_at(actual_output, 160),\\n                                         bytes(owners[1].data) + canary)\\n                        self.assertEqual(ctypes.string_at(actual_workspace, capacity + 32),\\n                                         bytes(owners[2].data) + canary)\\n                        self.assertEqual(ctypes.string_at(source, len(packet) + 32),\\n                                         packet + canary)\\n                        expected_output, expected_workspace = owners[1].data, owners[2].data\\n                        observations.append({\\\"status\\\": int(actual),\\n                            \\\"output_sha256\\\": sha256(bytes(expected_output)).hexdigest(),\\n                            \\\"workspace_sha256\\\": sha256(bytes(expected_workspace)).hexdigest(),\\n                            \\\"all_source_output_workspace_canaries_unchanged\\\": True})\\n                        return actual\\n                    self.assertEqual(invoke(raw), 0)\\n                    self.assertEqual(invoke(struct.pack(\\\"<12Q\\\", bridge.STEP_MAGIC, 4,\\n                        0, 0, 0, 1, 0, 0, 0, 0, 0, nonce)), 1)\\n                    for index, (operation, values) in enumerate(replies, 1):\\n                        self.assertEqual(struct.unpack_from(\\\"<Q\\\", actual_output, 8)[0], operation)\\n                        self.assertEqual(invoke(struct.pack(\\\"<12Q\\\", bridge.CLAIM_MAGIC, 4,\\n                            index, operation, nonce, 0, 0, 0, 0, 0, 0, 0)), 3)\\n                        reply = struct.pack(\\\"<12Q\\\", bridge.STEP_MAGIC, 4, index,\\n                                            operation, 0, *values, 0, 0, 0, nonce)\\n                        self.assertEqual(invoke(reply), 2 if index == len(replies) else 1)\\n                    count = struct.unpack_from(\\\"<Q\\\", actual_output, 64)[0]\\n                    release = list(struct.unpack_from(\\\"<\\\" + \\\"Q\\\" * count,\\n                                                       actual_workspace, 2816))\\n                    expected_release = (forward_release if profile == 312\\n                                        else list(reversed(forward_release)))\\n                    self.assertEqual(release, expected_release)\\n                    self.observations.append({\\\"test\\\": self.id(), \\\"profile\\\": profile,\\n                        \\\"argv\\\": argv, \\\"native_release\\\": release,\\n                        \\\"expected_release\\\": expected_release,\\n                        \\\"independent_vm_full_buffers\\\": observations})\\n\\n    def test_preclaim_ack_loss_never_launches_a_foreign_effect(self):\\n        class Stop(BaseException): pass\\n        for before in (True, False):\\n            with self.subTest(before=before):\\n                session = self.prepare([\\\"capabilities\\\"])\\n                self.assertEqual(session.step(), 1)\\n                original = self.owner.control._entry\\n                returned = []\\n                def interrupted(*args):\\n                    self.assertEqual(struct.unpack(\\\"<Q\\\", ctypes.string_at(args[0], 8))[0],\\n                                     bridge.CLAIM_MAGIC)\\n                    if not before:\\n                        returned.append(original(*args))\\n                    raise Stop(\\\"claim ACK lost\\\")\\n                effects = []\\n                with (patch.object(self.owner.control, \\\"_entry\\\", new=interrupted),\\n                      patch.object(cli, \\\"agent_capabilities\\\", new=lambda: effects.append(1) or {})):\\n                    with self.assertRaises(Stop):\\n                        session.observe()\\n                self.assertEqual(returned, [] if before else [3])\\n                self.assertEqual(effects, [])\\n                self.assertEqual(struct.unpack_from(\\\"<Q\\\", session.workspace, 2256)[0],\\n                                 0 if before else 1)\\n                with self.assertRaises(RuntimeError): session.observe()\\n                with self.assertRaises(RuntimeError): session.step()\\n                self.assertIs(bridge._ACTIVE_SESSIONS[session.nonce], session)\\n\\n    def test_foreign_result_ack_loss_keeps_owner_and_forbids_replay(self):\\n        class Stop(BaseException): pass\\n        class Value: pass\\n        session = self.prepare([\\\"capabilities\\\"])\\n        self.assertEqual(session.step(), 1)\\n        references, effects = [], []\\n        def effect():\\n            value = Value()\\n            references.append(weakref.ref(value))\\n            effects.append(\\\"effect\\\")\\n            return value\\n        def lose(*args):\\n            raise Stop(\\\"foreign result ACK lost\\\")\\n        with (patch.object(cli, \\\"agent_capabilities\\\", new=effect),\\n              patch.object(session, \\\"_packet\\\", new=lose)):\\n            with self.assertRaises(Stop): session.observe()\\n        gc.collect()\\n        self.assertIsNotNone(references[0]())\\n        self.assertEqual(effects, [\\\"effect\\\"])\\n        self.assertEqual(struct.unpack_from(\\\"<Q\\\", session.workspace, 2256)[0], 1)\\n        self.assertIs(bridge._ACTIVE_SESSIONS[session.nonce], session)\\n        with self.assertRaises(RuntimeError): session.observe()\\n        with self.assertRaises(RuntimeError): session.step()\\n        self.assertEqual(effects, [\\\"effect\\\"])\\n\\n\\n    def test_closed_instance_nonces_never_reuse_and_old_claim_cannot_move(self):\\n        closed = []\\n        with (patch.dict(os.environ, environment(), clear=True),\\n              patch.object(cli, \\\"output_json\\\", new=lambda value: None)):\\n            for _ in range(32):\\n                session = self.owner.prepare([\\\"capabilities\\\"], cli)\\n                closed.append(session.nonce)\\n                self.assertEqual(session.run(), 0)\\n                self.assertNotIn(session.nonce, bridge._ACTIVE_SESSIONS)\\n                del session\\n            target = self.owner.prepare([\\\"capabilities\\\"], cli)\\n        self.assertEqual(closed, sorted(set(closed)))\\n        self.assertGreater(target.nonce, closed[-1])\\n        self.assertEqual(target.step(), 1)\\n        old = struct.pack(\\\"<12Q\\\", bridge.CLAIM_MAGIC, 4, 1, 1,\\n                          closed[0], 0, 0, 0, 0, 0, 0, 0)\\n        source = ctypes.create_string_buffer(old, len(old))\\n        self.assertEqual(self.owner.control._entry(source, len(old), target.output, 128,\\n                                                   target.workspace, len(target.workspace)), 199)\\n        with patch.object(cli, \\\"agent_capabilities\\\", new=lambda: self.fail(\\\"late claim executed\\\")):\\n            with self.assertRaises(RuntimeError): target.observe()\\n        self.observations.append({\\\"test\\\": self.id(), \\\"closed_nonces\\\": closed,\\n                                  \\\"new_nonce\\\": target.nonce, \\\"old_claim_status\\\": 199})\\n\\n    def test_nonce_exhaustion_refuses_before_control_entry_without_wrap(self):\\n        original = self.owner.control._entry\\n        entered = []\\n        def record(*args):\\n            entered.append(struct.unpack(\\\"<Q\\\", ctypes.string_at(args[0], 8))[0])\\n            return original(*args)\\n        with (patch.dict(os.environ, environment(), clear=True),\\n              patch.object(bridge, \\\"_SESSION_NONCES\\\", iter([(1 << 64) - 1, 1 << 64])),\\n              patch.object(self.owner.control, \\\"_entry\\\", new=record)):\\n            last = self.owner.prepare([\\\"capabilities\\\"], cli)\\n            self.assertEqual(last.nonce, (1 << 64) - 1)\\n            self.assertEqual(last.kind, 0)\\n            self.assertEqual(len(entered), 1)\\n            with self.assertRaisesRegex(RuntimeError, \\\"nonce namespace exhausted\\\"):\\n                self.owner.prepare([\\\"capabilities\\\"], cli)\\n            self.assertEqual(len(entered), 1)\\n\\n    def test_cross_session_claim_and_repeated_claim_are_native_refusals(self):\\n        one, two = self.prepare([\\\"capabilities\\\"]), self.prepare([\\\"capabilities\\\"])\\n        self.assertEqual(one.step(), 1)\\n        self.assertEqual(two.step(), 1)\\n        op, seq = one.command[:2]\\n        wrong = struct.pack(\\\"<12Q\\\", bridge.CLAIM_MAGIC, 4, seq, op,\\n                            two.nonce, 0, 0, 0, 0, 0, 0, 0)\\n        source = ctypes.create_string_buffer(wrong, len(wrong))\\n        self.assertEqual(self.owner.control._entry(source, len(wrong), one.output, len(one.output),\\n                                                   one.workspace, len(one.workspace)), 199)\\n        with self.assertRaises(RuntimeError): one.observe()\\n        two._claim_effect()\\n        with self.assertRaises(RuntimeError): two._claim_effect()\\n        self.assertEqual(struct.unpack_from(\\\"<Q\\\", two.workspace, 2080)[0], 1)\\n\\n    def test_same_session_reentry_fences_but_independent_nested_call_is_allowed(self):\\n        session = self.prepare([\\\"capabilities\\\"])\\n        calls, output = [], []\\n        def reenter():\\n            calls.append(\\\"outer\\\")\\n            with self.assertRaises(RuntimeError): session.run()\\n            return {}\\n        with (patch.object(cli, \\\"agent_capabilities\\\", new=reenter),\\n              patch.object(cli, \\\"output_json\\\", new=lambda value: output.append(value))):\\n            with self.assertRaises(RuntimeError): session.run()\\n        self.assertEqual(calls, [\\\"outer\\\"])\\n        self.assertEqual(output, [])\\n\\n        level = [0]\\n        def nested():\\n            level[0] += 1\\n            if level[0] == 1:\\n                self.assertEqual(self.owner.run([\\\"capabilities\\\"], cli), 0)\\n            return {\\\"level\\\": level[0]}\\n        with (patch.dict(os.environ, environment(), clear=True),\\n              patch.object(cli, \\\"agent_capabilities\\\", new=nested),\\n              patch.object(cli, \\\"output_json\\\", new=lambda value: None)):\\n            self.assertEqual(self.owner.run([\\\"capabilities\\\"], cli), 0)\\n        self.assertEqual(level, [2])\\n\\n    def test_normal_terminal_releases_owned_locals_without_gc_or_retained_pool(self):\\n        from hepta import hia_program, hia_program_tools\\n        references = []\\n        class Program:\\n            def report(self): return {\\\"ok\\\": True}\\n        def verify(raw):\\n            value = Program()\\n            references.append(weakref.ref(value))\\n            return value\\n        session = self.prepare([\\\"verify\\\", \\\"unused\\\"])\\n        with (patch.object(hia_program_tools, \\\"read_bounded\\\", new=lambda *a, **k: b\\\"x\\\"),\\n              patch.object(hia_program, \\\"verify_program\\\", new=verify),\\n              patch.object(cli, \\\"output_json\\\", new=lambda value: None)):\\n            self.assertEqual(session.run(), 0)\\n        self.assertIsNone(references[0]())\\n        self.assertNotIn(session.nonce, bridge._ACTIVE_SESSIONS)\\n        self.assertTrue(all(value is bridge._RELEASED for value in session.handles))\\n\\n    def test_warm_disk_image_drift_or_missing_is_rejected_before_entry(self):\\n        case = self.folder / \\\"warm-image-custody\\\"\\n        shutil.copytree(self.manifest.parent, case)\\n        manifest = case / self.manifest.name\\n        metadata = json.loads(manifest.read_bytes())\\n        bridge.installed_cli_strict(manifest)\\n        for name in (\\\"control\\\", \\\"format\\\"):\\n            child = case / metadata[name + \\\"_manifest\\\"]\\n            image = child.parent / json.loads(child.read_bytes())[\\\"image_path\\\"]\\n            raw = image.read_bytes()\\n            for missing in (False, True):\\n                with self.subTest(name=name, missing=missing):\\n                    if missing: image.unlink()\\n                    else: image.write_bytes(raw + b\\\"\\\\0\\\")\\n                    try:\\n                        with self.assertRaises((ValueError, FileNotFoundError)):\\n                            bridge.installed_cli_strict(manifest)\\n                    finally:\\n                        image.write_bytes(raw)\\n            self.assertIsInstance(bridge.installed_cli_strict(manifest), bridge.NativeCli)\\n\\n    def test_published_warm_loader_keeps_actual_immutable_mappings(self):\\n        case = self.folder / \\\"published-warm-image-custody\\\"\\n        shutil.copytree(self.manifest.parent, case)\\n        manifest = case / self.manifest.name\\n        metadata = json.loads(manifest.read_bytes())\\n        admitted = bridge.installed_cli(manifest)\\n        for name, expected in ((\\\"control\\\", admitted.control), (\\\"format\\\", admitted.formatter)):\\n            child = case / metadata[name + \\\"_manifest\\\"]\\n            image = child.parent / json.loads(child.read_bytes())[\\\"image_path\\\"]\\n            raw = image.read_bytes()\\n            for mutation in (\\\"changed\\\", \\\"missing\\\"):\\n                with self.subTest(component=name, mutation=mutation):\\n                    try:\\n                        if mutation == \\\"changed\\\":\\n                            image.write_bytes(b\\\"changed disk bytes after original mapping\\\")\\n                        else:\\n                            image.unlink()\\n                        warm = bridge.installed_cli(manifest)\\n                        actual = warm.control if name == \\\"control\\\" else warm.formatter\\n                        self.assertIs(actual, expected)\\n                        self.assertEqual(actual._mapping[:], raw)\\n                    finally:\\n                        image.write_bytes(raw)\\n\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    unittest.main()\\n\"\n    },\n    \"tests/test_hia_cli_native.py\": {\n      \"bytes\": 54092,\n      \"sha256\": \"7fa75b027a5e67ecb1ff39cd9e73b4e7a7e178a32de30e6590fd6db488efc5d1\",\n      \"text\": \"\\\"\\\"\\\"Exact ordinary CLI comparisons, native phase lifecycle and original callers.\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport ast\\nfrom contextlib import ExitStack, redirect_stderr, redirect_stdout\\nimport ctypes\\nfrom hashlib import sha256\\nimport io\\nimport json\\nimport os\\nfrom pathlib import Path\\nimport shutil\\nimport stat\\nimport struct\\nimport subprocess\\nimport sys\\nimport tempfile\\nfrom types import SimpleNamespace\\nimport unittest\\nimport zipfile\\nfrom unittest.mock import patch\\n\\nfrom hepta import cli\\nfrom hepta.hia_cli_native import (\\n    NativeCli, CliSession, SOURCES, SELECTOR, STEP_MAGIC, CONTROL_SCHEMA,\\n    installed_cli, _print_parser_message,\\n)\\n\\nROOT = Path(__file__).resolve().parents[1]\\nCOLD = \\\"HEPTA_HIA_CLI_COLD_REPORT\\\"\\nDEVELOPMENT = \\\"HEPTA_HIA_CLI_DEVELOPMENT_MANIFEST\\\"\\nFIXTURE_EVIDENCE = \\\"HEPTA_HIA_CLI_FIXTURE_EVIDENCE\\\"\\nENVIRONMENT = {\\\"COLUMNS\\\": \\\"80\\\", \\\"LINES\\\": \\\"24\\\", \\\"TERM\\\": \\\"dumb\\\",\\n               \\\"PYTHON_COLORS\\\": \\\"0\\\", \\\"NO_COLOR\\\": \\\"\\\", \\\"FORCE_COLOR\\\": \\\"\\\"}\\n\\n\\ndef environment(values=None):\\n    result = {key: value for key, value in os.environ.items() if not key.startswith(\\\"HEPTA_HIA_\\\")}\\n    result.update(ENVIRONMENT)\\n    result.update(values or {})\\n    return result\\n\\n\\nclass Parsed(BaseException):\\n    def __init__(self, namespace):\\n        self.namespace = namespace\\n\\n\\ndef parser_outcome(owner, argv, *, selected):\\n    output, errors = io.StringIO(), io.StringIO()\\n    real_parse = argparse.ArgumentParser.parse_args\\n    def stop(parser, *args, **kwargs):\\n        raise Parsed(real_parse(parser, *args, **kwargs))\\n    with redirect_stdout(output), redirect_stderr(errors):\\n        try:\\n            if selected:\\n                with patch.object(argparse, \\\"ArgumentParser\\\", side_effect=AssertionError(\\\"retained parser entered\\\")):\\n                    session = owner.prepare(argv, cli)\\n                    if session.kind == 0:\\n                        answer = (\\\"namespace\\\", vars(session.namespace))\\n                    else:\\n                        first, second = owner.format_result(session)\\n                        if session.kind == 3:\\n                            _print_parser_message(first, sys.stderr)\\n                            _print_parser_message(second, sys.stderr)\\n                        else:\\n                            _print_parser_message(first + second, sys.stdout)\\n                        answer = (\\\"exit\\\", session.exit_code)\\n            else:\\n                with patch.object(argparse.ArgumentParser, \\\"parse_args\\\", stop):\\n                    cli._reference_hia_main(argv)\\n                raise AssertionError(\\\"reference parser did not produce a namespace\\\")\\n        except Parsed as result:\\n            answer = (\\\"namespace\\\", vars(result.namespace))\\n        except SystemExit as error:\\n            answer = (\\\"exit\\\", error.code)\\n        except BaseException as error:\\n            answer = (\\\"error\\\", type(error).__name__, str(error))\\n    return answer, output.getvalue(), errors.getvalue()\\n\\n\\ndef entry_outcome(argv, manifest=None):\\n    output, errors = io.StringIO(), io.StringIO()\\n    with ExitStack() as stack:\\n        stack.enter_context(redirect_stdout(output))\\n        stack.enter_context(redirect_stderr(errors))\\n        if manifest is not None:\\n            stack.enter_context(patch.dict(os.environ, {SELECTOR: str(manifest)}))\\n            stack.enter_context(patch.object(cli, \\\"_reference_hia_main\\\",\\n                                            side_effect=AssertionError(\\\"retained CLI entered\\\")))\\n            stack.enter_context(patch.object(argparse, \\\"ArgumentParser\\\",\\n                                            side_effect=AssertionError(\\\"retained parser entered\\\")))\\n        try:\\n            answer = (\\\"return\\\", cli.hia_main(argv))\\n        except SystemExit as error:\\n            answer = (\\\"exit\\\", error.code)\\n        except BaseException as error:\\n            answer = (\\\"error\\\", type(error).__name__, str(error))\\n    return answer, output.getvalue(), errors.getvalue()\\n\\n\\nclass CliSourceTests(unittest.TestCase):\\n    def test_complete_regeneration_and_unchanged_native_profile(self):\\n        from hepta.hia_agent_assembly import render_assembly\\n        from tools import generate_hia_cli_control, generate_hia_cli_format\\n        for name, generator in ((\\\"control\\\", generate_hia_cli_control), (\\\"format\\\", generate_hia_cli_format)):\\n            with self.subTest(kernel=name):\\n                document = generator.document()\\n                assembly = render_assembly(document)\\n                self.assertEqual(SOURCES[name].read_text(), assembly)\\n                self.assertLessEqual(len(document[\\\"functions\\\"]), 128)\\n                self.assertLessEqual(sum(len(fn[\\\"blocks\\\"]) for fn in document[\\\"functions\\\"]), 1536)\\n                self.assertLessEqual(sum(len(block[\\\"ops\\\"]) for fn in document[\\\"functions\\\"]\\n                                         for block in fn[\\\"blocks\\\"]), 8192)\\n                for fn in document[\\\"functions\\\"]:\\n                    definitions = {value[\\\"name\\\"] for value in fn[\\\"params\\\"]}\\n                    for block in fn[\\\"blocks\\\"]:\\n                        definitions.update(value[\\\"name\\\"] for value in block[\\\"params\\\"])\\n                        definitions.update(value[\\\"name\\\"] for op in block[\\\"ops\\\"] for value in op[\\\"out\\\"])\\n                    self.assertLessEqual(len(fn[\\\"blocks\\\"]), 256)\\n                    self.assertLessEqual(len(definitions), 2048)\\n                self.assertLessEqual(len(assembly.encode()), 1 << 20)\\n\\n    def test_matching_cold_build_rejects_before_output_creation(self):\\n        from tools.build_hia_cli_native import build\\n        with tempfile.TemporaryDirectory(prefix=\\\"hia-cli-bad-cold-\\\") as folder:\\n            root = Path(folder)\\n            (root / \\\"compiler\\\").write_bytes(b\\\"unqualified\\\")\\n            (root / \\\"cold\\\").write_bytes(b\\\"{}\\\")\\n            with self.assertRaises(ValueError):\\n                build(root / \\\"output\\\", root / \\\"compiler\\\", root / \\\"cold\\\")\\n            self.assertFalse((root / \\\"output\\\").exists())\\n\\n    def test_independent_core_vm_argument_and_error_formatter(self):\\n        script = r'''\\nimport ctypes,io,json,os,resource\\nfrom contextlib import redirect_stdout,redirect_stderr\\nfrom unittest.mock import patch\\nresource.setrlimit(resource.RLIMIT_AS,(384<<20,384<<20))\\nfrom hepta import cli\\nfrom hepta.hia_agent_assembly import assemble_program\\nfrom hepta.hia_program_runtime import _Machine,_Owner,_View\\nfrom hepta.hia_cli_native import NativeCli,SOURCES,_print_parser_message\\nclass VM:\\n def __init__(self,path):self.program=assemble_program(path.read_bytes());self.calls=0\\n def _entry(self,s,ns,o,no,w,nw):\\n  owners=[_Owner(-1,bytearray(ctypes.string_at(s,ns))),_Owner(-2,bytearray(ctypes.string_at(o,no))),_Owner(-3,bytearray(ctypes.string_at(w,nw)))]\\n  machine=_Machine(self.program,25000000,64<<20,None,128)\\n  result=machine.invoke(self.program.as_dict()['functions'][0],[_View(owners[0],False),_View(owners[1],True),_View(owners[2],True)])[0]\\n  ctypes.memmove(o,bytes(owners[1].data),no);ctypes.memmove(w,bytes(owners[2].data),nw)\\n  self.calls+=1\\n  return result\\ncontrol,formatter=VM(SOURCES['control']),VM(SOURCES['format'])\\nowner=NativeCli(control,formatter)\\noutput=io.StringIO();errors=io.StringIO()\\nwith patch.dict(os.environ,{'COLUMNS':'80','LINES':'24','PYTHON_COLORS':'0','TERM':'dumb'},clear=True),redirect_stdout(output),redirect_stderr(errors):\\n session=owner.prepare(['build','source.hia'],cli)\\n assert session.kind==3 and session.exit_code==2\\n first,second=owner.format_result(session)\\n _print_parser_message(first,errors);_print_parser_message(second,errors)\\n assert 'the following arguments are required: --output/-o' in errors.getvalue()\\n assert owner.driver_error('snow \\u96ea \\\"quoted\\\"\\\\n')==json.dumps({'ok':False,'status':'error','diagnostics':[{'code':'E_DRIVER','message':'snow \\u96ea \\\"quoted\\\"\\\\n','phase':'driver'}]},ensure_ascii=False,indent=2,sort_keys=True)\\nprint(json.dumps({'control_calls':control.calls,'formatter_calls':formatter.calls,'native_image_loaded':False}))\\n'''\\n        process = subprocess.run([sys.executable, \\\"-B\\\", \\\"-c\\\", script], cwd=ROOT,\\n                                 capture_output=True, timeout=60)\\n        self.assertEqual(process.returncode, 0, process.stdout + process.stderr)\\n        report = json.loads(process.stdout)\\n        self.assertEqual(report[\\\"control_calls\\\"], 1)\\n        self.assertEqual(report[\\\"formatter_calls\\\"], 3)\\n        self.assertIs(report[\\\"native_image_loaded\\\"], False)\\n\\n\\nclass CliNativeTests(unittest.TestCase):\\n    @classmethod\\n    def setUpClass(cls):\\n        cold, development = os.environ.get(COLD), os.environ.get(DEVELOPMENT)\\n        if cold and development:\\n            raise AssertionError(\\\"development cannot override current cold selection\\\")\\n        if not cold and not development:\\n            raise unittest.SkipTest(\\\"requires explicit CLI cold report or development bundle\\\")\\n        cls.temporary = None\\n        evidence = os.environ.get(FIXTURE_EVIDENCE)\\n        if evidence:\\n            base = Path(evidence).absolute()\\n            base.mkdir(mode=0o700, parents=True, exist_ok=True)\\n            cls.folder = base / cls.__name__\\n            cls.folder.mkdir(mode=0o700)\\n        else:\\n            cls.temporary = tempfile.TemporaryDirectory(prefix=\\\"hia-cli-native-tests-\\\")\\n            cls.folder = Path(cls.temporary.name)\\n            cls.addClassCleanup(cls.temporary.cleanup)\\n        if cold:\\n            from tools.build_hia_cli_native import build\\n            outer = json.loads(Path(cold).read_bytes())\\n            nested = json.loads(Path(outer[\\\"nested_report\\\"]).read_bytes())\\n            cls.compiler = Path(nested[\\\"generations\\\"][-1][\\\"produced_image\\\"])\\n            cls.manifest = build(cls.folder / \\\"qualified\\\", cls.compiler, Path(cold))\\n            cls.scope = \\\"MATCHING_SOURCE_COLD_BUILD\\\"\\n        else:\\n            cls.manifest = Path(development).resolve(strict=True)\\n            request = json.loads((cls.manifest.parent / \\\"control/cli-control.request.json\\\").read_bytes())\\n            cls.compiler = Path(request[\\\"image\\\"])\\n            expected = json.loads((cls.manifest.parent / \\\"control/manifest.json\\\").read_bytes())[\\\"compiler_sha256\\\"]\\n            if sha256(cls.compiler.read_bytes()).hexdigest() != expected:\\n                raise AssertionError(\\\"development compiler receipt changed\\\")\\n            cls.scope = \\\"EXPLICIT_DEVELOPMENT_ONLY\\\"\\n        cls.owner = installed_cli(str(cls.manifest))\\n        cls.observations = []\\n\\n    @classmethod\\n    def tearDownClass(cls):\\n        (cls.folder / \\\"observations.json\\\").write_text(json.dumps({\\n            \\\"schema\\\": \\\"hia.cli.native-test-observations.v1\\\", \\\"scope\\\": cls.scope,\\n            \\\"manifest\\\": str(cls.manifest), \\\"observations\\\": cls.observations,\\n            \\\"whole_native_delivery_qualified\\\": False,\\n        }, indent=2, sort_keys=True) + \\\"\\\\n\\\")\\n        if cls.temporary is not None:\\n            cls.temporary.cleanup()\\n\\n    def assert_parse_same(self, argv, variables=None):\\n        with patch.dict(os.environ, environment(variables), clear=True):\\n            expected = parser_outcome(self.owner, argv, selected=False)\\n            actual = parser_outcome(self.owner, argv, selected=True)\\n        self.observations.append({\\\"test\\\": self.id(), \\\"argv\\\": argv, \\\"environment\\\": variables,\\n                                  \\\"expected\\\": expected, \\\"actual\\\": actual})\\n        self.assertEqual(actual, expected, (argv, variables))\\n        return actual\\n\\n    def test_selfhost_options_errors_and_complete_argv_preserve_current_entry(self):\\n        missing = str(self.folder / 'not-a-source.core.hepta')\\n        prefix = ['build', missing, '-o', str(self.folder / 'not-published.o')]\\n        tails = [\\n            ['--backend', 'selfhost'],\\n            ['--backend', 'selfhost', '--selfhost-manifest', 'compiler.json'],\\n            ['--backend', 'selfhost', '--selfhost-manifest-sha256', 'a' * 64],\\n            ['--backend', 'selfhost', '--selfhost-manifest', '', '--selfhost-manifest-sha256', 'a' * 64],\\n            ['--selfhost-manifest', 'compiler.json'],\\n            ['--selfhost-manifest', ''],\\n            ['--backend', 'native', '--selfhost-manifest-sha256', 'a' * 64],\\n            ['--selfhost', 'ambiguous'],\\n            ['--backend', 'selfhost', '--selfhost-manifest', 'compiler.json',\\n             '--selfhost-manifest-sha256', 'a' * 64],\\n            ['--backend=selfhost', '--selfhost-manifest=compiler.json',\\n             '--selfhost-manifest-sha256=' + 'b' * 64],\\n        ]\\n        for tail in tails:\\n            argv = prefix + tail\\n            with self.subTest(argv=argv), patch.dict(os.environ, environment(), clear=True):\\n                expected = entry_outcome(argv)\\n                actual = entry_outcome(argv, self.manifest)\\n                self.assertEqual(actual, expected)\\n                self.observations.append({'test': self.id(), 'argv': argv,\\n                                          'expected': expected, 'actual': actual})\\n        self.assertFalse((self.folder / 'not-published.o').exists())\\n\\n    def test_hyphenated_build_help_matches_reference_at_every_ordinary_width(self):\\n        for columns in range(1, 161):\\n            with self.subTest(columns=columns):\\n                self.assert_parse_same(['build', '--help'], {'COLUMNS': str(columns)})\\n\\n    def test_hia_continuation_routes_selfhost_without_entering_direct_emitter(self):\\n        from tests.test_hia_agent_entry import fixture\\n        import hepta.hia_program_selfhost as compiler\\n        import hepta.hia_program_native as direct\\n        source = self.folder / 'selected-selfhost.core.hepta'\\n        source.write_text(json.dumps(fixture()))\\n        argv = ['build', str(source), '-o', str(self.folder / 'selfhost.o'),\\n                '--backend', 'selfhost', '--selfhost-manifest', 'compiler.json',\\n                '--selfhost-manifest-sha256', 'c' * 64]\\n        calls = []\\n        def observe(program, output, **options):\\n            calls.append((program.sha256, output, options))\\n            return {'ok': True, 'scope': 'foreign-effect-transport-control'}\\n        with patch.dict(os.environ, environment(), clear=True), \\\\\\n                patch.object(compiler, 'build_program_selfhost', side_effect=observe), \\\\\\n                patch.object(direct, 'build_program_machine', side_effect=AssertionError('direct emitter fallback')):\\n            expected = entry_outcome(argv)\\n            actual = entry_outcome(argv, self.manifest)\\n        self.assertEqual(actual, expected)\\n        self.assertEqual(len(calls), 2)\\n        self.assertEqual(calls[0], calls[1])\\n        self.assertEqual(calls[1][2], {'manifest': 'compiler.json',\\n                                     'manifest_sha256': 'c' * 64,\\n                                     'kind': 'object', 'target': 'x86_64-unknown-linux-gnu'})\\n        self.observations.append({'test': self.id(), 'calls': calls,\\n                                  'native_build_semantics_qualified_by_this_control': False})\\n\\n    def test_argparse_order_abbreviation_clusters_repetition_and_sentinel(self):\\n        cases = [\\n            [], [\\\"--version\\\"], [\\\"--vers\\\"], [\\\"--version=x\\\"], [\\\"--help=x\\\"], [\\\"-hv\\\"], [\\\"-hh\\\"],\\n            [\\\"--\\\"], [\\\"--\\\", \\\"verify\\\", \\\"x\\\"], [\\\"-\\\"], [\\\"\\\"], [\\\"bogus\\\"],\\n            [\\\"verify\\\", \\\"x\\\"], [\\\"verify\\\", \\\"--\\\", \\\"-leading\\\"], [\\\"verify\\\", \\\"--\\\", \\\"--\\\"],\\n            [\\\"verify\\\", \\\"x\\\", \\\"extra\\\"], [\\\"verify\\\", \\\"x\\\", \\\"--\\\", \\\"extra\\\"],\\n            [\\\"verify\\\", \\\"-1\\\"], [\\\"verify\\\", \\\"-1.5\\\"], [\\\"verify\\\", \\\"-.5\\\"],\\n            [\\\"verify\\\", \\\"-\\u0661\\\"], [\\\"verify\\\", \\\"-1\\\\n\\\"], [\\\"verify\\\", \\\"-1.\\\"], [\\\"verify\\\", \\\"-1e2\\\"],\\n            [\\\"verify\\\", \\\"-1x\\\"], [\\\"verify\\\", \\\"-.1x\\\"], [\\\"verify\\\", \\\"-.1.\\\"],\\n            [\\\"verify\\\", \\\"-.1\\\\n\\\\n\\\"], [\\\"verify\\\", \\\"-1\\\\n\\\\n\\\"], [\\\"verify\\\", \\\"-1\\\\x00\\\"],\\n            [\\\"verify\\\", \\\"-\\u0661e2\\\"], [\\\"verify\\\", \\\"-.\\u0661x\\\"], [\\\"verify\\\", \\\"-\\\\U00010d40x\\\"],\\n            [\\\"verify\\\", \\\"-\\\"], [\\\"verify\\\", \\\"-.\\\"], [\\\"verify\\\", \\\"-.x\\\"], [\\\"verify\\\", \\\"-\\u00b2x\\\"],\\n            [\\\"verify\\\", \\\"-..1\\\"], [\\\"verify\\\", \\\"--1\\\"], [\\\"verify\\\", \\\"-1\\\\ud800\\\"],\\n            [\\\"build\\\", \\\"x\\\", \\\"-o\\\", \\\"-1.\\\"], [\\\"build\\\", \\\"x\\\", \\\"-o\\\", \\\"-1e2\\\"],\\n            [\\\"build\\\", \\\"x\\\", \\\"-o\\\", \\\"-.\\u0661tail\\\"], [\\\"build\\\", \\\"x\\\", \\\"-o\\\", \\\"-.x\\\"],\\n            [\\\"--output\\\", \\\"bad\\\", \\\"capabilities\\\"], [\\\"capabilities\\\", \\\"--version\\\"],\\n            [\\\"catalog\\\", \\\"--schema\\\"], [\\\"catalog\\\", \\\"--schema\\\", \\\"bad\\\"],\\n            [\\\"catalog\\\", \\\"--sch=hepta.hia.program.v2\\\"],\\n            [\\\"catalog\\\", \\\"--schema\\\", \\\"hepta.hia.program.v1\\\", \\\"--schema\\\", \\\"hepta.hia.program.v8\\\"],\\n            [\\\"build\\\", \\\"x\\\"], [\\\"build\\\", \\\"--help\\\", \\\"--backend\\\", \\\"bad\\\"],\\n            [\\\"build\\\", \\\"--backend\\\", \\\"bad\\\", \\\"--help\\\"], [\\\"build\\\", \\\"x\\\", \\\"-o\\\"],\\n            [\\\"build\\\", \\\"x\\\", \\\"-oone\\\", \\\"--output=two\\\"], [\\\"build\\\", \\\"x\\\", \\\"-o=-leading\\\"],\\n            [\\\"build\\\", \\\"x\\\", \\\"-o\\\", \\\"--\\\"], [\\\"build\\\", \\\"x\\\", \\\"-o\\\", \\\"-1\\\"],\\n            [\\\"build\\\", \\\"x\\\", \\\"--back\\\", \\\"native\\\", \\\"--k\\\", \\\"object\\\", \\\"--t\\\", \\\"x86_64-unknown-linux-gnu\\\", \\\"-o\\\", \\\"o\\\"],\\n            [\\\"edit-query\\\", \\\"x\\\", \\\"--f\\\", \\\"a\\\"], [\\\"edit-query\\\", \\\"--help\\\", \\\"--f\\\", \\\"a\\\"],\\n            [\\\"edit-query\\\", \\\"x\\\", \\\"--function\\\", \\\"f\\\", \\\"--block\\\", \\\"b\\\", \\\"--value\\\", \\\"v\\\", \\\"--fields\\\", \\\"\\\"],\\n            [\\\"edit-query\\\", \\\"x\\\", \\\"--function=f\\\", \\\"--block=b\\\", \\\"--value=v\\\", \\\"--fields=a,,b,\\\"],\\n            [\\\"edit-apply\\\", \\\"x\\\", \\\"--query=q\\\", \\\"--response=r\\\", \\\"--output=o\\\"],\\n            [\\\"edit-batch-apply\\\", \\\"x\\\", \\\"--q\\\", \\\"q\\\", \\\"--r\\\", \\\"r\\\"],\\n            [\\\"impact\\\", \\\"x\\\", \\\"--request\\\", \\\"-not-a-value\\\"], [\\\"patch\\\", \\\"x\\\", \\\"--request=r\\\", \\\"--output\\\", \\\"\\\"],\\n        ]\\n        cases += [[action, option] for action in cli.HIA_AGENT_ACTIONS for option in (\\\"-h\\\", \\\"--help\\\", \\\"--he\\\")]\\n        for argv in cases:\\n            with self.subTest(argv=argv):\\n                self.assert_parse_same(argv)\\n\\n    def test_help_wrapping_columns_and_exact_unicode_repr(self):\\n        widths = (\\\"1\\\", \\\"2\\\", \\\"3\\\", \\\"18\\\", \\\"20\\\", \\\"39\\\", \\\"40\\\", \\\"80\\\", \\\"120\\\",\\n                  \\\"0\\\", \\\"-1\\\", \\\"bad\\\", \\\"\\uff11\\uff12\\\", \\\"  +8_0  \\\", \\\"1__0\\\", \\\"9\\\" * 5000)\\n        for width in widths:\\n            for argv in ([\\\"--help\\\"], [\\\"build\\\", \\\"--help\\\"], [\\\"edit-query\\\", \\\"--help\\\"],\\n                         [\\\"build\\\"], [\\\"--version\\\"]):\\n                with self.subTest(columns=width[:40], argv=argv):\\n                    self.assert_parse_same(argv, {\\\"COLUMNS\\\": width})\\n        for value in (\\\"snow \\u96ea\\\", \\\"emoji \\ud83d\\ude00\\\", \\\"'\\\", '\\\"', \\\"'\\\\\\\"\\\", \\\"a\\\\nb\\\\tc\\\", \\\"\\\\x00\\\", \\\"\\\\x1f\\\",\\n                      \\\"\\\\x7f\\\", \\\"\\\\u00a0\\\", \\\"\\\\u2028\\\", \\\"\\\\ud800\\\", \\\"\\\\udfff\\\", \\\"\\\\U0001f979\\\"):\\n            for argv in ([value], [\\\"catalog\\\", \\\"--schema\\\", value]):\\n                with self.subTest(argv=argv):\\n                    self.assert_parse_same(argv)\\n\\n    def test_python_color_environment_precedence_and_colored_wrapping(self):\\n        cases = [\\n            (\\\"python-force-before-no-color\\\", {\\\"PYTHON_COLORS\\\": \\\"1\\\", \\\"NO_COLOR\\\": \\\"1\\\", \\\"TERM\\\": \\\"dumb\\\"}, True),\\n            (\\\"python-disable-before-force\\\", {\\\"PYTHON_COLORS\\\": \\\"0\\\", \\\"FORCE_COLOR\\\": \\\"1\\\", \\\"TERM\\\": \\\"xterm\\\"}, False),\\n            (\\\"no-color\\\", {\\\"PYTHON_COLORS\\\": \\\"\\\", \\\"NO_COLOR\\\": \\\"1\\\", \\\"FORCE_COLOR\\\": \\\"1\\\", \\\"TERM\\\": \\\"xterm\\\"}, False),\\n            (\\\"force-color\\\", {\\\"PYTHON_COLORS\\\": \\\"\\\", \\\"NO_COLOR\\\": \\\"\\\", \\\"FORCE_COLOR\\\": \\\"1\\\", \\\"TERM\\\": \\\"dumb\\\"}, True),\\n            (\\\"dumb-terminal\\\", {\\\"PYTHON_COLORS\\\": \\\"other\\\", \\\"NO_COLOR\\\": \\\"\\\", \\\"FORCE_COLOR\\\": \\\"\\\", \\\"TERM\\\": \\\"dumb\\\"}, False),\\n            (\\\"observed-nonterminal\\\", {\\\"PYTHON_COLORS\\\": \\\"other\\\", \\\"NO_COLOR\\\": \\\"\\\", \\\"FORCE_COLOR\\\": \\\"\\\", \\\"TERM\\\": \\\"xterm\\\"}, False),\\n        ]\\n        for name, values, colored in cases:\\n            for argv in ([\\\"--help\\\"], [\\\"build\\\", \\\"--help\\\"], [\\\"--version\\\"], [\\\"catalog\\\", \\\"--schema\\\", \\\"bad\\\"]):\\n                with self.subTest(color_case=name, argv=argv):\\n                    outcome = self.assert_parse_same(argv, {**values, \\\"COLUMNS\\\": \\\"39\\\"})\\n                    if argv == [\\\"--help\\\"]:\\n                        self.assertEqual(\\\"\\\\x1b[\\\" in outcome[1],\\n                                         colored and sys.version_info[:2] == (3, 14))\\n\\n    def test_error_json_is_native_and_keeps_active_exception_context(self):\\n        messages = [\\\"ordinary\\\", \\\"snow \\u96ea \\ud83d\\ude00\\\", '\\\"quoted\\\"\\\\\\\\slash\\\\n\\\\t', \\\"\\\\ud800\\\", \\\"\\\\x00\\\\x1f\\\"]\\n        from hepta import hia_program_tools\\n        for message in messages:\\n            observations = []\\n            class Failure(ValueError):\\n                def __str__(self):\\n                    observations.append(sys.exception() is self)\\n                    return message\\n            expected_error, actual_error = Failure(), Failure()\\n            with patch.dict(os.environ, environment(), clear=True):\\n                with patch.object(hia_program_tools, \\\"read_bounded\\\", side_effect=expected_error):\\n                    expected = entry_outcome([\\\"verify\\\", \\\"unused\\\"])\\n                with (patch.object(hia_program_tools, \\\"read_bounded\\\", side_effect=actual_error),\\n                      patch.object(cli, \\\"output_json\\\", side_effect=AssertionError(\\\"retained E_DRIVER JSON entered\\\"))):\\n                    actual = entry_outcome([\\\"verify\\\", \\\"unused\\\"], self.manifest)\\n            self.assertEqual(actual, expected)\\n            self.assertEqual(observations, [True, True])\\n            self.assertEqual(actual[0], (\\\"return\\\", 2))\\n\\n    def test_parser_stream_write_failures_and_missing_stdout_match(self):\\n        class Stream:\\n            def __init__(self, error=None):\\n                self.events = []\\n                self.error = error\\n            def write(self, text):\\n                self.events.append(text)\\n                if self.error is not None:\\n                    raise self.error\\n                return len(text)\\n        def run(argv, selected, missing, error_type):\\n            stream = Stream(None if error_type is None else error_type(\\\"write stopped\\\"))\\n            errors = Stream()\\n            with ExitStack() as stack:\\n                stack.enter_context(patch.dict(os.environ, environment(), clear=True))\\n                stack.enter_context(patch.object(sys, \\\"stdout\\\", None if missing else stream))\\n                stack.enter_context(patch.object(sys, \\\"stderr\\\", errors))\\n                if selected:\\n                    stack.enter_context(patch.dict(os.environ, {SELECTOR: str(self.manifest)}))\\n                    stack.enter_context(patch.object(argparse, \\\"ArgumentParser\\\", side_effect=AssertionError(\\\"retained parser\\\")))\\n                try:\\n                    result = (\\\"return\\\", cli.hia_main(argv))\\n                except SystemExit as error:\\n                    result = (\\\"exit\\\", error.code)\\n                except BaseException as error:\\n                    result = (\\\"raise\\\", type(error).__name__, str(error))\\n            return result, stream.events, errors.events\\n        for missing, error_type in ((False, None), (True, None), (False, OSError),\\n                                   (False, AttributeError), (False, ValueError),\\n                                   (False, RuntimeError), (False, KeyboardInterrupt)):\\n            for argv in ([\\\"--help\\\"], [\\\"--version\\\"]):\\n                with self.subTest(missing=missing, error_type=error_type, argv=argv):\\n                    self.assertEqual(run(argv, True, missing, error_type), run(argv, False, missing, error_type))\\n\\n    def _prepare_case(self, folder):\\n        from tests.test_hia_agent_entry import fixture\\n        from hepta.hia_program import verify_program\\n        from hepta.hia_agent_assembly import render_assembly\\n        from hepta.hia_edit_query import prepare_edit\\n        from hepta.hia_edit_batch import prepare_batch\\n        from hepta.hia_program_tools import PATCH_SCHEMA\\n        folder.mkdir(mode=0o700)\\n        source = fixture()\\n        raw = json.dumps(source).encode()\\n        (folder / \\\"program.core.hepta\\\").write_bytes(raw)\\n        (folder / \\\"\\u96ea.hia\\\").write_bytes(raw)\\n        (folder / \\\"program.hepta\\\").write_text(render_assembly(source))\\n        program = verify_program(raw)\\n        operation = source[\\\"functions\\\"][0][\\\"blocks\\\"][0][\\\"ops\\\"][1]\\n        operation = {**operation, \\\"op\\\": \\\"int.sub.wrap\\\"}\\n        request = {\\\"schema\\\": PATCH_SCHEMA, \\\"expected_sha256\\\": program.sha256,\\n                   \\\"edits\\\": [{\\\"action\\\": \\\"replace_operation\\\", \\\"function\\\": \\\"calculate\\\",\\n                              \\\"block\\\": \\\"entry\\\", \\\"index\\\": 1, \\\"operation\\\": operation}]}\\n        selections = [{\\\"function\\\": \\\"calculate\\\", \\\"block\\\": \\\"entry\\\", \\\"output\\\": \\\"y\\\", \\\"fields\\\": [\\\"op\\\"]}]\\n        query = prepare_edit(program, **selections[0])\\n        batch = prepare_batch(program, selections)\\n        for name, value in (\\n            (\\\"patch.json\\\", request), (\\\"selections.json\\\", selections), (\\\"query.json\\\", query),\\n            (\\\"batch.json\\\", batch), (\\\"response.json\\\", {\\\"op\\\": \\\"int.sub.wrap\\\"}),\\n            (\\\"batch-response.json\\\", {\\\"edits\\\": [{\\\"site\\\": 0, \\\"changes\\\": {\\\"op\\\": \\\"int.sub.wrap\\\"}}]}),\\n        ):\\n            (folder / name).write_text(json.dumps(value))\\n        return program\\n\\n    @staticmethod\\n    def _files(folder):\\n        result = {}\\n        for path in sorted(folder.rglob(\\\"*\\\")):\\n            if path.is_dir():\\n                result[path.relative_to(folder).as_posix() + \\\"/\\\"] = None\\n            else:\\n                result[path.relative_to(folder).as_posix()] = (stat.S_IMODE(path.stat().st_mode), path.read_bytes())\\n        return result\\n\\n    def test_all_fifteen_real_actions_and_publication_branches(self):\\n        cases = [\\n            [\\\"capabilities\\\"], [\\\"catalog\\\"], [\\\"import-assembly\\\", \\\"program.hepta\\\"],\\n            [\\\"render-assembly\\\", \\\"program.core.hepta\\\"], [\\\"check-assembly\\\", \\\"program.hepta\\\"],\\n            [\\\"verify\\\", \\\"\\u96ea.hia\\\"], [\\\"inspect\\\", \\\"program.core.hepta\\\"], [\\\"normalize\\\", \\\"program.core.hepta\\\"],\\n            [\\\"build\\\", \\\"program.core.hepta\\\", \\\"-o\\\", \\\"target.o\\\"],\\n            [\\\"patch\\\", \\\"program.core.hepta\\\", \\\"--request\\\", \\\"patch.json\\\"],\\n            [\\\"impact\\\", \\\"program.core.hepta\\\", \\\"--request\\\", \\\"patch.json\\\"],\\n            [\\\"edit-query\\\", \\\"program.core.hepta\\\", \\\"--function\\\", \\\"calculate\\\", \\\"--block\\\", \\\"entry\\\", \\\"--value\\\", \\\"y\\\", \\\"--fields\\\", \\\"op\\\"],\\n            [\\\"edit-apply\\\", \\\"program.core.hepta\\\", \\\"--query\\\", \\\"query.json\\\", \\\"--response\\\", \\\"response.json\\\"],\\n            [\\\"edit-batch-query\\\", \\\"program.core.hepta\\\", \\\"--selections\\\", \\\"selections.json\\\"],\\n            [\\\"edit-batch-apply\\\", \\\"program.core.hepta\\\", \\\"--query\\\", \\\"batch.json\\\", \\\"--response\\\", \\\"batch-response.json\\\"],\\n        ]\\n        output_actions = {\\\"import-assembly\\\", \\\"render-assembly\\\", \\\"normalize\\\", \\\"patch\\\",\\n                          \\\"edit-query\\\", \\\"edit-apply\\\", \\\"edit-batch-query\\\", \\\"edit-batch-apply\\\"}\\n        cases += [argv + [\\\"-o\\\", \\\"published\\\"] for argv in cases if argv[0] in output_actions]\\n        method = self.folder / \\\"all-fifteen-actions\\\"\\n        method.mkdir(mode=0o700)\\n        entered = []\\n        real_effect = CliSession._effect\\n        def effect(session, operation, *args):\\n            entered.append(operation)\\n            return real_effect(session, operation, *args)\\n        original_directory = Path.cwd()\\n        rows = []\\n        try:\\n            for index, argv in enumerate(cases):\\n                with self.subTest(action=argv[0], argv=argv):\\n                    pair = []\\n                    for selected in (False, True):\\n                        folder = method / \\\"current\\\"\\n                        self._prepare_case(folder)\\n                        os.chdir(folder)\\n                        with (patch.dict(os.environ, environment({\\\"PATH\\\": \\\"\\\"}), clear=True),\\n                              patch.object(CliSession, \\\"_effect\\\", effect)):\\n                            outcome = entry_outcome(argv, self.manifest if selected else None)\\n                        os.chdir(original_directory)\\n                        files = self._files(folder)\\n                        destination = method / (\\\"%02d-%s\\\" % (index, \\\"native\\\" if selected else \\\"reference\\\"))\\n                        folder.rename(destination)\\n                        pair.append((outcome, files))\\n                    rows.append({\\\"argv\\\": argv, \\\"expected\\\": pair[0][0], \\\"actual\\\": pair[1][0],\\n                                 \\\"file_names\\\": sorted(pair[1][1]), \\\"equal\\\": pair[0] == pair[1]})\\n                    self.assertEqual(pair[1], pair[0])\\n                    self.assertEqual(pair[1][0][0], (\\\"return\\\", 0))\\n            self.assertEqual({argv[0] for argv in cases}, set(cli.HIA_AGENT_ACTIONS))\\n            self.assertTrue((set(range(1, 32)) | set(range(35, 42))) <= set(entered))\\n            self.observations.append({\\\"test\\\": self.id(), \\\"all_actions\\\": list(cli.HIA_AGENT_ACTIONS),\\n                                      \\\"cases\\\": rows, \\\"actual_native_effects\\\": entered})\\n        finally:\\n            os.chdir(original_directory)\\n            (method / \\\"comparisons.json\\\").write_text(json.dumps(rows, indent=2, sort_keys=True) + \\\"\\\\n\\\")\\n\\n    def test_output_precedes_result_truth_and_query_read_errors(self):\\n        from hepta import hia_agent_assembly, hia_program, hia_program_tools, hia_program_native\\n        for action in (\\\"check-assembly\\\", \\\"build\\\"):\\n            def run(selected):\\n                events = []\\n                result = {\\\"accepted\\\": True} if action == \\\"check-assembly\\\" else {\\\"ok\\\": True}\\n                def output(value):\\n                    events.append((\\\"output\\\", dict(value)))\\n                    if action == \\\"check-assembly\\\":\\n                        value[\\\"accepted\\\"] = False\\n                    else:\\n                        value[\\\"ok\\\"] = 1\\n                with (patch.dict(os.environ, environment(), clear=True),\\n                      patch.object(hia_program_tools, \\\"read_bounded\\\", return_value=b\\\"opaque\\\"),\\n                      patch.object(hia_program, \\\"verify_program\\\", return_value=object()),\\n                      patch.object(hia_agent_assembly, \\\"diagnose_assembly\\\", return_value=result),\\n                      patch.object(hia_program_native, \\\"build_program_machine\\\", return_value=result),\\n                      patch.object(cli, \\\"output_json\\\", output)):\\n                    argv = [action, \\\"input\\\"] + ([\\\"-o\\\", \\\"output\\\"] if action == \\\"build\\\" else [])\\n                    outcome = entry_outcome(argv, self.manifest if selected else None)\\n                return outcome, events\\n            expected, actual = run(False), run(True)\\n            self.assertEqual(actual, expected)\\n            self.assertEqual(actual[0][0], (\\\"return\\\", 1))\\n\\n        root = self.folder / \\\"query-order\\\"\\n        self._prepare_case(root)\\n        (root / \\\"broken.json\\\").write_text(\\\"{\\\")\\n        real_read = hia_program_tools.read_bounded\\n        for action in (\\\"edit-apply\\\", \\\"edit-batch-apply\\\"):\\n            def run(selected):\\n                reads = []\\n                def read(path, *, limit=8 << 20):\\n                    reads.append((Path(path).name, limit))\\n                    return real_read(path, limit=limit)\\n                with (patch.dict(os.environ, environment(), clear=True),\\n                      patch.object(hia_program_tools, \\\"read_bounded\\\", read)):\\n                    outcome = entry_outcome([action, str(root / \\\"program.core.hepta\\\"), \\\"--query\\\",\\n                                             str(root / \\\"broken.json\\\"), \\\"--response\\\",\\n                                             str(root / \\\"missing.json\\\")], self.manifest if selected else None)\\n                return outcome, reads\\n            expected, actual = run(False), run(True)\\n            self.assertEqual(actual, expected)\\n            self.assertEqual(actual[0][0], (\\\"return\\\", 2))\\n            self.assertEqual(len(actual[1]), 2 if action == \\\"edit-apply\\\" else 3)\\n            if action == \\\"edit-batch-apply\\\":\\n                self.assertEqual([limit for _, limit in actual[1]], [8 << 20, 1 << 20, 64 << 10])\\n\\n    def test_existing_read_ceilings_and_unicode_error_publication(self):\\n        root = self.folder / \\\"bounded-inputs\\\"\\n        self._prepare_case(root)\\n        (root / \\\"oversized\\\").write_bytes(b\\\" \\\" * ((8 << 20) + 1))\\n        (root / \\\"invalid-utf8\\\").write_bytes(b\\\"\\\\xff\\\")\\n        (root / \\\"input-link\\\").symlink_to(root / \\\"program.core.hepta\\\")\\n        for argv in (\\n            [\\\"verify\\\", str(root / \\\"oversized\\\")],\\n            [\\\"import-assembly\\\", str(root / \\\"invalid-utf8\\\")],\\n            [\\\"verify\\\", str(root / \\\"input-link\\\")],\\n            [\\\"verify\\\", str(root / \\\"missing\\\")],\\n        ):\\n            with self.subTest(argv=argv), patch.dict(os.environ, environment(), clear=True):\\n                expected, actual = entry_outcome(argv), entry_outcome(argv, self.manifest)\\n                self.assertEqual(actual, expected)\\n                self.assertEqual(actual[0], (\\\"return\\\", 2))\\n        for action, query, response, size in (\\n            (\\\"edit-apply\\\", \\\"query.json\\\", \\\"too-big-single\\\", (16 << 10) + 1),\\n            (\\\"edit-batch-apply\\\", \\\"batch.json\\\", \\\"too-big-batch\\\", (64 << 10) + 1),\\n        ):\\n            (root / response).write_bytes(b\\\" \\\" * size)\\n            argv = [action, str(root / \\\"program.core.hepta\\\"), \\\"--query\\\", str(root / query),\\n                    \\\"--response\\\", str(root / response)]\\n            with patch.dict(os.environ, environment(), clear=True):\\n                self.assertEqual(entry_outcome(argv, self.manifest), entry_outcome(argv))\\n\\n    def test_native_ack_refusal_and_no_replay_after_consumed_effect(self):\\n        with patch.dict(os.environ, environment(), clear=True):\\n            session = self.owner.prepare([\\\"capabilities\\\"], cli)\\n        calls = []\\n        with patch.object(cli, \\\"agent_capabilities\\\", side_effect=lambda: calls.append(\\\"called\\\") or {}):\\n            self.assertEqual(session.step(), 1)\\n            session.observe()\\n            with self.assertRaises(RuntimeError):\\n                session.observe()\\n            self.assertEqual(calls, [\\\"called\\\"])\\n            with self.assertRaises(RuntimeError):\\n                session.step()\\n\\n        for defect in (\\\"short\\\", \\\"magic\\\", \\\"sequence\\\", \\\"reserved\\\", \\\"second-argv\\\"):\\n            with self.subTest(defect=defect), patch.dict(os.environ, environment(), clear=True):\\n                session = self.owner.prepare([\\\"capabilities\\\"], cli)\\n                self.assertEqual(session.step(), 1)\\n                operation, sequence = session.command[:2]\\n                good = session._packet(sequence, operation, 0, session.register({}), 0, 0)\\n                bad = bytearray(good)\\n                if defect == \\\"short\\\":\\n                    bad = bad[:16]\\n                elif defect == \\\"magic\\\":\\n                    struct.pack_into(\\\"<Q\\\", bad, 0, 0)\\n                elif defect == \\\"sequence\\\":\\n                    struct.pack_into(\\\"<Q\\\", bad, 16, sequence + 1)\\n                elif defect == \\\"reserved\\\":\\n                    struct.pack_into(\\\"<Q\\\", bad, 72, 1)\\n                else:\\n                    bad = session.raw\\n                def native(raw):\\n                    source = ctypes.create_string_buffer(bytes(raw), len(raw))\\n                    return self.owner.control._entry(source, len(raw), session.output, len(session.output),\\n                                                     session.workspace, len(session.workspace))\\n                self.assertEqual(native(bad), 199)\\n                self.assertEqual(_q(session.workspace, 2080), 1)\\n                self.assertEqual(native(good), 199)\\n\\n    def test_external_baseexception_after_native_return_closes_permission(self):\\n        class ForeignStop(BaseException):\\n            pass\\n        for before in (True, False):\\n            with patch.dict(os.environ, environment(), clear=True):\\n                session = self.owner.prepare([\\\"capabilities\\\"], cli)\\n            original = self.owner.control._entry\\n            stop = ForeignStop(\\\"native boundary stop\\\")\\n            returns = []\\n            def interrupted(*args):\\n                if before:\\n                    raise stop\\n                result = original(*args)\\n                returns.append(result)\\n                raise stop\\n            with patch.object(self.owner.control, \\\"_entry\\\", interrupted):\\n                with self.assertRaises(ForeignStop) as observed:\\n                    session.step()\\n                self.assertIs(observed.exception, stop)\\n            self.assertEqual(returns, [] if before else [1])\\n            self.assertTrue(session.finished)\\n            self.assertFalse(session.pending)\\n            with patch.object(cli, \\\"agent_capabilities\\\", side_effect=AssertionError(\\\"stale effect replayed\\\")):\\n                with self.assertRaises(RuntimeError):\\n                    session.observe()\\n                with self.assertRaises(RuntimeError):\\n                    session.step()\\n\\n    def test_error_str_baseexception_preserves_object_context_and_closes(self):\\n        from hepta import hia_program_tools\\n        class ForeignStop(BaseException):\\n            pass\\n        stop = ForeignStop(\\\"str callback failed\\\")\\n        events = []\\n        class Domain(ValueError):\\n            def __str__(self):\\n                events.append(sys.exception() is self)\\n                raise stop\\n        error = Domain()\\n        with patch.dict(os.environ, environment(), clear=True):\\n            session = self.owner.prepare([\\\"verify\\\", \\\"unused\\\"], cli)\\n        with patch.object(hia_program_tools, \\\"read_bounded\\\", side_effect=error):\\n            with self.assertRaises(ForeignStop) as observed:\\n                session.run()\\n        self.assertIs(observed.exception, stop)\\n        self.assertIs(stop.__context__, error)\\n        self.assertEqual(events, [True])\\n        self.assertTrue(session.finished)\\n        self.assertFalse(session.pending)\\n        with self.assertRaises(RuntimeError):\\n            session.observe()\\n\\n    def test_source_bundle_binding_and_selected_fail_closed(self):\\n        with (patch.dict(os.environ, environment({SELECTOR: str(self.folder / \\\"missing\\\")}), clear=True),\\n              patch.object(cli, \\\"_reference_hia_main\\\", side_effect=AssertionError(\\\"fallback entered\\\"))):\\n            with self.assertRaises(FileNotFoundError):\\n                cli.hia_main([\\\"--help\\\"])\\n        bundle = json.loads(self.manifest.read_bytes())\\n        copy = self.folder / \\\"drift-bundle\\\"\\n        shutil.copytree(self.manifest.parent, copy)\\n        candidate = copy / self.manifest.name\\n        control_manifest = copy / bundle[\\\"control_manifest\\\"]\\n        metadata = json.loads(control_manifest.read_bytes())\\n        metadata[\\\"source_sha256\\\"] = \\\"0\\\" * 64\\n        control_manifest.write_text(json.dumps(metadata))\\n        bundle[\\\"control_manifest_sha256\\\"] = sha256(control_manifest.read_bytes()).hexdigest()\\n        candidate.write_text(json.dumps(bundle))\\n        with self.assertRaisesRegex(ValueError, \\\"source identity\\\"):\\n            installed_cli(str(candidate))\\n        from hepta import hia_cli_native\\n        bad_source = self.folder / \\\"source-drift.hepta\\\"\\n        bad_source.write_bytes(SOURCES[\\\"control\\\"].read_bytes() + b\\\"\\\\n\\\")\\n        with patch.dict(hia_cli_native.SOURCES, {\\\"control\\\": bad_source}):\\n            with self.assertRaisesRegex(ValueError, \\\"source identity\\\"):\\n                installed_cli(str(self.manifest))\\n        self.assertIsInstance(installed_cli(str(self.manifest)), NativeCli)\\n\\n    def test_unchanged_original_agent_entry_suite_with_native_selected(self):\\n        output = self.folder / \\\"original-agent-entry\\\"\\n        output.mkdir(mode=0o700)\\n        script = r'''\\nimport json,os,subprocess,sys,unittest\\nfrom pathlib import Path\\nfrom tests import test_hia_agent_entry as original\\nmanifest,report_path=sys.argv[1:3]\\nactual_run=subprocess.run;injected=[]\\nguard=\\\"import argparse\\\\nfrom hepta import cli\\\\ndef reject(*args,**kwargs):raise AssertionError('retained ordinary CLI/parser entered')\\\\ncli._reference_hia_main=reject\\\\nargparse.ArgumentParser=reject\\\\n\\\"\\ndef run(argv,*args,**kwargs):\\n if type(argv) is list and len(argv)>3 and argv[:3]==[sys.executable,'-B','-c'] and argv[3]==original.CHILD:\\n  argv=list(argv);argv[3]=guard+argv[3]\\n  env=dict(kwargs['env']);env['HEPTA_HIA_CLI_MANIFEST']=manifest;kwargs['env']=env\\n  injected.append(json.loads(argv[4]))\\n return actual_run(argv,*args,**kwargs)\\nsubprocess.run=run\\nsuite=unittest.defaultTestLoader.loadTestsFromModule(original)\\ndef flatten(value):\\n for member in value:\\n  if isinstance(member,unittest.TestSuite):yield from flatten(member)\\n  else:yield member\\nloaded=[case.id() for case in flatten(suite)];executed=[]\\nclass Result(unittest.TextTestResult):\\n def startTest(self,test):executed.append(test.id());super().startTest(test)\\nresult=unittest.TextTestRunner(verbosity=2,resultclass=Result).run(suite)\\nanomalies={'failures':[(t.id(),s) for t,s in result.failures],'errors':[(t.id(),s) for t,s in result.errors],'skipped':[(t.id(),s) for t,s in result.skipped],'expected_failures':[(t.id(),s) for t,s in result.expectedFailures],'unexpected_successes':[t.id() for t in result.unexpectedSuccesses]}\\npassed=bool(loaded) and len(set(loaded))==len(loaded) and loaded==executed and result.testsRun==len(loaded) and bool(injected) and not any(anomalies.values())\\nreport={'schema':'hia.cli.original-agent-entry-native-selection.v1','status':'PASS' if passed else 'FAIL','loaded_test_ids':loaded,'executed_test_ids':executed,'tests_run':result.testsRun,'selected_child_argv':injected,**anomalies}\\nPath(report_path).write_text(json.dumps(report,sort_keys=True,indent=2)+'\\\\n')\\nraise SystemExit(0 if passed else 1)\\n'''\\n        (output / \\\"controller.py\\\").write_text(script)\\n        process = subprocess.run([sys.executable, \\\"-B\\\", str(output / \\\"controller.py\\\"),\\n                                  str(self.manifest), str(output / \\\"report.json\\\")], cwd=ROOT,\\n                                 env=environment({\\\"PYTHONPATH\\\": str(ROOT), \\\"PYTHONDONTWRITEBYTECODE\\\": \\\"1\\\"}),\\n                                 capture_output=True, timeout=180)\\n        (output / \\\"stdout.log\\\").write_bytes(process.stdout)\\n        (output / \\\"stderr.log\\\").write_bytes(process.stderr)\\n        self.assertEqual(process.returncode, 0, process.stdout + process.stderr)\\n        report = json.loads((output / \\\"report.json\\\").read_bytes())\\n        self.assertEqual(report[\\\"status\\\"], \\\"PASS\\\")\\n        self.assertTrue(report[\\\"loaded_test_ids\\\"])\\n        self.assertEqual(report[\\\"loaded_test_ids\\\"], report[\\\"executed_test_ids\\\"])\\n        self.assertEqual(report[\\\"tests_run\\\"], len(report[\\\"loaded_test_ids\\\"]))\\n        self.assertFalse(any(report[key] for key in\\n                             (\\\"failures\\\", \\\"errors\\\", \\\"skipped\\\", \\\"expected_failures\\\", \\\"unexpected_successes\\\")))\\n\\n\\n    def test_actual_installed_wheel_without_retained_cli_or_checkout_resources(self):\\n        from hepta.hia_agent_contract import DISCOVERY_FILES, NATIVE_SOURCE_FILES, SOURCE_BUILD_FILES, COMPILER_BUILD_FILES, PUBLICATION_BUILD_FILES, BACKEND_BUILD_FILES, EMITTER_BUILD_FILES, BYTE_WRAPPER_BUILD_FILES, MACHINE_OBJECT_BUILD_FILES, EXECUTION_OBSERVATION_BUILD_FILES, CONTINUATION_BUILD_FILES, ENTRY_BUILD_FILES\\n        from tests.test_hia_agent_entry import fixture\\n        case = self.folder / \\\"installed-control\\\"\\n        case.mkdir(mode=0o700)\\n        source, wheels, installed = case / \\\"source\\\", case / \\\"wheels\\\", case / \\\"installed\\\"\\n        source.mkdir(mode=0o700)\\n        resources = ((tuple(\\\"docs/\\\" + name for name in DISCOVERY_FILES) + NATIVE_SOURCE_FILES\\n                     + SOURCE_BUILD_FILES + COMPILER_BUILD_FILES + PUBLICATION_BUILD_FILES) + BACKEND_BUILD_FILES + EMITTER_BUILD_FILES + BYTE_WRAPPER_BUILD_FILES + MACHINE_OBJECT_BUILD_FILES + EXECUTION_OBSERVATION_BUILD_FILES + CONTINUATION_BUILD_FILES + ENTRY_BUILD_FILES)\\n        required = {\\n            \\\"control\\\": \\\"examples/hia_bootstrap/cli_control.hepta\\\",\\n            \\\"format\\\": \\\"examples/hia_bootstrap/cli_format.hepta\\\",\\n        }\\n        for name in required.values():\\n            self.assertIn(name, NATIVE_SOURCE_FILES)\\n        shutil.copytree(ROOT / \\\"hepta\\\", source / \\\"hepta\\\", ignore=shutil.ignore_patterns(\\\"__pycache__\\\", \\\"*.pyc\\\"))\\n        for name in (*resources, \\\"setup.py\\\", \\\"pyproject.toml\\\", \\\"MANIFEST.in\\\"):\\n            target = source / name\\n            target.parent.mkdir(parents=True, exist_ok=True)\\n            shutil.copyfile(ROOT / name, target)\\n        bundle = case / \\\"bundle\\\"\\n        shutil.copytree(self.manifest.parent, bundle)\\n        manifest = bundle / self.manifest.name\\n        inputs = case / \\\"input.hia\\\"\\n        inputs.write_text(json.dumps(fixture()))\\n        packaging_python = os.environ.get(\\\"HEPTA_HIA_TEST_PACKAGING_PYTHON\\\", sys.executable)\\n        records = []\\n        source_hashes = {name: sha256(path.read_bytes()).hexdigest() for name, path in SOURCES.items()}\\n        report = {\\n            \\\"schema\\\": \\\"hepta.hia.cli-installed-control.v1\\\", \\\"status\\\": \\\"HOLD\\\", \\\"scope\\\": self.scope,\\n            \\\"whole_native_delivery_qualified\\\": False, \\\"source_sha256_before\\\": source_hashes,\\n            \\\"packaging_uses_declared_resources_only\\\": True, \\\"processes\\\": records,\\n            \\\"original_manifest\\\": str(self.manifest), \\\"manifest\\\": str(manifest),\\n        }\\n\\n        def command(arguments, label, *, env=None):\\n            result = subprocess.run(arguments, cwd=case, env=env, capture_output=True, timeout=120)\\n            (case / (label + \\\".stdout\\\")).write_bytes(result.stdout)\\n            (case / (label + \\\".stderr\\\")).write_bytes(result.stderr)\\n            records.append({\\\"label\\\": label, \\\"argv\\\": arguments, \\\"returncode\\\": result.returncode,\\n                            \\\"stdout_sha256\\\": sha256(result.stdout).hexdigest(),\\n                            \\\"stderr_sha256\\\": sha256(result.stderr).hexdigest()})\\n            (case / \\\"processes.json\\\").write_text(json.dumps(records, sort_keys=True, indent=2) + \\\"\\\\n\\\")\\n            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)\\n            return result\\n\\n        child = r'''\\nimport argparse,importlib.abc,importlib.metadata,io,json,os,sys\\nfrom contextlib import redirect_stdout,redirect_stderr\\nfrom hashlib import sha256\\nfrom pathlib import Path\\ninstalled=Path(sys.argv[1]).resolve(strict=True)\\nmanifest=Path(sys.argv[2]).resolve(strict=True)\\ninput_path=Path(sys.argv[3]).resolve(strict=True)\\nsys.path.insert(0,str(installed))\\nforbidden_entries={\\\"tools\\\":[],\\\"retained_cli\\\":[],\\\"retained_parser\\\":[]}\\nclass NoTools(importlib.abc.MetaPathFinder):\\n def find_spec(self,fullname,path=None,target=None):\\n  if fullname==\\\"tools\\\" or fullname.startswith(\\\"tools.\\\"):\\n   forbidden_entries[\\\"tools\\\"].append(fullname)\\n   raise AssertionError(\\\"installed native CLI imported authoring tools\\\")\\nsys.meta_path.insert(0,NoTools())\\nfrom hepta import cli\\nfrom hepta.hia_cli_native import SOURCES,SELECTOR,installed_cli\\ndef forbidden_cli(*args,**kwargs):\\n forbidden_entries[\\\"retained_cli\\\"].append(True)\\n raise AssertionError(\\\"retained CLI body entered\\\")\\ndef forbidden_parser(*args,**kwargs):\\n forbidden_entries[\\\"retained_parser\\\"].append(True)\\n raise AssertionError(\\\"retained argparse entered\\\")\\ncli._reference_hia_main=forbidden_cli\\nargparse.ArgumentParser=forbidden_parser\\nentries=[e for e in importlib.metadata.distribution(\\\"hia-core\\\").entry_points\\n         if e.group==\\\"console_scripts\\\" and e.name==\\\"hia\\\"]\\nassert len(entries)==1 and entries[0].value==\\\"hepta.cli:hia_main\\\"\\nentry=entries[0].load()\\nassert entry is cli.hia_main\\nos.environ[SELECTOR]=str(manifest)\\nsource_bytes={}\\nfor name,path in SOURCES.items():\\n assert path.resolve(strict=True)==installed/\\\"hepta/_data/examples/hia_bootstrap\\\"/(\\\"cli_\\\"+name+\\\".hepta\\\")\\n source_bytes[name]=path.read_bytes()\\nowner=installed_cli(str(manifest))\\nnative_returns={\\\"control\\\":[],\\\"format\\\":[]}\\nfor name,image in ((\\\"control\\\",owner.control),(\\\"format\\\",owner.formatter)):\\n original=image._entry\\n def record(*args,_name=name,_original=original):\\n  result=_original(*args)\\n  native_returns[_name].append(int(result))\\n  return result\\n image._entry=record\\ncalls=[]\\ndef call(argv):\\n output,errors=io.StringIO(),io.StringIO()\\n with redirect_stdout(output),redirect_stderr(errors):\\n  try:kind,code=\\\"return\\\",entry(argv)\\n  except SystemExit as error:kind,code=\\\"exit\\\",error.code\\n value={\\\"argv\\\":argv,\\\"kind\\\":kind,\\\"code\\\":code,\\\"stdout\\\":output.getvalue(),\\\"stderr\\\":errors.getvalue()}\\n calls.append(value)\\n return value\\nversion=call([\\\"--version\\\"])\\nassert version[\\\"kind\\\"]==\\\"exit\\\" and version[\\\"code\\\"]==0 and version[\\\"stdout\\\"]==\\\"hia \\\"+cli.__version__+\\\"\\\\n\\\" and version[\\\"stderr\\\"]==\\\"\\\"\\nhelp_result=call([\\\"--help\\\"])\\nassert help_result[\\\"code\\\"]==0 and help_result[\\\"stderr\\\"]==\\\"\\\" and all(name in help_result[\\\"stdout\\\"] for name in cli.HIA_AGENT_ACTIONS)\\nverified=call([\\\"verify\\\",str(input_path)])\\nassert verified[\\\"kind\\\"]==\\\"return\\\" and verified[\\\"code\\\"]==0 and json.loads(verified[\\\"stdout\\\"])[\\\"status\\\"]==\\\"standalone_core_checked\\\"\\ncapabilities=call([\\\"capabilities\\\"])\\nassert capabilities[\\\"kind\\\"]==\\\"return\\\" and capabilities[\\\"code\\\"]==0 and json.loads(capabilities[\\\"stdout\\\"])[\\\"schema\\\"]==\\\"hepta.hia.agent-entry.v1\\\"\\nbad=call([\\\"verify\\\"])\\nassert bad[\\\"kind\\\"]==\\\"exit\\\" and bad[\\\"code\\\"]==2 and \\\"required: input\\\" in bad[\\\"stderr\\\"] and bad[\\\"stdout\\\"]==\\\"\\\"\\nmissing=call([\\\"verify\\\",str(input_path.with_suffix(\\\".missing\\\"))])\\nassert missing[\\\"kind\\\"]==\\\"return\\\" and missing[\\\"code\\\"]==2 and json.loads(missing[\\\"stdout\\\"])[\\\"diagnostics\\\"][0][\\\"code\\\"]==\\\"E_DRIVER\\\"\\nrefusals=[]\\ndef refuse(label,expected):\\n before={name:len(values) for name,values in native_returns.items()}\\n output,errors=io.StringIO(),io.StringIO()\\n with redirect_stdout(output),redirect_stderr(errors):\\n  try:entry([\\\"--version\\\"])\\n  except expected as error:refusals.append({\\\"case\\\":label,\\\"type\\\":type(error).__name__,\\\"message\\\":str(error)})\\n  else:raise AssertionError(\\\"selected invalid installation or bundle was accepted: \\\"+label)\\n assert output.getvalue()==errors.getvalue()==\\\"\\\"\\n assert before=={name:len(values) for name,values in native_returns.items()}\\nfor name,path in SOURCES.items():\\n original=source_bytes[name]\\n path.write_bytes(original+b\\\"\\\\n\\\")\\n try:refuse(\\\"changed-installed-\\\"+name,ValueError)\\n finally:path.write_bytes(original)\\n held=path.with_suffix(path.suffix+\\\".held\\\")\\n path.rename(held)\\n try:refuse(\\\"missing-installed-\\\"+name,FileNotFoundError)\\n finally:held.rename(path)\\n restored=call([\\\"--version\\\"])\\n assert restored[\\\"code\\\"]==0\\nbundle_original=manifest.read_bytes()\\nmetadata=json.loads(bundle_original)\\nfor label,change in ((\\\"bundle-schema\\\",{\\\"schema\\\":\\\"unrecognized\\\"}),\\n                     (\\\"bundle-child-traversal\\\",{\\\"control_manifest\\\":\\\"../outside.json\\\"}),\\n                     (\\\"bundle-child-hash\\\",{\\\"control_manifest_sha256\\\":\\\"0\\\"*64})):\\n manifest.write_text(json.dumps({**metadata,**change}))\\n try:refuse(label,ValueError)\\n finally:manifest.write_bytes(bundle_original)\\nos.environ[SELECTOR]=str(manifest.with_suffix(\\\".missing\\\"))\\ntry:refuse(\\\"missing-selected-bundle\\\",FileNotFoundError)\\nfinally:os.environ[SELECTOR]=str(manifest)\\nos.environ[SELECTOR]=\\\"\\\"\\ntry:refuse(\\\"empty-selected-bundle\\\",OSError)\\nfinally:os.environ[SELECTOR]=str(manifest)\\nassert all(path.read_bytes()==source_bytes[name] for name,path in SOURCES.items())\\nassert manifest.read_bytes()==bundle_original\\nassert all(native_returns.values()) and not any(forbidden_entries.values())\\nassert not any(name==\\\"tools\\\" or name.startswith(\\\"tools.\\\") for name in sys.modules)\\nassert sys.flags.isolated and sys.flags.no_site and os.environ[\\\"PATH\\\"]==\\\"\\\"\\nprint(json.dumps({\\\"schema\\\":\\\"hepta.hia.cli-installed-execution.v1\\\",\\n \\\"status\\\":\\\"PASS_INSTALLED_NATIVE_CLI_CONTROL\\\",\\\"python\\\":sys.version,\\n \\\"installed_source_paths\\\":{name:str(path) for name,path in SOURCES.items()},\\n \\\"source_sha256\\\":{name:sha256(raw).hexdigest() for name,raw in source_bytes.items()},\\n \\\"bundle_sha256\\\":sha256(bundle_original).hexdigest(),\\\"native_returns\\\":native_returns,\\n \\\"console_entry_point\\\":entries[0].value,\\\"isolated_without_site\\\":True,\\\"empty_PATH\\\":True,\\n \\\"forbidden_entries\\\":forbidden_entries,\\\"calls\\\":calls,\\\"refusals\\\":refusals,\\n \\\"sources_and_bundle_restored\\\":True,\\\"whole_native_delivery_qualified\\\":False},sort_keys=True))\\n'''\\n        try:\\n            command([packaging_python, \\\"-B\\\", \\\"-m\\\", \\\"pip\\\", \\\"wheel\\\", \\\"--no-cache-dir\\\", \\\"--no-deps\\\",\\n                     \\\"--no-index\\\", \\\"--no-build-isolation\\\", \\\"--wheel-dir\\\", str(wheels), str(source)], \\\"wheel-build\\\")\\n            wheel, = wheels.glob(\\\"*.whl\\\")\\n            with zipfile.ZipFile(wheel) as archive:\\n                members = archive.namelist()\\n                for name, resource in required.items():\\n                    self.assertEqual(archive.read(\\\"hepta/_data/\\\" + resource), SOURCES[name].read_bytes())\\n                self.assertFalse(any(name.startswith((\\\"tools/\\\", \\\"examples/\\\")) for name in members))\\n            command([packaging_python, \\\"-B\\\", \\\"-m\\\", \\\"pip\\\", \\\"install\\\", \\\"--no-cache-dir\\\", \\\"--no-deps\\\",\\n                     \\\"--no-index\\\", \\\"--target\\\", str(installed), str(wheel)], \\\"wheel-install\\\")\\n            script = case / \\\"installed-control.py\\\"\\n            script.write_text(child)\\n            env = environment({\\\"PATH\\\": \\\"\\\", \\\"PYTHONPATH\\\": \\\"\\\"})\\n            result = command([sys.executable, \\\"-I\\\", \\\"-S\\\", \\\"-B\\\", str(script), str(installed),\\n                              str(manifest), str(inputs)], \\\"installed-execution\\\", env=env)\\n            observed = json.loads(result.stdout)\\n            (case / \\\"installed-execution.json\\\").write_text(json.dumps(observed, sort_keys=True, indent=2) + \\\"\\\\n\\\")\\n            self.assertEqual(observed[\\\"schema\\\"], \\\"hepta.hia.cli-installed-execution.v1\\\")\\n            self.assertEqual(observed[\\\"status\\\"], \\\"PASS_INSTALLED_NATIVE_CLI_CONTROL\\\")\\n            self.assertEqual(observed[\\\"source_sha256\\\"], source_hashes)\\n            self.assertEqual(len(observed[\\\"refusals\\\"]), 9)\\n            self.assertTrue(observed[\\\"isolated_without_site\\\"])\\n            self.assertTrue(observed[\\\"empty_PATH\\\"])\\n            self.assertTrue(all(observed[\\\"native_returns\\\"].values()))\\n            self.assertFalse(any(observed[\\\"forbidden_entries\\\"].values()))\\n            report.update(status=\\\"PASS_INSTALLED_NATIVE_CLI_CONTROL\\\",\\n                          wheel={\\\"path\\\": str(wheel), \\\"bytes\\\": wheel.stat().st_size,\\n                                 \\\"sha256\\\": sha256(wheel.read_bytes()).hexdigest()},\\n                          installed_execution=observed)\\n            self.observations.append({\\\"test\\\": self.id(), \\\"installed_report\\\": str(case / \\\"report.json\\\"),\\n                                      \\\"native_returns\\\": observed[\\\"native_returns\\\"],\\n                                      \\\"refusal_cases\\\": [row[\\\"case\\\"] for row in observed[\\\"refusals\\\"]]})\\n        except BaseException as error:\\n            report.update(error_type=type(error).__name__, error=str(error))\\n            raise\\n        finally:\\n            report[\\\"source_sha256_after\\\"] = {name: sha256(path.read_bytes()).hexdigest()\\n                                             for name, path in SOURCES.items()}\\n            report[\\\"original_sources_preserved\\\"] = report[\\\"source_sha256_after\\\"] == source_hashes\\n            if not report[\\\"original_sources_preserved\\\"]:\\n                report[\\\"status\\\"] = \\\"HOLD\\\"\\n            (case / \\\"report.json\\\").write_text(json.dumps(report, sort_keys=True, indent=2) + \\\"\\\\n\\\")\\n        self.assertTrue(report[\\\"original_sources_preserved\\\"])\\n\\n\\ndef _q(buffer, offset):\\n    return struct.unpack_from(\\\"<Q\\\", buffer, offset)[0]\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    unittest.main()\\n\"\n    }\n  },\n  \"schema\": \"hepta.hia.cli-routing-retained-inputs.v1\"\n}\n"
      },
