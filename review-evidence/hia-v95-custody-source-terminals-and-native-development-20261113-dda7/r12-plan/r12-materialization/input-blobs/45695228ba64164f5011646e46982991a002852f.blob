        "text": "name: HIA Core-only\non: [push, pull_request, workflow_dispatch]\njobs:\n  source:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-python@v5\n        with:\n          python-version: '3.14.4'\n      - name: Install original Agent discovery dependency\n        run: python -m pip install jsonschema==4.26.0\n      - name: Install packaging dependencies for the actual portable Source fixture\n        run: python -m pip install setuptools==78.1.1 wheel==0.46.3\n      - name: Refresh checker custody before HIA generation\n        run: python -B tools/generate_hia_checker_inventory.py\n      - name: Regenerate actual HIA sources\n        run: |\n          set -eu\n          for component in core_workspace_pipeline core_workspace_facts core_workspace_facts_cli core_workspace_materialize core_workspace_cli capability_renaming core_module_graph core_workspace_json core_workspace_json_cli agent_identity agent_slice elf_linker native_filter core_json_cli agent_stdio agent_snapshot agent_snapshot_json agent_snapshot_json_cli sha256_stream native_observer sha256 json_preflight json_decode json_canonical core_json_frontend selfhost agent_binary64 agent_data_json instruction_policy program_shape function_shape artifact_publication core_admission_cli core_admission agent_binary64_format core_patch core_patch_cli core_patch_result_cli composite_types task_helpers composite_functions composite_constructor composite_outer worker_request release_install release_selection retirement_state agent_journal execution_budget candidate_budget source_build nominal_json slot_ledger cli_control cli_format json_wire worker_report machine_encoding machine_state machine_instructions machine_plan core_lowering core_emitter byte_wrapper machine_object execution_observation continuation enum_match enum_operations record_operations record_transitions task_operations call_primitive nominal_terminators nominal_module nominal_admission request_journal task_helper_cache artifact_namespace slot_ledger_continuation program_execution static_budget heap_bound heap_kernels core_json_bytes cpython_note_packer program_normalization linked_observer source_admission machine_elf machine_plan_control service_context core_lowering_control service_emission core_emitter_control native_byte_abi native_build_foreign native_build service_verification_foreign service_verification proof_contract service_requests service_requests_foreign core_verification assembly_front service_artifacts service_artifacts_foreign service_evaluation service_evaluation_foreign release_launch store_lifecycle_foreign store_lifecycle candidate_build selfhost_linux_stdio linux_stdio_entry cli_discovery_json selfhost_linux_process linux_process_entry selfhost_linux_cli_process linux_cli_entry native_cli_process cli_discovery_routing cli_parser_context selfhost_linux_file linux_file_entry native_file_read; do\n            python -B -m \"tools.generate_hia_$component\"\n          done\n          git diff --exit-code\n      - name: Refresh checker custody after HIA generation\n        run: python -B tools/generate_hia_checker_inventory.py\n      - run: python -B tools/check_hia_core_only.py\n      - run: python -B tools/generate_hia_selfhost_contract.py --check\n      - run: python -B tests/test_hia_selfhost_language_coverage.py --generate-inventory\n      - run: git diff --exit-code\n      - name: Check final checker custody inventory\n        run: python -B tools/generate_hia_checker_inventory.py --check\n      - name: Core source and independent reference controls\n        env:\n          HEPTA_HIA_CANDIDATE_BUILD_TEST_EVIDENCE: ${{ runner.temp }}/hia-candidate-build-source\n          HEPTA_HIA_LINUX_STDIO_SOURCE_EVIDENCE: ${{ runner.temp }}/hia-linux-stdio-source\n          HEPTA_HIA_LINUX_PROCESS_SOURCE_EVIDENCE: ${{ runner.temp }}/hia-linux-process-source\n        run: |\n          python -B - <<'PY'\n          import unittest\n          names = (\n              'tests.test_hia_core_only',\n              'tests.test_hia_cli_native.CliSourceTests',\n              'tests.test_hia_json_wire_native.WireSourceTests',\n              'tests.test_hia_complete_output_observation',\n              'tests.test_hia_agent_identity_source_binding',\n              'tests.test_hia_source_suffix',\n              'tests.test_hia_original_select_fragments.SourceSuffixConsumerTests',\n              'tests.test_hia_evidence_archive',\n              'tests.test_hia_retained_evidence',\n              'tests.test_hia_core_workspace_facts_native.CoreWorkspaceFactsSourceTests',\n              'tests.test_hia_core_workspace_materialize_native.CoreWorkspaceMaterializerSourceTests',\n              'tests.test_hia_core_string_accounting',\n              'tests.test_hia_structure_traversal',\n              'tests.test_hia_capability_renaming_native.CapabilityRenamingSourceTests',\n              'tests.test_hia_core_module_graph_native.CoreModuleGraphSourceTests',\n              'tests.test_hia_source_head_identity',\n              'tests.test_hia_integrated_workflow',\n              'tests.test_hia_core_workspace_json_native.CoreWorkspaceJsonSourceTests',\n              'tests.test_hia_core_workspace_json_cli.CoreWorkspaceJsonCliSourceTests',\n              'tests.test_hia_core_workspace_pipeline.CoreWorkspacePipelineSourceTests',\n              'tests.test_hia_agent_identity_native.AgentIdentitySourceTests',\n              'tests.test_hia_agent_slice_native.AgentSliceSourceTests',\n              'tests.test_hia_agent_installed_resources.AgentInstalledResourceSourceTests',\n              'tests.test_hia_agent_stdio.AgentStdioSourceTests',\n              'tests.test_hia_agent_snapshot_native.AgentSnapshotSourceTests',\n              'tests.test_hia_agent_snapshot_json_native.AgentSnapshotJsonSourceTests',\n              'tests.test_hia_agent_entry',\n              'tests.test_hia_elf_linker.ElfLinkerSourceTests',\n              'tests.test_hia_core_json_cli.CoreJsonCliSourceTests',\n              'tests.test_hia_program_selfhost.SelfhostBuildSourceTests',\n              'tests.test_hia_selfhost_word_io.WordIOSourceTests',\n              'tests.test_hia_selfhost_emitter_words.EmitterSourceTests',\n              'tests.test_hia_sha256_stream_native.Sha256StreamSourceTests',\n              'tests.test_hia_sha256_native.Sha256HiaSourceTests',\n              'tests.test_hia_json_preflight',\n              'tests.test_hia_json_preflight_native.JsonPreflightHiaSourceTests',\n              'tests.test_hia_json_decode_native.JsonDecodeHiaSourceTests',\n              'tests.test_hia_json_canonical_native.JsonCanonicalHiaSourceTests',\n              'tests.test_hia_selfhost_exports.ExportSourceTests',\n              'tests.test_hia_core_json_frontend_native.CoreJsonFrontendHiaSourceTests',\n              'tests.test_hia_selfhost.SelfhostSourceTests',\n              'tests.test_hia_selfhost_call_graph_efficiency.CallGraphSourceTests',\n              'tests.test_hia_selfhost_contract.SelfhostContractTests',\n              'tests.test_hia_selfhost_cli',\n              'tests.test_hia_selfhost_names',\n              'tests.test_hia_reference_fixture_efficiency',\n              'tests.test_hia_selfhost_returned_loans',\n              'tests.test_hia_selfhost_multi_results.SelfhostMultiResultSourceTests',\n              'tests.test_hia_selfhost_keywords.SelfhostKeywordTests',\n              'tests.test_hia_selfhost_signed.SelfhostSignedTests',\n              'tests.test_hia_selfhost_traps.SelfhostExplicitTrapTests',\n              'tests.test_hia_selfhost_language_coverage.SelfhostLanguageSourceTests',\n              'tests.test_hia_agent_data_json_native.AgentDataJsonSourceTests',\n              'tests.test_hia_agent_binary64_native.AgentBinary64SourceTests',\n              'tests.test_hia_instruction_policy_native.InstructionPolicySourceTests',\n              'tests.test_hia_program_shape_native.ProgramShapeSourceTests',\n              'tests.test_hia_function_shape_native.FunctionShapeSourceTests',\n              'tests.test_hia_artifact_publication_native.ArtifactPublicationPolicyTests',\n              'tests.test_hia_artifact_publication_route.PublicationRouteSourceTests',\n              'tests.test_hia_core_admission_native.CoreAdmissionSourceTests',\n              'tests.test_hia_core_admission_cli.CoreAdmissionCliSourceTests',\n              'tests.test_hia_core_patch_native.CorePatchSourceTests',\n              'tests.test_hia_core_patch_cli.CorePatchCliSourceTests',\n              'tests.test_hia_core_patch_result_cli.CorePatchResultCliSourceTests',\n              'tests.test_hia_core_patch_result_cli.CorePatchResultCliAdapterTests',\n              'tests.test_hia_composite_types_native.CompositeTypesSourceTests',\n              'tests.test_hia_composite_types_native.CompositeTypesAdapterTests',\n              'tests.test_hia_composite_origins_native.CompositeOriginsAdapterTests',\n              'tests.test_hia_composite_signatures_native.CompositeSignaturesAdapterTests',\n              'tests.test_hia_task_helpers_native.TaskHelpersSourceTests',\n              'tests.test_hia_task_helpers_native.TaskHelpersAdapterTests',\n              'tests.test_hia_composite_native_composition.SourceTests',\n              'tests.test_hia_composite_functions_native.FunctionSourceTests',\n              'tests.test_hia_composite_function_tokens.TokenCodecTests',\n              'tests.test_hia_composite_function_protocol_audit.FunctionTokenProtocolAuditTests',\n              'tests.test_hia_composite_constructor_source.ConstructorSourceTests',\n              'tests.test_hia_composite_constructor_native.ConstructorFrameTests',\n              'tests.test_hia_composite_outer_source.OuterSourceTests',\n              'tests.test_hia_composite_outer_native.OuterFrameTests',\n              'tests.test_hia_native_builder_source_binding',\n              'tests.test_hia_standalone_builder_source_binding',\n              'tests.test_hia_compile_stage_custody',\n              'tests.test_hia_unittest_gate',\n              'tests.test_hia_sha256_builder_source_binding',\n              'tests.test_hia_source_build_entrypoint',\n              'tests.test_hia_agent_binary64_format_native.AgentBinary64FormatSourceTests',\n              'tests.test_hia_agent_artifact_store_native.AgentArtifactStorePolicyTests',\n              'tests.test_hia_worker_request_native.WorkerRequestSourceTests',\n              'tests.test_hia_worker_native_helpers.WorkerHelperSourceTests',\n              'tests.test_hia_core_lowering_native.CoreLoweringSourceTests',\n              'tests.test_hia_core_emitter_native.CoreEmitterSourceTests',\n              'tests.test_hia_byte_wrapper_native.ByteWrapperSourceTests',\n              'tests.test_hia_machine_object_native.MachineObjectSourceTests',\n              'tests.test_hia_execution_observation_native.ExecutionObservationSourceTests',\n              'tests.test_hia_continuation_native.ContinuationSourceTests',\n              'tests.test_hia_worker_scheduling_bundle.WorkerSchedulingSourceTests',\n              'tests.test_hia_installed_fixture_resources',\n              'tests.test_hia_machine_plan_native.MachinePlanSourceTests',\n              'tests.test_hia_machine_encoding_native.MachineEncodingSourceTests',\n              'tests.test_hia_machine_state_native.MachineStateSourceTests',\n              'tests.test_hia_machine_instructions_native.MachineInstructionsSourceTests',\n              'tests.test_hia_worker_report_native.WorkerReportSourceTests',\n              'tests.test_hia_worker_report_custody.WorkerReportCustodySourceTests',\n              'tests.test_hia_release_install.ReleaseInstallerSourceTests',\n              'tests.test_hia_release_selection.ReleaseSelectionSourceTests',\n              'tests.test_hia_release_selection_review.ReleaseSelectionReviewPolicyTests',\n              'tests.test_hia_retirement_st