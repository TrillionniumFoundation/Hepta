    const bytes = Buffer.from(item.content, 'utf8');
    if (bytes.length !== item.bytes ||
        crypto.createHash('sha256').update(bytes).digest('hex') !== item.sha256) {
      throw Error('packet member byte identity mismatch: '+name);
    }
    const target = path.join(destination, ...parts);
    fs.mkdirSync(path.dirname(target), {recursive:true, mode:0o700});
    fs.writeFileSync(target, bytes, {flag:'wx', mode:item.mode==='100755'?0o755:0o644});
  }
