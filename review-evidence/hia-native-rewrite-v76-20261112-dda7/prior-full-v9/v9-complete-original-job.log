];
for (const spec of specs) {
  const result = await github.rest.git.getBlob({
    owner:'TrillionniumFoundation', repo:'Hepta', file_sha:spec.sha
  });
  if (result.data.encoding !== 'base64') throw Error('unexpected Git blob encoding');
  const raw = Buffer.from(result.data.content, 'base64');
  const digest = crypto.createHash('sha256').update(raw).digest('hex');
  const git = crypto.createHash('sha1').update(Buffer.from('blob '+raw.length+'\0')).update(raw).digest('hex');
  if (raw.length !== spec.size || digest !== spec.digest || git !== spec.sha || result.data.sha !== spec.sha) {
    throw Error('exact external packet identity mismatch');
  }
  const packet = JSON.parse(raw.toString('utf8'));
  const entries = Object.entries(packet.files);
  if (entries.length !== spec.files) throw Error('packet file inventory mismatch');
  const destination = path.join(root, spec.directory);
  fs.mkdirSync(destination, {mode:0o700});
  fs.writeFileSync(path.join(destination, 'SOURCE-PACKET.json'), raw, {flag:'wx', mode:0o600});
