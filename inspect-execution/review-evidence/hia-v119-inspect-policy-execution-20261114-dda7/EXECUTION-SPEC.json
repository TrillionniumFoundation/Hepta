          "id": "tests.test_hia_program_tools.HIAProgramToolsTests.test_cli_verify_run_inspect_and_patch_need_no_rust_or_high_level_source",
          "text": "def test_cli_verify_run_inspect_and_patch_need_no_rust_or_high_level_source(self):\n        with tempfile.TemporaryDirectory() as folder:\n            source, request, output = (Path(folder) / n for n in [\"input.hepta\", \"edit.json\", \"new.hepta\"])\n            source.write_text(json.dumps(scalar_program()))\n            request.write_text(json.dumps(add_two_patch(scalar_program())))\n            env = {**os.environ, \"RUSTC\": \"/does/not/exist\", \"PYTHONDONTWRITEBYTECODE\": \"1\"}\n            commands = [[\"verify\", str(source)], [\"inspect\", str(source)],\n                        [\"run\", str(source), \"--function\", \"increment\", \"--arguments\", \"[40]\"],\n                        [\"patch\", str(source), \"--request\", str(request), \"-o\", str(output)]]\n            for command in commands:\n                with self.subTest(command=command[0]):\n                    result = subprocess.run([sys.executable, \"-m\", \"tools.hia_core_reference\", *command],\n                                            env=env, capture_output=True, text=True, timeout=20)\n                    self.assertEqual(result.returncode, 0, result.stdout + result.stderr)\n                    json.loads(result.stdout)\n            self.assertNotEqual(verify_program(read_bounded(source)).sha256,\n                                verify_program(read_bounded(output)).sha256)\n"
        }
      ],
      "sha256": "3f637a36f31b92d014c846e61994741e251011e53b50dd1468e65c212f3482b5"
