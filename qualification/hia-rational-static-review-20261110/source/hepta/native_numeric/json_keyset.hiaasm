  in_k1:bool = compare.le(offset_k1,total_k1)
  valid_k1:bool = bool.and(same_k1,in_k1)
  branch valid_k1 remaining(left_k1,right_k1,offset_k1,total_k1,n_k1) invalid()
block remaining(left_k2:readbuf,right_k2:readbuf,offset_k2:u64,total_k2:u64,n_k2:usize)
  remaining_k2:u64 = int.sub.checked(total_k2,offset_k2)
  size_k2:u64 = int.cast(n_k2) {"mode":"wrap"}
  fits_k2:bool = compare.le(size_k2,remaining_k2)
  branch fits_k2 progress(left_k2,right_k2,offset_k2,total_k2,n_k2) invalid()
block progress(left_k3:readbuf,right_k3:readbuf,offset_k3:u64,total_k3:u64,n_k3:usize)
  zero_k3:usize = const() {"value":0}
  nonempty_k3:bool = compare.gt(n_k3,zero_k3)
  final_k3:bool = compare.eq(offset_k3,total_k3)
  valid_k3:bool = bool.or(nonempty_k3,final_k3)
  branch valid_k3 loop(left_k3,right_k3,offset_k3,total_k3,n_k3,zero_k3) invalid()
block loop(left_k4:readbuf,right_k4:readbuf,offset_k4:u64,total_k4:u64,n_k4:usize,index_k4:usize)
  more_k4:bool = compare.lt(index_k4,n_k4)
  branch more_k4 byte(left_k4,right_k4,offset_k4,total_k4,n_k4,index_k4) finish(offset_k4,total_k4,n_k4)
block byte(left_k5:readbuf,right_k5:readbuf,offset_k5:u64,total_k5:u64,n_k5:usize,index_k5:usize)
  a_k5:u8 = buffer.load(left_k5,index_k5)
  b_k5:u8 = buffer.load(right_k5,index_k5)
  equal_k5:bool = compare.eq(a_k5,b_k5)
  one_k5:usize = const() {"value":1}
  next_k5:usize = int.add.checked(index_k5,one_k5)
  branch equal_k5 loop(left_k5,right_k5,offset_k5,total_k5,n_k5,next_k5) unequal()
block finish(offset_k6:u64,total_k6:u64,n_k6:usize)
  size_k6:u64 = int.cast(n_k6) {"mode":"wrap"}
  end_k6:u64 = int.add.checked(offset_k6,size_k6)
  final_k6:bool = compare.eq(end_k6,total_k6)
  branch final_k6 equal() continuing()
block unequal()
  status_k7:u32 = const() {"value":0}
  ret(status_k7)
block continuing()
