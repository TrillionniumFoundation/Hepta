  same_total_k0:bool = compare.eq(left_total_k0,right_total_k0)
  branch same_total_k0 extent(left_k0,right_k0,offset_k0,left_total_k0) unequal()
block extent(left_k1:readbuf,right_k1:readbuf,offset_k1:u64,total_k1:u64)
  n_k1:usize = buffer.len(left_k1)
  m_k1:usize = buffer.len(right_k1)
