        "sha256": "2dc0f10e9af8baae6a743b323eb91f95b7d809c120c57f7686450771826c2e53",
        "text": "\"\"\"Qualify complete Linux-process callers from matching current-source cold B3.\n\nThe five retained native groups keep their original 180+3 second owners,\n20 second children, 1 MiB buffers and 10M VM limit. Cold preparation and the\noriginal 71 public source callers are separate complete groups. Development\npins/results and mutable serialized fixtures are not qualification authority.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nfrom pathlib import Path\nimport os\nimport platform\nimport sys\nimport time\nimport traceback\nimport unittest\n\nROOT = Path(__file__).resolve().parents[1]\nif __package__ in {None, ''}:\n    sys.path.insert(0, str(ROOT))\n\nfrom hepta.hia_agent_assembly import assemble_program, render_assembly\nfrom hepta.hia_linux_process import PROFILE\nfrom tools import hia_linux_process_cold as custody\nfrom tools.build_hia_linux_process_cold import (\n    build_toolchain, build_program, admit_toolchain, admit_program,\n)\nfrom tools.hia_linux_process_cold import (\n    CAPACITY, admit_cold, check_bindings, decode, digest, guard_authority,\n    pin, publish, re_admit_authority, require, wire,\n)\n\nCOLD_FIXTURE_ENV = 'HEPTA_HIA_LINUX_PROCESS_COLD_FIXTURE'\nEVIDENCE_ENV = 'HEPTA_HIA_LINUX_PROCESS_TEST_EVIDENCE'\nSOURCE_EVIDENCE_ENV = 'HEPTA_HIA_LINUX_PROCESS_SOURCE_EVIDENCE'\nGROUP_SECONDS = 180\nCLEANUP_SECONDS = 3\nCOMPILE_SECONDS = 20\nFIXTURE_SCHEMA = 'hepta.hia.linux-process-current-cold-fixture.v1'\nFIXTURE_STATUS = 'MATCHING_SOURCE_COLD_PROCESS_INPUTS_PREPARED_NOT_QUALIFIED'\nANOMALIES = ('failures', 'errors', 'skipped', 'expected_failures',\n             'unexpected_successes', 'subtest_failures')\nGROUP_ORDER = ('source', 'direct', 'packer', 'startup', 'entry', 'legacy', 'portable')\nGROUP_SELECTORS = {\n    'source': ('tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests',\n               'tests.test_hia_program', 'tests.test_hia_agent_assembly',\n               'tests.test_hia_linux_process.LinuxProcessPublicSourceTests'),\n    'direct': ('tests.test_hia_linux_process_cold.LinuxProcessMatchingColdNativeTests',),\n    'packer': ('tests.test_hia_linux_process_cold.LinuxProcessPackerMatchingColdNativeTests',),\n    'startup': ('tests.test_hia_linux_process_cold.LinuxProcessStartupMatchingColdNativeTests',),\n    'entry': ('tests.test_hia_linux_process_cold.LinuxProcessEntryMatchingColdNativeTests',),\n    'legacy': ('tests.test_hia_linux_process_cold.LinuxProcessDomainMatchingColdNativeTests',),\n    'portable': ('tests.test_hia_linux_process_cold.LinuxProcessPortableSourceTests',),\n}\nGROUP_COUNTS = {'source': 71, 'direct': 33, 'packer': 13, 'startup': 4,\n                'entry': 4, 'legacy': 4, 'portable': 1}\n# Filled mechanically from the frozen exact methods before this author revision\n# is admitted. Tests reject an absent pin or any changed complete test file.\nTEST_SOURCE_PINS = {'tests/test_hia_linux_stdio.py': 'fd406365f9d846f7c90471e9054653dd53f77918d05d27d37792914c8ee53cd8', 'tests/test_hia_program.py': '73de53638397a1d564b3580551c83fa0ecf936c79af3ba1c5334b929aad45d3c', 'tests/test_hia_agent_assembly.py': '2f429e970da879bb5e4e65f414c415cfe4df6577cfb3d9618a9c8a64d992c7f7', 'tests/test_hia_linux_process.py': 'fcfbd5ec034895b2526b69290bdd001bcd0e20e5d879fa36b95607b22684314e', 'tests/test_hia_linux_process_cold.py': '93309d8cdfa4060a437eabe6d03b3ab7c28f5e9fd872929031fb9488fcadba28', 'tests/test_hia_agent_installed_resources.py': '28281f2ba1ba11c735b7a88db599aa1baae7614a9cb19d3e59c3cd196a67e511', 'tests/hia_linux_process_programs.py': 'f37997f9f3b176e2dbd291185ad07523c828b7970e4defa3b5aa568a40d4781a', 'tests/hia_linux_process_cases.py': '427f9be316fb61c6220ac5d15f46b37fd37dadeca8110edcf4dc76871ccf8931', 'tests/hia_linux_stdio_cases.py': 'c7085e1660cb04b54db46058e10ea1ef953261acc1d60c3b72499554b7c0a1ef', 'tests/hia_linux_process_cold_cases.py': 'a5159e8b481a26b6113fc227371838f4dbb4389bc245c886ab1fd92c82bb6dc9', 'tests/hia_linux_process_buffer_observer.py': 'bfae4102bea6642589d9d2a8941b334fd1c9b75d8a1b2c9c96e390891dd27107', 'tests/hia_linux_process_buffer_child.py': '7cb753661bad24fccb55f6a2fa10c957adc950463702e9ad28ff54707fa21ce5', 'tests/hia_linux_process_startup_fault_observer.py': '6f7f9199e985acc7fff3d922678fdf917f26326645bad62119a36b6a26715b58', 'tests/fixtures/hia_linux_process_retained_controls.json': '7a308746f98a62627ac1449d9391ad72ab3c17dd9b70c089bf8ca874731e66ba'}\nEXPECTED_IDS = {'source': ('tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests.test_bounds_proven_before_provider_including_overflow_and_zero_count', 'tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests.test_callee_effect_propagation_and_unknown_host_target_are_closed', 'tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests.test_default_assembly_core_vm_and_code_still_refuse_extended_input', 'tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests.test_default_global_opcode_and_effect_tables_are_not_extended', 'tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests.test_exact_negative_errno_short_read_and_zero_still_issue_one_effect', 'tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests.test_exact_one_mib_read_and_write_buffers_are_preserved', 'tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests.test_exact_types_effects_and_empty_attributes_are_mandatory', 'tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests.test_explicit_profile_is_exact_and_never_guessed_from_module', 'tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests.test_forged_or_modified_verified_bytes_are_rechecked', 'tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests.test_original_compiler_bounds_and_entry_schema_are_not_widened', 'tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests.test_parent_suspend_and_loan_end_use_the_real_capability_checker', 'tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests.test_provider_domain_and_foreign_exception_identity_are_preserved', 'tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests.test_public_builder_rejects_bad_profile_and_compiler_pin_before_execution', 'tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests.test_public_byte_boundary_exact_types_and_original_extent_limits', 'tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests.test_public_roundtrip_checks_actual_io_opcodes_without_proxy_calls', 'tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests.test_reference_signal_is_explicit_exact_and_retains_full_state', 'tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests.test_request_carries_no_mutable_owner_or_implicit_real_fd_provider', 'tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests.test_step_stop_is_not_errno_and_runs_no_provider', 'tests.test_hia_program.CanonicalInputAndCFGTests.test_canonical_input_and_duplicate_keys', 'tests.test_hia_program.CanonicalInputAndCFGTests.test_immutable_snapshot_and_rechecked_public_constructor', 'tests.test_hia_program.CanonicalInputAndCFGTests.test_malformed_values_reject_with_controlled_errors', 'tests.test_hia_program.CanonicalInputAndCFGTests.test_ssa_cfg_effect_and_unknown_claim_rejections', 'tests.test_hia_program.CanonicalInputAndCFGTests.test_wrong_json_container_at_each_schema_position_is_rejected', 'tests.test_hia_program.ResourceExecutionTests.test_allocation_failure_empty_owner_multireturn_and_error_cleanup', 'tests.test_hia_program.ResourceExecutionTests.test_borrowed_call_reborrow_and_resume_parent', 'tests.test_hia_program.ResourceExecutionTests.test_local_stored_view_and_owner_cross_blocks_together', 'tests.test_hia_program.ResourceExecutionTests.test_loop_carries_owner_and_mutable_loan_identity', 'tests.test_hia_program.ResourceExecutionTests.test_write_read_move_drop_and_bounds', 'tests.test_hia_program.ScalarExecutionTests.test_checked_and_wrapping_at_every_integer_width', 'tests.test_hia_program.ScalarExecutionTests.test_closed_block_loop_and_calls', 'tests.test_hia_program.ScalarExecutionTests.test_exact_arguments_and_no_host_fabricated_capabilities', 'tests.test_hia_program.ScalarExecutionTests.test_signed_