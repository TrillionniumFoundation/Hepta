tests.test_hia_machine_frame_shared_native.SharedFrameSourceTests',\n              'tests.test_hia_service_emission_native.ServiceEmissionSourceTests',\n              'tests.test_hia_service_emission_builder.ServiceEmissionAdapterTests',\n              'tests.test_hia_service_emission_qualifier.ServiceEmissionQualifierSourceTests',\n              'tests.test_hia_service_emission_lifetimes.ServiceEmissionLifetimeSourceTests',\n              'tests.test_hia_artifact_publication_route.PublicationSealedDescriptorTests',\n              'tests.test_hia_candidate_evidence',\n              'tests.test_hia_candidate_preflight',\n              'tests.test_hia_core_emitter_control_native.CoreEmitterSourceTests',\n              'tests.test_hia_native_byte_abi_native.NativeByteABISourceTests',\n              'tests.test_hia_native_build_native.NativeBuildSourceTests',\n              'tests.test_hia_native_build_native.NativeBuildCallerSourceTests',\n              'tests.test_hia_service_verification_native.ServiceVerificationSourceTests',\n              'tests.test_hia_service_verification_builder.ServiceVerificationAdapterTests',\n              'tests.test_hia_service_verification_qualifier.ServiceVerificationQualifierSourceTests',\n              'tests.test_hia_service_verification_default_replay.ServiceVerificationDefaultReplaySourceTests',\n              'tests.test_hia_call_primitive_native.CallPrimitiveArenaTests',\n              'tests.test_hia_joint_owner_integration.JointOwnerIntegrationSourceTests',\n              'tests.test_hia_proof_contract_native.ProofContractSourceTests',\n              'tests.test_hia_proof_contract_builder.ProofContractAdapterTests',\n              'tests.test_hia_proof_contract_qualifier.ProofContractQualifierSourceTests',\n              'tests.test_hia_service_requests_native.ServiceRequestsSourceTests',\n              'tests.test_hia_service_requests_builder.ServiceRequestsAdapterTests',\n              'tests.test_hia_service_requests_qualifier.ServiceRequestsQualifierSourceTests',\n              'tests.test_hia_service_artifacts_native.ServiceArtifactsSourceTests',\n              'tests.test_hia_service_artifacts_builder.ServiceArtifactsAdapterTests',\n              'tests.test_hia_service_artifacts_qualifier.ServiceArtifactsQualifierSourceTests',\n              'tests.test_hia_service_evaluation_native.ServiceEvaluationSourceTests',\n              'tests.test_hia_service_evaluation_builder.ServiceEvaluationAdapterTests',\n              'tests.test_hia_service_evaluation_qualifier.ServiceEvaluationQualifierSourceTests',\n              'tests.test_hia_front_registration.FrontRegistrationSourceTests',\n              'tests.test_hia_backend_family_selection.BackendFamilySelectionTests',\n              'tests.test_hia_backend_family_selection.BackendFamilyFacadeTests',\n              'tests.test_hia_service_family_routing',\n              'tests.test_hia_checker_inventory.CheckerInventorySourceTests',\n              'tests.test_hia_checker_inventory.CheckerImportTemplateSourceTests',\n              'tests.test_hia_byte_policy_selection.BytePolicySelectionTests',\n              'tests.test_hia_retained_agent_callers.RetainedAgentCallerSourceTests',\n              'tests.test_hia_release_launch.ReleaseLaunchSourceTests',\n              'tests.test_hia_release_launch_qualifier.ReleaseLaunchQualifierSourceTests',\n              'tests.test_hia_candidate_build.CandidateBuildSourceTests',\n              'tests.test_hia_candidate_build_qualifier.CandidateBuildQualifierSourceTests',\n              'tests.test_hia_store_lifecycle_native.StoreLifecycleSourceTests',\n              'tests.test_hia_store_lifecycle_builder.StoreLifecycleAdapterTests',\n              'tests.test_hia_store_lifecycle_qualifier.StoreLifecycleQualifierTests',\n              'tests.test_hia_linux_stdio.LinuxStdioPublicSourceTests',\n              'tests.test_hia_linux_stdio_cold.LinuxStdioColdSourceTests',\n              'tests.test_hia_linux_stdio_cold.LinuxStdioPortableSourceTests',\n              'tests.test_hia_cli_discovery_json.CliDiscoveryJsonSourceTests',\n              'tests.test_hia_linux_process.LinuxProcessPublicSourceTests',\n              'tests.test_hia_linux_process_cold.LinuxProcessColdSourceTests',\n              'tests.test_hia_linux_process_cold.LinuxProcessPortableSourceTests',\n              'tests.test_hia_linux_cli_process.LinuxCliProcessSourceTests',\n              'tests.test_hia_cli_discovery_routing_native.CliDiscoveryRoutingSourceTests',\n              'tests.test_hia_linux_file.LinuxFileSourceTests',\n              'tests.test_hia_linux_file_render.LinuxFileRenderSourceTests',\n              'tests.test_hia_core_representation_source.CoreRepresentationSourceTests',\n              'tests.test_hia_verified_report_source.VerifiedReportSourceTests',\n              'tests.test_hia_linux_file_roundtrip_source.LinuxFileRoundtripSourceTests',\n              'tests.test_hia_cli_verified_report_native.CliVerifiedReportSourceTests',\n              'tests.test_hia_optional_profiles.OptionalProfileSourceTests',\n              'tests.test_hia_optional_profile_races.OptionalProfileRaceSourceTests',\n              'tests.test_hia_linux_file_roundtrip_cold.LinuxFileRoundtripColdSourceTests',\n              'tests.hia_linux_file_roundtrip_portable.RoundtripProfileCaptureSourceTests',\n              'tests.test_hia_roundtrip_source_roles.RoundtripSourceRoleTests',\n              'tests.test_hia_explicit_profile_providers.ExplicitProfileProviderSourceTests',\n          )\n          suite = unittest.defaultTestLoader.loadTestsFromNames(names)\n          expected = suite.countTestCases()\n          result = unittest.TextTestRunner(verbosity=2).run(suite)\n          complete = result.testsRun == expected and expected > 0\n          clean = not (result.errors or result.failures or result.skipped or\n                       result.expectedFailures or result.unexpectedSuccesses)\n          raise SystemExit(0 if complete and clean and result.wasSuccessful() else 1)\n          PY\n      - name: Preserve actual candidate Source VM buffers\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: hia-core-source-vm-${{ github.sha }}-${{ github.run_attempt }}\n          if-no-files-found: warn\n          retention-days: 7\n          path: ${{ runner.temp }}/hia-candidate-build-source/\n      - name: Preserve actual Linux portable Source evidence\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: hia-core-linux-portable-source-${{ github.sha }}-${{ github.run_attempt }}\n          if-no-files-found: error\n          retention-days: 7\n          include-hidden-files: true\n          path: |\n            ${{ runner.temp }}/hia-linux-stdio-source/\n            ${{ runner.temp }}/hia-linux-process-source/\n  native:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-python@v5\n        with:\n          python-version: '3.14.4'\n      - name: Install qualified Clang 20 native execution prerequisites\n        run: |\n          set -euo pipefail\n          curl --fail --location --retry 3 --output \"$RUNNER_TEMP/hia-llvm.asc\" https://apt.llvm.org/llvm-snapshot.gpg.key\n          fingerprint=$(gpg --show-keys --with-colons \"$RUNNER_TEMP/hia-llvm.asc\" | awk -F: '$1 == \"fpr\" { print $10; exit }')\n          test \"$fingerprint\" = 6084F3CF814B57C1CF12EFD515CF4D18AF4F7421\n          sudo install -m 0644 \"$RUNNER_TEMP/hia-llvm.asc\" /usr/share/keyrings/hia-llvm.asc\n          printf '%s\\n' 'deb [arch=amd64 signed-by=/usr/share/keyrings/hia-llvm.asc] https://apt.llvm.org/noble/ llvm-toolchain-noble-20 main' | sudo tee /etc/apt/sources.list.d/hia-llvm20.list\n          sudo apt-get update\n          sudo apt-get install -y binutils gcc clang-20 libclang-rt-20-dev strace\n          printf 'CLANG=/usr/bin/clang-20\\nHEPTA_CLANG=/usr/bin/clang-20\\n' >> \"$GITHUB_ENV\"\n      - run: python -m pip install setuptools==78.1.1 wheel==0.46.3 z3-solver==4.15.4.0 jsonschema==4.26.0\n      - name: Prepare original locked Rust caller dependencies\n        run: |\n          set -euo pipefail\n          cargo --version\n          rustc --version\n          sha256sum rust/hia-core-shadow/Cargo.toml rust/hia-core-shadow/Cargo.lock > \"$RUNNER_TEMP/hia-rust-caller-inputs.sha256\"\n          cargo fetch --locked --manifest-path rust/hia-core-shadow/Cargo.toml\n          sha256sum --check \"$RUNNER_TEMP/hia-rust-caller-inputs.sha256\"\n          git diff --exit-code -- rust/hia-core-shadow/Cargo.toml rust/hia-core-shadow/Cargo.lock\n      - run: python -B tools/replay_hia_selfhost_cold.py --output \"$RUNNER_TEMP/hia-cold.json\"\n      - name: Original call graph and native convergence controls\n        run: python -B tools/run_hia_unittest_gate.py tests.test_hia_selfhost_call_graph_efficiency.CallGraphNativeTests\n      - run: python -B tests/test_hia_selfhost_language_coverage.py --output \"$RUNNER_TEMP/hia-language.json\"\n      - name: Prepare isolated continuation-family evidence\n        run: mkdir -p \"$RUNNER_TEMP/hia-continuation-family\"\n      - name: Native selected release launch with matching cold and original kernel controls\n        run: python -B tools/qualify_hia_release_launch.py --cold-report \"$RUNNER_TEMP/hia-cold.json\" --evidence \"$RUNNER_TEMP/hia-release-launch-matching-cold\"\n      - name: Native candidate build with matching cold and all original 55 images\n        run: python -B -m tools.qualify_hia_candidate_build --cold-report \"$RUNNER_TEMP/hia-cold.json\" --evidence \"$RUNNER_TEMP/hia-candidate-build\"\n      - name: Native Store lifecycle with matching cold and all original controls\n        env:\n          HEPTA_HIA_STORE_LIFECYCLE_COLD_REPORT: ${{ runner.temp }}/hia-cold.json\n          HEPTA_HIA_STORE_LIFECYCLE_EVIDENCE: ${{ runner.temp }}/hia-store-lifecycle\n        run: python -B tools/run_hia_unittest_gate.py tests.test_hia_store_lifecycle_native.StoreLifecycleNativeTests\n      - name: Native Store lifecycle original agent callers\n        run: python -B tools/qualify_hia_store_lifecycle.py --caller-group agent --cold-report \"$RUNNER_TEMP/hia-cold.json\" --evidence \"$RUNNER_TEMP/hia-store-lifecycle-agent\"\n      - name: Native Store lifecycle original namespace callers\n        run: python -B tools/qualify_hia_store_lifecycle.py --caller-group namespace --cold-report \"$RUNNER_TEMP/hia-cold.json\" --evidence \"$RUNNER_TEMP/hia-store-lifecycle-namespace\"\n      - name: Native Store lifecycle original ledger callers\n        run: python -B tools/qualify_hia_store_lifecycle.py --caller-group ledger --cold-report \"$RUNNER_TEMP/hia-cold.json\" --evidence \"$RUNNER_TEMP/hia-store-lifecycle-ledger\"\n      - name: Native Linux stdio with matching cold and all original 69 controls\n        run: python -B tools/qualify_hia_linux_stdio.py --cold-report \"$RUNNER_TEMP/hia-cold.json\" --evidence \"$RUNNER_TEMP/hia-linux-stdio-matching-cold\"\n      - name: Native CLI discovery JSON with matching cold and all original four groups\n        run: python -B tools/qualify_hia_cli_discovery_json.py --cold-report \"$RUNNER_TEMP/hia-cold.json\" --evidence \"$RUNNER_TEMP/hia-cli-discovery-json-matching-cold\"\n      - name: Native Linux process with matching cold and all original 130 controls\n        run: python -B tools/qualify_hia_linux_process.py --cold-report \"$RUNNER_TEMP/hia-cold.json\" --evidence \"$RUNNER_TEMP/hia-linux-process-matching-cold\"\n      - name: Native CLI discovery bundle with matching cold and all original 43 plus nine controls\n        run: python -B -m tools.qualify_hia_cli_discovery_bundle --cold-report \"$RUNNER_TEMP/hia-cold.json\" --evidence \"$RUNNER_TEMP/hia-cli-discovery-bundle-matching-cold\"\n      - name: Native linked loader and compiler receipt bindings\n        run: |\n          python -B - <<'PYBINDINGS'\n          from hashlib import sha256\n          import json\n          import os\n          from pathlib import Path\n          import unittest\n          from tools.build_hia_json_preflight import admit_cold_build\n          cold_path = Path(os.environ['HEPTA_HIA_LINKED_OBSERVER_COLD_REPORT'])\n          cold_bytes = cold_path.read_bytes()\n          cold = json.loads(cold_bytes)\n          nested_bytes = Path(cold['nested_report']).read_bytes()\n          if sha256(nested_bytes).hexdigest() != cold['nested_report_sha256']:\n              raise ValueError('current cold nested report changed before receipt controls')\n          nested = json.loads(nested_bytes)\n          compiler = Path(nested['generations'][-1]['produced_image'])\n          compiler_bytes = compiler.read_bytes()\n          admit_cold_build(compiler_bytes, cold_bytes)\n          os.environ['HEPTA_HIA_COMPILE_RECEIPT_COMPILER'] = str(compiler)\n          os.environ['HEPTA_HIA_COMPILE_RECEIPT_COMPILER_SHA256'] = sha256(compiler_bytes).hexdigest()\n          names = (\n              'tests.test_hia_selfhost_linked_observer.LinkedObserverNativeTests',\n              'tests.test_hia_original_select_fragments.CompleteOutputObservationTests',\n              'tests.test_hia_compile_receipt_binding.CompileReceiptNativeTests',\n          )\n          suite = unittest.defaultTestLoader.loadTestsFromNames(names)\n          if suite.countTestCases() != 37:\n              raise AssertionError('complete linked-loader and receipt control inventory changed')\n          _loaded_count = suite.countTestCases()\n          result = unittest.TextTestRunner(verbosity=2).run(suite)\n          unchanged = (compiler.read_bytes() == compiler_bytes\n                       and cold_path.read_bytes() == cold_bytes\n                       and Path(cold['nested_report']).read_bytes() == nested_bytes)\n          passed = (result.wasSuccessful() and result.testsRun == 37 and unchanged\n                    and not result.skipped and not result.expectedFailures\n                    and not result.unexpectedSuccesses)\n          complete = result.testsRun == _loaded_count and _loaded_count > 0\n          clean = not (result.errors or result.failures or result.skipped or\n                       result.expectedFailures or result.unexpectedSuccesses)\n          raise SystemExit(0 if (passed) and complete and clean else 1)\n          PYBINDINGS\n        env:\n          HEPTA_HIA_LINKED_OBSERVER_COLD_REPORT: ${{ runner.temp }}/hia-cold.json\n          HEPTA_HIA_LINKED_OBSERVER_EVIDENCE: ${{ runner.temp }}/hia-continuation-family/hia-linked-observer\n          HEPTA_HIA_COMPILE_RECEIPT_OBSERVATIONS: ${{ runner.temp }}/hia-continuation-family/hia-compile-receipts\n      - name: Native applications and actual Core memory controls\n        run: |\n          python -B - <<'PYTEST'\n          import unittest\n          names = (\n              'tests.test_hia_agent_stdio',\n              'tests.test_hia_agent_snapshot_native',\n              'tests.test_hia_agent_snapshot_json_native',\n              'tests.test_hia_core_json_cli',\n              'tests.test_hia_program_selfhost.SelfhostBuildNativeTests',\n              'tests.test_hia_elf_linker',\n              'tests.test_hia_agent_identity_native',\n              'tests.test_hia_agent_slice_native',\n              'tests.test_hia_agent_installed_resources',\n              'tests.test_hia_native_child_limits',\n              'tests.test_hia_native_seccomp',\n              'tests.test_hia_native_side_effects',\n              'tests.test_hia_native_cleanup',\n              'tests.test_hia_native_mapping_identity',\n              'tests.test_hia_native_startup_isolation',\n              'tests.test_hia_json_preflight_native',\n              'tests.test_hia_selfhost_emitter_words',\n              'tests.test_hia_host_region',\n              'tests.test_hia_host_region_admission_transaction',\n              'tests.test_hia_host_region_borrow_admission',\n              'tests.test_hia_host_region_borrow_rollback_receipt',\n              'tests.test_hia_host_region_completed_pin_retirement',\n              'tests.test_hia_host_region_finalization_receipt',\n              'tests.test_hia_host_region_job_identity',\n              'tests.test_hia_host_region_lease_authority',\n              'tests.test_hia_host_region_lease_identity_collision',\n              'tests.test_hia_host_region_lease_mprotect_receipt',\n              'tests.test_hia_host_region_lease_token_revocation',\n              'tests.test_hia_host_region_owner_registry_identity',\n              'tests.test_hia_host_region_owner_retirement',\n              'tests.test_hia_host_region_prestart_admission',\n              'tests.test_hia_host_region_prestart_pin_release_receipt',\n              'tests.test_hia_host_region_prestart_retirement_receipt',\n              'tests.test_hia_host_region_public_release_receipt',\n              'tests.test_hia_host_region_quarantine_receipt',\n              'tests.test_hia_host_region_race',\n              'tests.test_hia_host_region_recovery_mprotect_receipt',\n              'tests.test_hia_host_region_recovery_receipt',\n              'tests.test_hia_host_region_recovery_snapshot',\n              'tests.test_hia_host_region_recovery_zero_fault',\n              'tests.test_hia_host_region_write_receipt',\n              'tests.test_hia_agent_data_json_native',\n              'tests.test_hia_agent_binary64_native',\n              'tests.test_hia_agent_binary64_format_native',\n          )\n          suite = unittest.defaultTestLoader.loadTestsFromNames(names)\n          expected = suite.countTestCases()\n          result = unittest.TextTestRunner(verbosity=2).run(suite)\n          complete = result.testsRun == expected and expected > 0\n          clean = not (result.errors or result.failures or result.skipped or\n                       result.expectedFailures or result.unexpectedSuccesses)\n          raise SystemExit(0 if complete and clean and result.wasSuccessful() else 1)\n          PYTEST\n        env:\n          HEPTA_HIA_AGENT_STDIO_COLD_REPORT: ${{ runner.temp }}/hia-cold.json\n          HEPTA_HIA_SOURCE_BUILD_COLD_REPORT: ${{ runner.temp }}/hia-cold.json\n          HEPTA_HIA_NOMINAL_JSON_COLD_REPORT: ${{ runner.temp }}/hia-cold.json\n          HEPTA_HIA_AGENT_IDENTITY_COLD_REPORT: ${{ runner.temp }}/hia-cold.json\n      - name: Native HIA multi-image scheduling and source-bound installed entry\n        env:\n          HEPTA_HIA_NATIVE_CONTINUATION_COLD_REPORT: ${{ runner.temp }}/hia-cold.json\n        run: python -B tools/run_hia_unittest_gate.py tests.test_hia_continuation_native\n      - name: Five-family native in-process worker scheduling custody\n        env:\n          HEPTA_HIA_WORKER_SCHEDULING_COLD_REPORT: ${{ runner.temp }}/hia-cold.json\n          HEPTA_HIA_WORKER_SCHEDULING_FIXTURE_EVIDENCE: ${{ runner.temp }}/worker-scheduling-fixture\n        run: python -B tools/run_hia_unittest_gate.py tests.test_hia_worker_scheduling_bundle\n      - name: All original runtime callers with HIA-owned internal scheduling\n        run: python -B tools/qualify_hia_execution_observation_callers.py --native-continuation --cold-report \"$RUNNER_TEMP/hia-cold.json\" --evidence \"$RUNNER_TEMP/native-continuation-callers\"\n      - name: Original runtime callers through in-process HIA native scheduling\n        run: python -B tools/qualify_hia_execution_observation_callers.py --native-continuation --in-process --cold-report \"$RUNNER_TEMP/hia-cold.json\" --evidence \"$RUNNER_TEMP/native-inprocess-continuation-callers\"\n      - name: Original no-child compiler scripts through four in-process HIA schedulers\n        run: python -B tools/qualify_hia_continuation_no_child.py --cold-report \"$RUNNER_TEMP/hia-cold.json\" --evidence \"$RUNNER_TEMP/native-no-child-continuation-callers\"\n      - name: Native execution ledger policy and installed real runtime callers\n        run: |\n          python -B - <<'PYOBSERVE'\n          import unittest\n          suite=unittest.defaultTestLoader.loadTestsFromName('tests.test_hia_execution_observation_native')\n          expected=suite.countTestCases()\n          result=unittest.TextTestRunner(verbosity=2).run(suite)\n          clean=not(result.errors or result.failures or result.skipped or result.expectedFailures or result.unexpectedSuccesses)\n          raise SystemExit(0 if expected>0 and result.testsRun==expected and clean and result.wasSuccessful() else 1)\n          PYOBSERVE\n        env:\n          HEPTA_HIA_EXECUTION_OBSERVATION_COLD_REPORT: ${{ runner.temp }}/hia-cold.json\n          HEPTA_HIA_EXECUTION_OBSERVATION_FIXTURE_EVIDENCE: ${{ runner.temp }}/execution-observation-fixture\n      - name: Actual original runtime callers with retained ledger policy forbidden\n        run: python -B tools/qualify_hia_execution_observation_callers.py --cold-report \"$RUNNER_TEMP/hia-cold.json\" --evidence \"$RUNNER_TEMP/execution-observation-callers\"\n      - name: Native ELF object writer and actual source-bound installed controls\n        run: |\n          python -B - <<'PYMACHINE'\n          import unittest\n          suite = unittest.defaultTestLoader.loadTestsFromName('tests.test_hia_machine_object_native')\n          expected = suite.countTestCases()\n          result = unittest.TextTestRunner(verbosity=2).run(suite)\n          complete = result.testsRun == expected and expected > 0\n          clean = not (result.errors or result.failures or result.skipped or\n                       result.expectedFailures or result.unexpectedSuccesses)\n          raise SystemExit(0 if complete and clean and result.wasSuccessful() else 1)\n          PYMACHINE\n        env:\n          HEPTA_HIA_MACHINE_OBJECT_COLD_REPORT: ${{ runner.temp }}/hia-cold.json\n          HEPTA_HIA_MACHINE_OBJECT_FIXTURE_EVIDENCE: ${{ runner.temp }}/machine-object-fixture\n      - name: Actual original machine and Core callers with complete HIA ELF object control\n        run: python -B tools/qualify_hia_machine_object_callers.py --cold-report \"$RUNNER_TEMP/hia-cold.json\" --evidence \"$RUNNER_TEMP/machine-object-callers\"\n      - name: Actual original callers with native ELF byte wrapper Emitter and Function control together\n        run: python -B tools/qualify_hia_machine_object_callers.py --cold-report \"$RUNNER_TEMP/hia-cold.json\" --with-core-lowering --with-core-emitter --with-byte-wrapper --evidence \"$RUNNER_TEMP/machine-object-composed-callers\"\n      - name: Native byte wrapper and actual source-bound installed controls\n        run: |\n          python -B - <<'PYMACHINE'\n          import unittest\n          suite = unittest.defaultTestLoader.loadTestsFromName('tests.test_hia_byte_wrapper_native')\n          expected = suite.countTestCases()\n          result = unittest.TextTestRunner(verbosity=2).run(suite)\n          complete = result.testsRun == expected and expected > 0\n          clean = not (result.errors or result.failures or result.skipped or\n                       result.expectedFailures or result.unexpectedSuccesses)\n          raise SystemExit(0 if complete and clean and result.wasSuccessful() else 1)\n          PYMACHINE\n        env:\n          HEPTA_HIA_BYTE_WRAPPER_COLD_REPORT: ${{ runner.temp }}/hia-cold.json\n          HEPTA_HIA_BYTE_WRAPPER_FIXTURE_EVIDENCE: ${{ runner.temp }}/byte-wrapper-fixture\n      - name: Actual original machine and Core callers with complete HIA borrowed-byte control\n        run: python -B tools/qualify_hia_byte_wrapper_callers.py --cold-report \"$RUNNER_TEMP/hia-cold.json\" --evidence \"$RUNNER_TEMP/byte-wrapper-callers\"\n      - name: Actual original callers with native byte wrapper Emitter and Function control together\n        run: python -B tools/qualify_hia_byte_wrapper_callers.py --cold-report \"$RUNNER_TEMP/hia-cold.json\" --with-core-lowering --with-core-emitter --evidence \"$RUNNER_TEMP/byte-wrapper-composed-callers\"\n      - name: Native Core emitter and actual source-bound installed controls\n        run: |\n          python -B - <<'PYMACHINE'\n          import unittest\n          suite = unittest.defaultTestLoader.loadTestsFromName('tests.test_hia_core_emitter_native')\n          expected = suite.countTestCases()\n          result = unittest.TextTestRunner(verbosity=2).run(suite)\n          complete = result.testsRun == expected and expected > 0\n          clean = not (result.errors or result.failures or result.skipped or\n                       result.expectedFailures or result.unexpectedSuccesses)\n          raise SystemExit(0 if complete and clean and result.wasSuccessful() else 1)\n          PYMACHINE\n        env:\n          HEPTA_HIA_CORE_EMITTER_COLD_REPORT: ${{ runner.temp }}/hia-cold.json\n          HEPTA_HIA_CORE_EMITTER_FIXTURE_EVIDENCE: ${{ runner.temp }}/core-emitter-fixture\n      - name: Actual original machine and Core callers with complete HIA Emitter control\n        run: python -B tools/qualify_hia_core_emitter_callers.py --cold-report \"$RUNNER_TEMP/hia-cold.json\" --evidence \"$RUNNER_TEMP/core-emitter-callers\"\n      - name: Actual original callers with both native Emitter and Function control\n        run: python -B tools/qualify_hia_core_emitter_callers.py --cold-report \"$RUNNER_TEMP/hia-cold.json\" --with-core-lowering --evidence \"$RUNNER_TEMP/core-emitter-function-callers\"\n      - name: Native Core lowering and actual source-bound installed controls\n        run: |\n          python -B - <<'PYMACHINE'\n          import unittest\n          suite = unittest.defaultTestLoader.loadTestsFromName('tests.test_hia_core_lowering_native')\n          expected = suite.countTestCases()\n          result = unittest.TextTestRunner(verbosity=2).run(suite)\n          complete = result.testsRun == expected and expected > 0\n          clean = not (result.errors or result.failures or result.skipped or\n                       result.expectedFailures or result.unexpectedSuccesses)\n          raise Sys